__pycache__/
*.pyc

piper-voices

brave-Profiles
brave-profiles

# dunstrc is generated by theme-apply from dunstrc.tmpl per palette;
# dunstrc.tmpl is the versioned template.
.config/dunst/dunstrc


# Chrome theme signing artifacts (per-machine, never commit private key)
.config/qtile/browser-theme.pem
.config/qtile/browser-theme.key
.config/qtile/browser-theme.crx
.config/qtile/browser-theme-updates.xml
.config/qtile/browser-theme/Cached Theme.pak

# eww colors.scss regenerated by theme-apply per palette; template
# lives at .config/eww/colors.scss.tmpl (versioned).
.config/eww/colors.scss

# Per-machine generated theme artifacts (rewritten on every theme-apply
# / wal-precompile). Regenerated on demand; not portable across hosts.
.config/qtile/browser-theme/manifest.json
.config/qtile/WAL_PRECOMPILE_REPORT.md
.config/rofi/themes/palette-wal.rasi

# theme-apply symlinks these to the active theme file per mode.
# Per-machine runtime state, not portable.
.config/rofi/themes/current-palette.rasi
.config/kitty/themes/current.conf
.config/alacritty/themes/current.toml

# homepage.html regenerated per palette from homepage.html.tmpl
.config/qutebrowser/html/homepage.html

# dcli's own per-machine install-state tracking (installed.yaml,
# dotfiles-state.yaml, config-backups) -- not portable across hosts.
.config/arch-config/state/
