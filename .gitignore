__pycache__/
*.pyc

piper-voices

brave-Profiles
brave-profiles

# dunstrc is generated by theme-apply from dunstrc.tmpl per palette;
# dunstrc.tmpl is the versioned template.
.config/dunst/dunstrc


# Chrome theme signing artifacts (per-machine, never commit private key)
.config/qtile/browser-theme.pem
.config/qtile/browser-theme.key
.config/qtile/browser-theme.crx
.config/qtile/browser-theme-updates.xml
.config/qtile/browser-theme/Cached Theme.pak

# eww colors.scss regenerated by theme-apply per palette; template
# lives at .config/eww/colors.scss.tmpl (versioned).
.config/eww/colors.scss

# Per-machine generated theme artifacts (rewritten on every theme-apply
# / wal-precompile). Regenerated on demand; not portable across hosts.
.config/qtile/browser-theme/manifest.json
.config/qtile/WAL_PRECOMPILE_REPORT.md
.config/rofi/themes/palette-wal.rasi

# theme-apply symlinks these to the active theme file per mode.
# Per-machine runtime state, not portable.
.config/rofi/themes/current-palette.rasi
.config/kitty/themes/current.conf
.config/alacritty/themes/current.toml

# homepage.html regenerated per palette from homepage.html.tmpl
.config/qutebrowser/html/homepage.html

# dcli's own per-machine install-state tracking (installed.yaml,
# dotfiles-state.yaml, config-backups) -- not portable across hosts.
.config/arch-config/state/

# qt5ct/qt6ct palettes are regenerated by theme-apply's gen_qt_colors()
# on every apply (they carry the active mode's colours, so tracking them
# means a diff after every theme switch). The generator is the source of
# truth; these are pure output.
.config/qt5ct/colors/
.config/qt6ct/colors/
.config/qt5ct/qt5ct.conf
.config/qt6ct/qt6ct.conf

# ======================================================================
# Machine state -- never portable, actively harmful to ship (2026-07-30)
# ======================================================================
# qutebrowser's own runtime dirs: browser cache blobs, leveldb Local/
# Session Storage, logs. ~92 tracked files, all regenerated on first
# launch, none meaningful on another machine.
.config/qutebrowser/qutebrowser-preview/cache/
.config/qutebrowser/qutebrowser-preview/data/

# Personal browsing data, not configuration -- these are saved links, and
# one tracked bookmark was a file:///home/ati/... path that is dead on any
# other machine (validate.sh had to special-case the file to keep its
# hardcoded-home check green). qutebrowser creates both on demand, so a
# fresh clone just starts with an empty list.
.config/qutebrowser/bookmarks/urls
.config/qutebrowser/quickmarks

# fish REWRITES this file at runtime. The tracked copy carried a PATH with
# ~/.cargo/bin three times and dead fnm_multishells session dirs from this
# laptop. The settings that mattered now live in config.fish, versioned.
.config/fish/fish_variables
.config/fish/fishd.tmp.*

# Editor/tooling backups. Snapshots of one machine mid-edit.
*.bak
*.bak-*

# Written per-machine by the wizard's `gpu` module from the local PCI ids
# (see step_gpu). Shipping one machine's answer to another is the bug this
# whole mechanism exists to prevent.
.config/picom/gpu.env

# Rendered from the sibling .tmpl by the wizard's `paths` module, with
# @HOME@ replaced by the real $HOME. These three formats cannot expand a
# variable themselves (Chromium/Brave launchers pass flag lines verbatim;
# GTK CSS @import takes a URL), so the path must be baked in per machine.
.config/brave-flags.conf
.config/chrome-flags.conf
.config/chromium-flags.conf
.config/gtk-3.0/gtk.css
.config/gtk-4.0/gtk.css
.config/gtk-3.0/bookmarks

# Runtime state with this machine's paths baked in. nitrogen has no caller
# anywhere in the repo (the wallpaper is set by xwallpaper from ~/.cache/wall
# in .xinitrc), and these two files are just its window geometry and last
# selection. QtProject.conf is Qt's file-dialog history.
.config/nitrogen/nitrogen.cfg
.config/nitrogen/bg-saved.cfg
.config/qutebrowser/qsettings/

# copyq's lock/geometry state, rewritten while it runs.
.config/copyq/copyq_geometry.ini.lock
