# Private API keys, sourced by the rofi scripts via rofi_common.sh.
#
# Copy this to ~/.config/secrets.env and fill in what you have:
#
#   cp ~/.config/secrets.env.example ~/.config/secrets.env
#   chmod 600 ~/.config/secrets.env
#
# The real file must NOT be world-readable: rofi_common.sh warns you with a
# notification if it is anything other than 600 or 400. It is gitignored, and
# the keys used to live commented-out in /etc/environment, which is
# world-readable and not re-read by anything qtile spawns.
#
# Everything here is OPTIONAL. Without a key the feature that needs it
# degrades rather than breaking: the translators render without the
# "synonyms" and "examples" sections, and rofi_anki reports that the key is
# missing instead of drawing an empty menu.

# Google Gemini — used by:
#   rofi_translator          synonyms + example sentences
#   rofi_translator/wordreference.py
#   rofi_anki                card generation
#   rofi_docs                the "ask" panel
# Free tier is enough for all of it: https://aistudio.google.com/apikey
GEMINI_API_KEY=
