[Unit]
Description=Cloudflare quick tunnel for the local Stremio streaming server
After=network-online.target
Wants=network-online.target
# Both halves of this live OUTSIDE the repo: cloudflared is installed by
# hand, and sync-tunnel-url.sh belongs to the Stremio server's own data
# directory. Without the conditions a fresh checkout gets an enabled unit
# whose ExecStart does not exist, and Restart=always turns that into a
# restart loop at every login until systemd rate-limits it. Two DIFFERENT
# Condition directives on purpose: systemd ORs repeats of the same one and
# ANDs different ones, so ConditionFileIsExecutable twice would have meant
# "either", which is not the question being asked.
ConditionPathExists=/usr/local/bin/cloudflared
ConditionFileIsExecutable=%h/.stremio-server-data/sync-tunnel-url.sh

[Service]
Type=simple
ExecStartPre=/bin/sh -c ': > %h/.stremio-server-data/tunnel.log'
ExecStart=/usr/local/bin/cloudflared tunnel --url http://localhost:11470 --logfile %h/.stremio-server-data/tunnel.log
ExecStartPost=%h/.stremio-server-data/sync-tunnel-url.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
