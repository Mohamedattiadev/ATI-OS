[Unit]
Description=WTSH Telegram bot + Cloudflare quick tunnel
After=network-online.target
Wants=network-online.target
# The bot and its credentials are both outside the repo -- wtsh-bot-run is
# its own project, and wtsh-bot.env holds a token that must never be
# committed (it is not in .gitignore because it is not in this tree at
# all). A missing EnvironmentFile is a hard start failure, so guard the
# env file as well as the binary. Same reason as stremio-tunnel.service
# for the two condition directives being different ones.
ConditionFileIsExecutable=%h/.local/bin/wtsh-bot-run
ConditionPathExists=%h/.config/wtsh-bot.env

[Service]
Type=simple
EnvironmentFile=%h/.config/wtsh-bot.env
Environment=WTSH_LOG=info
Environment=WTSH_BOT_PORT=8080
# Tunnel mode: wtsh-bot-run brings up a Cloudflare quick tunnel, verifies it's
# actually reachable (retrying on a dead hostname), and runs the bot with
# PUBLIC_BASE_URL pointed at it -> proxied streaming (fixes Content-Disposition
# on Akwam links, and unlocks 4KHDHub). Needs the account-less quick-tunnel
# slot free (see stremio-tunnel.service). To go back to no-tunnel/raw-link
# mode, set ExecStart back to %h/.local/bin/wtsh-bot.
ExecStart=%h/.local/bin/wtsh-bot-run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
