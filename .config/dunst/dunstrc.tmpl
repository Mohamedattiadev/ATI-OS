    frame_color = "{{ACCENT}}"

[Keyboard Layout Changed!]

    summary = "Keyboard Layout Changed!"
    urgency = low
    background = "{{BG}}"
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"
[Note]
    summary = "Note"
