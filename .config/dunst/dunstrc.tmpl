    urgency = normal
    background = "{{BG}}"
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"
    icon = system-software-update-symbolic

[spotify]
    appname = "Spotify"
    urgency = low
    background = "{{BG}}"
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"
