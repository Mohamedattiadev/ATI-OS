[volume]
    appname = "Volume"
    urgency = normal   # changed from low
    background = "{{BG}}"
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"
    timeout = 1
    icon = audio-volume-medium-symbolic

[volume-mute]
    appname = "VolumeMute"
    urgency = low
    background = "{{BG}}"
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"
    timeout = 1
    icon = audio-volume-muted-symbolic
    history_ignore = yes
# --- Logging All Notifications ---

[message-info]
    summary = "message-info"
    urgency = low
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"

[message-warning]
    summary = "message-warning"
    urgency = normal
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"

[message-error]
    summary = "message-error"
    urgency = critical
    foreground = "{{FG}}"
    frame_color = "{{ACCENT}}"

[logall]
    summary = "*"
    script = /home/ati/.config/dunst/scripts/log-all.sh


[copy]
    summary = ".*"
    script = /home/ati/.config/dunst/scripts/do-copy.sh
