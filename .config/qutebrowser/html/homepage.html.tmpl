<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ati's Homepage</title>
    <link rel="stylesheet" href="../styles/homepage.css" />
    <!-- BEGIN-THEME-VARS (rewritten by theme-apply) -->
    <style id="theme-vars">
      :root {
        --bg: #000000;
        --bg-alt: #0a0a0a;
        --fg: #00ff41;
        --red: #ff0000;
        --green: #00ff41;
        --yellow: #c0ff00;
        --blue: #008f11;
        --purple: #00b849;
        --cyan: #00ff9f;
        --accent: #008f11;
        --urgent: #ff0000;
        --dim: #009c28;
        --highlight: #0f2413;
        --border: #16341c;
      }
    </style>
    <!-- END-THEME-VARS -->
  </head>
  <body>
    <div id="search" aria-hidden="true">
      <input
        id="search-field"
        type="text"
        name="search-field"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search…"
      />
      <div id="search-hint">
        <kbd>Enter</kbd> search &nbsp;·&nbsp; <kbd>Esc</kbd> close &nbsp;·&nbsp;
        prefix <kbd>!g</kbd> <kbd>!gh</kbd> <kbd>!yt</kbd> to jump
      </div>
    </div>

    <div class="container">
      <div id="clock">--:--:--</div>
      <div id="date"></div>
      <div class="welcome-message">
        Welcome, @@USER@@<span class="cursor">_</span>
      </div>

      <div class="bookmark-container">
        <div class="bookmark-set">
          <div class="bookmark-title">
            <span class="icon">🔧</span> Developer Tools
          </div>
          <div class="bookmark-inner-container">
            <a class="bookmark" href="https://devdocs.io/">DevDocs</a>
            <a class="bookmark" href="https://developer.mozilla.org/"
              >MDN Web Docs</a
            >
            <a class="bookmark" href="https://github.com/">GitHub</a>
            <a class="bookmark" href="https://gitlab.com">GitLab</a>
            <a class="bookmark" href="https://stackoverflow.com"
              >Stack Overflow</a
            >
            <a class="bookmark" href="https://onecompiler.com/"
              >OneCompiler — multi-language IDE</a
            >
            <a class="bookmark" href="https://playcode.io/"
              >PlayCode — instant JS</a
            >
          </div>
        </div>

        <div class="bookmark-set">
          <div class="bookmark-title"><span class="icon">⭐</span> Most used</div>
          <div class="bookmark-inner-container">
            <a class="bookmark" href="https://yewtu.be/"
              >YouTube — Invidious</a
            >
            <a class="bookmark" href="https://mohamedattiaDev.github.io/AtiDocs"
              >AtiDocs</a
            >
            <a class="bookmark" href="https://Fa3elKheer.github.io/Fa3elKheer"
              >Fa3elKheer</a
            >
            <a class="bookmark" href="https://github.com/MohamedattiaDev"
              >My GitHub</a
            >
            <a class="bookmark" href="https://www.linkedin.com/in/mohmd-attia/"
              >My LinkedIn</a
            >
            <a class="bookmark" href="https://x.com/Mohmd_Attia">My X</a>
            <a class="bookmark" href="https://www.instagram.com/mohmd_attia/"
              >My Instagram</a
            >
          </div>
        </div>

        <div class="bookmark-set">
          <div class="bookmark-title"><span class="icon">🎓</span> Uni</div>
          <div class="bookmark-inner-container">
            <a class="bookmark" href="https://obs.aybu.edu.tr/">AYBU OBS</a>
            <a class="bookmark" href="https://aybuzem.aybu.edu.tr/">AYBUZEM</a>
            <a class="bookmark" href="https://aybu.edu.tr/aybu/tr/duyurular"
              >AYBU — genel duyuru</a
            >
            <a
              class="bookmark"
              href="https://aybu.edu.tr/yazilimMuh/tr/duyurular"
              >AYBU — yazılım duyuru</a
            >
          </div>
        </div>
      </div>
    </div>

    <script>
      "use strict";

      // ---- clock -------------------------------------------------------
      const clock = document.getElementById("clock");
      const dateEl = document.getElementById("date");
      const pad = (n) => String(n).padStart(2, "0");

      const tick = () => {
        const d = new Date();
        clock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(
          d.getSeconds(),
        )}`;
        dateEl.textContent = d.toLocaleDateString(undefined, {
          weekday: "long",
          day: "numeric",
          month: "long",
        });
      };

      // Ran on window.onload before, so the clock showed the placeholder
      // until every subresource had settled. Nothing here needs images.
      tick();
      setInterval(tick, 1000);

      // ---- search overlay ----------------------------------------------
      const search = document.getElementById("search");
      const field = document.getElementById("search-field");

      // DuckDuckGo, matching c.url.searchengines DEFAULT in config.py --
      // this used to hardcode Google, so the start page and the :open
      // bar disagreed about where a bare query goes.
      const ENGINE = "https://duckduckgo.com/?q=";

      const openSearch = () => {
        search.classList.add("open");
        search.setAttribute("aria-hidden", "false");
        field.focus();
        field.select();
      };

      const closeSearch = () => {
        search.classList.remove("open");
        search.setAttribute("aria-hidden", "true");
        field.value = "";
        field.blur();
      };

      const submit = () => {
        const query = field.value.trim();
        if (!query) return;
        // Navigate this tab rather than window.open(): the overlay used
        // to stay up behind a brand-new tab, so the next Escape landed
        // on a page that was no longer in front of you.
        closeSearch();
        location.assign(ENGINE + encodeURIComponent(query));
      };

      document.addEventListener("keydown", (event) => {
        const typing = document.activeElement === field;

        if (event.key === "Escape") {
          closeSearch();
          return;
        }

        if (typing) {
          if (event.key === "Enter") {
            event.preventDefault();
            submit();
          }
          return;
        }

        // Space or / opens the overlay. Both are swallowed so the page
        // does not scroll / qutebrowser does not open its own find bar.
        if (event.key === " " || event.key === "/") {
          event.preventDefault();
          openSearch();
        }
      });

      // Clicking the dimmed backdrop (but not the input) dismisses it.
      search.addEventListener("mousedown", (event) => {
        if (event.target === search) closeSearch();
      });
    </script>
  </body>
</html>
