
(defwindow onboarding-welcome
  :monitor 0
  :geometry (geometry
              :x "0%"
              :y "0%"
              :width "400px"
              :height "200px"
              :anchor "center")
  :stacking "fg"
  :windowtype "dialog"
  :wm-ignore false
  :exclusive false
  :focusable false

 (revealer
    :reveal true
    :transition "fade"
    :duration "250ms"

  (box :class "onboarding"
       :orientation "v"
       :space-evenly false

    (label
      :class "onb-title"
      :halign "start"
      :text "Welcome")

    (label
      :class "onb-text"
      :halign "start"
      :xalign 0
      :wrap true
      :text
"This short tour will walk you through
the essentials and get you ready to work.")

    (box
      :class "onb-footer"
      :orientation "h"
      :space-evenly false

      (onb-steps :current 1)
      (box :hexpand true)

      (box
      :halign "end"
      :spacing 10


      (button
        :class "onb-btn onb-btn-danger"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; qtile cmd-obj -o widget tooltip_widgetbox -f close 2>/dev/null; true'"
        "Cancel")

      (button
        :class "onb-btn onb-btn-Apply"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; eww open bar-tooltip'"
        "Next")
    ))
  ))
)
