
(defwindow onboarding-keybindings
  :monitor 0
  :geometry (geometry
              :x "0%"
              :y "0%"
              :width "520px"
              :height "200px"
              :anchor "center")
  :stacking "fg"
  :windowtype "dialog"
  :wm-ignore false
  :exclusive false
  :focusable false

 (revealer
    :reveal true
    :transition "fade"
    :duration "250ms"

  (box :class "onboarding"
       :orientation "v"
       :space-evenly false

    (label
      :class "onb-title"
      :halign "start"
      :text "Keybindings")

    (label
      :class "onb-text"
      :halign "start"
      :xalign 0
      :wrap true
      :text
"Keybindings are essential for an efficient workflow.
Once they become muscle memory, everything starts to feel
effortless.")

        ;; Win+Shift+K enters CheatSheet-Mode (a swallowing KeyChord); the
        ;; sheet itself is the `k` that follows. Naming only the chord
        ;; left people holding a live mode with nothing on screen.
        (label
        :class "onb-text"
        :halign "start"
        :xalign 0
        :wrap true
:markup "<b>Tip: </b>Press <b><span foreground='${palette.cyan}'>Win + Shift + K</span></b>, then <b><span foreground='${palette.cyan}'>k</span></b>, to open the cheatsheet."
)

    (box
      :class "onb-footer"
      :orientation "h"
      :space-evenly false

      (onb-steps :current 4)
      (box :hexpand true)

      (box
      :halign "end"
      :spacing 10

      (button
        :class "onb-btn"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; eww open onboarding-workspaces'"
        "Back")

      ;; The sheet used to also open on a five second timer, which is why
      ;; this page carried a warning about it. Opening a full-screen popup
      ;; over someone who is still reading is not a feature, and a button
      ;; that opens it -- and gets the tour back when you press Esc -- says
      ;; the same thing without the countdown or the warning.
      (button
        :class "onb-btn"
        :timeout "3000ms"
        :onclick "setsid -f ati-onboarding-cheatsheet 0"
        "Cheatsheet")

      (button
        :class "onb-btn onb-btn-Apply"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; eww open onboarding-finish'"
        "Done")
    ))
  ))
)
