
(defwindow onboarding-finish
  :monitor 0
  :geometry (geometry
              :x "0%"
              :y "0%"
              :width "420px"
              :height "220px"
              :anchor "center")
  :stacking "fg"
  :windowtype "dialog"
  :wm-ignore false
  :exclusive false
  :focusable false

  (box
    :class "onboarding"
    :orientation "v"
    :space-evenly false

    ;; ----------------------------
    ;; Title
    ;; ----------------------------
    (label
      :class "onb-title"
      :halign "start"
      :text "You're all set")

    ;; ----------------------------
    ;; Message
    ;; ----------------------------
    (label
      :class "onb-text"
      :halign "start"
      :xalign 0
      :wrap true
      :unindent true
      :text
"Your system is ready to use now.
You’ve learned the basics:

• The top bar
• Workspaces
• Keybindings

From here on, everything is muscle memory.
Take your time, explore, and make it yours.


")

    ;; ----------------------------
    ;; Tip
    ;; ----------------------------
    ;; :wrap -- the card is 420px and this line is wider than it; without
    ;; wrapping pango ellipsised the tip mid-sentence.
    (label
      :class "onb-text"
      :halign "start"
      :xalign 0
      :wrap true
      :markup
"<b>Tip:</b> <b><span foreground='${palette.cyan}'>Win + Shift + K</span></b> then <b><span foreground='${palette.cyan}'>k</span></b> opens the cheatsheet, anytime.")

    ;; ----------------------------
    ;; Actions
    ;; ----------------------------
    (box
      :class "onb-footer"
      :orientation "h"
      :space-evenly false

      (onb-steps :current 5)
      (box :hexpand true)

      (box
      :halign "end"
      :spacing 10

      (button
        :class "onb-btn"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; eww open onboarding-keybindings'"
        "Back")

      (button
        :class "onb-btn onb-btn-Apply"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; qtile cmd-obj -o widget tooltip_widgetbox -f close 2>/dev/null; true'"
        "Finish")
    ))
  )
)
