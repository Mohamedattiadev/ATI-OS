;; ============================
;; Bar Tooltip + Multi Overlay (Onboarding)
;; ============================

(defwindow bar-tooltip
  :monitor 0
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore true
  :exclusive false         ;; 🔥 FIX
  :focusable false         ;; 🔥 FIX

  ;; 👇 THIS IS THE FIX
  ;; :visible {onb_open && onb_step == 1}

  ;; Covers bar + tooltip area
  :geometry (geometry
              :x "0%"
              :y "0%"
              :width "100%"
              :height "180px"
              :anchor "top left")

  ;; ONE revealer controls everything
  (revealer
    ;; :reveal {onb_open && onb_step == 1}

 :reveal true
  :transition "slidedown"
  :duration "250ms"    
  (box
      :orientation "v"
      :space-evenly false

      ;; ============================
      ;; OVERLAY STRIP (ON THE BAR)
      ;; ============================
      (centerbox

        :class "bar-overlay-container"
        :orientation "h"

        ;; -------- LEFT --------
        (box
          :class "bar-overlay"
          :halign "start"
          :valign "center"

          (label
            :class "bar-overlay-text"
            :text "Launcher & Layout & Opened apps")
        )

        ;; -------- CENTER --------
        (box
          :class "bar-overlay"
          :halign "center"
          :valign "center"

          (label
            :class "bar-overlay-text"
            :text "Active window")
        )

        ;; -------- RIGHT --------
        (box
          :class "bar-overlay"
          :halign "end"
          :valign "center"

          (label
            :class "bar-overlay-text"
            :text "System Widgets & clock & System tray")
        )
      )

      ;; ============================
      ;; TOOLTIP CARD (BELOW BAR)
      ;; ============================
      (box
        :orientation "h"
        :halign "center"
        :space-evenly  false

        (box
          :class "onboarding-tooltip"
          :orientation "v"
          ;; :spacing 6
          :space-evenly  false

          (label
            :class "onb-title"
            :halign "start"
            :text "Top Bar")

             (label
              :class "onb-text"
              :halign "start"
              :xalign 0
              :wrap true
              :unindent true
              :text "
        • Left — launchers ,layout and opened apps
        • Center —  active window info
        • Right — system widgets and time
         ")
(label
  :class "onb-text"
  :halign "start"
  :xalign 0
  :wrap true
  ;; main_icon_chip in config.py: Button1 open_docs, Button2 open_terminal,
  ;; Button3 open_launcher. Left-click stopped being the terminal when the
  ;; docs menu took the most prominent click in the bar -- the terminal
  ;; moved to middle-click, and this page never followed.
  :markup "• <span foreground='${palette.purple}'>󰕰</span>  Main menu:
 - <b><span foreground='${palette.fg}'>Left-Click</span></b> to open the docs menu
 - <b><span foreground='${palette.fg}'>Middle-Click</span></b> to open Terminal
 - <b><span foreground='${palette.fg}'>Right-Click</span></b> to open Launcher (Rofi)
  "
)
(label
  :class "onb-text"
  :halign "start"
  :xalign 0
  :wrap true
  :markup
"Right-side widgets (collapsed):
• <span foreground='${palette.green}'>△</span>  : system tray
• <span foreground='${palette.red}'>󰤂</span>   : CPU and memory status
• <span foreground='${palette.purple}'>󰖯</span>   : updates, volume and disk status
• <b><span foreground='${palette.cyan}'>x</span></b>   : wallpaper launcher
• <b><span foreground='${palette.fg}'>󰌶</span></b>   : tooltip (current opened app)
"
)


        ;; Mod keys as qtile binds them: mod = Win (config.py: "Alt broken
        ;; on hardware"), mod2 = Alt. Alt+grave is system_widgetbox,
        ;; Win+grave is 2nd_system_widgetbox -- this page had the two
        ;; the wrong way round.
        (label
        :class "onb-text"
        :halign "start"
        :xalign 0
        :wrap true
        :markup "<b>Tip: </b><b><span foreground='${palette.cyan}'>Alt + `</span></b> opens the system widgets, <b><span foreground='${palette.cyan}'>Win + `</span></b> the second set, <b><span foreground='${palette.cyan}'>Alt + Tab</span></b> the tray."
)

  ;; ============================
  ;; NAVIGATION (STEP 1)
  ;; ============================
  (box
    :class "onb-footer"
    :orientation "h"
    :space-evenly false

    (onb-steps :current 2)
    (box :hexpand true)

    (box
      :halign "end"
      :spacing 10

      (button
        :class "onb-btn"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; eww open onboarding-welcome'"
        "Back")

      (button
        :class "onb-btn onb-btn-Apply"
        :timeout "3000ms"
        :onclick "sh -c 'eww close onboarding-welcome bar-tooltip onboarding-workspaces onboarding-keybindings onboarding-finish 2>/dev/null; eww open onboarding-workspaces'"
        "Next")
    ))

        )
      )
    )
  )
)

