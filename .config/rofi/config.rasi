configuration {
  modi: "window,drun,ssh,combi";
  // Was "hack 10", which is not an installed family and is not declared in
  // arch-config/modules/fonts.yaml either; fc-match answers Noto Sans CJK KR.
  // It has been invisible because every theme under themes/ reaches
  // base.rasi, whose `* { font: }` overrides this one. That override is the
  // only reason it never showed, so the moment a menu is launched with a
  // theme that sets no font, the look would have depended on the installed
  // font set. Same family base.rasi names, for the same reason it names it.
  font: "Noto Sans CJK KR 10";
  combi-modi: "window,drun,ssh";

  kb-accept-entry: "Return";
  kb-remove-to-eol: "";

  kb-row-up: "Up,Control+p,Control+k";
  kb-row-down: "Down,Control+n,Control+j";
  drun-display-format: "{icon}    {name}";
  show-icons: true;
  terminal: "alacritty";
  // drun-use-generic-names: true;
  // window-format: "{w} · {c}";
  window-thumbnail: true;
  // max-history-size: 10;
  sort: true;
  // case-sensitive: false;
  // cycle: true;
  // sidebar-mode: true;
  icon-theme: "Papirus";
  icon-size: 24;
}

@theme "~/.config/rofi/themes/current.rasi"
