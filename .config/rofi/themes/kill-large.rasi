/**
 * Process kill picker. Delta: wider, more lines, wrap long lines.
 */

@import "base.rasi"

window {
    width:  75%;
    height: 60%;
}

/* Font inherited from base.rasi ("FiraCode Nerd Font Mono 12") so
 * rofi-kill matches other menus. */
listview {
    lines:   15;
    dynamic: true;
}

element-text {
    wrap:      true;
    ellipsize: false;
}

textbox {
    wrap:      true;
    ellipsize: false;
}
