/**
 * Process kill picker. Delta: wider, more lines, wrap long lines.
 */

@import "base.rasi"

window {
    width:  75%;
    height: 60%;
}

* {
    font: "FiraCode Nerd Font Mono Bold 10";
}

listview {
    lines:   15;
    dynamic: true;
}

element-text {
    wrap:      true;
    ellipsize: false;
}

textbox {
    wrap:      true;
    ellipsize: false;
}
