/**
 * Horizontal top-bar dmenu (dtos style).
 * Layout too different from base.rasi (horizontal), but palette
 * pulled from current-palette.rasi so wallpaper drives colors.
 */

@import "current-palette.rasi"

* {
    background-color: @background;
    border-color:     @background;
    text-color:       @foreground;
    height:           22px;
    font:             "FiraCode Nerd 10";
    prompt-font:      "FiraCode Nerd Bold 10";
    prompt-padding:   4px;
}

window {
    anchor:   north;
    location: north;
    width:    100%;
    padding:  0px;
    children: [ horibox ];
}

horibox {
    orientation: horizontal;
    children:    [ prompt, entry, listview ];
}

prompt {
    padding:          @prompt-padding;
    background-color: @selected;
    text-color:       @background;
    font:             @prompt-font;
}

listview {
    layout: horizontal;
    lines:  100;
}

entry {
    padding: 4px;
    expand:  false;
    width:   12em;
}

element {
    padding: 4px 10px;
}

element selected {
    background-color: @selectedone;
    text-color:       #ffffff;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

element-icon {
    background-color: inherit;
}
