/**
 * Shared rofi base — doom-one flavored, polished.
 * Palette from current-palette.rasi (theme-apply symlinks to
 * palette-wal.rasi so wallpaper drives colors).
 * Consumers @import this and override only layout deltas.
 */

@import "current-palette.rasi"

/* PROPORTIONAL, and deliberately so. Leave it alone.

   This used to read "FiraCode Nerd 12", which is NOT an installed family.
   fontconfig does not warn about a missing family -- it substitutes,
   silently -- and `fc-match "FiraCode Nerd"` answers NotoSansCJK, so the
   menus rendered in Noto Sans CJK KR by accident for their whole life.

   242b8ff "corrected" the string to "FiraCode Nerd Font Mono", the real
   family, on the reasoning that the padded columns below want a monospace
   font. The reasoning is sound; the look was wrong. These menus are wanted
   in the proportional face.

   So the face is kept and the NAME is now honest: this asks for the family
   it actually renders in, instead of relying on a lookup miss. Same
   pixels, but pinned -- a substitution depends on the whole installed font
   set, so adding an unrelated font could silently have changed what rofi
   looked like. noto-fonts-cjk is declared in modules/fonts.yaml and
   validate.sh asserts this family resolves to itself.

   The cost is real and accepted: rofi_docs pads its first column to a
   fixed width (`%-38s`) to align the second, and padding only aligns in a
   monospace font, so that column is ragged. If it ever needs to line up,
   fix it in rofi_docs -- with a rofi table/markup column rather than
   space padding -- and do NOT fix it by renaming the font here. */
* {
    background-color: transparent;
    text-color:       @foreground;
    font:             "Noto Sans CJK KR 13";
}

/* ---- SPACING PASS ----
   "The rofi popups need an upgrade in UI/UX and spacing, the font is a bit
   small." Every number below moved in one direction: outward. They are
   sized to sit beside the island rather than against it — the island's
   panels were rescaled in the same pass (qml/common/Metrics.js) and a
   launcher that is tighter and smaller-typed than everything around it
   reads as the odd surface, which is what it had become.

   The radius is 18 to match the island's panel corners, not 12. */
window {
    background-color: @background;
    location:         center;
    anchor:           center;
    padding:          22px;
    border-radius:    18px;
    border:           1px;
    border-color:     @selected;
}

mainbox {
    /* `message` has to be listed here or rofi silently DROPS every -mesg it
       is handed. It was styled forty lines further down but never packed,
       so the hint line under the prompt has never once been drawn --
       rofi-kill's "Alt+k force / Ctrl+y yank PID", rofi_todo's shortcuts,
       rofi_docs' navigation: all written, all invisible. rofi only builds
       the widget when there is a message to put in it, so menus that pass
       no -mesg are unchanged and gain no empty box. */
    children: [ inputbar, message, listview ];
    border:   0;
    padding:  0;
    spacing:  12px;
}

listview {
    fixed-height: 0;
    spacing:      7px;
    scrollbar:    false;
    padding:      10px 0px 0px;
    border:       0;
}

element {
    padding:       11px 14px;
    border-radius: 10px;
    border:        0;
    spacing:       13px;
}

/* 24, which is what config.rasi's `icon-size: 24` has been asking for all
   along. A theme rule beats the configuration block, so this 20 was quietly
   overriding it and every icon in every menu was drawn a fifth smaller than
   configured. Now the two agree. */
element-icon {
    size:             24px;
    background-color: inherit;
    padding:          0 6px 0 0;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element.normal.normal,
element.alternate.normal {
    background-color: @background;
    text-color:       @foreground;
}

element.selected.normal {
    background-color: @background-alt;
    border:           1px;
    border-radius:    10px;
    border-color:     @selectedone;
    text-color:       #ffffff;
}

element.normal.urgent,
element.selected.urgent,
element.alternate.urgent {
    background-color: @urgent;
    text-color:       @background;
}

element.normal.active,
element.selected.active,
element.alternate.active {
    background-color: @active;
    text-color:       @background;
}

scrollbar {
    width:        0px;
    border:       0;
    handle-width: 0px;
    padding:      0;
}

inputbar {
    padding:          13px 15px;
    spacing:          10px;
    background-color: @background-alt;
    border-radius:    10px;
    children:         [ prompt, entry, num-filtered-rows, textbox-num-sep, num-rows ];
}

prompt {
    enabled:          true;
    padding:          0 8px 0 2px;
    background-color: inherit;
    text-color:       @selected;
    markup:           true;
}

entry {
    background-color:  inherit;
    placeholder:       "Search...";
    placeholder-color: @selectedone;
    expand:            true;
    padding:           0px;
}

num-filtered-rows {
    expand:           false;
    background-color: inherit;
    text-color:       @foreground;
}

textbox-num-sep {
    expand:           false;
    str:              "/";
    background-color: inherit;
    text-color:       @selectedone;
}

num-rows {
    expand:           false;
    background-color: inherit;
    text-color:       @foreground;
}

message {
    padding:          13px;
    border:           0px;
    border-radius:    10px;
    background-color: @background-alt;
}

case-indicator {
    spacing: 0;
}
