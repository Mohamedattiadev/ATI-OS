/**
 * Shared rofi base — doom-one flavored, polished.
 * Palette from current-palette.rasi (theme-apply symlinks to
 * palette-wal.rasi so wallpaper drives colors).
 * Consumers @import this and override only layout deltas.
 */

@import "current-palette.rasi"

/* DELIBERATE, and not the family it appears to name. Leave it alone.

   "FiraCode Nerd" is NOT an installed family. fontconfig does not warn
   about a missing family -- it silently substitutes -- and
   `fc-match "FiraCode Nerd"` on this machine answers
   NotoSansCJK-Regular.ttc. So this line renders every rofi menu in
   Noto Sans CJK KR, a PROPORTIONAL face.

   242b8ff "corrected" this to "FiraCode Nerd Font Mono 12" on the
   reasoning that the padded columns below want a monospace font. That is
   true, and the look was still wrong: this is the face these menus are
   wanted in, so the substitution stays.

   The cost is real and accepted: rofi_docs pads its first column to a
   fixed width (`%-38s`) to align the second, and padding only aligns in a
   monospace font, so that column is ragged. If it ever needs to line up,
   fix it in rofi_docs -- with a rofi table/markup column rather than
   space padding -- and do NOT fix it by renaming the font here. */
* {
    background-color: transparent;
    text-color:       @foreground;
    font:             "FiraCode Nerd 12";
}

window {
    background-color: @background;
    location:         center;
    anchor:           center;
    padding:          16px;
    border-radius:    12px;
    border:           1px;
    border-color:     @selected;
}

mainbox {
    /* `message` has to be listed here or rofi silently DROPS every -mesg it
       is handed. It was styled forty lines further down but never packed,
       so the hint line under the prompt has never once been drawn --
       rofi-kill's "Alt+k force / Ctrl+y yank PID", rofi_todo's shortcuts,
       rofi_docs' navigation: all written, all invisible. rofi only builds
       the widget when there is a message to put in it, so menus that pass
       no -mesg are unchanged and gain no empty box. */
    children: [ inputbar, message, listview ];
    border:   0;
    padding:  0;
    spacing:  8px;
}

listview {
    fixed-height: 0;
    spacing:      4px;
    scrollbar:    false;
    padding:      6px 0px 0px;
    border:       0;
}

element {
    padding:       7px 10px;
    border-radius: 8px;
    border:        0;
    spacing:       10px;
}

element-icon {
    size:             20px;
    background-color: inherit;
    padding:          0 6px 0 0;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element.normal.normal,
element.alternate.normal {
    background-color: @background;
    text-color:       @foreground;
}

element.selected.normal {
    background-color: @background-alt;
    border:           1px;
    border-radius:    8px;
    border-color:     @selectedone;
    text-color:       #ffffff;
}

element.normal.urgent,
element.selected.urgent,
element.alternate.urgent {
    background-color: @urgent;
    text-color:       @background;
}

element.normal.active,
element.selected.active,
element.alternate.active {
    background-color: @active;
    text-color:       @background;
}

scrollbar {
    width:        0px;
    border:       0;
    handle-width: 0px;
    padding:      0;
}

inputbar {
    padding:          8px 10px;
    spacing:          8px;
    background-color: @background-alt;
    border-radius:    8px;
    children:         [ prompt, entry, num-filtered-rows, textbox-num-sep, num-rows ];
}

prompt {
    enabled:          true;
    padding:          0 8px 0 2px;
    background-color: inherit;
    text-color:       @selected;
    markup:           true;
}

entry {
    background-color:  inherit;
    placeholder:       "Search...";
    placeholder-color: @selectedone;
    expand:            true;
    padding:           0px;
}

num-filtered-rows {
    expand:           false;
    background-color: inherit;
    text-color:       @foreground;
}

textbox-num-sep {
    expand:           false;
    str:              "/";
    background-color: inherit;
    text-color:       @selectedone;
}

num-rows {
    expand:           false;
    background-color: inherit;
    text-color:       @foreground;
}

message {
    padding:          10px;
    border:           0px;
    border-radius:    8px;
    background-color: @background-alt;
}

case-indicator {
    spacing: 0;
}
