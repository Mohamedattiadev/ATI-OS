#!/bin/bash
#
# Script name: dm-documents
# Description: Search for PDFs to open.
# Dependencies: dmenu, fzf, rofi, zathura
# GitLab: https://www.gitlab.com/dwt1/dmscripts
# License: https://www.gitlab.com/dwt1/dmscripts/LICENSE
# Contributors: Derek Taylor
#               HostGrady

# Set with the flags "-e", "-u","-o pipefail" cause the script to fail
# if certain things happen, which is a good thing.  Otherwise, we can
# get hidden bugs that are hard to discover.

set -euo pipefail

# shellcheck disable=SC1091
source ./_dm-helper.sh 2>/dev/null || source _dm-helper.sh 2>/dev/null

source_dmscripts_configs

if configs_are_different; then
    echo "$(date): configs are different" >>"$DM_CONFIG_DIFF_LOGFILE"
    sleep 1
fi

main() {
    # The menu label used to be reconstructed back into a path with a
    # second set of sed substitutions, which lost files three ways:
    #
    #   * 's/.pdf//g' has an UNESCAPED dot, so it ate the character
    #     before the extension too. "Mohamed Attia(CV) .pdf" came back as
    #     "Mohamed Attia(CV).pdf" -- a file that does not exist. Two of
    #     the ten PDFs in this home directory failed exactly this way.
    #   * The abbreviations are not reversible. Any path merely
    #     CONTAINING "Pic" was expanded to "Pictures" on the way back.
    #   * 'sort -g' is a numeric sort applied to filenames, so the
    #     ordering was arbitrary.
    #
    # Keep the real path next to the label instead of trying to compute
    # it back from the display text. Abbreviations stay purely cosmetic.
    local -a files=() labels=()
    mapfile -d '' -t files < <(find "$HOME" -maxdepth 4 -iname '*.pdf' -print0 2>/dev/null)

    if (( ${#files[@]} == 0 )); then
        echo "No PDFs found under $HOME (maxdepth 4)." >&2
        exit 0
    fi

    declare -A REAL_PATH=()
    local f rel label
    for f in "${files[@]}"; do
        rel="${f#"$HOME"/}"
        # Exact suffix removal -- a parameter expansion, not a regex.
        label="${rel%.[Pp][Dd][Ff]}"
        # Cosmetic only; nothing is ever parsed back out of these.
        case "$label" in
            Documents/*) label="Dcs/${label#Documents/}" ;;
            Downloads/*) label="Dwn/${label#Downloads/}" ;;
            Pictures/*)  label="Pic/${label#Pictures/}" ;;
            Images/*)    label="Img/${label#Images/}" ;;
        esac
        # Two different files can abbreviate to the same label; keep both
        # reachable rather than letting one shadow the other.
        while [[ -n "${REAL_PATH[$label]:-}" ]]; do
            label+=" "
        done
        REAL_PATH["$label"]="$f"
        labels+=("$label")
    done

    choice=$(printf '%s\n' "${labels[@]}" | sort -f | ${MENU} "File: ") || exit 1

    if [[ -n "$choice" && -n "${REAL_PATH[$choice]:-}" ]]; then
        "${PDF_VIEWER}" "${REAL_PATH[$choice]}"
    else
        echo "Program Terminated." && exit 0
    fi
}

MENU="$(get_menu_program "$@")"
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main
