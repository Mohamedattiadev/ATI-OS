#!/usr/bin/env bash
# ati-theme-toggle — rofi picker for theme mode. Current mode marked with ●.
# Rofi uses the shared current.rasi palette so the picker matches whatever
# theme is active right now.
#
# NOTE: never use a shell var named DISPLAY in this script — it shadows
# the X11 $DISPLAY env var and every downstream tool (kitty @, brave,
# eww, qtile cmd-obj) then fails silently when theme-apply is exec'd.

set -euo pipefail

# readlink -f: this script is reached through a /usr/local/bin symlink, so
# a plain $0 dirname resolves to the symlink's directory, not the repo.
# shellcheck source=ati-rofi-common.sh
source "$(dirname "$(readlink -f "$0")")/ati-rofi-common.sh"

STATE_FILE="$HOME/.cache/qtile/theme_mode"
CURRENT="doomone"
[[ -f "$STATE_FILE" ]] && CURRENT="$(cat "$STATE_FILE")"

# "<display>|<mode>" — display shown in picker, mode passed to theme-apply.
ENTRIES=(
  "Wallpaper|wal"
  "DoomOne|doomone"
  "Dracula|dracula"
  "Gruvbox|gruvbox"
  "Nord|nord"
  "TokyoNight|tokyonight"
  "Catppuccin|catppuccin"
  "Monokai|monokai"
  "Everforest|everforest"
  "Rose Pine|rose-pine"
  "Kanagawa|kanagawa"
  "Oxocarbon|oxocarbon"
  "OneDark|onedark"
  "Palenight|palenight"
  "Night Owl|nightowl"
  "GitHub Dark|github-dark"
  "Ayu Mirage|ayu-mirage"
  "Cyberpunk Neon|cyberpunk-neon"
  "Synthwave|synthwave"
  "Matrix|matrix"
  "Mono Dark|mono-dark"
  "Mono Light|mono-light"
)

LIST=""
for e in "${ENTRIES[@]}"; do
  label="${e%%|*}"
  mode="${e##*|}"
  if [[ "$mode" == "$CURRENT" ]]; then
    LIST+="● $label"$'\n'
  else
    LIST+="○ $label"$'\n'
  fi
done

CHOICE="$(printf '%s' "$LIST" | rofi -dmenu -i -p "Theme" \
  -mesg "$(rofi_hint "↵ retint everything" "Esc cancels" "● is active" "${#ENTRIES[@]} palettes")")"
[[ -z "$CHOICE" ]] && exit 0

# Strip marker prefix ("● " or "○ ") — display name only.
LABEL="${CHOICE#* }"

MODE=""
for e in "${ENTRIES[@]}"; do
  if [[ "${e%%|*}" == "$LABEL" ]]; then
    MODE="${e##*|}"
    break
  fi
done

[[ -z "$MODE" ]] && exit 1
# ati-theme-animate, not theme-apply: it hands the change to whichever shell can
# draw the circular reveal and falls back to theme-apply when there is none.
# Picking a palette here used to repaint the desktop in stages while the
# island's own picker swept — the same change with two different faces
# depending on where you started it.
#
# Guarded, and not out of politeness: ati-theme-animate is a NEW script, so it is
# absent on any machine where AtiScriptsV1/install.sh has not been re-run
# since. `exec` on a missing command takes this shell down with it and the
# theme simply never changes — a picker that silently does nothing is the
# worst of the three outcomes here, and the fallback is exactly what
# ati-theme-animate itself would have done.
# ---- LET ROFI LEAVE THE SCREEN FIRST ----
#
# Reported: picking a theme here makes rofi freeze and glitch for about 0.4 s
# before the new palette arrives.
#
# The 0.4 s is not a coincidence and it is not the theme code. rofi is a LAYER
# SURFACE, Hyprland drops it from `hyprctl layers` when the close BEGINS and
# then animates it out, and looks.conf's `animation = fade, 1, 4` is 400 ms.
# Measured with a CONTROL that changed no theme at all — rofi opened and
# dismissed with Escape, consecutive frames differenced over the panel:
#
#     +3558 ms   the layer disappears from `hyprctl layers`
#     +3593 ms   the panel starts changing — the fade begins HERE
#     +3996 ms   d(prev) reaches the noise floor
#
# So rofi is still painted for ~400 ms after the compositor says it is gone,
# theme change or no theme change. What makes it a REPORTED bug is that the
# overlay screenshots the screen in that window and holds the frame: you get a
# half-faded rofi frozen in front of you for as long as theme-apply takes.
#
# NEXT-SESSION.md guessed "the frozen frame holds a rofi that has already
# exited". Right about the symptom, wrong about who was late — rofi exits
# promptly and the COMPOSITOR is the one still drawing it.
#
# Two things fix it together. looks.conf now sets `layerrule = animation none`
# for rofi, which halves the tail (ghost at +50 ms, gone by +200 ms), and this
# waits out the rest. The first attempt here waited only one frame, on the
# theory that the race was with rofi's exit; it changed nothing, which is what
# sent the measurement to the control run above.
#
# WAYLAND_DISPLAY, not XDG_SESSION_TYPE: this script is the qtile session's
# picker too, and that variable is set by the display manager and absent for a
# session started any other way. The RULES record it.
#
# The poll cap is 400 ms so a compositor that never reports the surface gone
# cannot hang the picker.
rofi_settle() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
    local i
    for ((i = 0; i < 40; i++)); do
      hyprctl layers -j 2>/dev/null | grep -q '"namespace": *"rofi"' || break
      sleep 0.01
    done
  fi
  sleep 0.25
}

rofi_settle

if command -v ati-theme-animate >/dev/null 2>&1; then
  exec ati-theme-animate "$MODE"
fi
exec theme-apply "$MODE"
