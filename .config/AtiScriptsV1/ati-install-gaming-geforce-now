#!/usr/bin/env bash
# ati-install-gaming-geforce-now — install NVIDIA's official GeForce NOW
# client via its own installer script. Ported from Omarchy's
# bin/omarchy-install-gaming-geforce-now (MIT, see NOTICE.md); adapted to
# use dcli for the flatpak dependency and drop the omarchy-launch-browser
# post-install step (a login-hang workaround specific to Omarchy's own
# browser-launch wrapper, not something ati-launch-webapp needs).
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/ati-rofi-common.sh"

require_cmd curl || exit 1

echo "Installing GeForce NOW..."
dcli install flatpak

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
installer="$tmpdir/GeForceNOWSetup.bin"

curl -fL --retry 3 -o "$installer" \
  https://international.download.nvidia.com/GFNLinux/GeForceNOWSetup.bin
chmod +x "$installer"
"$installer"

notify_safe "GeForce NOW" "Installed -- find it in Apps"
