#!/usr/bin/env bash
# rofi_windows — window switcher, drop-in for `rofi -show window -show-icons`,
# with a kill action added on the QML side.
#
# "win+p then j the windows rofi should be qml ... i want to add the kill
# feature so i can kill ... the selected window and asks for y/n". Real
# rofi's `-show window` is a built-in mode with no room to hang a custom
# action off of, and stays exactly as it was for X11 / island / no
# ati-menu-select (unchanged, see the guard just below) -- rofi already
# supports real in-session custom keybinds and this file adding a second,
# QML-only implementation of window-switching is not something anyone
# asked to touch there.
#
# On Wayland it is genuinely a different script: Menu.qml's dmenu is
# "pick one row, get one value", no custom keybind concept at all (same
# gap ati-kill's own qml_kill_flow and dm-spellcheck's review_qml already
# work around) -- so literal Ctrl+K while browsing the list isn't
# something the QML popup can do. The closest honest equivalent, same
# shape as ati-kill: pick a window, THEN pick what to do to it
# (Switch/Kill), Kill goes through rofi_confirm (Enter = yes, Esc = no,
# exactly as asked) before anything closes.
set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/../lib/ati-rofi-common.sh"

if ! use_ati_menu_select; then
	exec rofi -show window -show-icons
fi

require_cmd hyprctl jq || exit 1

# "should show the real icons of the apps and do not show '0x55fxzc.....'
# i want it show the real name" -- two separate fixes. The label is now
# "$class — $title", no address in sight; the 4th tab field (appIcon) is
# the class name, which Menu.qml (see its own note in rebuildDisplay())
# now resolves through the SAME icon-theme lookup real app rows use
# instead of a hand-picked Nerd Font glyph guessed from the class regex
# this used to carry. Falls back to a generic icon on its own when a
# class doesn't match anything installed -- nothing to do here for that.
#
# The address no longer rides in the label at all, so it isn't what
# comes back from a selection either (Menu.qml drops the icon field, and
# ati-menu-select's own `cut -f1` drops detail/appIcon too -- only label
# survives the round trip). Re-found afterward by matching "class — title"
# against a live re-scan, same "identify it by re-deriving, not by a row
# index rofi never gave us either" shape ati-kill's own PID lookup uses.
build_window_rows() {
	hyprctl clients -j 2>/dev/null | jq -r '
        .[] | select(.title != "" and (.workspace.id // -1) >= 0)
        | [.class, .title, .workspace.name] | @tsv
    ' | while IFS=$'\t' read -r class title ws; do
		printf '\t%s — %s\tworkspace %s\t%s\n' "$class" "$title" "$ws" "$class"
	done
}

qml_windows_flow() {
	local sel addr class action

	while true; do
		sel="$(build_window_rows | ati-menu-select --mode select --width 560 \
			--prompt "Windows")"
		[[ -z "$sel" ]] && return 0

		addr="$(hyprctl clients -j 2>/dev/null | jq -r --arg want "$sel" '
			.[] | select((.class + " — " + .title) == $want) | .address' | head -n1)"
		if [[ -z "$addr" ]]; then
			notify_safe "❌ Window already gone"
			continue
		fi
		class="${sel%% — *}"

		action="$(printf 'Switch to it\nKill\n' \
			| ati-menu-select --mode select --width 300 --prompt "$class")"
		case "$action" in
		"Switch to it")
			hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
			return 0
			;;
		Kill)
			if rofi_confirm "Kill $class?" ""; then
				hyprctl dispatch closewindow "address:$addr" >/dev/null 2>&1
			fi
			;;
		*) : ;;
		esac
	done
}

qml_windows_flow
