#!/usr/bin/env bash
# ati-menu-select — a themed `select one of N` / `prompt for text` dialog,
# drop-in for `rofi -dmenu` on the Hyprland side, routed through the QML
# ati-menu's own dmenu view (Menu.qml's openDmenu(), vendored from Omarchy)
# instead of rofi, so every picker Hyprland scripts pop up looks and behaves
# like the menu itself -- the same "match every picker's style to the QML
# menu" direction rofi's own base.rasi already carries for the qtile side.
#
# openDmenu() was fully wired the day Menu.qml was vendored; what was
# missing was a way to reach it from outside QML. shell.qml's new `dmenu`
# IPC function is that path -- this script is the bash side of it.
#
# Usage:
#   printf 'label 1\nlabel 2\n' | ati-menu-select --mode select --prompt "Pick one"
#   ati-menu-select --mode input --prompt "Minutes"
#
# select-mode stdin rows: "label", "glyph\tlabel", or "glyph\tlabel\tsubtext"
# -- exactly Menu.qml's own row format (MenuModel row splitting), passed
# through untouched. Prints the chosen label (first field only) on stdout.
# Nonzero exit and no output on Escape/cancel, matching `rofi -dmenu`'s own
# contract closely enough that callers can swap one for the other.
#
# Two-temp-file poll: the QML side writes the selection to $selection_file
# then touches $done_file (or touches only $done_file on cancel) --
# Omarchy's own bin/omarchy-menu-select uses the same shape, deliberately
# simple, no D-Bus round trip needed.
set -uo pipefail

MODE="select"
PROMPT="Select"
WIDTH=300
# input mode only -- Menu.qml's openDmenu() seeds filterText from this so
# an --mode input caller (dm-spellcheck's ask_text, rofi_input's own
# $prefill arg) gets the same pre-typed-answer behaviour rofi's own
# `-filter "$prefill"` gave it. Previously dropped entirely on this path
# -- see rofi_input's header in ati-rofi-common.sh for the report that
# named it.
PREFILL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE="$2"; shift 2 ;;
    --prompt) PROMPT="$2"; shift 2 ;;
    --width) WIDTH="$2"; shift 2 ;;
    --prefill) PREFILL="$2"; shift 2 ;;
    # Bare positional prompt, same convention `rofi -dmenu -i -p PROMPT`
    # takes -- so this script is a drop-in for existing `${RMENU} "prompt"`
    # call sites that swap their RMENU default per-session, no other
    # changes needed at the call site.
    *) PROMPT="$1"; shift ;;
  esac
done

case "$MODE" in
  select|input) ;;
  *) echo "ati-menu-select: --mode must be 'select' or 'input'" >&2; exit 2 ;;
esac

# -u: name only, don't create -- QML's finishRequest() distinguishes
# "not done yet" from "done" by the done_file's mere EXISTENCE, so this
# script must not leave it pre-created by mktemp.
selection_file="$(mktemp -u)"
done_file="$(mktemp -u)"
payload_file="$(mktemp --suffix=.json)"
trap 'rm -f "$selection_file" "$done_file" "$payload_file"' EXIT

# Read once into a variable rather than letting jq consume stdin directly
# below -- the width fit pass just under this needs the same rows too,
# and a pipe can only be read once.
STDIN_ROWS=""
[[ "$MODE" == "select" ]] && STDIN_ROWS="$(cat)"

options_json="[]"
if [[ "$MODE" == "select" ]]; then
  options_json="$(printf '%s\n' "$STDIN_ROWS" | jq -Rn '[inputs | select(length > 0)]')"
fi

# ---- auto-fit width: "make the size of the popup fit the size of txt" ----
#
# Label/subtext Text elements elide to whatever width the payload carries
# (Menu.qml, unchanged) -- so a caller-picked WIDTH narrower than its own
# content truncates with "…", which read as "the translator just shows
# 'word -> ...'". The content is only known on this side of the IPC call,
# so it's measured here rather than in Menu.qml: longest FIELD (icon,
# label, or subtext each render on their own line, never concatenated)
# across every row, plus the prompt and, for --mode input, the prefill.
#
# This only ever WIDENS WIDTH, never shrinks it -- a caller's own guess
# stays the floor for short content, and this is what pushes past it for
# long content, not a target everything gets squeezed to.
longest=${#PROMPT}
if [[ "$MODE" == "select" && -n "$STDIN_ROWS" ]]; then
  while IFS=$'\t' read -r -a fields; do
    for f in "${fields[@]}"; do
      (( ${#f} > longest )) && longest=${#f}
    done
  done <<<"$STDIN_ROWS"
fi
[[ "$MODE" == "input" && ${#PREFILL} -gt $longest ]] && longest=${#PREFILL}
# ~8px/char at this popup's font size, plus the icon column + margins
# Menu.qml reserves regardless of content (measured against dm-spellcheck's
# own 700 for a ~75-char row, which was comfortable, not cramped).
fit_width=$(( longest * 8 + 90 ))
(( fit_width > WIDTH )) && WIDTH=$fit_width

jq -n \
  --arg mode "$MODE" \
  --arg prompt "$PROMPT" \
  --argjson options "$options_json" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  --argjson width "$WIDTH" \
  --arg prefill "$PREFILL" \
  '{mode: $mode, prompt: $prompt, options: $options, selectionFile: $selectionFile, doneFile: $doneFile, width: $width, prefill: $prefill}' \
  > "$payload_file"

IPC_BIN=qs
command -v qsipc >/dev/null 2>&1 && IPC_BIN=qsipc

if ! "$IPC_BIN" -p "$HOME/.config/quickshell/ati-menu" ipc call menu dmenu "$payload_file" >/dev/null 2>&1; then
  echo "ati-menu-select: ati-menu isn't running (IPC call failed)" >&2
  exit 1
fi

# Capped at 10 minutes -- the dialog itself has no timeout (Escape cancels
# it instantly, which touches done_file right away), this cap only guards
# against the IPC call having silently gone nowhere.
for _ in $(seq 1 6000); do
  [[ -e "$done_file" ]] && break
  sleep 0.1
done

if [[ ! -e "$done_file" ]]; then
  echo "ati-menu-select: timed out waiting for a response" >&2
  exit 1
fi

if [[ ! -s "$selection_file" ]]; then
  exit 1
fi

# First field only (label) -- subtext, when present, is dropped so callers
# can treat this exactly like `rofi -dmenu` output.
head -n1 "$selection_file" | cut -f1
