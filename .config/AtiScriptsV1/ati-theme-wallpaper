#!/usr/bin/env bash
# ============================================================
#  ati-theme-wallpaper — which wallpaper belongs to which theme, and putting
#  it on screen in whichever session is asking.
#
#  Ask #5: "a fitting wallpaper per theme, applied on theme change", with
#  a manual choice still sticking. Two halves, and they pull against each
#  other — a theme change that always forces its own image would throw
#  away a wallpaper the user just picked. The resolution the user chose:
#
#      picking a wallpaper while THEME is active REBINDS that theme.
#
#  So synthwave means whatever you last chose under synthwave, and only
#  falls back to its generated default until you choose something. That
#  makes "applied on theme change" and "a manual pick sticks" the same
#  rule rather than two competing ones, and it needs no extra state
#  beyond the map below.
#
#  ---- THE FOUR LAYERS ----
#
#      1. override   ~/.cache/qtile/theme-walls.json   what you picked
#      2. set        ~/Pictures/Wallpapers/themed/<theme>/*  pick at random
#      3. single     ~/Pictures/Wallpapers/themed/<theme>.jpg
#                    generated by ati-theme-wallpaper-gen
#      4. nothing    leave the wallpaper alone
#
#  Layer 4 matters: with no override and no image at all this script must
#  be a no-op, because a theme change that BLANKS the wallpaper is far
#  worse than one that leaves it. That is why `apply` exits 0 on a miss
#  and why theme-apply calls it with `|| true`.
#
#  ---- WHY THE OVERRIDE STILL BEATS THE SET ----
#
#  Ask: "for gruvbox for example if i have 10 wal i want in every change
#  of theme to have one randomly selected wal from these 10". That is
#  layer 2, and it is new.
#
#  It sits BELOW the override on purpose, and this is the part that is
#  easy to get backwards. The rebinding rule above — picking a wallpaper
#  under a theme makes the theme mean that image — was chosen explicitly
#  by the user and has not been retracted. If the random set beat the
#  override, a deliberate pick would survive exactly until the next theme
#  change, which is the opposite of "a manual pick sticks". So a bound
#  theme is not random, and `forget <theme>` is how you hand it back to
#  its set.
#
#  ---- NO IMMEDIATE REPEAT ----
#
#  A uniform draw from ten images repeats about one change in ten, and a
#  repeat is indistinguishable from the feature being broken. The last
#  pick per theme is remembered in ~/.cache/qtile/theme-wall-last.json
#  and excluded from the next draw whenever the set has more than one
#  image. With a set of one there is nothing to vary and the record is
#  simply kept accurate.
#
#  ---- WHY THE STATE IS IN ~/.cache/qtile ----
#
#  Because that is where this desktop already keeps exactly this kind of
#  thing: theme_mode, layout_state.json, window_group_state.json — state
#  that is real but regenerable, shared by both sessions, and addressed by
#  both from a fixed path. Losing the file to a cache clear costs the
#  overrides and falls back to the generated defaults, which is the same
#  failure the neighbouring files already accept.
#
#  ---- WHY THIS APPLIES THE WALLPAPER ITSELF ----
#
#  theme-apply is SHARED with the qtile session, and the two sessions set
#  a wallpaper in completely different ways:
#
#      Hyprland / Wayland   awww img  (hypr/scripts/wallpaper-sync.sh)
#      qtile / X11          xwallpaper --stretch   (ati-dm-setbg's setbg())
#
#  wallpaper-sync.sh has no session guard at all — it calls `awww query`,
#  and on failure starts `awww-daemon`, and awww is Wayland-only. Calling
#  it from theme-apply under qtile would fail under `set -e` partway
#  through a theme change. So the session split lives here, once, instead
#  of being pushed into theme-apply where it would run on every theme.
#
#  ---- NO RECURSION, AND THIS IS LOAD-BEARING ----
#
#  wallpaper-set.sh re-runs `theme-apply wal` after a pick, because in wal
#  mode the wallpaper IS the palette. theme-apply now sets a wallpaper.
#  Left alone that is a loop.
#
#  Two independent guards, either sufficient:
#
#    * theme-apply only calls `apply` for NAMED themes, never for wal —
#      in wal mode the wallpaper drives the palette, so a per-theme
#      wallpaper is meaningless there by definition.
#    * `apply` pokes the wallpaper daemon directly and never calls
#      wallpaper-set.sh, so it cannot reach the re-derive branch.
#
#  Usage:
#      ati-theme-wallpaper resolve <theme> [show|consume]
#                                             print path, or nothing.
#                                             consume records the draw.
#      ati-theme-wallpaper bind    <theme> <img>  remember img for theme
#      ati-theme-wallpaper apply   <theme> [normal|instant]
#                                             resolve, then put on screen.
#                                             instant skips the wave, for
#                                             use under the theme cover.
#      ati-theme-wallpaper forget  <theme>        drop the override
#      ati-theme-wallpaper list                   every theme and its wallpaper
#      ati-theme-wallpaper set     <theme>        list a theme's whole set
# ============================================================
set -euo pipefail

MAP="$HOME/.cache/qtile/theme-walls.json"
LAST="$HOME/.cache/qtile/theme-wall-last.json"
THEMED_DIR="$HOME/Pictures/Wallpapers/themed"
WALL_LINK="$HOME/.cache/wall"
# What `poke_daemon` last actually PAINTED, as opposed to WALL_LINK, which is
# the current CHOICE and can be (and, since wallpaper-set.sh's animated-X11
# path, routinely is) updated by a caller before this script ever runs. See
# the dedup check in `apply)` for why the difference matters.
PAINTED_MARKER="$HOME/.cache/qtile/.wallpaper-painted"

usage() { sed -n '/^#  Usage:/,/^# ===/p' "$0" | sed 's/^#  \{0,1\}//;$d'; }

# ------------------------------------------------------------
#  The map
# ------------------------------------------------------------
#  Read and written with python3 rather than jq: jq is not a declared
#  dependency of this desktop and python3 is a hard one for half of
#  AtiScriptsV1 already. Written through a temp file and os.replace so a
#  crash mid-write cannot leave a truncated map — losing every override
#  because one write was interrupted is not an acceptable failure for a
#  file the user builds up by hand over months.
map_get() {
    python3 - "$MAP" "$1" <<'PY'
import json, os, sys
path, theme = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        d = json.load(f)
except Exception:
    sys.exit(0)
v = d.get(theme, "")
if v and os.path.isfile(v):
    print(v)
PY
}

map_set() {
    python3 - "$MAP" "$1" "$2" <<'PY'
import json, os, sys
path, theme, img = sys.argv[1], sys.argv[2], sys.argv[3]
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    with open(path) as f:
        d = json.load(f)
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
if img:
    d[theme] = img
else:
    d.pop(theme, None)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(d, f, indent=1, sort_keys=True)
    f.write("\n")
os.replace(tmp, path)
PY
}

# ------------------------------------------------------------
#  The set, and the draw
# ------------------------------------------------------------
#  `consume` is the difference between the two callers. `apply` wants a
#  draw and should record it so the next one can avoid it; `list` and
#  `set` want to SHOW the set without perturbing anyone's next wallpaper.
#  A read-only command that quietly advances state is the kind of thing
#  that makes a later measurement wrong for reasons nobody can find.
set_pick() {
    python3 - "$THEMED_DIR/$1" "$LAST" "$1" "${2:-show}" <<'PY'
import json, os, random, sys
d, last_path, theme, mode = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
exts = {".jpg", ".jpeg", ".png", ".webp"}
try:
    files = sorted(
        os.path.join(d, f) for f in os.listdir(d)
        if os.path.splitext(f)[1].lower() in exts
        and os.path.isfile(os.path.join(d, f))
    )
except Exception:
    sys.exit(0)
if not files:
    sys.exit(0)
if mode == "all":
    for f in files:
        print(f)
    sys.exit(0)

try:
    with open(last_path) as fh:
        last = json.load(fh)
    if not isinstance(last, dict):
        last = {}
except Exception:
    last = {}

pool = files
prev = last.get(theme, "")
# Only exclude the previous pick when there is something else to pick.
# With a set of one, excluding it would return nothing and the theme
# would silently stop setting a wallpaper at all.
if len(files) > 1 and prev in files:
    pool = [f for f in files if f != prev]
choice = random.choice(pool)
print(choice)

if mode == "consume":
    last[theme] = choice
    tmp = last_path + ".tmp"
    os.makedirs(os.path.dirname(last_path), exist_ok=True)
    # Same os.replace discipline as the override map: a crash mid-write
    # must not truncate the file and lose every theme's record.
    with open(tmp, "w") as fh:
        json.dump(last, fh, indent=1, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, last_path)
PY
}

resolve() {
    local theme="$1" mode="${2:-show}" hit
    hit="$(map_get "$theme" || true)"
    if [ -n "$hit" ]; then
        printf '%s\n' "$hit"
        return 0
    fi
    # Layer 2: a directory of candidates, drawn from at random.
    hit="$(set_pick "$theme" "$mode" || true)"
    if [ -n "$hit" ]; then
        printf '%s\n' "$hit"
        return 0
    fi
    # Layer 3. The generator writes .jpg; .png is accepted too so a
    # hand-dropped replacement works without renaming it.
    local ext
    for ext in jpg png jpeg webp; do
        if [ -r "$THEMED_DIR/$theme.$ext" ]; then
            printf '%s\n' "$THEMED_DIR/$theme.$ext"
            return 0
        fi
    done
    return 0
}

# ------------------------------------------------------------
#  Putting it on screen
# ------------------------------------------------------------
#  Remove-then-symlink, never `printf >`. ~/.cache/wall is a SYMLINK, and
#  writing to it writes THROUGH to the image file it points at, corrupting
#  a wallpaper instead of repointing the record. ati-dm-setbg carries the same
#  comment for the same reason; this is the third copy of that lesson and
#  the second script to nearly repeat it.
record() {
    mkdir -p "$(dirname "$WALL_LINK")"
    rm -f "$WALL_LINK"
    ln -sfn -- "$1" "$WALL_LINK"
}

#  Session detection is on what is actually RUNNING, not on
#  XDG_SESSION_TYPE alone. theme-apply is invoked from rofi menus, from
#  the island over IPC, and from a plain shell, and the environment it
#  inherits is not reliably the session's — ati-dm-setbg has a comment about
#  exactly this, where an unset XDG_SESSION_TYPE under `set -u` aborted
#  the script before it could reach its own error branch.
#  ---- instant MODE, AND WHY A HARD CUT IS THE RIGHT ANIMATION ----
#
#  Ask: "i want also the theme and the wallpaper change in the same time
#  no glitch at all one animation".
#
#  The wave exists so that changing the wallpaper on a LIVE desktop is not
#  a hard cut. Under the theme-change cover there is no live desktop to
#  cut — the island is holding a frozen frame over the whole screen — so
#  the wave is a second animation nobody can see, played underneath the
#  first one, whose only measurable effect is to make the freeze longer.
#
#  So under the cover the wallpaper is swapped with `none` (an alias for
#  simple with transition-step 255, which finishes instantly), and the
#  cover's own sweep becomes the transition for BOTH the palette and the
#  wallpaper. That is the "one animation" — not two animations
#  synchronised, which is what makes the seam so hard to remove, but one
#  reveal with everything already changed behind it.
poke_daemon() {
    local img="$1" mode="${2:-normal}"

    # Written on every successful path below, and read by `apply)`'s dedup
    # check instead of WALL_LINK — see PAINTED_MARKER's own comment for why
    # WALL_LINK stopped being a safe stand-in for "already on screen".
    _mark_painted() {
        mkdir -p "$(dirname "$PAINTED_MARKER")"
        printf '%s' "$img" > "$PAINTED_MARKER"
    }

    if command -v awww >/dev/null 2>&1 && awww query >/dev/null 2>&1; then
        # awww is up: this is the Hyprland session, and it owns transitions.
        if [ "$mode" = "instant" ]; then
            awww img "$img" --transition-type none >/dev/null 2>&1 \
                && { _mark_painted; return 0; }
        fi
        # Same parameters wallpaper-sync.sh uses, so a theme change and a
        # manual pick animate identically instead of one cutting hard.
        awww img "$img" \
            --transition-type wave \
            --transition-angle 30 \
            --transition-wave "60,30" \
            --transition-fps 60 \
            --transition-step 90 >/dev/null 2>&1 \
            && { _mark_painted; return 0; }
    fi

    if [ "${XDG_SESSION_TYPE:-x11}" = "x11" ] && command -v xwallpaper >/dev/null 2>&1; then
        xwallpaper --stretch "$img" >/dev/null 2>&1 && { _mark_painted; return 0; }
    fi

    if command -v swaybg >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        pkill -x swaybg 2>/dev/null || true
        swaybg -m stretch -i "$img" >/dev/null 2>&1 &
        _mark_painted
        return 0
    fi

    echo "ati-theme-wallpaper: no usable wallpaper daemon for this session" >&2
    return 1
}

cmd="${1:-}"
case "$cmd" in
    resolve)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        # The mode is reachable from the CLI so the draw can be exercised
        # without setting a wallpaper. Default `show`, so a bare `resolve`
        # stays the read-only thing every existing caller expects.
        case "${3:-show}" in
            show|consume) ;;
            *) echo "ati-theme-wallpaper: resolve mode must be show or consume" >&2; exit 2 ;;
        esac
        resolve "$2" "${3:-show}"
        ;;

    bind)
        [ $# -ge 3 ] || { usage >&2; exit 2; }
        img="$(readlink -f -- "$3")"
        [ -r "$img" ] || { echo "ati-theme-wallpaper: not readable: $img" >&2; exit 1; }
        map_set "$2" "$img"
        ;;

    forget)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        map_set "$2" ""
        ;;

    apply)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        theme="$2"
        # `consume`: this is the draw that goes on screen, so it is the one
        # the no-immediate-repeat record has to remember.
        img="$(resolve "$theme" consume)"
        # A miss is a no-op and a SUCCESS. See layer 4 in the header: a
        # theme with no wallpaper must leave the current one alone.
        [ -n "$img" ] || exit 0
        # Already on screen — skip the daemon so re-applying the same theme
        # does not replay a wave transition over an identical image. With a
        # random set this is now mostly unreachable, but it still catches
        # the single-image set and the bound-override case, which are
        # exactly the ones that WOULD re-wave over an identical picture.
        #
        # AGAINST PAINTED_MARKER, NOT WALL_LINK. This used to compare
        # against WALL_LINK, which is the record of the CHOICE, and that
        # was correct only as long as this script was the one thing that
        # ever updated it. wallpaper-set.sh's animated-X11 path breaks that:
        # it does `ln -sfn` onto WALL_LINK itself, immediately, BEFORE
        # ever reaching here — so by the time this ran, WALL_LINK already
        # equalled the new pick and this exited thinking the daemon had
        # nothing to do. Measured live: the record updated, the picker
        # closed, and the desktop kept showing the old wallpaper the whole
        # time — `poke_daemon` was never called at all. PAINTED_MARKER is
        # written by poke_daemon itself and by nothing else, so it can only
        # ever say "yes" when this script's own daemon call already ran.
        if [ "$(cat "$PAINTED_MARKER" 2>/dev/null || true)" = "$img" ]; then
            exit 0
        fi
        record "$img"
        poke_daemon "$img" "${3:-normal}" || exit 0
        ;;

    set)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        set_pick "$2" all
        ;;

    list)
        # Every theme once, whether it is served by a set directory, a
        # single file, or only by an override. Listing the directory alone
        # missed the last case entirely.
        {
            for f in "$THEMED_DIR"/*; do
                [ -e "$f" ] || continue
                b="$(basename "$f")"
                # A theme is a directory (its set) or an image (the
                # single-file form). NOT every file that happens to live
                # here: manifest.json was being listed as a theme called
                # "manifest" with 0 in its set, which is the sort of row
                # that makes a reader distrust the whole table.
                case "$b" in
                    *.jpg|*.jpeg|*.png|*.webp) ;;
                    *) [ -d "$f" ] || continue ;;
                esac
                printf '%s\n' "${b%.*}"
            done
            python3 -c 'import json,sys
try:
    print("\n".join(json.load(open(sys.argv[1]))))
except Exception:
    pass' "$MAP" 2>/dev/null || true
        } | sort -u | while read -r t; do
            [ -n "$t" ] || continue
            n="$(set_pick "$t" all | wc -l)"
            bound=""
            [ -n "$(map_get "$t" || true)" ] && bound=" (bound)"
            # `show`, never `consume`: listing must not move anyone's
            # no-repeat record.
            printf '%-16s %2d in set%s  %s\n' "$t" "$n" "$bound" "$(resolve "$t" show)"
        done
        ;;

    ""|-h|--help|help) usage ;;
    *) echo "ati-theme-wallpaper: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
