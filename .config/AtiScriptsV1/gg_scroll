#!/usr/bin/env bash

# Per-user: /tmp is shared, so a fixed path here is owned by whichever
# account pressed gg first and every other account's write fails with
# EACCES -- leaving the double-tap detection permanently stuck.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/rofi-$(id -u)}"
mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
STATE_FILE="$RUNTIME_DIR/qtile_gg_state"
TIMEOUT=0.5

NOW=$(date +%s.%N)

if [[ -f "$STATE_FILE" ]]; then
	LAST=$(cat "$STATE_FILE")
	ELAPSED=$(echo "$NOW - $LAST" | bc)

	if (($(echo "$ELAPSED < $TIMEOUT" | bc -l))); then
		# Second press detected → scroll to top
		xdotool click --repeat 300 --delay 0 4
		rm -f "$STATE_FILE"
		exit 0
	fi
fi

# First press: store timestamp
echo "$NOW" >"$STATE_FILE"
