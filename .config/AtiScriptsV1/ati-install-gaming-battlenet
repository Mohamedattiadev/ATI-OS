#!/usr/bin/env bash
# ati-install-gaming-battlenet — Battle.net has no native Linux client;
# Omarchy's own installer (bin/omarchy-install-gaming-battlenet) builds a
# whole standalone umu-launcher + GE-Proton Wine prefix and runs Blizzard's
# installer inside it by hand. That is a lot of unattended, sudo-driving,
# reboot-capable machinery to introduce for one specific game.
#
# This repo takes the smaller, safer path instead: install Lutris (already
# offered as its own gaming entry) and point at it -- Lutris ships its own
# maintained, versioned Battle.net installer script in its public library
# and already handles the Wine prefix/Proton/runner selection for it. Same
# end result (Battle.net launchable from the desktop), less bespoke
# machinery for this repo to own and keep working.
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/ati-rofi-common.sh"

echo "Installing Lutris (Battle.net installs through it)..."
dcli install lutris

notify_safe "Battle.net" "Lutris installed -- search \"Battle.net\" inside it to install"
echo
echo "Open Lutris, search \"Battle.net\" in its game library, and install from there."
setsid lutris >/dev/null 2>&1 &
