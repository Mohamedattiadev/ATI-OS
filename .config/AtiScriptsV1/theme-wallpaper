#!/usr/bin/env bash
# ============================================================
#  theme-wallpaper — which wallpaper belongs to which theme, and putting
#  it on screen in whichever session is asking.
#
#  Ask #5: "a fitting wallpaper per theme, applied on theme change", with
#  a manual choice still sticking. Two halves, and they pull against each
#  other — a theme change that always forces its own image would throw
#  away a wallpaper the user just picked. The resolution the user chose:
#
#      picking a wallpaper while THEME is active REBINDS that theme.
#
#  So synthwave means whatever you last chose under synthwave, and only
#  falls back to its generated default until you choose something. That
#  makes "applied on theme change" and "a manual pick sticks" the same
#  rule rather than two competing ones, and it needs no extra state
#  beyond the map below.
#
#  ---- THE THREE LAYERS ----
#
#      1. override   ~/.cache/qtile/theme-walls.json   what you picked
#      2. default    ~/Pictures/Wallpapers/themed/<theme>.jpg
#                    generated by theme-wallpaper-gen
#      3. nothing    leave the wallpaper alone
#
#  Layer 3 matters: with no override and no generated file this script
#  must be a no-op, because a theme change that BLANKS the wallpaper is
#  far worse than one that leaves it. That is why `apply` exits 0 on a
#  miss and why theme-apply calls it with `|| true`.
#
#  ---- WHY THE STATE IS IN ~/.cache/qtile ----
#
#  Because that is where this desktop already keeps exactly this kind of
#  thing: theme_mode, layout_state.json, window_group_state.json — state
#  that is real but regenerable, shared by both sessions, and addressed by
#  both from a fixed path. Losing the file to a cache clear costs the
#  overrides and falls back to the generated defaults, which is the same
#  failure the neighbouring files already accept.
#
#  ---- WHY THIS APPLIES THE WALLPAPER ITSELF ----
#
#  theme-apply is SHARED with the qtile session, and the two sessions set
#  a wallpaper in completely different ways:
#
#      Hyprland / Wayland   awww img  (hypr/scripts/wallpaper-sync.sh)
#      qtile / X11          xwallpaper --stretch   (dm-setbg's setbg())
#
#  wallpaper-sync.sh has no session guard at all — it calls `awww query`,
#  and on failure starts `awww-daemon`, and awww is Wayland-only. Calling
#  it from theme-apply under qtile would fail under `set -e` partway
#  through a theme change. So the session split lives here, once, instead
#  of being pushed into theme-apply where it would run on every theme.
#
#  ---- NO RECURSION, AND THIS IS LOAD-BEARING ----
#
#  wallpaper-set.sh re-runs `theme-apply wal` after a pick, because in wal
#  mode the wallpaper IS the palette. theme-apply now sets a wallpaper.
#  Left alone that is a loop.
#
#  Two independent guards, either sufficient:
#
#    * theme-apply only calls `apply` for NAMED themes, never for wal —
#      in wal mode the wallpaper drives the palette, so a per-theme
#      wallpaper is meaningless there by definition.
#    * `apply` pokes the wallpaper daemon directly and never calls
#      wallpaper-set.sh, so it cannot reach the re-derive branch.
#
#  Usage:
#      theme-wallpaper resolve <theme>        print path, or nothing
#      theme-wallpaper bind    <theme> <img>  remember img for theme
#      theme-wallpaper apply   <theme>        resolve, then put on screen
#      theme-wallpaper forget  <theme>        drop the override
#      theme-wallpaper list                   every theme and its wallpaper
# ============================================================
set -euo pipefail

MAP="$HOME/.cache/qtile/theme-walls.json"
THEMED_DIR="$HOME/Pictures/Wallpapers/themed"
WALL_LINK="$HOME/.cache/wall"

usage() { sed -n '/^#  Usage:/,/^# ===/p' "$0" | sed 's/^#  \{0,1\}//;$d'; }

# ------------------------------------------------------------
#  The map
# ------------------------------------------------------------
#  Read and written with python3 rather than jq: jq is not a declared
#  dependency of this desktop and python3 is a hard one for half of
#  AtiScriptsV1 already. Written through a temp file and os.replace so a
#  crash mid-write cannot leave a truncated map — losing every override
#  because one write was interrupted is not an acceptable failure for a
#  file the user builds up by hand over months.
map_get() {
    python3 - "$MAP" "$1" <<'PY'
import json, os, sys
path, theme = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        d = json.load(f)
except Exception:
    sys.exit(0)
v = d.get(theme, "")
if v and os.path.isfile(v):
    print(v)
PY
}

map_set() {
    python3 - "$MAP" "$1" "$2" <<'PY'
import json, os, sys
path, theme, img = sys.argv[1], sys.argv[2], sys.argv[3]
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    with open(path) as f:
        d = json.load(f)
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
if img:
    d[theme] = img
else:
    d.pop(theme, None)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(d, f, indent=1, sort_keys=True)
    f.write("\n")
os.replace(tmp, path)
PY
}

resolve() {
    local theme="$1" hit
    hit="$(map_get "$theme" || true)"
    if [ -n "$hit" ]; then
        printf '%s\n' "$hit"
        return 0
    fi
    # The generator writes .jpg; .png is accepted too so a hand-dropped
    # replacement works without renaming it.
    local ext
    for ext in jpg png jpeg webp; do
        if [ -r "$THEMED_DIR/$theme.$ext" ]; then
            printf '%s\n' "$THEMED_DIR/$theme.$ext"
            return 0
        fi
    done
    return 0
}

# ------------------------------------------------------------
#  Putting it on screen
# ------------------------------------------------------------
#  Remove-then-symlink, never `printf >`. ~/.cache/wall is a SYMLINK, and
#  writing to it writes THROUGH to the image file it points at, corrupting
#  a wallpaper instead of repointing the record. dm-setbg carries the same
#  comment for the same reason; this is the third copy of that lesson and
#  the second script to nearly repeat it.
record() {
    mkdir -p "$(dirname "$WALL_LINK")"
    rm -f "$WALL_LINK"
    ln -sfn -- "$1" "$WALL_LINK"
}

#  Session detection is on what is actually RUNNING, not on
#  XDG_SESSION_TYPE alone. theme-apply is invoked from rofi menus, from
#  the island over IPC, and from a plain shell, and the environment it
#  inherits is not reliably the session's — dm-setbg has a comment about
#  exactly this, where an unset XDG_SESSION_TYPE under `set -u` aborted
#  the script before it could reach its own error branch.
poke_daemon() {
    local img="$1"

    if command -v awww >/dev/null 2>&1 && awww query >/dev/null 2>&1; then
        # awww is up: this is the Hyprland session, and it owns transitions.
        # Same parameters wallpaper-sync.sh uses, so a theme change and a
        # manual pick animate identically instead of one cutting hard.
        awww img "$img" \
            --transition-type wave \
            --transition-angle 30 \
            --transition-wave "60,30" \
            --transition-fps 60 \
            --transition-step 90 >/dev/null 2>&1 && return 0
    fi

    if [ "${XDG_SESSION_TYPE:-x11}" = "x11" ] && command -v xwallpaper >/dev/null 2>&1; then
        xwallpaper --stretch "$img" >/dev/null 2>&1 && return 0
    fi

    if command -v swaybg >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        pkill -x swaybg 2>/dev/null || true
        swaybg -m stretch -i "$img" >/dev/null 2>&1 &
        return 0
    fi

    echo "theme-wallpaper: no usable wallpaper daemon for this session" >&2
    return 1
}

cmd="${1:-}"
case "$cmd" in
    resolve)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        resolve "$2"
        ;;

    bind)
        [ $# -ge 3 ] || { usage >&2; exit 2; }
        img="$(readlink -f -- "$3")"
        [ -r "$img" ] || { echo "theme-wallpaper: not readable: $img" >&2; exit 1; }
        map_set "$2" "$img"
        ;;

    forget)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        map_set "$2" ""
        ;;

    apply)
        [ $# -ge 2 ] || { usage >&2; exit 2; }
        theme="$2"
        img="$(resolve "$theme")"
        # A miss is a no-op and a SUCCESS. See layer 3 in the header: a
        # theme with no wallpaper must leave the current one alone.
        [ -n "$img" ] || exit 0
        # Already on screen — skip the daemon so re-applying the same theme
        # does not replay a wave transition over an identical image.
        if [ "$(readlink -f "$WALL_LINK" 2>/dev/null || true)" = "$img" ]; then
            exit 0
        fi
        record "$img"
        poke_daemon "$img" || exit 0
        ;;

    list)
        for f in "$THEMED_DIR"/*; do
            [ -e "$f" ] || continue
            b="$(basename "$f")"
            t="${b%.*}"
            printf '%-16s %s\n' "$t" "$(resolve "$t")"
        done
        ;;

    ""|-h|--help|help) usage ;;
    *) echo "theme-wallpaper: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
