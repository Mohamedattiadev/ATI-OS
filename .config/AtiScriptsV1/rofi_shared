#!/usr/bin/env bash
# Rofi shared-links picker. Palette follows wallpaper via rofi_common.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=rofi_common.sh
source "$SCRIPT_DIR/rofi_common.sh"

require_cmd rofi curl grep sed || exit 1
load_palette

ROFI_THEME="$HOME/.config/rofi/themes/kill-large.rasi"
VIDEO_FILE="$HOME/.config/rofi/Todo_files/Shared_Links.md"
THUMB_DIR="/tmp/link-thumbs"
mkdir -p "$THUMB_DIR" "$(dirname "$VIDEO_FILE")"
touch "$VIDEO_FILE"

BROWSER="${BROWSER:-brave}"

# Delimiter (unit separator — safe in titles/urls).
SEP=$'\x1f'

# Thumbnail cache. Requires wget + optionally jq + convert.
get_thumbnail() {
    local url="$1"
    local thumb_path
    thumb_path="$THUMB_DIR/$(printf '%s' "$url" | md5sum | cut -d' ' -f1).jpg"

    if [[ ! -f "$thumb_path" ]]; then
        if [[ "$url" =~ (youtu\.be|youtube\.com) ]] && command -v wget &>/dev/null; then
            local vid
            vid=$(printf '%s' "$url" | grep -oE '([A-Za-z0-9_-]{11})' | sed 1q)
            if [[ -n "$vid" ]]; then
                wget -q -O "$thumb_path" "https://img.youtube.com/vi/${vid}/hqdefault.jpg" || true
            fi
        fi
        if [[ ! -s "$thumb_path" ]] && command -v jq &>/dev/null && command -v wget &>/dev/null; then
            local img_url
            img_url=$(curl -sf --max-time 8 "https://api.microlink.io/?url=${url}&palette=true" | jq -r '.data.image.url // empty' 2>/dev/null)
            if [[ -n "$img_url" ]]; then
                wget -q -O "$thumb_path" "$img_url" || true
            fi
        fi
        if [[ ! -s "$thumb_path" ]] && command -v convert &>/dev/null; then
            convert -size 480x270 xc:"$PAL_BG_ALT" -gravity center -fill "$PAL_FG" -pointsize 24 -annotate 0 "No Preview" "$thumb_path" 2>/dev/null || true
        fi
    fi
    printf '%s' "$thumb_path"
}

build_rofi_input() {
    grep -Eo '\[.*\]\(http[^)]+\)' "$VIDEO_FILE" | while read -r line; do
        local title url
        title=$(printf '%s' "$line" | sed -E 's/^\[(.*)\]\(http.*\)$/\1/')
        url=$(printf '%s'   "$line" | sed -E 's/^\[.*\]\((http.*)\)$/\1/')
        printf '%s%s%s\n' "$title" "$SEP" "$url"
    done
}

show_preview() {
    command -v feh &>/dev/null || { notify_safe "feh not installed"; return; }
    local url="$1"
    local thumb_path
    thumb_path=$(get_thumbnail "$url")
    pkill -f "feh --title link-preview" 2>/dev/null
    (feh --title "link-preview" \
        --geometry 200x150 \
        --scale-down \
        --zoom max \
        --force-aliasing \
        "$thumb_path" </dev/null &>/dev/null &)
}

add_new_link() {
    local url="$1"
    if ! [[ "$url" =~ ^https?:// ]]; then
        notify_safe "❌ Invalid Input" "'$url' is not a valid URL."
        return
    fi
    notify_safe "⏳ Fetching title for..." "$url"
    local page_title html
    html=$(curl -sfL --max-time 10 "$url" 2>/dev/null) || {
        notify_safe "⚠️  HTTP fetch failed" "$url"
    }
    page_title=$(printf '%s' "$html" | grep -io '<title>[^<]*</title>' | sed -e 's/<title>\(.*\)<\/title>/\1/I' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | head -n 1)
    if [[ -z "$page_title" ]]; then
        page_title=$(printf '%s' "$url" | sed -E 's_https?://([^/]+)/?.*_\1_')
        notify_safe "⚠️  Title not found" "Using domain '$page_title'"
    fi
    page_title=$(printf '%s' "$page_title" | tr -d '[]')
    printf -- '- [%s](%s)\n' "$page_title" "$url" >>"$VIDEO_FILE"
    notify_safe "✅ Link Added" "$page_title"
}

edit_link_title() {
    local old_title="$1"
    local url="$2"
    local new_title
    new_title=$(rofi -dmenu -theme "$ROFI_THEME" -p "Edit Title" -mesg "$url" -filter "$old_title")

    if [[ -n "$new_title" && "$new_title" != "$old_title" ]]; then
        local escaped_url escaped_new
        escaped_url=$(printf '%s\n' "$url" | sed 's/[&/\]/\\&/g')
        escaped_new=$(printf '%s\n' "$new_title" | sed 's/[&/\]/\\&/g')
        sed -i "/(${escaped_url})/s/\[[^]]*\]/[${escaped_new}]/" "$VIDEO_FILE"
        notify_safe "✅ Title Updated" "$new_title"
    fi
}

delete_link() {
    local title="$1"
    local url="$2"
    rofi_confirm "Delete link?" "$title" || return
    local escaped_url
    escaped_url=$(printf '%s\n' "$url" | sed 's/[&/\]/\\&/g')
    sed -i "/(${escaped_url})/d" "$VIDEO_FILE"
    notify_safe "🗑️  Link Deleted" "$title"
}

last_index=0

while true; do
    mapfile -t LINES < <(build_rofi_input)

    if [[ ${#LINES[@]} -eq 0 ]]; then
        if rofi_confirm "No links yet. Add one?"; then
            ret=13
            selection=""
        else
            break
        fi
    else
        mapfile -t TITLES < <(printf '%s\n' "${LINES[@]}" | awk -F"$SEP" '{print $1}')
        selection=$(printf '%s\n' "${TITLES[@]}" | \
            rofi -dmenu -markup-rows -i \
                -theme "$ROFI_THEME" \
                -p "Links" \
                -mesg "<b>↵/Alt+o</b> open  <b>Alt+y</b> copy  <b>Alt+s</b> preview  <b>Alt+a</b> add  <b>Alt+e</b> edit  <b>Alt+d</b> delete" \
                -selected-row "$last_index" \
                -kb-custom-1 "Alt+o" \
                -kb-custom-2 "Alt+y" \
                -kb-custom-3 "Alt+s" \
                -kb-custom-4 "Alt+a" \
                -kb-custom-5 "Alt+e" \
                -kb-custom-6 "Alt+d")
        ret=$?
    fi

    if [[ $ret -eq 1 ]]; then
        pkill -f "feh --title link-preview" 2>/dev/null
        break
    fi

    index=-1
    if [[ -n "$selection" ]]; then
        for i in "${!TITLES[@]}"; do
            if [[ "${TITLES[$i]}" == "$selection" ]]; then
                index="$i"
                break
            fi
        done
    fi

    if [[ $index -lt 0 && $ret -ne 13 ]]; then
        continue
    fi

    title=""; url=""
    if [[ $index -ge 0 ]]; then
        full_line="${LINES[$index]}"
        title="${full_line%%${SEP}*}"
        url="${full_line#*${SEP}}"
        last_index=$index
    fi

    case $ret in
        0|10) # Open
            if [[ -n "$url" ]]; then
                # shellcheck disable=SC2086
                $BROWSER "$url" &
            fi
            pkill -f "feh --title link-preview" 2>/dev/null
            break
            ;;
        11) # Copy
            copy_to_clipboard "$url"
            notify_safe "📋 Copied URL" "$title"
            ;;
        12) # Preview
            show_preview "$url"
            ;;
        13) # Add
            new_url=$(rofi -dmenu -theme "$ROFI_THEME" -p "Enter URL to Add")
            if [[ -n "$new_url" ]]; then
                add_new_link "$new_url"
                last_index=0
            fi
            ;;
        14) # Edit title
            edit_link_title "$title" "$url"
            ;;
        15) # Delete
            delete_link "$title" "$url"
            last_index=0
            ;;
    esac
done
