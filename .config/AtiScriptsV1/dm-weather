#!/usr/bin/env bash
#
# Script name: dm-weather
# Description: Weather notification (short format + cache)
# Dependencies: dmenu, curl, dunst

set -euo pipefail

# The dmscripts helper library. Tried in three places, in order: the
# current directory (upstream's own convention), $PATH, then the path the
# dmscripts package actually installs it to.
#
# The explicit failure is the point. This used to be two `2>/dev/null`
# attempts and nothing else, so when both missed, `set -e` killed the
# script on the next undefined function with no message whatsoever -- a
# keybinding that did nothing at all, and no way to tell why.
# shellcheck disable=SC1091
if ! { source ./_dm-helper.sh 2>/dev/null \
    || source _dm-helper.sh 2>/dev/null \
    || source /usr/bin/_dm-helper.sh 2>/dev/null; }; then
  msg="${0##*/}: cannot find _dm-helper.sh (install the dmscripts package)"
  command -v notify-send >/dev/null 2>&1 && notify-send "${0##*/}" "$msg"
  printf '%s\n' "$msg" >&2
  exit 1
fi

source_dmscripts_configs

if configs_are_different; then
  echo "$(date): configs are different" >>"$DM_CONFIG_DIFF_LOGFILE"
  sleep 1
fi

main() {
  # shellcheck disable=SC2154
  _location="$(printf '%s\n' "${weather_locations}" | ${MENU} "Where do you want to see the weather?")"
  [[ -z "$_location" ]] && exit 0

  # Cache config. Per-user: a fixed /tmp path is created mode 644 by
  # whichever account runs first, and every other account's cache write
  # then fails with EACCES -- so the cache never hits and every lookup
  # goes to the network.
  cache_dir="${XDG_RUNTIME_DIR:-/tmp/rofi-$(id -u)}/dm-weather"
  mkdir -p "$cache_dir"

  cache_file="$cache_dir/${_location// /_}"
  cache_ttl=3600 # 1 hour

  if [[ -f "$cache_file" ]] && (($(date +%s) - $(stat -c %Y "$cache_file") < cache_ttl)); then
    weather="$(cat "$cache_file")"
  else
    weather="$(curl -s "https://wttr.in/${_location// /%20}?format=3")"
    echo "$weather" >"$cache_file"
  fi

  dunstify \
    -a "Weather" \
    -u normal \
    -t 8000 \
    "$_location" \
    "$weather"
}

MENU="$(get_menu_program "$@")"
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main
