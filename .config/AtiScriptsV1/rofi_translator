#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/ati-rofi-common.sh"

#
# Cursor Select Translator v2
#
# A script to translate a selected word, get synonyms/examples via Gemini,
# get IPA, and perform Text-to-Speech.
#
# Dependencies:
#   - xclip, rofi, translate-shell (trans), espeak-ng, jq, mpv
#   - (Optional) gtts-cli, piper
#

# -------------------------- Configuration --------------------------
# Per-user. /tmp/translator was shared, so the second account to run this
# hit EACCES writing the TTS audio and got a silent translation. The three
# files that use this directory (here, dunst/scripts/rofi-translator.sh,
# rofi_translator/wordreference.py) each write only their own scratch --
# nothing is handed between them -- but they resolve the same path so the
# directory stays one concept.
TMP_DIR="$ROFI_RUNTIME_DIR/translator"
# Resolved at runtime: this pointed at ~/.local/bin/piper while piper is
# installed at /usr/bin/piper, so the German TTS branch below never once
# ran. Same bug that was in wordreference.py.
PIPER_CMD="$(command -v piper || echo "$HOME/.local/bin/piper")"
PIPER_VOICE_DE="$HOME/.config/piper-voices/de_DE-thorsten-high.onnx"

NOTIFY_TIMEOUT=25000 # Milliseconds to show notification

# TTS Settings
TTS_SPEED="0.8"        # Slower mpv playback for better understanding
TTS_LENGTH_SCALE="1.3" # Piper-specific setting for slower voice

# Gemini API key — optional. Sourced from ~/.config/secrets.env via
# ati-rofi-common.sh. It was previously read straight from the environment,
# which nothing ever set, so call_gemini() returned "" on every call and
# the synonym/example sections rendered blank with no explanation.
load_secrets
HAVE_GEMINI=0
[[ -n "${GEMINI_API_KEY:-}" ]] && HAVE_GEMINI=1

# -------------------------- Pre-flight Checks --------------------------
# espeak-ng and mpv are only needed for IPA and playback respectively, so
# they are no longer hard requirements — a missing optional tool should
# cost you that one feature, not the whole translation.
require_cmd xclip rofi trans || exit 1
mkdir -p "$TMP_DIR"

# -------------------------- Check if word is selected --------------------------
#
# "win+p then e [translate], check" — traced with bash -x: this whole
# script was dying right here, silently, under `set -euo pipefail`.
# xclip exits non-zero when nothing is on the primary selection (the
# NORMAL case the comment below already expects), pipefail promotes
# that into the pipeline's own exit status, and set -e then kills the
# script on THIS assignment before it ever reaches the `[ -z "$WORD" ]`
# fallback three lines down — no rofi, no qml, nothing, exactly what was
# reported. `|| true` on each of the two reads below is the fix: let the
# explicit -z checks that already exist decide what "nothing" means,
# same as dm-spellcheck's ask_text already does for the same read.
#
# xclip is also X11-only. dm-spellcheck branches on wayland_active() and
# uses wl-paste there; this file never did, so on a pure-Wayland session
# (no XWayland selection sync) xclip could come back empty or wrong even
# with real text selected. Same branch, ported.
if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-paste >/dev/null 2>&1; then
	WORD=$(wl-paste --primary --no-newline 2>/dev/null | tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//') || true
else
	WORD=$(xclip -o -selection primary 2>/dev/null | tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//') || true
fi

# Nothing highlighted is a normal way to reach this, not an error — you
# often want a word you are thinking of rather than one on screen. Ask
# for it instead of bailing out.
if [ -z "$WORD" ]; then
	WORD=$(rofi_input "Translate" "nothing selected — type a word" |
		tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//') || true
fi
[ -z "$WORD" ] && exit 0

# -------------------------- Helper Functions --------------------------
# Thin wrapper over ati-rofi-common.sh's gemini(). The model list, transport
# and error logging are shared with rofi_anki now; this script used to
# carry its own list containing "gemini-flash-1.5-8b", a name that was
# never a real model, plus two retired 1.5 entries ahead of the only
# live one — four wasted round trips per lookup.
call_gemini() {
	(( HAVE_GEMINI )) || return 0
	gemini "$1" || true
}

# "confirms-> " (blank) — translate-shell's default engine is Google, and
# Google was rate-limited: `trans -b ":ar" confirms` exits 0 and prints
# its "[ERROR] Google did not return results" to STDERR, so $(...) here
# captures nothing and TRANSLATION ends up empty with no failure anywhere
# to catch. Confirmed live: `trans -e bing` answers the same query fine
# while Google is still rate-limited. So: try the default engine first
# (it's usually the better translation), and only reach for bing if that
# came back empty — same shape as call_gemini's own "degrade, don't die".
trans_shell() {
	local out
	out="$(trans "$@" 2>/dev/null)" || true
	if [ -z "$out" ]; then
		out="$(trans -e bing "$@" 2>/dev/null)" || true
	fi
	printf '%s' "$out"
}

# -------------------------- Main Script Logic --------------------------
SOURCE_LANG=$(trans_shell -b -id "$WORD")
# Same set -e/pipefail trap as WORD above: rofi_select exits non-zero on
# Escape, which is the ordinary way to back out of this prompt, not a
# fault. `|| true` lets the -z check on the next line be the thing that
# decides, instead of `set -e` deciding first.
TARGET_LANG=$(echo -e "en\nde\nar\ntr" | rofi_select "Translate to ($SOURCE_LANG detected)") || true
[ -z "$TARGET_LANG" ] && exit 0

BODY=""
TITLE=""

if [ "$SOURCE_LANG" = "$TARGET_LANG" ]; then
	# DEFINITION MODE
	TITLE="📖 Definition → $TARGET_LANG"
	BODY="<b><span color='#FFD700'>Word:</span></b> <span color='#00CED1'>$WORD</span>\n"

	IPA=$(espeak-ng -v "$SOURCE_LANG" --ipa -q "$WORD" 2>/dev/null | tr -d '\n' || echo "")
	[ -n "$IPA" ] && BODY+="<b><span color='#FF69B4'>IPA ($SOURCE_LANG):</span></b> /$IPA/\n"

	SYNONYMS=$(call_gemini "Give me 5 diverse synonyms for '$WORD' in $TARGET_LANG, comma separated.")
	[ -n "$SYNONYMS" ] && BODY+="<b><span color='#ADFF2F'>Synonyms:</span></b> <i>$SYNONYMS</i>\n\n"

	EXAMPLES=$(call_gemini "Write 3 natural example sentences in $TARGET_LANG using '$WORD'. Number them '1. ', '2. ', '3. '.")
	[ -n "$EXAMPLES" ] && BODY+="<b><span color='#87CEEB'>Examples:</span></b>\n$EXAMPLES"

else
	# TRANSLATION MODE
	TITLE="🌐 Translation → $TARGET_LANG"
	TRANSLATION=$(trans_shell -b ":$TARGET_LANG" "$WORD")

	# RLM used to go straight into $TRANSLATION here, which then fed
	# espeak-ng (IPA_TARGET), two Gemini prompts, AND the display --
	# an invisible bidi control character has no business in the first
	# three, and "the ara translation the text is opposite" tracks with
	# it reaching a QML Text now too: Qt's Text already runs the real
	# Unicode bidi algorithm on its own per paragraph (this needed the
	# nudge for dunst/pango, not for Menu.qml), and forcing RLM in ahead
	# of that plus this row's own explicit AlignRight/ElideLeft (see
	# rightLabelText in Menu.qml) fought it rather than helping. Applied
	# only to the notify-send BODY now, the one path it was ever fixing.
	RLM=$'\u200f'

	IPA_SOURCE=$(espeak-ng -v "$SOURCE_LANG" --ipa -q "$WORD" 2>/dev/null | tr -d '\n' || echo "")
	IPA_TARGET=$(espeak-ng -v "$TARGET_LANG" --ipa -q "$TRANSLATION" 2>/dev/null | tr -d '\n' || echo "")

	SYNONYMS_SOURCE=$(call_gemini "Give me 5 synonyms for '$WORD' in $SOURCE_LANG, comma separated.")
	SYNONYMS_TARGET=$(call_gemini "Give me 5 synonyms for '$TRANSLATION' in $TARGET_LANG, comma separated.")

	EXAMPLE_PROMPT="Write 3 natural example sentences in $TARGET_LANG using the word or phrase '$TRANSLATION'. After each sentence, provide its translation to $SOURCE_LANG in parentheses. Number them '1. ', '2. ', '3. '."
	EXAMPLES=$(call_gemini "$EXAMPLE_PROMPT")

	TRANSLATION_NOTIFY="$TRANSLATION"
	[ "$TARGET_LANG" = "ar" ] && TRANSLATION_NOTIFY="${RLM}${TRANSLATION}"
	BODY="<b><span color='#FFD700'>Word:</span></b> <span color='#00CED1'>$WORD</span>\n"
	BODY+="<b><span color='#FFA500'>Translation:</span></b> <span bgcolor='#333333' color='#ffffff'><b>$TRANSLATION_NOTIFY</b></span>\n\n"

	[ -n "$SYNONYMS_SOURCE" ] && BODY+="<b><span color='#ADFF2F'>Synonyms ($SOURCE_LANG):</span></b> <i>$SYNONYMS_SOURCE</i>\n"
	[ -n "$SYNONYMS_TARGET" ] && BODY+="<b><span color='#ADFF2F'>Synonyms ($TARGET_LANG):</span></b> <i>$SYNONYMS_TARGET</i>\n"
	[ -n "$IPA_SOURCE" ] && BODY+="<b><span color='#FF69B4'>IPA ($SOURCE_LANG):</span></b> /$IPA_SOURCE/\n"
	[ -n "$IPA_TARGET" ] && BODY+="<b><span color='#FF69B4'>IPA ($TARGET_LANG):</span></b> /$IPA_TARGET/\n"

	[ -n "$EXAMPLES" ] && BODY+="\n<b><span color='#87CEEB'>Examples:</span></b>\n$EXAMPLES"
fi

# BODY is assembled with "\n" inside double quotes, i.e. literal
# backslash-n. Expand it with %b so the notification and the clipboard
# both get real line breaks instead of the two-character escape.
BODY_EXPANDED="$(printf '%b' "$BODY")"

# "the translation not showing anything in the popup ... should show in
# the qml popup right" — two bugs in one screenshot. The empty
# "Translation:" line was $TRANSLATION/etc. genuinely coming back empty
# from trans/gemini (unrelated to display); but "Word:" rendering as a
# stray box was THIS notify-send call: $WORD and friends go into pango
# markup unescaped, so a word containing '&', '<' or '>' breaks the XML
# dunst is parsing and it silently drops everything from there on —
# exactly the "Word: [box], Translation: (nothing)" shape reported.
#
# "column, vertical, [] []" asked for the word and the translation as two
# columns on one row. Built that as a new 5th (rightLabel) field on
# Menu.qml's dmenu row format -- and that turned out to be the actual
# cause of "the translation not work at all": the field was read
# (`row.rightLabel.length`) without ever being declared a `required
# property` on the delegate, which is a hard QML runtime error on every
# single row the dmenu view draws, app rows and menu rows included, not
# just this one. That's reverted (Menu.qml/MenuModel.js, back to the
# plain label/subtext/appIcon contract every other dmenu caller already
# uses). Rebuilt here on exactly that proven contract instead: two plain
# ROWS, word then translation, each with its own subtext -- not literal
# side-by-side columns, but nothing unverified between the data and the
# screen this time either.
CARD_ROWS=()
if [ "$SOURCE_LANG" = "$TARGET_LANG" ]; then
	WORD_DETAILS=()
	[ -n "${IPA:-}" ] && WORD_DETAILS+=("IPA /$IPA/")
	[ -n "${SYNONYMS:-}" ] && WORD_DETAILS+=("Synonyms: $SYNONYMS")
	WORD_DETAIL=""
	for part in "${WORD_DETAILS[@]+"${WORD_DETAILS[@]}"}"; do
		WORD_DETAIL="${WORD_DETAIL:+$WORD_DETAIL · }$part"
	done
	CARD_ROWS+=("$(printf '\t%s\t%s' "$WORD" "$WORD_DETAIL")")
else
	SOURCE_DETAILS=()
	[ -n "${IPA_SOURCE:-}" ] && SOURCE_DETAILS+=("IPA /$IPA_SOURCE/")
	[ -n "${SYNONYMS_SOURCE:-}" ] && SOURCE_DETAILS+=("Synonyms: $SYNONYMS_SOURCE")
	SOURCE_DETAIL="$SOURCE_LANG"
	for part in "${SOURCE_DETAILS[@]+"${SOURCE_DETAILS[@]}"}"; do
		SOURCE_DETAIL="$SOURCE_DETAIL · $part"
	done
	CARD_ROWS+=("$(printf '\t%s\t%s' "$WORD" "$SOURCE_DETAIL")")

	TARGET_DETAILS=()
	[ -n "${IPA_TARGET:-}" ] && TARGET_DETAILS+=("IPA /$IPA_TARGET/")
	[ -n "${SYNONYMS_TARGET:-}" ] && TARGET_DETAILS+=("Synonyms: $SYNONYMS_TARGET")
	TARGET_DETAIL="$TARGET_LANG"
	for part in "${TARGET_DETAILS[@]+"${TARGET_DETAILS[@]}"}"; do
		TARGET_DETAIL="$TARGET_DETAIL · $part"
	done
	CARD_ROWS+=("$(printf '\t%s\t%s' "$TRANSLATION" "$TARGET_DETAIL")")
fi
if [ -n "${EXAMPLES:-}" ]; then
	CARD_ROWS+=("$(printf '\t%s\t%s' "Examples" "$(printf '%s' "$EXAMPLES" | tr '\n' ' ')")")
fi

# Debug trail -- every round of "not working" so far has needed a live
# bash -x trace to actually see what happened, and that trace is what
# found both the set -e/pipefail death and the RLM-reaching-espeak bug.
# Logged instead of traced from now on so the next report can be read
# out of a file (`cat "$TMP_DIR/debug.log"`) rather than needing another
# live run.
{
	printf '[%s] WORD=%s SOURCE_LANG=%s TARGET_LANG=%s\n' \
		"$(date +%H:%M:%S)" "$WORD" "$SOURCE_LANG" "$TARGET_LANG"
	printf '  use_ati_menu_select=%s TRANSLATION=%s\n' \
		"$(use_ati_menu_select && echo yes || echo no)" "${TRANSLATION:-}"
	printf '  rows:\n'
	printf '    %s\n' "${CARD_ROWS[@]}"
} >>"$TMP_DIR/debug.log" 2>&1

if use_ati_menu_select; then
	printf '%s\n' "${CARD_ROWS[@]}" | rofi_select "$TITLE" >/dev/null || true
else
	notify-send -t "$NOTIFY_TIMEOUT" -u normal "$TITLE" "<span font='13'>$BODY_EXPANDED</span>"
fi
copy_to_clipboard "$(printf '%s' "$BODY_EXPANDED" | sed 's/<[^>]*>//g')"

# -------------------------- TTS Logic --------------------------
OUT_FILE="$TMP_DIR/tts_audio"
TTS_WORD="$WORD"
TTS_LANG="$SOURCE_LANG"

# AR/TR → EN/DE uses translated word
if { [ "$SOURCE_LANG" = "ar" ] || [ "$SOURCE_LANG" = "tr" ]; } && { [ "$TARGET_LANG" = "en" ] || [ "$TARGET_LANG" = "de" ]; }; then
	TTS_WORD="$TRANSLATION"
	TTS_LANG="$TARGET_LANG"
fi

# Skip voice if AR→AR or TR→TR
if { [ "$SOURCE_LANG" = "ar" ] && [ "$TARGET_LANG" = "ar" ]; } || { [ "$SOURCE_LANG" = "tr" ] && [ "$TARGET_LANG" = "tr" ]; }; then
	TTS_WORD=""
fi

if [ -n "$TTS_WORD" ]; then
	case "$TTS_LANG" in
	en)
		if command -v gtts-cli >/dev/null; then
			OUT_FILE="$OUT_FILE.mp3"
			gtts-cli -l en "$TTS_WORD" --output "$OUT_FILE" &>/dev/null
			mpv --speed="$TTS_SPEED" --really-quiet "$OUT_FILE" &
		fi
		;;
	de)
		if [[ -x "$PIPER_CMD" && -f "$PIPER_VOICE_DE" ]]; then
			OUT_FILE="$OUT_FILE.wav"
			echo "$TTS_WORD" | "$PIPER_CMD" --model "$PIPER_VOICE_DE" --length_scale "$TTS_LENGTH_SCALE" --output_file "$OUT_FILE" &>/dev/null
			mpv --really-quiet "$OUT_FILE" "$OUT_FILE" &
		fi
		;;
	*)
		if command -v espeak-ng >/dev/null; then
			OUT_FILE="$OUT_FILE.wav"
			espeak-ng -v "$TTS_LANG" "$TTS_WORD" -w "$OUT_FILE" &>/dev/null
			mpv --really-quiet "$OUT_FILE" &
		fi
		;;
	esac
fi

exit 0
