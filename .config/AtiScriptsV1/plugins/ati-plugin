#!/usr/bin/env bash
# ati-plugin {list|sync|doctor|dir} — the plugin loader.
#
# ARCHITECTURE.md Phase 3, "read-only first": the mechanism ships with ZERO
# plugins, so nothing about the desktop changes until someone puts a
# directory in ~/.config/ati-plugins. That is the point — the contract gets
# to be proven while the blast radius is nil.
#
# A plugin is ONE DIRECTORY with a manifest and any subset of five
# well-known subdirectories (ARCHITECTURE.md §3):
#
#   ~/.config/ati-plugins/<name>/
#       plugin.toml     required — the manifest
#       bin/            executables, symlinked onto PATH
#       binds.conf      Hyprland binds
#       menu.json       entries merged into the ati-menu tree
#       theme/          a palette, offered to the theme picker
#       qml/            a bar chip or popup
#
# WHAT sync DOES, AND WHY IT HAS TO EXIST AT ALL
# ----------------------------------------------
# Three of the five surfaces cannot read a glob at runtime, so `sync`
# MATERIALISES them: it writes the symlinks and the two generated files that
# Hyprland and ati-menu then read as ordinary single paths. It is idempotent
# and it is the only thing that writes; `list` and `doctor` never do.
#
# Everything sync creates is recorded in its own state file, and the next
# sync removes what it created last time before creating this time. That is
# what makes removing a plugin work: delete the directory, run sync, and the
# symlinks it owned go with it. Nothing else on the system is ever touched --
# a name sync did not create is a name sync will not delete.
#
# THE ERROR OVERLAY, WHICH IS WHY binds ARE NOT A GLOB
# ----------------------------------------------------
# ARCHITECTURE.md §4 says the keybind surface is
# `source = ~/.config/ati-plugins/*/binds.conf`, "Hyprland already supports
# glob sourcing". It does, but measured in a throwaway nested Hyprland:
#
#   source = <glob matching nothing>   -> "source= globbing error: found no
#                                          match" + the full-width red error
#                                          overlay across the screen
#   source = <single missing file>     -> the same
#   source = <single EMPTY file>       -> clean
#
# So the spec's line cannot ship: with zero plugins installed -- the state
# Phase 3 explicitly ships in -- every machine would boot to an error
# banner. Hyprland sources ONE always-present file instead
# (~/.config/hypr/plugins.conf, tracked in the repo, comment-only until a
# plugin exists), and sync rewrites it. With no plugins its output is
# byte-identical to what the repo ships, so a clean checkout stays clean.
set -uo pipefail

PLUGIN_DIR="${ATI_PLUGIN_DIR:-$HOME/.config/ati-plugins}"
# FIRST-PARTY plugins, shipped by this repo, scanned alongside the user's.
#
# Phase 4 is the first thing that needed this: `ati-adhkar` moved OUT of
# AtiScriptsV1 and into a plugin, and a plugin that only exists in
# ~/.config/ati-plugins would not survive a fresh install -- the feature
# would simply be gone on every new machine. Two roots, not a symlink farm
# into the user's directory: a symlink would make `ati-plugin list` show a
# repo-shipped plugin as if somebody had installed it by hand, and deleting
# it would "work" until the next sync put it back.
#
# The user's directory wins a name collision, so a first-party plugin can be
# replaced by a local one of the same name without touching the repo.
REPO_PLUGIN_DIR="${ATI_REPO_PLUGIN_DIR:-$HOME/.dotfiles/plugins}"
# ~/.local/bin, not /usr/local/bin: AtiScriptsV1's own install.sh needs sudo
# because it writes to /usr/local/bin, and a sync that prompts for a password
# is a sync nobody runs. ~/.local/bin is already ahead of /usr/local/bin on
# PATH here (measured in a Hyprland-spawned process's /proc/<pid>/environ),
# it is user-owned, and it already holds the AtiScriptsV1 symlinks -- which
# is exactly the "alongside" §4 asks for.
BIN_DIR="${ATI_PLUGIN_BIN_DIR:-$HOME/.local/bin}"
HYPR_CONF="${ATI_PLUGIN_HYPR_CONF:-$HOME/.config/hypr/plugins.conf}"
CACHE_DIR="${ATI_PLUGIN_CACHE:-$HOME/.cache/ati-plugins}"
MENU_AGG="$CACHE_DIR/menu.json"
QML_AGG="$CACHE_DIR/qml.json"
STATE="$CACHE_DIR/synced.json"

# The one line every generated file carries, so a reader who finds one in a
# diff knows what wrote it and what to run instead of editing it.
GEN_BANNER="# generated by \`ati-plugin sync\` — do not edit, your changes will be overwritten"

_c() { command -v tput >/dev/null 2>&1 && [[ -t 1 ]] && tput setaf "$1" 2>/dev/null || true; }
_r() { command -v tput >/dev/null 2>&1 && [[ -t 1 ]] && tput sgr0 2>/dev/null || true; }
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✔%s %s\n' "$(_c 2)" "$(_r)" "$*"; }
warn() { printf '%s!%s %s\n' "$(_c 3)" "$(_r)" "$*"; }
bad()  { printf '%s✖%s %s\n' "$(_c 1)" "$(_r)" "$*"; }

# ---------------------------------------------------------------------------
#  Reading the plugin set
# ---------------------------------------------------------------------------
# One python pass produces the whole picture as JSON, because every consumer
# below needs the same three things (does the manifest parse, what does it
# declare, which surfaces exist on disk) and shelling out per plugin per
# question is how a loader gets slow enough to be skipped.
_scan() {
  PLUGIN_DIR="$PLUGIN_DIR" REPO_PLUGIN_DIR="$REPO_PLUGIN_DIR" python3 <<'PY'
import json, os, sys
try:
    import tomllib
except ModuleNotFoundError:                      # python < 3.11
    tomllib = None

# User directory LAST so it wins: same name in both, the local one is the
# one that gets scanned and the shipped one is ignored entirely.
roots = [("repo", os.environ.get("REPO_PLUGIN_DIR", "")),
         ("user", os.environ["PLUGIN_DIR"])]
out, seen = [], {}
for origin, root in roots:
    if not root or not os.path.isdir(root):
        continue
    for name in sorted(os.listdir(root)):
        d = os.path.join(root, name)
        # A dotfile is not a plugin. This is what lets the directory hold a
        # README, an editor's scratch dir, or a half-finished checkout
        # without the loader trying to load it.
        if not os.path.isdir(d) or name.startswith("."):
            continue
        p = {"name": name, "dir": d, "origin": origin,
             "errors": [], "meta": {}, "surfaces": []}
        man = os.path.join(d, "plugin.toml")
        if not os.path.isfile(man):
            p["errors"].append("no plugin.toml")
        elif tomllib is None:
            p["errors"].append("python3.11+ (tomllib) needed to read plugin.toml")
        else:
            try:
                with open(man, "rb") as fh:
                    m = tomllib.load(fh)
                # `name` in the manifest must match the directory. The
                # directory is what every surface is keyed on -- the bind
                # file, the menu ids, the symlink bookkeeping -- so a
                # manifest claiming a different one is a plugin that reports
                # itself under a name nothing else uses.
                if "name" not in m:
                    p["errors"].append("plugin.toml has no `name`")
                elif str(m["name"]) != name:
                    p["errors"].append(
                        "plugin.toml name %r does not match directory %r" % (m["name"], name))
                p["meta"] = {
                    "version":     str(m.get("version", "")),
                    "description": str(m.get("description", "")),
                    "depends":     [str(x) for x in m.get("depends", []) or []],
                    "requires":    {str(k): str(v) for k, v in (m.get("requires") or {}).items()},
                    "hooks":       {str(k): str(v) for k, v in (m.get("hooks") or {}).items()},
                    # The SIXTH surface, added in Phase 4 -- see the header.
                    "service":     str((m.get("service") or {}).get("exec", "")),
                }
            except Exception as e:
                p["errors"].append("plugin.toml is not valid TOML: %s" % e)

        for surface, rel in (("bin", "bin"), ("binds", "binds.conf"),
                             ("menu", "menu.json"), ("theme", "theme"), ("qml", "qml")):
            if os.path.exists(os.path.join(d, rel)):
                p["surfaces"].append(surface)
        # `service` is declared in the manifest rather than by a file
        # existing, because it is a COMMAND and not a directory -- and
        # because a surface that starts a process at login should have to be
        # written down in words, not inferred from a filename.
        if p["meta"].get("service"):
            p["surfaces"].append("service")
        p["bins"] = sorted(
            f for f in os.listdir(os.path.join(d, "bin"))
            if os.path.isfile(os.path.join(d, "bin", f))
               and os.access(os.path.join(d, "bin", f), os.X_OK)
        ) if os.path.isdir(os.path.join(d, "bin")) else []
        seen[name] = p
out = [seen[k] for k in sorted(seen)]
json.dump(out, sys.stdout)
PY
}

_jq() { command -v jq >/dev/null 2>&1; }

# Pull unit names out of `systemctl list-units` on stdin.
#
# NOT `awk '{print $1}'`. systemctl prefixes a line with a status bullet
# when the unit is not simply loaded-and-active -- "● name.service loaded
# activating auto-restart ..." -- so field 1 is the BULLET for exactly the
# units a teardown most needs to find: the failed ones and the ones stuck
# restarting. Measured: a crash-looping plugin service survived every
# `ati-plugin sync` after its plugin had been deleted, because the name the
# loop compared against was "●".
_unit_names() {
  awk '{ for (i = 1; i <= NF; i++) if ($i ~ /\.service$/ || $i ~ /\.timer$/) { print $i; break } }'
}

# ---------------------------------------------------------------------------
#  list
# ---------------------------------------------------------------------------
cmd_list() {
  local scan
  scan="$(_scan)" || { bad "could not scan $PLUGIN_DIR"; return 1; }
  if [[ "$scan" == "[]" ]]; then
    say "no plugins installed"
    say ""
    say "  Plugins live in $PLUGIN_DIR/<name>/ — one directory each, with a"
    say "  plugin.toml and any of: bin/ binds.conf menu.json theme/ qml/."
    say "  See docs/plugins.html, or ARCHITECTURE.md §3 for the contract."
    return 0
  fi
  SCAN="$scan" python3 <<'PY'
import json, os
for p in json.loads(os.environ["SCAN"]):
    mark = "✖" if p["errors"] else "✔"
    ver  = p["meta"].get("version") or "-"
    surf = ", ".join(p["surfaces"]) or "nothing"
    origin = "" if p.get("origin") == "user" else "  [shipped]"
    print("%s %-20s %-8s %s%s" % (mark, p["name"], ver, surf, origin))
    if p["meta"].get("description"):
        print("    %s" % p["meta"]["description"])
    for e in p["errors"]:
        print("    ✖ %s" % e)
PY
}

# ---------------------------------------------------------------------------
#  sync
# ---------------------------------------------------------------------------
# Order matters: tear down what the LAST sync created before building this
# one, so a renamed or deleted plugin does not leave a live symlink behind
# pointing at nothing.
_teardown_previous() {
  [[ -f "$STATE" ]] || return 0
  local link
  while IFS= read -r link; do
    [[ -z "$link" ]] && continue
    # Only ever a symlink, and only ever one we recorded. A plugin that
    # shipped a bin/ named `ls` cannot make this delete /usr/bin/ls: the
    # path came out of our own state file, and the -L guard means a real
    # file that has since replaced our link is left alone.
    [[ -L "$link" ]] && rm -f "$link"
  done < <(STATE="$STATE" python3 -c '
import json, os, sys
try:
    with open(os.environ["STATE"]) as fh:
        d = json.load(fh)
except Exception:
    sys.exit(0)
for l in d.get("bin_links", []):
    print(l)
')
}

cmd_sync() {
  local scan
  scan="$(_scan)" || { bad "could not scan $PLUGIN_DIR"; return 1; }
  mkdir -p "$CACHE_DIR" "$BIN_DIR"

  _teardown_previous

  local created=()
  local skipped=0 linked=0

  # ---- PATH ----
  # `dir` comes from the scan, because there are two roots now: a
  # first-party plugin lives in the repo and a user's in ~/.config, and
  # rebuilding the path from $PLUGIN_DIR would point every shipped plugin's
  # symlink at a directory that does not exist. (It did, for one commit --
  # the link resolved into ~/.config/ati-plugins for a plugin that was never
  # there, and the service died with status=127.)
  local name dir bin src dst
  while IFS=$'\t' read -r name dir bin; do
    [[ -z "$name" ]] && continue
    src="$dir/bin/$bin"
    dst="$BIN_DIR/$bin"
    if [[ -e "$dst" && ! -L "$dst" ]]; then
      warn "$name: $bin not linked — a real file already owns $dst"
      skipped=$(( skipped + 1 )); continue
    fi
    # A DANGLING link is not "already points somewhere else", it is litter
    # from a previous life, and refusing to replace it is how a migration
    # silently fails. Phase 4 hit exactly this: moving ati-adhkar out of
    # AtiScriptsV1 left ~/.local/bin/ati-adhkar pointing at the old path,
    # and the guard below would have declined to fix the very link the move
    # had just broken. Only a link resolving to a file that EXISTS and is
    # not ours is a real conflict.
    if [[ -L "$dst" && -e "$dst" ]] && [[ "$(readlink -f "$dst")" != "$(readlink -f "$src")" ]]; then
      warn "$name: $bin not linked — $dst already points somewhere else"
      skipped=$(( skipped + 1 )); continue
    fi
    ln -sfn "$src" "$dst"
    created+=("$dst"); linked=$(( linked + 1 ))
  done < <(SCAN="$scan" HOME="$HOME" python3 <<'PYSYNC'
# Rule 3 of ARCHITECTURE.md §3 is "namespacing is ENFORCED, not requested",
# so the refusal happens HERE and not only in doctor's report. A plugin that
# ships bin/ati-menu does not get to shadow ati-menu on PATH just because
# ~/.local/bin sorts ahead of /usr/local/bin: the symptom would be "the menu
# key stopped working", and nothing on screen would connect that to a plugin
# installed last week.
#
# Within one sync the first plugin in directory order keeps a contested name
# and the rest are refused, so the outcome is stable and reportable instead
# of depending on which symlink happened to be written last.
import json, os

scan = json.loads(os.environ["SCAN"])
core = set()
root = os.path.join(os.environ["HOME"], ".config", "AtiScriptsV1")
for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = [d for d in dirnames if not d.startswith(".")]
    for f in filenames:
        if os.access(os.path.join(dirpath, f), os.X_OK):
            core.add(f)

claimed = {}
for p in scan:
    if p["errors"]:
        continue
    for b in p["bins"]:
        if b in core or b in claimed:
            continue
        claimed[b] = p["name"]
        print("%s\t%s\t%s" % (p["name"], p["dir"], b))
PYSYNC
)

  # ---- services ----
  _sync_services "$scan"
  # ---- keybinds ----
  _write_hypr_conf "$scan"
  # ---- menu ----
  _write_menu_agg "$scan"
  # ---- qml ----
  _write_qml_agg "$scan"
  # themes need no generated file: theme-list.sh and theme-apply were taught
  # to search $PLUGIN_DIR/*/theme directly, because a theme is picked by
  # NAME at the moment the picker runs and a stale materialised copy would
  # be a theme that still appears after its plugin is gone.

  # ---- state ----
  STATE="$STATE" python3 -c '
import json, os, sys
json.dump({"bin_links": sys.argv[1:]}, open(os.environ["STATE"], "w"))
' "${created[@]:-}"

  local n
  n="$(SCAN="$scan" python3 -c '
import json, os
print(len([p for p in json.loads(os.environ["SCAN"]) if not p["errors"]]))
')"
  local note=""
  (( skipped > 0 )) && note=", $skipped skipped (see: ati-plugin doctor)"
  ok "synced $n plugin(s): $linked command(s) linked$note"
}

# ---------------------------------------------------------------------------
#  The SERVICE surface — PHASE 4's correction to the contract
# ---------------------------------------------------------------------------
# ARCHITECTURE.md §3 lists five surfaces and none of them can say "run this
# at login". §6 then forbids the obvious workaround outright:
#
#   "Do not let a plugin run arbitrary code at load. Hooks run at INSTALL
#    time, once, visibly. A plugin that executes on every login is a plugin
#    that can make the desktop unbootable."
#
# Phase 4's candidate is `ati-adhkar`, and ati-adhkar is a LOGIN DAEMON: a
# `while true` of notify-send on a random interval, started by
# autostart.conf. So the contract as written cannot express the one feature
# the phase picked to prove it with -- which is precisely what §5 said this
# phase was for ("if it cannot be expressed as a plugin, the contract in §3
# is wrong and this is where that is discovered").
#
# The resolution is a sixth surface that keeps §6's INTENT rather than its
# letter. What §6 is actually protecting against is a plugin that can make
# the desktop unbootable, and every part of that danger comes from running
# the plugin's code INSIDE the session's startup path: an exec-once that
# blocks, or crashes, or hangs, takes the compositor's startup with it.
#
# A transient `systemd --user` unit has none of those properties:
#
#   * it is not in the compositor's startup path, so it cannot block or
#     break the session no matter what it does
#   * it is supervised -- a crash is a failed unit, not a broken desktop
#   * it is VISIBLE, which is the other half of §6's demand: every one of
#     them shows up in `systemctl --user list-units 'ati-plugin-*'`
#   * it is stoppable without editing, moving or uninstalling the plugin
#
# It is also the mechanism this repo already reaches for: `ati-reminder`
# schedules with `systemd-run --user`, for the same reasons.
#
# Reconciled, not restarted. A sync runs on every login and after every
# plugin change; restarting a running daemon each time would make `sync`
# something you think twice about, and the whole design rests on it being
# safe to run at any moment.
_sync_services() {
  local scan="$1" name dir exec unit
  command -v systemd-run >/dev/null 2>&1 || return 0

  # Stop the units of plugins that are gone, or that no longer declare a
  # service. Derived from OUR unit prefix and nothing else -- a unit this
  # command did not name is a unit it will not touch.
  local declared
  declared="$(SCAN="$scan" python3 -c '
import json, os
for p in json.loads(os.environ["SCAN"]):
    if not p["errors"] and p["meta"].get("service"):
        print("ati-plugin-%s.service" % p["name"])
')"
  while read -r unit; do
    [[ -z "$unit" ]] && continue
    if ! grep -qxF "$unit" <<<"$declared"; then
      systemctl --user stop "$unit" >/dev/null 2>&1
      systemctl --user reset-failed "$unit" >/dev/null 2>&1
    fi
  done < <(systemctl --user list-units --type=service --all --no-legend \
             'ati-plugin-*' 2>/dev/null | _unit_names)

  while IFS=$'\t' read -r name dir exec; do
    [[ -z "$name" ]] && continue
    unit="ati-plugin-${name}.service"
    systemctl --user is-active --quiet "$unit" && continue
    # Not active, but not necessarily absent either: a unit sitting in
    # "activating (auto-restart)" after a crash still OWNS the name, and
    # `systemd-run --unit=` on a name that exists fails outright. Clear the
    # corpse in both of its shapes before claiming the name -- reset-failed
    # alone does nothing to one that is mid-restart, which is how a fixed
    # command kept reporting "service failed to start" after the bug in it
    # had already been repaired.
    systemctl --user stop "$unit" >/dev/null 2>&1
    systemctl --user reset-failed "$unit" >/dev/null 2>&1
    # /bin/sh -c because `exec` is a command LINE from a manifest, not an
    # argv: a plugin author writes `exec = "ati-adhkar"` and should be able
    # to write `exec = "ati-adhkar --quiet"` without learning how this is
    # spawned.
    #
    # Restart=on-failure, not always: a service that exits 0 has finished,
    # and respawning it forever would turn a one-shot into a spin. --collect
    # so a unit that fails and stops does not sit in the list as a corpse
    # that blocks the next start under the same name.
    # An EXPLICIT PATH, and this is not belt-and-braces. A `systemd --user`
    # service inherits the user manager's environment, which is whatever
    # existed when the manager started -- not the login shell's, and not
    # necessarily containing ~/.local/bin, which is where sync puts a
    # plugin's commands. `exec = "ati-adhkar"` would then fail with status
    # 127 on a machine whose manager never imported it, and the plugin would
    # be "installed" and permanently dead.
    #
    # The plugin's OWN bin/ goes first, so a plugin can call its own helper
    # scripts by bare name without knowing where sync linked them, or
    # whether sync refused to link one because the name was taken.
    if ! systemd-run --user --unit="ati-plugin-${name}" --collect \
           --property=Restart=on-failure --property=RestartSec=5 \
           --setenv="PATH=$dir/bin:$BIN_DIR:/usr/local/bin:/usr/bin:/bin" \
           /bin/sh -c "$exec" >/dev/null 2>&1; then
      warn "$name: service failed to start — systemctl --user status $unit"
    fi
  done < <(SCAN="$scan" python3 -c '
import json, os
for p in json.loads(os.environ["SCAN"]):
    if not p["errors"] and p["meta"].get("service"):
        print("%s\t%s\t%s" % (p["name"], p["dir"], p["meta"]["service"]))
')
}

# Rewrites ~/.config/hypr/plugins.conf. Hyprland re-reads it on its own --
# the file is inside the config tree it already watches -- so there is no
# `hyprctl reload` here: reloading the whole config as a side effect of a
# sync would restack every window rule and animation on the running desktop
# to deliver a bind.
_write_hypr_conf() {
  local scan="$1" tmp
  [[ -d "$(dirname "$HYPR_CONF")" ]] || return 0
  tmp="$(mktemp)"
  {
    printf '%s\n' "$GEN_BANNER"
    printf '#\n'
    printf '# Hyprland binds contributed by plugins in ~/.config/ati-plugins.\n'
    printf '# Sourced by binds.conf. Regenerate with: ati-plugin sync\n'
    printf '#\n'
    printf '# This file is TRACKED and ships comment-only on purpose: Hyprland\n'
    printf '# treats a missing source as an error and draws its red overlay over\n'
    printf '# the desktop, so the file has to exist before any script has run.\n'
    printf '# With no plugins installed the output below is empty and this file\n'
    printf '# is byte-identical to what the repo ships.\n'
    SCAN="$scan" python3 -c '
import json, os
for p in json.loads(os.environ["SCAN"]):
    if p["errors"] or "binds" not in p["surfaces"]:
        continue
    print("")
    print("# %s (%s)" % (p["name"], p["origin"]))
    print("source = %s/binds.conf" % p["dir"])
'
  } > "$tmp"
  if ! cmp -s "$tmp" "$HYPR_CONF" 2>/dev/null; then
    mv "$tmp" "$HYPR_CONF"
  else
    rm -f "$tmp"
  fi
}

# One merged JSON of every plugin's menu.json, for ati-menu (bash) and
# Menu.qml alike. An AGGREGATE rather than each consumer globbing: the bash
# menu merges with jq and the QML one parses with JSON.parse, and teaching
# both to walk a directory means two implementations of the same merge that
# can disagree about precedence.
_write_menu_agg() {
  local scan="$1"
  mkdir -p "$CACHE_DIR"
  SCAN="$scan" MENU_AGG="$MENU_AGG" python3 <<'PY'
import json, os
merged, seen = {}, {}
for p in json.loads(os.environ["SCAN"]):
    if p["errors"] or "menu" not in p["surfaces"]:
        continue
    try:
        with open(os.path.join(p["dir"], "menu.json")) as fh:
            data = json.load(fh)
    except Exception:
        continue                      # doctor reports it; sync does not die on it
    if not isinstance(data, dict):
        continue
    for k, v in data.items():
        # First plugin to claim a key keeps it, and the loser is reported by
        # doctor rather than silently overwriting. Last-write-wins would make
        # the winner depend on directory sort order, which is not something a
        # plugin author can see or control.
        if k in seen:
            continue
        seen[k] = p["name"]
        merged[k] = v
json.dump(merged, open(os.environ["MENU_AGG"], "w"), indent=1)
PY
}

# The QML surface is a manifest, not a merge: the shell reads this list and
# instantiates one contained Loader per entry. Kept as data so that a plugin
# whose QML throws can be dropped from the list without the shell needing to
# know what a plugin is.
_write_qml_agg() {
  local scan="$1"
  mkdir -p "$CACHE_DIR"
  SCAN="$scan" QML_AGG="$QML_AGG" python3 <<'PY'
import json, os
out = []
for p in json.loads(os.environ["SCAN"]):
    if p["errors"] or "qml" not in p["surfaces"]:
        continue
    entry = os.path.join(p["dir"], "qml", "main.qml")
    if os.path.isfile(entry):
        out.append({"name": p["name"], "path": entry})
json.dump(out, open(os.environ["QML_AGG"], "w"), indent=1)
PY
}

# ---------------------------------------------------------------------------
#  doctor
# ---------------------------------------------------------------------------
# The subcommand §4 calls "the one that matters": collisions, missing
# dependencies and failed loads in ONE place. Exits non-zero if anything is
# wrong, so it is usable from a hook or a CI step and not only by eye.
cmd_doctor() {
  local scan rc=0
  scan="$(_scan)" || { bad "could not scan $PLUGIN_DIR"; return 1; }

  # BOTH roots, and say which is which. Reporting only the user's made the
  # line "not created yet — zero plugins" print on a machine that had a
  # first-party plugin loaded and running, which is not a small wording
  # problem: doctor is the thing you read when you cannot tell what is
  # installed.
  local n_repo n_user
  n_repo="$(SCAN="$scan" python3 -c '
import json, os
print(len([p for p in json.loads(os.environ["SCAN"]) if p["origin"] == "repo"]))')"
  n_user="$(SCAN="$scan" python3 -c '
import json, os
print(len([p for p in json.loads(os.environ["SCAN"]) if p["origin"] == "user"]))')"
  say "shipped with the repo: $REPO_PLUGIN_DIR ($n_repo)"
  say "installed by you:      $PLUGIN_DIR ($n_user)"
  [[ -d "$PLUGIN_DIR" ]] || say "                       (not created yet — nothing installed by hand)"
  say ""

  # -- manifests --
  local bad_manifests
  bad_manifests="$(SCAN="$scan" python3 -c '
import json, os
for p in json.loads(os.environ["SCAN"]):
    for e in p["errors"]:
        print("%s: %s" % (p["name"], e))
')"
  if [[ -n "$bad_manifests" ]]; then
    while IFS= read -r l; do bad "$l"; done <<<"$bad_manifests"; rc=1
  else
    ok "every manifest parses"
  fi

  # -- declared dependencies --
  local missing_deps=""
  while IFS=$'\t' read -r name dep; do
    [[ -z "$name" ]] && continue
    command -v "$dep" >/dev/null 2>&1 || missing_deps+="$name needs $dep"$'\n'
  done < <(SCAN="$scan" python3 -c '
import json, os
for p in json.loads(os.environ["SCAN"]):
    for d in p["meta"].get("depends", []):
        print("%s\t%s" % (p["name"], d))
')
  if [[ -n "$missing_deps" ]]; then
    while IFS= read -r l; do [[ -n "$l" ]] && bad "$l"; done <<<"$missing_deps"; rc=1
  else
    ok "declared dependencies are installed"
  fi

  # -- command-name collisions --
  # Against BOTH the other plugins and AtiScriptsV1 itself. A plugin
  # shadowing `ati-menu` on PATH is not a conflict a user would ever guess
  # at from the symptom.
  local collisions
  collisions="$(SCAN="$scan" HOME="$HOME" python3 <<'PY'
import json, os, sys
scan = json.loads(os.environ["SCAN"])
core = set()
root = os.path.join(os.environ["HOME"], ".config", "AtiScriptsV1")
for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = [d for d in dirnames if not d.startswith(".")]
    for f in filenames:
        if os.access(os.path.join(dirpath, f), os.X_OK):
            core.add(f)
owner = {}
for p in scan:
    if p["errors"]:
        continue
    for b in p["bins"]:
        if b in core:
            print("%s: bin/%s shadows an AtiScriptsV1 command of the same name" % (p["name"], b))
        elif b in owner:
            print("%s: bin/%s collides with %s" % (p["name"], b, owner[b]))
        else:
            owner[b] = p["name"]
PY
)"
  if [[ -n "$collisions" ]]; then
    while IFS= read -r l; do bad "$l"; done <<<"$collisions"; rc=1
  else
    ok "no command-name collisions"
  fi

  # -- keybind collisions --
  # Rule 3 of §3: "namespacing is enforced, not requested". Compared against
  # the base config's own binds, parsed from the files rather than from
  # `hyprctl binds`, so this answers the same over SSH and inside a VM as it
  # does on the running desktop.
  local bindclash
  bindclash="$(SCAN="$scan" HOME="$HOME" python3 <<'PY'
import json, os, re, sys

BIND = re.compile(r'^\s*bind[lreonmtsdipg]*\s*=\s*([^,]*),\s*([^,]+),', re.I)

def norm(mods, key):
    m = sorted(x.strip().upper() for x in mods.split() if x.strip())
    return (" ".join(m), key.strip().upper())

base = {}
hypr = os.path.join(os.environ["HOME"], ".config", "hypr")
for fn in ("binds.conf", "submaps.conf"):
    path = os.path.join(hypr, fn)
    if not os.path.isfile(path):
        continue
    for line in open(path, encoding="utf-8", errors="replace"):
        m = BIND.match(line)
        if m:
            base.setdefault(norm(*m.groups()), fn)

for p in json.loads(os.environ["SCAN"]):
    if p["errors"] or "binds" not in p["surfaces"]:
        continue
    path = os.path.join(p["dir"], "binds.conf")
    for line in open(path, encoding="utf-8", errors="replace"):
        m = BIND.match(line)
        if not m:
            continue
        k = norm(*m.groups())
        if k in base:
            print("%s: %s %s is already bound by %s" % (p["name"], k[0] or "(no mod)", k[1], base[k]))
        else:
            base[k] = p["name"]
PY
)"
  if [[ -n "$bindclash" ]]; then
    while IFS= read -r l; do bad "$l"; done <<<"$bindclash"; rc=1
  else
    ok "no keybind collisions with the base config"
  fi

  # -- is what is on disk what sync would produce? --
  local drift=0
  if [[ -f "$HYPR_CONF" ]]; then
    local tmp_before
    tmp_before="$(mktemp)"; cp "$HYPR_CONF" "$tmp_before"
    _write_hypr_conf "$scan"
    cmp -s "$tmp_before" "$HYPR_CONF" || drift=1
    rm -f "$tmp_before"
  else
    bad "$HYPR_CONF is missing — Hyprland will draw its error overlay; run: ati-plugin sync"
    rc=1
  fi
  (( drift )) && { warn "$HYPR_CONF was out of date and has been regenerated"; }
  (( drift )) || ok "generated files are up to date"

  # -- declared services --
  # A daemon that is silently dead is the failure mode this whole surface
  # was added for: ati-adhkar spent an unknown number of boots not running
  # (autostart.conf's own comment records the pgrep guard that matched its
  # own parent shell), and nothing anywhere said so. It says so here.
  # CAN WE EVEN TALK TO THE USER MANAGER? Without DBUS_SESSION_BUS_ADDRESS
  # and XDG_RUNTIME_DIR -- a cron job, a `su`, an `env -i`, a unit with a
  # clean environment -- `systemctl --user` cannot connect, and then EVERY
  # service reads as "not running". Reporting that as a dead daemon sends
  # you to debug something that is fine.
  #
  # Measured 2026-08-30: doctor run under `env -i` printed
  #   ✖ service adhkar: not running
  # while the unit was active the whole time. "I could not ask" and "the
  # answer is no" are different findings and must not print the same line.
  local systemd_reachable=1
  systemctl --user show-environment >/dev/null 2>&1 || systemd_reachable=0

  local svc_bad=""
  while IFS=$'\t' read -r name _exec; do
    [[ -z "$name" ]] && continue
    if (( ! systemd_reachable )); then
      warn "service ${name}: cannot reach the user systemd bus — state unknown, not necessarily stopped"
      continue
    fi
    if systemctl --user is-active --quiet "ati-plugin-${name}.service"; then
      ok "service ${name}: running"
    else
      svc_bad+="service ${name}: not running — ati-plugin sync, then systemctl --user status ati-plugin-${name}.service"$'\n'
    fi
  done < <(SCAN="$scan" python3 -c '
import json, os
for p in json.loads(os.environ["SCAN"]):
    if not p["errors"] and p["meta"].get("service"):
        print("%s\t%s" % (p["name"], p["meta"]["service"]))
')
  if [[ -n "$svc_bad" ]]; then
    while IFS= read -r l; do [[ -n "$l" ]] && bad "$l"; done <<<"$svc_bad"; rc=1
  fi

  # -- the QML contract --
  local qmlmiss
  qmlmiss="$(SCAN="$scan" python3 -c '
import json, os
for p in json.loads(os.environ["SCAN"]):
    if p["errors"] or "qml" not in p["surfaces"]:
        continue
    if not os.path.isfile(os.path.join(p["dir"], "qml", "main.qml")):
        print("%s: has qml/ but no qml/main.qml — nothing to load" % p["name"])
')"
  if [[ -n "$qmlmiss" ]]; then
    while IFS= read -r l; do bad "$l"; done <<<"$qmlmiss"; rc=1
  fi

  say ""
  (( rc == 0 )) && ok "doctor: all checks passed" || bad "doctor: problems above"
  return "$rc"
}

case "${1:-}" in
  list)   cmd_list ;;
  sync)   cmd_sync ;;
  doctor) cmd_doctor ;;
  dir)    say "$PLUGIN_DIR" ;;
  *)      echo "usage: ati-plugin {list|sync|doctor|dir}" >&2; exit 2 ;;
esac
