#!/usr/bin/env bash
# ati-menu — a single declarative command tree, in the spirit of Omarchy's
# omarchy-menu: one JSON file of dotted-id nodes (icon/label/when/checked/
# disabled/action), walked generically instead of each menu being its own
# hand-coded case block the way ati-docs/ati-theme-toggle/etc are.
#
# Deliberately plain JSON, not JSONC — jq has no native comment support,
# and this tree is nowhere near Omarchy's ~340-entry scale, so the
# comment-stripping step their JS loader needs isn't worth carrying here.
# Explanatory context lives in this header instead of inline JSON comments.
#
# Schema per entry, keyed by a dotted id ("style.theme"; the id's own dots
# ARE the hierarchy — no explicit "parent" field, same inference Omarchy's
# own loader uses):
#   icon      leading glyph (Nerd Font, baked into the row text like every
#             other picker in this repo — \0icon\x1f stays reserved for real
#             image thumbnails, see ati-copyq-rofi/rofi_shared)
#   label     row text
#   when      optional shell expr; nonzero exit HIDES the row
#   checked   optional shell expr; zero exit prefixes "● ", nonzero "○ "
#             (only entries that declare this field get a marker at all)
#   disabled  optional shell expr; zero exit suffixes " ✓" and makes the
#             row nonselectable (rofi's `\0meta\x1fnonselectable\x1ftrue`,
#             same control line rofi_todo's header rows already use)
#   action    a leaf if present (bash -c'd on select) — otherwise the id is
#             a submenu, and selecting it descends into its own children
#   terminal  optional; "true" runs `action` inside a real floating
#             terminal (run_in_terminal, ati-rofi-common.sh) instead of a
#             silent background job — for anything with visible output or
#             a sudo prompt (installs, ati-update)
#
# All three condition fields are re-evaluated every time a level is drawn,
# not cached — same "always live" property Omarchy's fields have.
set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/ati-rofi-common.sh"

MENU_DEFAULT="$SCRIPT_DIR/ati-menu.json"
MENU_EXT="$SCRIPT_DIR/ati-menu-extensions.json"
# No -theme override: base.rasi itself now carries the QML-matched corner
# radius/padding ("i want all rofi to be same style of qml"), so every
# picker in the repo -- this one included -- gets it through the normal
# @import chain (config.rasi -> current.rasi -> dtos-center.rasi ->
# base.rasi) with no per-script theme file needed. Wider/taller than
# ati-docs's DOCS_GEO -- a command tree runs deeper and denser than
# ati-docs's hand-picked 3-8 row sections.
MENU_GEO='window { width: 40%; } listview { lines: 10; dynamic: false; }'

MERGED="$(mktemp --suffix=.json)"
trap 'rm -f "$MERGED"' EXIT

# Extension keys win on conflict (jq's `*` deep-merges right-biased) -- the
# override point Omarchy's own default+extension jsonc pair gives a user,
# without touching the shipped file. Parsed once at startup, not re-read
# per draw: the TREE shape rarely changes mid-session; what must stay live
# is the when/checked/disabled *conditions*, evaluated fresh every draw
# below.
if ! jq -s '.[0] * .[1]' "$MENU_DEFAULT" "$MENU_EXT" > "$MERGED" 2>/dev/null; then
  rofi -e "ati-menu: ati-menu.json or ati-menu-extensions.json is invalid JSON"
  exit 1
fi

# Everything below reads the TREE SHAPE (ids, icons, labels, action
# strings) from two bash structures loaded with exactly two jq calls
# total, not one jq call per field per id per draw. That used to be the
# design -- menu_field() spawned a fresh jq for every icon/label/when/
# checked/disabled/action lookup -- and it visibly slowed down as the
# flatten-for-search list grew (28 leaves needed ~2s to render vs ~0.8s
# at the original 3-entry test tree, timed by how long screenshots
# needed to wait during testing). The when/checked/disabled *values*
# still get `bash -c`'d live, every draw, same as always -- only the
# JSON field lookups themselves are batched, since those can't go stale
# mid-session the way a shell condition's truth value can.
mapfile -t ALL_IDS < <(jq -r 'keys[]' "$MERGED")

declare -A MENU_DATA
while IFS=$'\t' read -r id field value; do
  MENU_DATA["$id:$field"]="$value"
done < <(jq -r '
  to_entries[] | .key as $id | .value as $v
  | ($v | to_entries[] | "\($id)\t\(.key)\t\(.value)")
' "$MERGED")

# menu_children <id> — immediate child ids of <id> ("root" = top level), in
# file order (ALL_IDS is jq `keys[]` order = authoring order already).
menu_children() {
  local parent="$1" id rest
  for id in "${ALL_IDS[@]}"; do
    if [[ "$parent" == "root" ]]; then
      [[ "$id" != *.* ]] && printf '%s\n' "$id"
    elif [[ "$id" == "$parent".* ]]; then
      rest="${id#"$parent".}"
      [[ "$rest" != *.* ]] && printf '%s\n' "$id"
    fi
  done
}

menu_field() {  # menu_field <id> <field>
  printf '%s' "${MENU_DATA["$1:$2"]:-}"
}

# menu_all_leaves — every id in the tree with a non-empty action, at any
# depth (a "leaf" per the same has-action inference used everywhere else).
menu_all_leaves() {
  local id
  for id in "${ALL_IDS[@]}"; do
    [[ -n "${MENU_DATA["$id:action"]:-}" ]] && printf '%s\n' "$id"
  done
}

# menu_breadcrumb_for <id> — "Parent › Grandparent's-parent..." for id's
# ancestor chain, root-to-parent order, NOT including id's own label (the
# row already shows that). Empty for a root-level id.
menu_breadcrumb_for() {
  # NOT `local id="$1" cur="$id"` -- confirmed live (screenshot showed every
  # flattened row prefixed "Style", regardless of its real parent) that a
  # sibling local's initializer in the SAME `local` statement reads the
  # OUTER scope's variable, not the one just declared beside it: the
  # script's own `for id in "${children[@]}"` loop (used both above and in
  # the is_direct_child check below) leaves a global `id` behind, and that
  # is what "cur=\"\$id\"" was actually reading. `$1` has no such ambiguity.
  local cur="$1" parts=()
  while [[ "$cur" == *.* ]]; do
    cur="${cur%.*}"
    local lbl; lbl="$(menu_field "$cur" label)"
    [[ -z "$lbl" ]] && lbl="$cur"
    parts=("$lbl" "${parts[@]}")
  done
  local out="" p
  for p in "${parts[@]}"; do
    out+="${out:+ › }$p"
  done
  printf '%s' "$out"
}

menu_cond() {  # menu_cond <shell-expr> — true (rc 0) if empty or succeeds
  [[ -z "$1" ]] && return 0
  bash -c "$1" >/dev/null 2>&1
}

# rofi's -p (and -mesg) are pango markup, unlike plain dmenu row text --
# confirmed directly: `rofi -dmenu -p "A & B"` renders a BLANK prompt, no
# error, because a bare & is invalid XML. Only the breadcrumb (built from a
# node's `label` field, which may come from ati-menu-extensions.json, i.e.
# not fully author-controlled) goes through -p, so only it needs escaping.
pango_escape() {
  local s="$1"
  s="${s//&/&amp;}"
  s="${s//</&lt;}"
  s="${s//>/&gt;}"
  printf '%s' "$s"
}

# Runs a leaf's action. `terminal: true` routes through run_in_terminal
# (ati-rofi-common.sh), reusing the --class docs-view float/center
# convention so qtile's existing _float_and_center_docs hook sizes it the
# same way without a new class-specific hook. Everything else is a plain
# backgrounded job — the right default for silent toggles (theme switch,
# etc), which is most of the tree.
menu_run_action() {
  local id="$1" action term
  action="$(menu_field "$id" action)"
  [[ -z "$action" ]] && return
  term="$(menu_field "$id" terminal)"
  if [[ "$term" == "true" ]]; then
    run_in_terminal --class docs-view --title "ati-menu" -e bash -c \
      "$action; ec=\$?; echo; read -rp 'press enter to close (exit \$ec)' _"
  else
    bash -c "$action" >/dev/null 2>&1 &
  fi
}

# menu_emit_row <id> <rows_file> — appends one row for <id> to <rows_file>
# and pushes its id onto the `ids` array (global, indices must match rofi's
# -format i exactly). <prefix>, if set as $3, is prepended as "prefix › "
# before the icon/marker/label -- used for the flattened recursive-search
# rows below so a distant hit still reads as "Install › GIMP", not just
# "GIMP" with no context. Shared between the direct-children loop and the
# flatten loop so the when/checked/disabled logic exists in exactly one
# place.
menu_emit_row() {
  local id="$1" rows_file="$2" prefix="${3:-}"

  local when; when="$(menu_field "$id" when)"
  menu_cond "$when" || return

  local icon label; icon="$(menu_field "$id" icon)"; label="$(menu_field "$id" label)"
  [[ -z "$label" ]] && label="$id"

  local checked marker=""; checked="$(menu_field "$id" checked)"
  if [[ -n "$checked" ]]; then
    if menu_cond "$checked"; then marker="● "; else marker="○ "; fi
  fi

  local row_text="${prefix:+$prefix › }${icon:+$icon }${marker}${label}"

  local disabled; disabled="$(menu_field "$id" disabled)"
  if [[ -n "$disabled" ]] && menu_cond "$disabled"; then
    printf '%s ✓\0meta\x1fnonselectable\x1ftrue\n' "$row_text" >> "$rows_file"
  else
    printf '%s\n' "$row_text" >> "$rows_file"
  fi
  ids+=("$id")
}

navigation_stack=()
current="root"

while :; do
  mapfile -t children < <(menu_children "$current")

  # Rows go to a temp file, not a bash array/variable: a disabled row's
  # nonselectable control line embeds a raw NUL byte
  # (`\0meta\x1fnonselectable\x1ftrue`), and bash strings/command
  # substitution silently truncate at the first NUL -- the same reason
  # rofi_todo's own header rows go through a temp file rather than its
  # normal ROW_LINES array. `ids` stays a plain bash array in lockstep
  # (ids never contain a NUL), used to resolve rofi's `-format i` index
  # back to the id that produced that row.
  rows_file="$(mktemp)"
  ids=()

  if [[ "$current" != "root" ]]; then
    printf '..\n' >> "$rows_file"
    ids+=("__up__")
  fi

  for id in "${children[@]}"; do
    menu_emit_row "$id" "$rows_file"
  done

  # ---- recursive search ----
  #
  # rofi's own -i filter only matches against what is ALREADY in the row
  # list -- it has no notion of "search the whole tree", it just does
  # substring/fuzzy matching on whatever this script hands it. So typing
  # "minecraft" only ever finds something rofi can already see. The fix
  # is not clever rofi scripting (checked: rofi's script-mode API is
  # still "generate a list once, rofi filters what's there" underneath,
  # just called ROFI_RETV=2 "custom entry" on unmatched Enter -- not real
  # per-keystroke live search either) -- it's simpler than that: put
  # EVERY leaf in the whole tree into the list, always, breadcrumb-prefixed
  # when it is not a direct child of here. Unfiltered, the current level's
  # own entries sort first (added above) so normal browsing still reads
  # clean; typed, rofi's fuzzy match narrows the WHOLE flattened set, so a
  # leaf three levels down surfaces from any level, same as Omarchy's.
  #
  # Only leaves are flattened, not submenu nodes -- the concrete case this
  # exists for ("type minecraft, land on the install action") is about
  # reaching a leaf's action directly, and submenus are shallow enough
  # (root is one browse away from everything) that flattening them too
  # would just add noise without adding reachability.
  while IFS= read -r leaf_id; do
    [[ -z "$leaf_id" ]] && continue
    is_direct_child=0
    for id in "${children[@]}"; do
      [[ "$id" == "$leaf_id" ]] && { is_direct_child=1; break; }
    done
    (( is_direct_child )) && continue
    menu_emit_row "$leaf_id" "$rows_file" "$(menu_breadcrumb_for "$leaf_id")"
  done < <(menu_all_leaves)

  breadcrumb="Menu"
  if [[ "$current" != "root" ]]; then
    breadcrumb="$(menu_field "$current" label)"
    [[ -z "$breadcrumb" ]] && breadcrumb="$current"
  fi
  breadcrumb="$(pango_escape "$breadcrumb")"

  choice="$(rofi -dmenu -i -p "$breadcrumb" -format i -theme-str "$MENU_GEO" \
    -mesg "$(rofi_hint "↵ open" "Esc back")" < "$rows_file")"
  rc=$?
  rm -f "$rows_file"

  if (( rc != 0 )); then
    if [[ ${#navigation_stack[@]} -eq 0 ]]; then
      exit 0
    fi
    current="${navigation_stack[-1]}"
    unset 'navigation_stack[-1]'
    continue
  fi

  [[ "$choice" =~ ^[0-9]+$ ]] || continue
  sel_id="${ids[$choice]:-}"
  [[ -z "$sel_id" ]] && continue

  if [[ "$sel_id" == "__up__" ]]; then
    current="${navigation_stack[-1]}"
    unset 'navigation_stack[-1]'
    continue
  fi

  action="$(menu_field "$sel_id" action)"
  if [[ -n "$action" ]]; then
    menu_run_action "$sel_id"
    exit 0
  else
    navigation_stack+=("$current")
    current="$sel_id"
  fi
done
