#!/usr/bin/env bash
#
# Script name: ati-satty
# Description: Take screenshots, with optional editing in satty
# Dependencies: rofi, satty, and ONE of the two backends below
#   X11:      maim, xdotool, xrandr, xclip
#   Wayland:  grim, slurp, hyprctl, wl-copy
# License: MIT

set -euo pipefail

# Configuration - customize these paths
MAIM_DIR="${HOME}/Screenshots"
MAIM_PREFIX="screenshot"
# Overridable so the script can be DRIVEN without a pointer. Not scaffolding:
# every path through here is three menus deep, and a screenshot tool whose only
# test is "take one by hand" is how it came to be captured with an X11 tool in
# a Wayland session for as long as it was. A stub that echoes a fixed answer
# turns the whole flow into one command.
#
# Default picker matches the session: ati-menu-select on Hyprland (the QML
# menu's own dmenu view, same as every other picker in this repo now), rofi
# -dmenu -i -p on X11/qtile where that is not an option. Both take a single
# trailing prompt argument and read rows from stdin, so nothing below this
# line needed to change.
# ati-menu-select only under native bar mode -- see dm-confedit's own
# comment on this exact condition for why.
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ "$(cat "$HOME/.cache/bar-mode" 2>/dev/null)" != "island" ] \
    && command -v ati-menu-select >/dev/null 2>&1; then
	RMENU="${RMENU:-ati-menu-select}"
else
	RMENU="${RMENU:-rofi -dmenu -i -p}"
fi

# Create screenshot directory if it doesn't exist
mkdir -p "${MAIM_DIR}"

# ============================================================
#  WHICH DISPLAY SERVER — and why every screenshot was BLACK
# ============================================================
# Reported: "I use the screenshot from rofi and the screens are black".
#
# This script captured with `maim` and listed monitors with `xrandr` and found
# the active window with `xdotool`. All three are X11 tools. Under Hyprland
# they still RUN — XWayland answers them — and what maim then captures is the
# XWayland root window, which no Wayland client ever draws into. So it
# succeeded, wrote a valid PNG, notified "Screenshot Saved", and the file was
# solid black. Nothing failed anywhere, which is why it took a report.
#
# The clipboard half already knew about the split (copy_to_clipboard has had
# an x11/wayland case since it was written); the CAPTURE half did not.
#
# WAYLAND_DISPLAY rather than XDG_SESSION_TYPE. That variable is set by the
# display manager and is simply absent or wrong for a session started any
# other way — and being wrong here means a black screenshot again rather than
# an error. The socket either exists or it does not.
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	BACKEND=wayland
else
	BACKEND=x11
fi

get_timestamp() {
	date '+%Y%m%d-%H%M%S'
}

copy_to_clipboard() {
	# Keyed on BACKEND now, not on XDG_SESSION_TYPE. Same reasoning as the
	# capture: the socket is the fact, the variable is a report of it. This
	# also means the clipboard and the capture can no longer disagree, which
	# they could before — a Wayland session with XDG_SESSION_TYPE unset used
	# to capture with maim AND copy with xclip, consistently wrong.
	case "$BACKEND" in
	x11) xclip -selection clipboard -t image/png ;;
	wayland) wl-copy -t image/png ;;
	esac
}

# ============================================================
#  THE CAPTURE, ONE FUNCTION PER BACKEND
# ============================================================
# Both write a PNG to STDOUT. Every call site below then decides what to do
# with it — file, clipboard, both, or satty — so the two backends differ in
# exactly one place instead of at every destination.
#
# `geom` is empty for a full-screen capture and otherwise the X11 form,
# "WxH+X+Y", which is what maim's -g takes and what this script has always
# carried internally.
#
# GRIM DOES NOT TAKE THAT FORM. Its -g is "<x>,<y> <w>x<h>" — slurp's own
# output format — and handed "1346x710+10+48" it prints `invalid geometry` and
# exits non-zero. Caught here rather than in the field, but it is the shape of
# thing that would have looked like "the region option is broken" while
# fullscreen worked, so the conversion is explicit and lives next to the call.
capture() {
	local geom="$1" delay="$2"

	if [ "$BACKEND" = wayland ]; then
		# Reported: "i can see the rofi toke in the foto ... visible in
		# both fullscreen and the selected part". The X11 arm below has
		# always had an UNCONDITIONAL 0.5s settle baked into maim's own
		# `-qd 0.5` — its own comment says why: rofi has just exited, but
		# the compositor still needs a frame to stop drawing that surface
		# and repaint what was behind it, and capturing before that frame
		# lands puts rofi in the shot. This branch had no equivalent at
		# all: the only sleep here was `[ "$delay" -gt 0 ] && sleep
		# "$delay"`, so at the delay menu's own default answer, 0, grim
		# fired with NOTHING between rofi exiting and the shutter — the
		# race the X11 side was never exposed to. Same fixed floor as
		# maim's, the user's chosen delay still stacked on top of it.
		sleep 0.5
		[ "$delay" -gt 0 ] && sleep "$delay"
		if [ -n "$geom" ]; then
			local w h x y
			w="${geom%%x*}"
			h="${geom#*x}"; h="${h%%+*}"
			x="${geom#*+}"; x="${x%%+*}"
			y="${geom##*+}"
			grim -g "${x},${y} ${w}x${h}" -
		else
			grim -
		fi
		return
	fi

	# -q quiet, -d 0.5 the settle that lets a menu finish closing before the
	# shutter — without it every capture has rofi in it.
	local args="-qd 0.5"
	[ "$delay" -gt 0 ] && args="$args --delay=$delay"
	[ -n "$geom" ] && args="$args -g $geom"
	# Unquoted on purpose: these are several arguments in one string.
	# shellcheck disable=SC2086
	maim $args
}

# The list of monitors, as "NAME WxH+X+Y" lines.
list_monitors() {
	if [ "$BACKEND" = wayland ]; then
		hyprctl -j monitors | python3 -c '
import json, sys
for m in json.load(sys.stdin):
    print("%s %dx%d+%d+%d" % (m["name"], m["width"], m["height"], m["x"], m["y"]))
'
		return
	fi
	xrandr --listactivemonitors 2>/dev/null |
		awk '/\+/ {print $4, $3}' |
		awk -F'[x/+* ]' '{print $1,$2"x"$4"+"$6"+"$7}'
}

# The focused window, as "WxH+X+Y".
active_window_geometry() {
	if [ "$BACKEND" = wayland ]; then
		hyprctl -j activewindow | python3 -c '
import json, sys
w = json.load(sys.stdin)
if not w or "at" not in w:
    sys.exit(1)
print("%dx%d+%d+%d" % (w["size"][0], w["size"][1], w["at"][0], w["at"][1]))
'
		return
	fi
	command -v xdotool >/dev/null 2>&1 || return 1
	local id
	id="$(xdotool getactivewindow)" || return 1
	# maim can take a window id directly, but returning a geometry keeps
	# capture() with ONE parameter shape for both backends.
	xdotool getwindowgeometry --shell "$id" |
		awk -F= '/^X=/{x=$2} /^Y=/{y=$2} /^WIDTH=/{w=$2} /^HEIGHT=/{h=$2}
		         END{printf "%dx%d+%d+%d", w, h, x, y}'
}

# An interactive region, in this script's internal "WxH+X+Y" form.
#
# slurp prints GRIM's format, "<x>,<y> <w>x<h>" — the opposite convention from
# the one everything else here carries — so it is converted at the source
# rather than at the shutter. Feeding slurp's own string straight to capture()
# looks right, parses as nonsense, and crops somewhere unrelated.
slurp_region() {
	local sel
	sel="$(slurp)" || return 1
	printf '%sx%s+%s+%s' \
		"$(printf '%s' "$sel" | cut -d' ' -f2 | cut -dx -f1)" \
		"$(printf '%s' "$sel" | cut -d' ' -f2 | cut -dx -f2)" \
		"$(printf '%s' "$sel" | cut -d' ' -f1 | cut -d, -f1)" \
		"$(printf '%s' "$sel" | cut -d' ' -f1 | cut -d, -f2)"
}

show_error() {
	echo "Error: $1" >&2
	notify-send "Screenshot Error" "$1"
	exit 1
}

main() {
	local geom=""
	local interactive_select=false
	local file_type=""
	local use_satty=false

	# Available screenshot modes
	declare -a modes=(
		"Fullscreen"
		"Active window"
		"Selected region"
		"Fullscreen (edit with satty)"
		"Selected region (edit with satty)"
	)

	# Get monitor information
	if [ "$BACKEND" = wayland ]; then
		command -v grim &>/dev/null || show_error "grim is required but not installed"
	else
		command -v maim &>/dev/null || show_error "maim is required but not installed"
		command -v xrandr &>/dev/null || show_error "xrandr is required but not installed"
	fi

	_displays=$(list_monitors) || show_error "Failed to get monitor information"

	# Add monitor-specific options
	IFS=$'\n'
	declare -A display_mode
	for i in ${_displays}; do
		monitor_name="${i%% *}"
		modes+=("${monitor_name}")
		display_mode["${monitor_name}"]="${i##* }"
	done
	unset IFS

	# Prompt for screenshot type
	target=$(printf '%s\n' "${modes[@]}" | ${RMENU} "Take screenshot of:") || exit 0

	# Check if satty should be used
	case "$target" in
	*"(edit with satty)")
		use_satty=true
		target="${target% (edit with satty)*}"
		if ! command -v satty &>/dev/null; then
			show_error "satty is not installed"
		fi
		;;
	esac

	# Resolve the target to a GEOMETRY, whichever backend is up.
	case "$target" in
	"Fullscreen")
		file_type="full"
		;;
	"Active window")
		geom="$(active_window_geometry)" ||
			show_error "Could not find the active window"
		file_type="window"
		;;
	"Selected region")
		# Deferred to shoot(), below — on BOTH backends now.
		#
		# Reported: "the rofi of taking screenshot why not working the
		# same like real qtile's". Real qtile only has the X11 backend,
		# whose interactive maim -s select has always happened HERE, i.e.
		# LAST — the delay and destination prompts come first, and the
		# drag-select is the final step before the shutter, same order
		# `screenshot-area.sh` uses for the bare Print key.
		#
		# The Wayland branch resolved slurp's drag-select IMMEDIATELY on
		# this menu choice instead — before the delay and destination
		# prompts even appeared — because slurp_region() was called right
		# here rather than from shoot() like the X11 arm already does. Same
		# menu, same wording, but the interactive part of it happened at a
		# different STEP depending on which session you were in, which is
		# exactly the asymmetry a user switching between them would notice
		# and the X11 side would not have (it is what qtile's own key does).
		# One flag drives both backends now, and shoot() decides how to
		# resolve it, same shape as the delay it already applies after.
		interactive_select=true
		file_type="region"
		;;
	*)
		# Monitor selection
		geom="${display_mode[${target}]}"
		file_type="${target}"
		;;
	esac

	# Prompt for delay. Anything that is not a number counts as none:
	# the old test ran `[ ! "" -eq 0 ]` when the prompt came back empty,
	# which is an "integer expression expected" error and, under `set -e`,
	# killed the script with nothing on screen to explain it.
	delay=$(printf '%s\n' "$(seq 0 5)" | ${RMENU} "Delay (in seconds):") || exit 0
	if ! [[ "${delay}" =~ ^[0-9]+$ ]]; then
		delay=0
	fi

	# The interactive region is each backend's own selector rather than a
	# geometry resolved up front, so the drag-select happens at the SAME
	# step — last, right before the shutter — on both. wrapped here so
	# every call site below stays a plain `shoot`.
	shoot() {
		if $interactive_select; then
			if [ "$BACKEND" = wayland ]; then
				# slurp is cancelled with Escape, which is a "no thanks"
				# and not a failure — exit quietly rather than an error.
				# The delay still applies AFTER the drag resolves, same
				# order maim's own -s --delay gives the X11 arm below:
				# capture()'s sleep runs right before the grim call.
				local wgeom
				wgeom="$(slurp_region)" || exit 0
				capture "$wgeom" "$delay"
				return
			fi
			local args="-qd 0.5 -s"
			[ "${delay}" -gt 0 ] && args="$args --delay=${delay}"
			# shellcheck disable=SC2086
			maim $args
		else
			capture "$geom" "$delay"
		fi
	}

	if $use_satty; then
		# Capture and edit with satty.
		#
		# satty was previously started with --filename only. Its save
		# action needs --output-filename to have anywhere to write, so the
		# edit went nowhere; the script then moved the *unedited* capture
		# to Screenshots and announced "Screenshot Saved". Every annotation
		# ever made here was silently discarded -- which is why the folder
		# contains screenshot-full-* files and not one screenshot-satty-*.
		# Per-user: the timestamp makes a same-second collision unlikely
		# rather than impossible, and a screenshot is the last thing that
		# should land world-readable in /tmp for other accounts to open.
		temp_dir="${XDG_RUNTIME_DIR:-/tmp/rofi-$(id -u)}"
		mkdir -p "${temp_dir}" 2>/dev/null || true
		temp_file="${temp_dir}/satty-$(get_timestamp).png"
		shoot >"${temp_file}" || show_error "Failed to capture screenshot"

		output_file="${MAIM_DIR}/${MAIM_PREFIX}-satty-$(get_timestamp).png"

		if satty --help | grep -q '\--output-filename'; then
			satty --filename "${temp_file}" --output-filename "${output_file}" ||
				show_error "Failed to open satty"
		elif satty --help | grep -q '\--filename'; then
			# Older satty: no output flag, so the original is all there is.
			satty --filename "${temp_file}" || show_error "Failed to open satty"
			mv "${temp_file}" "${output_file}"
		else
			satty "${temp_file}" || show_error "Failed to open satty"
			mv "${temp_file}" "${output_file}"
		fi

		rm -f "${temp_file}"
		# Only claim a save if satty actually wrote one: closing the editor
		# without saving is a legitimate "no thanks", not a failure.
		if [ -s "${output_file}" ]; then
			notify-send "Screenshot Saved" "${output_file}"
		else
			notify-send "Screenshot Discarded" "satty closed without saving"
		fi

	else
		# Regular screenshot options
		destination=$(printf '%s\n' "File" "Clipboard" "Both" | ${RMENU} "Destination:") || exit 0

		case "$destination" in
		"File")
			output_file="${MAIM_DIR}/${MAIM_PREFIX}-${file_type}-$(get_timestamp).png"
			shoot >"${output_file}" || show_error "Failed to save screenshot"
			notify-send "Screenshot Saved" "${output_file}"
			;;
		"Clipboard")
			shoot | copy_to_clipboard || show_error "Failed to copy to clipboard"
			notify-send "Screenshot Copied" "Image saved to clipboard"
			;;
		"Both")
			output_file="${MAIM_DIR}/${MAIM_PREFIX}-${file_type}-$(get_timestamp).png"
			shoot | tee "${output_file}" | copy_to_clipboard || {
				show_error "Failed to save and copy screenshot"
			}
			notify-send "Screenshot Saved" "${output_file}\nAnd copied to clipboard"
			;;
		*)
			exit 0
			;;
		esac
	fi
}

# Run the main function
main "$@"
