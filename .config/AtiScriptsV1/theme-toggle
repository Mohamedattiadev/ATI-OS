#!/usr/bin/env bash
# theme-toggle — rofi picker for theme mode. Current mode marked with ●.
# Rofi uses the shared current.rasi palette so the picker matches whatever
# theme is active right now.
#
# NOTE: never use a shell var named DISPLAY in this script — it shadows
# the X11 $DISPLAY env var and every downstream tool (kitty @, brave,
# eww, qtile cmd-obj) then fails silently when theme-apply is exec'd.

set -euo pipefail

# readlink -f: this script is reached through a /usr/local/bin symlink, so
# a plain $0 dirname resolves to the symlink's directory, not the repo.
# shellcheck source=rofi_common.sh
source "$(dirname "$(readlink -f "$0")")/rofi_common.sh"

STATE_FILE="$HOME/.cache/qtile/theme_mode"
CURRENT="doomone"
[[ -f "$STATE_FILE" ]] && CURRENT="$(cat "$STATE_FILE")"

# "<display>|<mode>" — display shown in picker, mode passed to theme-apply.
ENTRIES=(
  "Wallpaper|wal"
  "DoomOne|doomone"
  "Dracula|dracula"
  "Gruvbox|gruvbox"
  "Nord|nord"
  "TokyoNight|tokyonight"
  "Catppuccin|catppuccin"
  "Monokai|monokai"
  "Everforest|everforest"
  "Rose Pine|rose-pine"
  "Kanagawa|kanagawa"
  "Oxocarbon|oxocarbon"
  "OneDark|onedark"
  "Palenight|palenight"
  "Night Owl|nightowl"
  "GitHub Dark|github-dark"
  "Ayu Mirage|ayu-mirage"
  "Cyberpunk Neon|cyberpunk-neon"
  "Synthwave|synthwave"
  "Matrix|matrix"
  "Mono Dark|mono-dark"
  "Mono Light|mono-light"
)

LIST=""
for e in "${ENTRIES[@]}"; do
  label="${e%%|*}"
  mode="${e##*|}"
  if [[ "$mode" == "$CURRENT" ]]; then
    LIST+="● $label"$'\n'
  else
    LIST+="○ $label"$'\n'
  fi
done

CHOICE="$(printf '%s' "$LIST" | rofi -dmenu -i -p "Theme" \
  -mesg "$(rofi_hint "↵ retint everything" "Esc cancels" "● is active" "${#ENTRIES[@]} palettes")")"
[[ -z "$CHOICE" ]] && exit 0

# Strip marker prefix ("● " or "○ ") — display name only.
LABEL="${CHOICE#* }"

MODE=""
for e in "${ENTRIES[@]}"; do
  if [[ "${e%%|*}" == "$LABEL" ]]; then
    MODE="${e##*|}"
    break
  fi
done

[[ -z "$MODE" ]] && exit 1
# theme-animate, not theme-apply: it hands the change to whichever shell can
# draw the circular reveal and falls back to theme-apply when there is none.
# Picking a palette here used to repaint the desktop in stages while the
# island's own picker swept — the same change with two different faces
# depending on where you started it.
#
# Guarded, and not out of politeness: theme-animate is a NEW script, so it is
# absent on any machine where AtiScriptsV1/install.sh has not been re-run
# since. `exec` on a missing command takes this shell down with it and the
# theme simply never changes — a picker that silently does nothing is the
# worst of the three outcomes here, and the fallback is exactly what
# theme-animate itself would have done.
if command -v theme-animate >/dev/null 2>&1; then
  exec theme-animate "$MODE"
fi
exec theme-apply "$MODE"
