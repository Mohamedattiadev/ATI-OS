#!/usr/bin/env bash
# theme-toggle — rofi picker for theme mode. Current mode marked with ●.
# Rofi uses the shared current.rasi palette so the picker matches whatever
# theme is active right now.

set -euo pipefail

STATE_FILE="$HOME/.cache/qtile/theme_mode"
CURRENT="doomone"
[[ -f "$STATE_FILE" ]] && CURRENT="$(cat "$STATE_FILE")"

MODES=(
  doomone
  wal
  dracula
  gruvbox
  nord
  tokyonight
  catppuccin
)

format() {
  local m="$1"
  if [[ "$m" == "$CURRENT" ]]; then
    printf '● %s\n' "$m"
  else
    printf '○ %s\n' "$m"
  fi
}

LIST=""
for m in "${MODES[@]}"; do
  LIST+="$(format "$m")
"
done

CHOICE="$(printf '%s' "$LIST" | rofi -dmenu -i -p "Theme")"
[[ -z "$CHOICE" ]] && exit 0

MODE="${CHOICE#* }"
exec theme-apply "$MODE"
