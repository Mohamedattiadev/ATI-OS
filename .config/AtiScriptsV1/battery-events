#!/bin/bash

# Found by TYPE, never by name. "BAT0" and "AC" are what this one laptop
# happens to call them; the kernel takes those names from firmware, so
# other machines expose BAT1, and the mains adapter is just as often ACAD,
# ADP0, ADP1 or AC0. Hardcoded, `cat "$BAT/status"` read a path that does
# not exist on those machines: STATUS and PERCENT stayed empty, every
# comparison below then matched the previous empty value, and the result
# was no plug/unplug popup and no low-battery warning, silently.
PS=/sys/class/power_supply
BAT=""; AC=""
for _d in "$PS"/*; do
  [[ -r "$_d/type" ]] || continue
  case "$(<"$_d/type")" in
    Battery) [[ -z "$BAT" && -r "$_d/capacity" ]] && BAT="$_d" ;;
    Mains)   [[ -z "$AC" ]] && AC="$_d" ;;
  esac
done
if [[ -z "$BAT" ]]; then
  notify-send -u critical "Battery" "No battery found under $PS" 2>/dev/null
  exit 1
fi

LAST_STATUS=""
LAST_PERCENT=""
LAST_AC=""

read_battery() {
  STATUS=$(cat "$BAT/status")
  PERCENT=$(cat "$BAT/capacity")
  AC_ONLINE=$(cat "$AC/online" 2>/dev/null || echo 0)
}

notify() {
  notify-send "Battery" "$1"
}

notify_critical() {
  notify-send -u critical "Battery Low" "$1"
}

# Initial state
read_battery
LAST_STATUS="$STATUS"
LAST_PERCENT="$PERCENT"
LAST_AC="$AC_ONLINE"

# Listen for EVENTS (UPower-based, no polling loop).
# Checked rather than assumed: without upower the pipeline below exits
# immediately, this watcher dies at login, and the only trace is a
# "command not found" on a stderr nobody is reading.
if ! command -v upower >/dev/null 2>&1; then
  notify-send -u critical "Battery" "upower is not installed — battery events disabled" 2>/dev/null
  exit 1
fi
upower --monitor-detail | while read -r _; do

  # Small settle delay (does NOT poll)
  sleep 1

  read_battery

  # Ignore fully duplicate refreshes
  [[ "$STATUS" == "$LAST_STATUS" && "$PERCENT" == "$LAST_PERCENT" && "$AC_ONLINE" == "$LAST_AC" ]] && continue

  # 🔌 Plug / unplug (AC-based, no duplicates)
  if [[ "$AC_ONLINE" != "$LAST_AC" ]]; then
    if [[ "$AC_ONLINE" == "1" ]]; then
      notify "🔌 Charger plugged in"
    else
      notify "🔌 Charger unplugged"
    fi
  fi

  # ✅ Full
  if [[ "$PERCENT" == "100" && "$LAST_PERCENT" != "100" ]]; then
    notify "✅ Battery is full — unplug charger"
  fi

  # 🔴 Low (fires ONLY when crossing 10%)
  if [[ "$PERCENT" -le 10 && "$LAST_PERCENT" -gt 10 && "$AC_ONLINE" == "0" ]]; then
    notify_critical "⚡ $PERCENT% remaining — plug in now!"
  fi

  LAST_STATUS="$STATUS"
  LAST_PERCENT="$PERCENT"
  LAST_AC="$AC_ONLINE"

done
