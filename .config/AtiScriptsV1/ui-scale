#!/usr/bin/env bash
# ui-scale — derive a UI scale factor for THIS display and publish it.
#
# The problem this solves: every pixel dimension in the qtile config was
# tuned on a 1366x768 14" panel at ~125 DPI. Copy the repo to a 15" 4K
# laptop and the bar is a sliver with unreadable text; copy it to a 24"
# 1080p desktop monitor and it is roughly right. Nothing warns you -- the
# desktop simply looks wrong, which is the one thing these dotfiles are
# supposed to guarantee across machines.
#
# What it writes:
#   ~/.cache/qtile/ui_scale         the factor, e.g. "1.15" (qtile reads it)
#   ~/.Xresources                   Xft.dpi, inside a marker block
#
# Both are per-machine and untracked. qtile multiplies every font size, bar
# height and margin by the factor; Xft.dpi is what makes GTK/Qt/rofi text
# follow along.
#
# Usage:
#   ui-scale               detect, write, print what changed
#   ui-scale --show        print detected + active factor, write nothing
#   ui-scale --set 1.25    pin a manual factor (survives re-detection)
#   ui-scale --auto        clear the manual pin, go back to detection
#   ui-scale --dry-run     print what would be written
#
# A manual pin always wins. "The formula disagrees with my eyes" is a valid
# outcome, and the fix has to be one command, not a config edit.

set -Eeuo pipefail

CACHE_DIR="$HOME/.cache/qtile"
SCALE_FILE="$CACHE_DIR/ui_scale"
PIN_FILE="$CACHE_DIR/ui_scale.pinned"
XRES="$HOME/.Xresources"
BEGIN='! BEGIN-UI-SCALE'
END='! END-UI-SCALE'

# The machine every pixel value in the config was tuned on. Changing these
# rescales every other machine, so they are the reference, not a default.
REF_DPI=125          # 1366x768 across 277mm
REF_HEIGHT=768

MIN_SCALE=1.00       # never go below the reference: it is already a small
                     # screen, and shrinking further helps nobody. A 24"
                     # 1080p monitor computes ~0.74 by pure DPI, which would
                     # make the desktop smaller than on the laptop it was
                     # designed for.
MAX_SCALE=3.00

DRY=0; MODE=detect; SET_TO=""
while (( $# )); do
  case "$1" in
    --show)    MODE=show ;;
    --auto)    MODE=auto ;;
    --set)     MODE=set; SET_TO="${2:-}"; shift ;;
    --set=*)   MODE=set; SET_TO="${1#*=}" ;;
    --dry-run) DRY=1 ;;
    --help|-h) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "ui-scale: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done

die() { echo "ui-scale: $*" >&2; exit 1; }

# ── detection ────────────────────────────────────────────────────────
# Read the primary output, falling back to the first connected one. A
# multi-monitor setup gets the primary's scale: qtile has one config, and
# guessing per-monitor scales it cannot apply would be worse than picking
# the display the user called primary.
read_geometry() {
  local line
  line="$(xrandr --current 2>/dev/null | grep " connected primary" | head -1)"
  [[ -n "$line" ]] || line="$(xrandr --current 2>/dev/null | grep " connected" | head -1)"
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line"
}

compute() {
  local line res_w res_h mm_w mm_h dpi diag_in scale method
  line="$(read_geometry)" || { echo "1.00 no-xrandr"; return; }

  res_w="$(sed -n 's/.*[^0-9]\([0-9]\+\)x[0-9]\+[+-][0-9]\+[+-][0-9]\+.*/\1/p' <<<"$line")"
  res_h="$(sed -n 's/.*[0-9]\+x\([0-9]\+\)[+-][0-9]\+[+-][0-9]\+.*/\1/p'  <<<"$line")"
  mm_w="$(sed -n 's/.*[^0-9]\([0-9]\+\)mm x [0-9]\+mm.*/\1/p' <<<"$line")"
  mm_h="$(sed -n 's/.*[0-9]\+mm x \([0-9]\+\)mm.*/\1/p' <<<"$line")"

  [[ -n "$res_w" && -n "$res_h" ]] || { echo "1.00 no-resolution"; return; }

  # Physical size is the honest basis for "looks the same size", but a lot
  # of monitors lie about it -- 0mm over some HDMI links and docks, absurd
  # values over others. Sanity-check the diagonal before trusting it, and
  # fall back to the height ratio when it fails.
  if [[ -n "$mm_w" && -n "$mm_h" && "$mm_w" -gt 0 && "$mm_h" -gt 0 ]]; then
    diag_in="$(awk -v w="$mm_w" -v h="$mm_h" 'BEGIN{printf "%.1f", sqrt(w*w+h*h)/25.4}')"
    if awk -v d="$diag_in" 'BEGIN{exit !(d >= 8 && d <= 60)}'; then
      dpi="$(awk -v r="$res_w" -v m="$mm_w" 'BEGIN{printf "%.1f", r/(m/25.4)}')"
      scale="$(awk -v d="$dpi" -v r="$REF_DPI" 'BEGIN{printf "%.4f", d/r}')"
      method="dpi:${dpi}@${diag_in}in"
    fi
  fi
  if [[ -z "${scale:-}" ]]; then
    scale="$(awk -v h="$res_h" -v r="$REF_HEIGHT" 'BEGIN{printf "%.4f", h/r}')"
    method="height:${res_h}px(no-usable-physical-size)"
  fi

  # Clamp, then round to 0.05 -- finer steps are invisible and only make
  # the value look more precise than the input justifies.
  scale="$(awk -v s="$scale" -v lo="$MIN_SCALE" -v hi="$MAX_SCALE" 'BEGIN{
    if (s < lo) s = lo; if (s > hi) s = hi;
    printf "%.2f", int(s/0.05 + 0.5) * 0.05
  }')"
  echo "$scale ${res_w}x${res_h} $method"
}

# ── modes ────────────────────────────────────────────────────────────
mkdir -p "$CACHE_DIR"

case "$MODE" in
  show)
    read -r det geom method <<<"$(compute)"
    printf 'detected : %s   (%s, %s)\n' "$det" "$geom" "$method"
    if [[ -f "$PIN_FILE" ]]; then
      printf 'pinned   : %s   (manual — ui-scale --auto to clear)\n' "$(<"$PIN_FILE")"
    fi
    printf 'active   : %s\n' "$( [[ -f "$SCALE_FILE" ]] && cat "$SCALE_FILE" || echo '(unset)' )"
    exit 0 ;;
  auto)
    (( DRY )) && { echo "[dry] rm $PIN_FILE"; exit 0; }
    rm -f "$PIN_FILE"
    echo "manual pin cleared — re-detecting"
    ;;
  set)
    [[ -n "$SET_TO" ]] || die "--set needs a value, e.g. --set 1.25"
    awk -v s="$SET_TO" 'BEGIN{exit !(s+0 >= 0.5 && s+0 <= 4)}' \
      || die "'$SET_TO' out of range (0.5-4)"
    (( DRY )) && { echo "[dry] pin $SET_TO"; exit 0; }
    printf '%s\n' "$SET_TO" > "$PIN_FILE"
    ;;
esac

read -r detected geom method <<<"$(compute)"
if [[ -f "$PIN_FILE" ]]; then
  scale="$(<"$PIN_FILE")"
  source_note="pinned"
else
  scale="$detected"
  source_note="detected from $geom via $method"
fi

# Xft.dpi is what carries the scale into everything that is NOT qtile --
# GTK, Qt, rofi, dunst all render text through Xft/pango and read it.
# Without this, only the bar would scale and every menu would stay tiny.
xft_dpi="$(awk -v s="$scale" -v r="$REF_DPI" 'BEGIN{printf "%d", s*96 + 0.5}')"

if (( DRY )); then
  echo "[dry] $SCALE_FILE <- $scale   ($source_note)"
  echo "[dry] $XRES Xft.dpi <- $xft_dpi"
  exit 0
fi

printf '%s\n' "$scale" > "$SCALE_FILE"

# Marker block, same idiom as the wizard's XCURSOR block: rewrite between
# the markers so repeated runs replace rather than append.
touch "$XRES"
if grep -qF "$BEGIN" "$XRES"; then
  sed -i "/^${BEGIN}\$/,/^${END}\$/d" "$XRES"
fi
{
  echo "$BEGIN"
  echo "! Written by ui-scale. Do not edit: run 'ui-scale' or 'ui-scale --set N'."
  echo "Xft.dpi: $xft_dpi"
  echo "$END"
} >> "$XRES"
command -v xrdb >/dev/null 2>&1 && xrdb -merge "$XRES" 2>/dev/null || true

# ── running terminals ────────────────────────────────────────────────
# kitty watches RESOURCE_MANAGER and re-derives its cell size from Xft.dpi
# on its own -- verified by measuring `kitty @ ls` columns across a DPI
# change, including while the window was minimized. What it does NOT undo
# is a font size that was set EXPLICITLY: ctrl+= / ctrl+- (and any
# `kitty @ set-font-size`) pin an override on that OS window which then
# ignores DPI entirely, in both directions. That is the state the summary
# window (Mod+Shift+S) kept getting stuck in -- it is long-lived and only
# ever minimized, never closed, so an override picked up once outlived
# every later scale change and the font stayed wrong after going back.
#
# `set-font-size 0` means "the configured size", re-derived at the CURRENT
# dpi, and it clears the override. Sending it to every live kitty makes a
# scale change authoritative again. Same socket fan-out theme-apply uses
# for colors; same 1s timeout so one wedged instance cannot hang this.
if command -v kitty >/dev/null 2>&1; then
  for sock in /tmp/kitty-*; do
    [[ -S "$sock" ]] || continue
    timeout 1 kitty @ --to "unix:$sock" set-font-size 0 >/dev/null 2>&1 &
  done
  wait 2>/dev/null || true
fi

printf 'ui scale : %s   (%s)\n' "$scale" "$source_note"
printf 'Xft.dpi  : %s\n' "$xft_dpi"
if [[ "$scale" != "1.00" ]]; then
  printf '\nReload qtile to apply the new geometry:\n'
  printf '  qtile cmd-obj -o cmd -f reload_config\n'
  printf 'GTK/Qt apps pick up Xft.dpi when they next start.\n'
fi
