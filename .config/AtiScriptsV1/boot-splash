#!/usr/bin/env bash
# boot-splash — a plymouth splash showing THIS user's name and a progress ring.
#
# Arch boots with the kernel log on screen: a wall of scrolling text ending
# in a mirror list. That is fine for a server and wrong for a desktop --
# and worse, a boot with no feedback is indistinguishable from a boot that
# has hung. This replaces it with the Arch mark inside a progress ring and
# the username underneath, in the colours of the theme currently active.
#
# The name is generated, not hardcoded: user `ati` gets "Ati", user `beko`
# gets "Beko". Nothing about this is specific to one machine.
#
# It also owns the frame BEFORE and AFTER plymouth. systemd-boot paints a
# bitmap from the UKI's .splash section the moment you pick a boot entry,
# and Arch ships its own logo there; plymouth then draws over it, and when
# plymouth quits its buffer is torn down and that bitmap is revealed again.
# The result is the distro logo bracketing your splash on both sides. So
# `generate` also renders a STATIC frame of this same design as a BMP, and
# `enable`/`sync` point the UKI at it -- one continuous image from the boot
# menu to the login prompt.
#
# Commands:
#   boot-splash generate    render assets + install the theme (no boot changes)
#   boot-splash preview     composite the real assets at this resolution and show it
#   boot-splash preview --real   run plymouth for real on a spare VT
#   boot-splash check       every pre-reboot safety check
#   boot-splash sync        rebuild the initramfs so the boot screen matches
#                           the CURRENT theme (generate alone cannot: the
#                           theme is embedded in the initramfs)
#   boot-splash enable      generate, then wire it into initramfs + cmdline
#   boot-splash disable     reverse everything enable did
#   boot-splash status      what is installed, hooked and set
#
# `generate` and `preview` are safe. `enable` edits mkinitcpio.conf and the
# kernel cmdline and rebuilds the initramfs -- see the guards in do_enable.

set -Eeuo pipefail

THEME_NAME="dotfiles"
THEME_DIR="/usr/share/plymouth/themes/$THEME_NAME"
SRC_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}/.config/arch-config/plymouth"
PALETTE="$HOME/.cache/qtile/current_palette.json"
MKINITCPIO="/etc/mkinitcpio.conf"
KCMDLINE="/etc/kernel/cmdline"
FONT="${BOOT_SPLASH_FONT:-/usr/share/fonts/TTF/FiraCodeNerdFontPropo-Bold.ttf}"
# Block art needs a MONOSPACE face with box-drawing glyphs; the proportional
# one above staggers every row and the letters fall apart.
MONO_FONT="${BOOT_SPLASH_MONO_FONT:-/usr/share/fonts/TTF/FiraCodeNerdFontMono-Bold.ttf}"
# Block-art size. 26 puts a three-letter name at ~23% of a 1366px screen,
# which is legible without dominating; 44 was ~39% and read as shouting.
# Long names scale themselves down further (see do_generate).
TITLE_SIZE="${BOOT_SPLASH_SIZE:-26}"
# Records the palette + user the CURRENTLY BUILT initramfs contains, which
# is not the same thing as what is in /usr/share right now. See do_sync.
STAMP="/usr/share/plymouth/themes/$THEME_NAME/.built-stamp"

# The Arch mark, from the archlinux-keyring/pixmaps the distro already
# ships. Vendoring a copy would mean tracking a trademarked logo in the
# repo; reading the installed one means it is always the current artwork
# and the file simply does not exist on a non-Arch machine, which is the
# correct behaviour there.
ARCH_LOGO="${BOOT_SPLASH_LOGO:-/usr/share/pixmaps/archlinux-logo.svg}"

# The static frame handed to systemd-boot. Deliberately NOT inside
# THEME_DIR: the plymouth mkinitcpio hook copies the whole theme directory
# into the initramfs, and this bitmap is several megabytes of something the
# initramfs has no use for -- it is read once, at UKI build time.
BOOT_BMP_DIR="/usr/share/arch-config"
BOOT_BMP="$BOOT_BMP_DIR/boot-splash.bmp"
# Every mkinitcpio preset on the box gets pointed at BOOT_BMP. The presets
# are pacman-owned, so they are edited in place with a backup rather than
# replaced -- the same approach .config/arch-config/boot/linux-lts.preset
# documents for the fallback edit.
PRESET_DIR="/etc/mkinitcpio.d"

r=$'\033[31m'; g=$'\033[32m'; y=$'\033[33m'; d=$'\033[90m'; o=$'\033[0m'
say()  { printf '%s[boot-splash]%s %s\n' "$d" "$o" "$*"; }
ok()   { printf '%s[boot-splash]%s %s✓%s %s\n' "$d" "$o" "$g" "$o" "$*"; }
warn() { printf '%s[boot-splash]%s %s!%s %s\n' "$d" "$o" "$y" "$o" "$*"; }
die()  { printf '%s[boot-splash]%s %s✗%s %s\n' "$d" "$o" "$r" "$o" "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing '$1'"; }

# ── colours ─────────────────────────────────────────────────────────
# Read the palette theme-apply wrote so the splash matches the desktop the
# user actually sees. Falls back to doom-one, which is the repo default.
read_palette() {
  BG="#1c2028"; FG="#bbc2cf"; ACCENT="#51afef"
  [[ -f "$PALETTE" ]] || return 0
  local out
  out="$(python3 - "$PALETTE" <<'PY' 2>/dev/null || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
# blue is the accent in every palette this repo ships; fall back through
# the keys that always exist rather than guessing a hex value.
print(d.get("bg")     or "#1c2028")
print(d.get("fg")     or "#bbc2cf")
print(d.get("blue")   or d.get("accent") or "#51afef")
PY
)"
  [[ -n "$out" ]] && { BG="$(sed -n 1p <<<"$out")"; FG="$(sed -n 2p <<<"$out")"; ACCENT="$(sed -n 3p <<<"$out")"; }
}

# plymouth's script module wants colour components as 0.0-1.0 floats, not
# hex, and it has no parsing helpers -- so substitute them into the script.
hex_to_float() {
  local h="${1#\#}"
  printf '%s %s %s' \
    "$(awk -v v="$((16#${h:0:2}))" 'BEGIN{printf "%.4f", v/255}')" \
    "$(awk -v v="$((16#${h:2:2}))" 'BEGIN{printf "%.4f", v/255}')" \
    "$(awk -v v="$((16#${h:4:2}))" 'BEGIN{printf "%.4f", v/255}')"
}

# ── screen geometry ─────────────────────────────────────────────────
# Sets SCREEN_W / SCREEN_H. Used to scale the ring and to size the static
# BMP, which must match the resolution the FIRMWARE hands to systemd-boot
# -- not the one X happens to be running.
#
# /sys/class/graphics/fb0/virtual_size is that resolution when the machine
# booted on the EFI framebuffer, which is exactly the case a boot splash
# cares about. xrandr is the fallback for a running desktop; the constant
# is the last resort, and is only ever a wrong guess about SIZE, never
# about layout -- the theme script positions everything from the real
# Window dimensions at boot.
screen_geometry() {
  SCREEN_W=""; SCREEN_H=""
  local fb=/sys/class/graphics/fb0/virtual_size
  if [[ -r "$fb" ]]; then
    IFS=, read -r SCREEN_W SCREEN_H < "$fb" || true
  fi
  if [[ -z "${SCREEN_W:-}" || -z "${SCREEN_H:-}" ]]; then
    read -r SCREEN_W SCREEN_H <<<"$(xrandr --current 2>/dev/null \
      | awk '/ connected primary/{split($4,a,"+"); split(a[1],b,"x"); print b[1], b[2]; exit}')"
  fi
  [[ "${SCREEN_W:-}" =~ ^[0-9]+$ && "${SCREEN_H:-}" =~ ^[0-9]+$ ]] || { SCREEN_W=1920; SCREEN_H=1080; }
}

# PNG24 forced on every raster write, not `-type TrueColor`.
#
# This is the same trap -colorspace sRGB exists for, one layer down: a
# canvas built from a neutral colour is typed Grayscale, and the PNG
# ENCODER then honours that and writes a greyscale file regardless of what
# -colorspace or -type said. Every coloured sprite composited onto it
# afterwards is silently desaturated -- the accent ring came out grey with
# no warning anywhere. `PNG24:` is the only form that survives the write.

# ── layout ──────────────────────────────────────────────────────────
# THE arithmetic. dotfiles.script computes the same thing at boot from the
# real Window dimensions; this is the copy used to composite the static
# BMP and the preview. The two must agree exactly, or the handover from
# systemd-boot's bitmap to plymouth's first frame is a visible jump.
#
# Sets L_RING_X/Y, L_TITLE_X/Y, L_MARK_X/Y from SCREEN_W/H and the assets
# in the given directory.
splash_layout() {
  local d="$1" tw th rw rh mw mh gap group_h group_y
  tw="$(magick identify -format '%w' "$d/title.png")"
  th="$(magick identify -format '%h' "$d/title.png")"
  rw="$(magick identify -format '%w' "$d/ring_track.png")"
  rh="$(magick identify -format '%h' "$d/ring_track.png")"
  mw="$(magick identify -format '%w' "$d/mark.png")"
  mh="$(magick identify -format '%h' "$d/mark.png")"

  # The ring and the name are ONE group: centred together, then lifted.
  # Positioning each from the screen edges independently is what produced
  # the old top-heavy stack with a lonely dot floating below it.
  gap=$(( SCREEN_H / 16 ))
  group_h=$(( rh + gap + th ))
  group_y=$(( SCREEN_H / 2 - group_h / 2 - SCREEN_H / 22 ))

  L_RING_X=$(( SCREEN_W / 2 - rw / 2 )); L_RING_Y=$group_y
  L_TITLE_X=$(( SCREEN_W / 2 - tw / 2 )); L_TITLE_Y=$(( group_y + rh + gap ))
  L_MARK_X=$(( SCREEN_W / 2 - mw / 2 ));  L_MARK_Y=$(( L_RING_Y + rh / 2 - mh / 2 ))
}

# Composite one full-screen frame from the assets in <dir>.
#   compose_still <dir> <bg-hex> <prog-index> <spin-index|-> <title-opacity> <out>
# A `-` spin index omits the comet, which is what the static BMP wants:
# a frozen comet is a lie about a machine that is not doing anything yet.
compose_still() {
  local d="$1" bg="$2" pidx="$3" sidx="$4" topa="$5" out="$6"
  local -a a
  splash_layout "$d"
  a=( -size "${SCREEN_W}x${SCREEN_H}" "xc:$bg" -colorspace sRGB )
  a+=( \( "$d/ring_track.png" -alpha set -channel A -evaluate multiply 0.15 +channel \)
       -geometry "+${L_RING_X}+${L_RING_Y}" -composite )
  a+=( "$d/ring_prog_$pidx.png" -geometry "+${L_RING_X}+${L_RING_Y}" -composite )
  [[ "$sidx" != "-" ]] && a+=( "$d/spin_$sidx.png" -geometry "+${L_RING_X}+${L_RING_Y}" -composite )
  a+=( "$d/mark.png" -geometry "+${L_MARK_X}+${L_MARK_Y}" -composite )
  a+=( \( "$d/title.png" -alpha set -channel A -evaluate multiply "$topa" +channel \)
       -geometry "+${L_TITLE_X}+${L_TITLE_Y}" -composite )
  magick "${a[@]}" -colorspace sRGB "$out"
}

# ── asset generation ────────────────────────────────────────────────
do_generate() {
  need magick
  need python3
  [[ -d "$SRC_DIR" ]] || die "theme source not found at $SRC_DIR"
  [[ -f "$FONT" ]] || {
    warn "font not found: $FONT — falling back to whatever fontconfig picks"
    FONT=""
  }
  [[ -f "$MONO_FONT" ]] || {
    warn "mono font not found: $MONO_FONT — block art may not line up"
    MONO_FONT="monospace"
  }
  local fontargs_p=()
  [[ -n "$FONT" ]] && fontargs_p=(-font "$FONT")

  read_palette
  screen_geometry
  local title
  # ${var^} uppercases only the first character: ati -> Ati, beko -> Beko.
  title="${USER^}"
  say "user '$USER' -> title '$title'   bg=$BG fg=$FG accent=$ACCENT"
  say "screen ${SCREEN_W}x${SCREEN_H}"

  local tmp; tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN

  # Everything below forces -colorspace sRGB explicitly.
  #
  # Without it ImageMagick types a canvas built from a NEUTRAL colour --
  # and #282828, the default background, is exactly that -- as Gray, then
  # silently desaturates every coloured thing composited onto it. The
  # accent-tinted title came out grey with no error anywhere.
  local SRGB=(-colorspace sRGB)

  # Title, as ANSI Shadow block art.
  #
  # Rendered from a vendored glyph table (plymouth/ansi-shadow.txt) rather
  # than by shelling out to figlet: figlet is not installed here, and the
  # ANSI Shadow face is a CONTRIBUTED font that does not ship with it, so
  # using it would mean both a new package dependency and vendoring a font
  # file of uncertain licence. The table is 40 glyphs of plain text and is
  # verified against the wizard's own hardcoded ATI logo.
  #
  # Rendered SOLID: only the block characters are kept, and the face's
  # box-drawing drop shadow is dropped on the floor. ANSI Shadow draws the
  # letterform with █▀▄ and its shadow with ╗╝╚═║╔, and filling both in one
  # colour -- which is all a single `magick label:` pass can do -- produces
  # a hollow double outline trailing every letter. On a real screen that
  # reads as a cheap 3D bevel, not as depth. Solid blocks are what the face
  # is actually good at.
  local art="$tmp/art.txt"
  if ! python3 - "$SRC_DIR/ansi-shadow.txt" "$title" > "$art" 2>/dev/null <<'PY'
import sys
glyphs, cur = {}, None
for line in open(sys.argv[1], encoding="utf-8"):
    line = line.rstrip("\n")
    if line.startswith("#"):
        continue
    if line.startswith("@"):
        cur = line[1:]
        glyphs[cur] = []
        continue
    if cur is not None:
        glyphs[cur].append(line)
word = [c for c in sys.argv[2].upper() if c in glyphs]
if not word:
    sys.exit(1)
BLOCK = set("█▀▄▌▐░▒▓")
for row in range(6):
    line = "".join(glyphs[c][row] for c in word)
    line = "".join(ch if ch in BLOCK or ch == " " else " " for ch in line)
    # A row that is entirely shadow becomes empty; `magick label:` treats a
    # zero-width line as the end of the text and silently truncates the
    # art, so keep the row alive with a single space.
    print(line.rstrip() or " ")
PY
  then
    warn "could not render block art for '$title' — falling back to plain text"
    magick -background none "${fontargs_p[@]}" -fill "$ACCENT" \
      -pointsize 130 -kerning 12 label:"$title" -trim +repage \
      "${SRGB[@]}" "$tmp/title.png"
  else
    # MONO font, not the proportional one: block art only lines up if every
    # cell is the same width. -interline-spacing closes the gap the font
    # leaves between rows, which would otherwise slice every letter into
    # six disconnected bands.
    # Scale down for long names so the art never runs past a comfortable
    # share of the screen. A three-letter name at 26 is ~23% of 1366px; a
    # nine-letter one at the same size would be ~70%, which is the problem
    # this whole change exists to fix.
    local cols ps
    cols="$(awk 'NR==1{print length($0)}' "$art")"
    ps="$(awk -v s="$TITLE_SIZE" -v c="${cols:-20}" 'BEGIN{
      # 20 columns is the width of a 3-letter name in this face.
      v = s * 20 / (c < 20 ? 20 : c)
      if (v < 12) v = 12
      printf "%d", v }')"
    # Interline spacing, calibrated by eye rather than from font metrics.
    #
    # The metrics lie here: measured ink height per row EXCEEDS the line
    # advance, which says the rows already overlap at spacing 0 -- yet
    # spacing 0 renders visible seams through every letter. Rendering a
    # ladder of values and looking at them is the honest method, and -2 at
    # 26pt is where the seams close while the letterforms stay intact.
    # -4 and beyond squash the A's crossbar into its bowl.
    local isp=$(( ps / 13 ))
    (( isp < 1 )) && isp=1
    # -kerning -1 closes the seam. The mono advance is a hair wider than
    # the ink of a █, so at this weight every letter is sliced by thin
    # vertical gaps at the character-cell boundaries -- invisible in a
    # mid-grey mock-up, obvious in cream on dark. -2 starts squashing the
    # A's counter, so -1 is the whole usable range.
    magick -background none -font "$MONO_FONT" -pointsize "$ps" \
      -interline-spacing "-$isp" -kerning -1 -fill "$FG" \
      label:@"$art" -trim +repage "${SRGB[@]}" "$tmp/title.png"
  fi

  # The name is drawn in the FOREGROUND colour, not the accent. The accent
  # now has exactly one job on this screen -- the progress arc -- and a
  # composition where the biggest element and the status indicator are the
  # same colour has nothing to direct the eye with.

  # ── ring ───────────────────────────────────────────────────────────
  # Plymouth's script language cannot draw an arc, so the ring is shipped
  # as frames. Two sequences, both on the same canvas so they overlay
  # exactly:
  #
  #   ring_prog_NN  the fill, growing clockwise from 12 o'clock
  #   spin_NN       a short comet sweeping round, which is what keeps
  #                 moving when plymouth reports no progress at all
  #
  # Sized from the SCREEN, not fixed at 96px. The previous ring was ~7% of
  # a 1366px screen and, photographed off the actual panel, read as a stray
  # dot rather than as a status light -- the comet was moving but there was
  # not enough arc for the motion to be legible. At 26% of screen height it
  # is a real element, which is also what lets the Arch mark live inside it
  # instead of needing its own slot in the stack.
  #
  # The stroke stays hairline-thin. A ring this size with the old 4px
  # stroke is a donut; the point is a drawn circle, not a gauge.
  local RS RC RR RW
  RS=$(( SCREEN_H * 26 / 100 ))
  (( RS < 96 )) && RS=96
  RW=$(( RS / 65 )); (( RW < 2 )) && RW=2
  RC=$(( RS / 2 ))
  RR=$(( RS / 2 - RW ))
  RING_CANVAS=$RS

  # ── Arch mark ──────────────────────────────────────────────────────
  # Sized against the RING, not the screen: it lives inside the ring, and
  # what matters is how much of that circle it fills. At 52% it read as
  # lost in the middle of the circle; 56% leaves a clear margin to the arc
  # while still making the mark the thing you see.
  local MARK_H=$(( RS * 56 / 100 ))
  if [[ -f "$ARCH_LOGO" ]]; then
    # Recoloured through the SVG's own alpha as a stencil rather than by
    # tinting its pixels: the logo is flat cyan, and -colorize or -fill on
    # a coloured raster leaves a halo at every antialiased edge.
    #
    # The connected-components pass drops the trademark glyph. It is a few
    # unreadable pixels off the logo's bottom-right that would sit inside
    # the ring as grit, and it is the only component in the artwork small
    # enough for an area threshold to isolate -- cropping cannot reach it
    # without also cutting the logo's feet.
    #
    # Rasterised at a fixed 512px and scaled down afterwards so that
    # threshold is a constant rather than something that has to track the
    # output size, and so the downscale does the antialiasing.
    #
    # -alpha copy before -alpha shape is load-bearing: connected-components
    # returns a bilevel image with NO alpha channel, and -alpha shape on an
    # image with no alpha silently yields nothing at all.
    magick -background none -density 600 "$ARCH_LOGO" -resize x512 "${SRGB[@]}" \
      -alpha extract \
      -define connected-components:area-threshold=400 \
      -define connected-components:mean-color=true \
      -connected-components 8 \
      -alpha copy -background "$FG" -alpha shape \
      -resize "x$MARK_H" \
      -channel A -evaluate multiply 0.92 +channel \
      -trim +repage "${SRGB[@]}" "$tmp/mark.png"
  else
    # No Arch logo on this machine (or not Arch at all). The ring still
    # works as a progress indicator with nothing in it, and a missing
    # optional asset must not take the boot screen down -- the script
    # unconditionally loads mark.png, so it has to exist.
    warn "no logo at $ARCH_LOGO — the ring will be empty"
    magick -size 1x1 xc:none "${SRGB[@]}" "$tmp/mark.png"
  fi

  # Track: the faint full circle the other two ride on.
  magick -size ${RS}x${RS} xc:none "${SRGB[@]}" -fill none \
    -stroke "$FG" -strokewidth $RW \
    -draw "ellipse $RC,$RC $RR,$RR 0,360" \
    "$tmp/ring_track.png"

  # Progress fill. 41 frames is 2.5% per step -- fine enough that the
  # growth looks continuous, coarse enough to stay small in the initramfs.
  PROG_FRAMES=41
  local i a
  for ((i = 0; i < PROG_FRAMES; i++)); do
    # -90 puts 0% at 12 o'clock; ImageMagick sweeps clockwise from there.
    a=$(( -90 + (360 * i) / (PROG_FRAMES - 1) ))
    if (( i == 0 )); then
      magick -size ${RS}x${RS} xc:none "${SRGB[@]}" "$tmp/ring_prog_$i.png"
    else
      magick -size ${RS}x${RS} xc:none "${SRGB[@]}" -fill none \
        -stroke "$ACCENT" -strokewidth $RW \
        -draw "stroke-linecap round ellipse $RC,$RC $RR,$RR -90,$a" \
        "$tmp/ring_prog_$i.png"
    fi
  done

  # Comet: a 46-degree arc with a bright head, rotated round the circle.
  # 48 frames = 7.5 degrees per step, which is smooth at the ~2.9s per
  # revolution the script plays it at.
  SPIN_FRAMES=48
  local s e hx hy rad
  for ((i = 0; i < SPIN_FRAMES; i++)); do
    s=$(( (360 * i) / SPIN_FRAMES - 90 ))
    e=$(( s + 46 ))
    # Head position, so the comet has a bright leading dot rather than
    # just stopping. bc is avoided: awk is already a dependency here.
    read -r hx hy <<<"$(awk -v a="$e" -v c="$RC" -v r="$RR" 'BEGIN{
      rad = a * 3.14159265 / 180
      printf "%d %d", c + r * cos(rad), c + r * sin(rad) }')"
    # The comet is drawn in the FOREGROUND colour, not the accent: the
    # progress fill is already accent, and two accent-coloured arcs on the
    # same circle are impossible to tell apart at a glance -- which defeats
    # the point of having both.
    magick -size ${RS}x${RS} xc:none "${SRGB[@]}" -fill none \
      -stroke "$FG" -strokewidth $RW \
      -draw "stroke-linecap round stroke-opacity 0.42 ellipse $RC,$RC $RR,$RR $s,$e" \
      -stroke none -fill "$FG" \
      -draw "circle $hx,$hy $hx,$(( hy - RW / 2 - 3 ))" \
      "$tmp/spin_$i.png"
  done

  # Substitute the colour floats into the script.
  read -r BR BG_ BB <<<"$(hex_to_float "$BG")"
  # FLAT background: top and bottom identical.
  #
  # There was a gradient here, lifted 7% at the top as a cheap vignette. It
  # read as "designed" in the wrong way -- the reference this is modelled on
  # is a flat dark field with one bright word on it, and every extra effect
  # moved it further from that.
  read -r TR TG TB <<<"$BR $BG_ $BB"
  read -r FR FG_ FB <<<"$(hex_to_float "$FG")"
  sed -e "s/BG_R/$BR/g" -e "s/BG_G/$BG_/g" -e "s/BG_B/$BB/g" \
      -e "s/FG_R/$FR/g" -e "s/FG_G/$FG_/g" -e "s/FG_B/$FB/g" \
      -e "s/SPIN_FRAMES/$SPIN_FRAMES/g" \
      -e "s/PROG_FRAMES/$PROG_FRAMES/g" \
      -e "s/BGTOP_R/$TR/g" -e "s/BGTOP_G/$TG/g" -e "s/BGTOP_B/$TB/g" \
      "$SRC_DIR/$THEME_NAME.script" > "$tmp/$THEME_NAME.script"

  # ── the frame BEFORE and AFTER plymouth ────────────────────────────
  # systemd-boot paints this the moment a boot entry is chosen, and it is
  # what reappears when plymouth's buffer is torn down at quit. Rendering
  # the SAME composition, from the SAME assets, is what turns three
  # separate screens into one continuous image.
  #
  # Progress index 0 and no comet: at the point this is on screen the
  # kernel has not started. Anything else would be an animation frozen
  # mid-stride, or a claim of progress that has not happened.
  #
  # BMP3 is not a stylistic choice -- systemd-boot reads uncompressed
  # 24-bit BMP and nothing else. The default BMP writer emits BMP4 with an
  # alpha mask, which it refuses.
  compose_still "$tmp" "$BG" 0 - 0.94 "$tmp/still.png"
  magick "$tmp/still.png" -alpha remove -alpha off -colorspace sRGB \
    -type TrueColor BMP3:"$tmp/boot-splash.bmp"
  sudo install -d -m755 "$BOOT_BMP_DIR"
  sudo install -m644 "$tmp/boot-splash.bmp" "$BOOT_BMP"

  sudo install -d -m755 "$THEME_DIR"
  # Remove every image first, including any the PREVIOUS design used.
  # Leftovers are not merely untidy: they get baked into the initramfs and
  # are then impossible to tell apart from the assets actually in use.
  # rule.png is one of these: the hairline the old design used is gone.
  sudo rm -f "$THEME_DIR"/*.png
  sudo install -m644 "$tmp/title.png"      "$THEME_DIR/title.png"
  sudo install -m644 "$tmp/mark.png"       "$THEME_DIR/mark.png"
  sudo install -m644 "$tmp/ring_track.png" "$THEME_DIR/ring_track.png"
  for ((i = 0; i < PROG_FRAMES; i++)); do
    sudo install -m644 "$tmp/ring_prog_$i.png" "$THEME_DIR/ring_prog_$i.png"
  done
  for ((i = 0; i < SPIN_FRAMES; i++)); do
    sudo install -m644 "$tmp/spin_$i.png" "$THEME_DIR/spin_$i.png"
  done
  # The script and the theme descriptor. Omitting these once left the theme
  # directory holding NEW images and the OLD script -- which indexes frame
  # numbers that no longer exist, i.e. a black screen at boot. That is
  # exactly what `boot-splash check` compares, and it caught it.
  sudo install -m644 "$tmp/$THEME_NAME.script"       "$THEME_DIR/$THEME_NAME.script"
  sudo install -m644 "$SRC_DIR/$THEME_NAME.plymouth" "$THEME_DIR/$THEME_NAME.plymouth"
  ok "theme installed to $THEME_DIR (${SPIN_FRAMES} spin + ${PROG_FRAMES} progress frames)"
  ok "static boot frame: $BOOT_BMP (${SCREEN_W}x${SCREEN_H})"

  # The theme lives INSIDE the initramfs -- plymouth runs before / is
  # mounted, so it cannot read /usr/share at boot. Regenerating here
  # therefore does not change what you actually see until mkinitcpio runs
  # again, and mkinitcpio takes about a minute: far too slow to run on
  # every theme switch, which is exactly when this is called.
  #
  # So: record what was generated, and report the mismatch rather than
  # either lying about it or burning a minute of CPU unasked.
  if grep -q '^HOOKS=.*plymouth' "$MKINITCPIO" 2>/dev/null; then
    local want="$USER|$BG|$FG|$ACCENT"
    local have; have="$(sudo cat "$STAMP" 2>/dev/null || echo '')"
    if [[ "$want" != "$have" ]]; then
      warn "the initramfs still has the previous splash — run: boot-splash sync"
      SPLASH_DIRTY=1
    fi
  fi
}

# ── the UKI splash section ──────────────────────────────────────────
# Point every mkinitcpio preset that builds a Unified Kernel Image at our
# static BMP instead of Arch's.
#
# This is the fix for the distro logo that bracketed the splash on both
# sides. Arch's linux.preset ships:
#
#   default_options="--splash /usr/share/systemd/bootctl/splash-arch.bmp"
#
# which bakes that bitmap into the UKI as a PE .splash section.
# systemd-boot draws it when the entry is picked, plymouth draws over it,
# and when plymouth quits its buffer is released and the bitmap shows
# through again until getty clears the console. Replacing the file it
# points at fixes both ends with one edit.
#
# Presets are pacman-owned, so this is an in-place sed with a backup, the
# same handling .config/arch-config/boot/linux-lts.preset documents for
# the fallback edit. A pacman upgrade of the linux package will restore
# Arch's line; `boot-splash sync` puts it back, and `status` reports it.
#
# Idempotent: safe to call from both enable and sync.
patch_uki_splash() {
  [[ -f "$BOOT_BMP" ]] || { warn "no $BOOT_BMP yet — run: boot-splash generate"; return 0; }
  [[ -d "$PRESET_DIR" ]] || { say "no $PRESET_DIR — not a mkinitcpio-preset system"; return 0; }

  local p changed=0
  for p in "$PRESET_DIR"/*.preset; do
    [[ -f "$p" ]] || continue
    # Only presets that actually build a UKI have a splash to set. A
    # preset producing a plain initramfs image ignores --splash entirely,
    # and adding it there would be noise in a pacman-owned file.
    sudo grep -qE '^[[:space:]]*[a-z_]+_uki=' "$p" || continue
    sudo grep -q -- "--splash $BOOT_BMP" "$p" && continue

    sudo cp -n "$p" "$p.bak-boot-splash" 2>/dev/null || true
    # Rewrite an existing --splash argument in place, whether or not the
    # line is commented out. Matching the path loosely (non-space run)
    # rather than Arch's exact filename means a preset already pointing
    # somewhere else is still corrected.
    sudo sed -i -E "s|--splash[[:space:]]+[^\"[:space:]]+|--splash $BOOT_BMP|g" "$p"

    # No --splash at all: add one to the UKI preset's options line, or
    # create that line if the preset does not have one.
    if ! sudo grep -q -- '--splash' "$p"; then
      if sudo grep -qE '^[[:space:]]*default_options=' "$p"; then
        sudo sed -i -E "s|^([[:space:]]*default_options=\")|\\1--splash $BOOT_BMP |" "$p"
      else
        printf 'default_options="--splash %s"\n' "$BOOT_BMP" | sudo tee -a "$p" >/dev/null
      fi
    fi
    if sudo grep -q -- "--splash $BOOT_BMP" "$p"; then
      ok "$(basename "$p") now boots our splash bitmap"
      changed=1
    else
      warn "could not set --splash in $p — check it by hand"
    fi
  done
  (( changed )) || say "UKI presets already point at $BOOT_BMP"
}

# ── preview ─────────────────────────────────────────────────────────
# Composites the REAL installed theme assets at THIS screen's resolution
# and opens the result. Not a mock-up of the design -- the same title.png,
# progress_box.png and progress_bar.png plymouth will use, laid out by the
# same rules dotfiles.script applies.
#
# Why not just run plymouthd: plymouth draws to the DRM console, and X owns
# the display while you are looking at it. Running plymouthd from a desktop
# session shows nothing at all -- which is exactly what happens if you try,
# and looks like the theme is broken when it is fine.
#
# `--real` does run it, on a spare VT, for when you want the actual thing.
do_preview() {
  need magick
  [[ -d "$THEME_DIR" ]] || die "theme not generated yet — run: boot-splash generate"

  if [[ "${2:-}" == "--real" || "${1:-}" == "--real" ]]; then
    need plymouthd
    warn "this switches to VT 3 and takes over the screen for ~8s."
    warn "it returns to VT 1 automatically; if it does not, press Ctrl+Alt+F1."
    read -rp "continue? [y/N] " a; [[ "$a" == [yY] ]] || { say "cancelled"; return 0; }
    sudo plymouth-set-default-theme "$THEME_NAME" >/dev/null 2>&1 || true
    sudo chvt 3
    sudo plymouthd --tty=/dev/tty3 >/dev/null 2>&1 || true
    sudo plymouth show-splash >/dev/null 2>&1 || true
    local i=0
    while (( i < 8 )); do
      sudo plymouth system-update --progress=$(( i * 12 )) >/dev/null 2>&1 || true
      sleep 0.8; i=$((i+1))
    done
    sudo plymouth quit >/dev/null 2>&1 || true
    sudo chvt 1
    ok "real preview done"
    return 0
  fi

  # Same geometry the BMP was rendered at, so the preview is the size the
  # boot screen will actually be.
  screen_geometry
  read_palette
  local out="${TMPDIR:-/tmp}/boot-splash-preview.gif"
  local tmp; tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN

  # An ANIMATED preview, because the splash is animated and a still frame
  # cannot show whether the motion is right. Frames go through the same
  # compose_still the static BMP uses and reuse the script's arithmetic --
  # breathing sine, comet index, progress drift -- so what you are looking
  # at is the layout and timing plymouth will produce, not an artist's
  # impression.
  local nspin=0 nprog=0
  while [[ -f "$THEME_DIR/spin_$nspin.png" ]]; do nspin=$((nspin+1)); done
  while [[ -f "$THEME_DIR/ring_prog_$nprog.png" ]]; do nprog=$((nprog+1)); done
  (( nspin > 0 && nprog > 0 )) || die "ring frames missing — run: boot-splash generate"

  # Frame 0 is the static BMP, held for a beat, so the preview shows the
  # handover this design is built around: the picture systemd-boot paints,
  # then plymouth continuing it without a seam. If frame 0 and frame 1 do
  # not line up here, they will not line up at boot either.
  local frames=60 f
  cp "$BOOT_BMP" "$tmp/_bmp.bmp" 2>/dev/null \
    && magick "$tmp/_bmp.bmp" -colorspace sRGB "$tmp/frame_000.png" \
    || compose_still "$THEME_DIR" "$BG" 0 - 0.94 "$tmp/frame_000.png"

  for ((f = 1; f < frames; f++)); do
    # ~4 ticks per preview frame at 50fps, so the GIF covers roughly the
    # five seconds the splash is really on screen rather than a minute of
    # motion nobody will ever witness.
    local tick=$(( f * 4 ))
    local top shown pidx sidx
    top="$(awk -v t="$tick" 'BEGIN{ printf "%.3f", 0.94 + 0.06*sin(t/45) }')"
    shown="$(awk -v t="$tick" 'BEGIN{
      d=t/700; if(d>0.75)d=0.75; p=t/1400; if(p>1)p=1; s=(p>d)?p:d; printf "%.4f", s }')"
    pidx="$(awk -v s="$shown" -v n="$nprog" 'BEGIN{ i=int(s*(n-1)); if(i<0)i=0; if(i>n-1)i=n-1; print i }')"
    sidx=$(( (tick / 3) % nspin ))
    compose_still "$THEME_DIR" "$BG" "$pidx" "$sidx" "$top" \
      "$tmp/frame_$(printf '%03d' "$f").png"
  done

  magick -delay 7 -loop 0 "$tmp"/frame_*.png -colorspace sRGB -layers optimize "$out"

  ok "animated preview rendered at ${SCREEN_W}x${SCREEN_H}, ${frames} frames: $out"
  if command -v imv >/dev/null 2>&1; then
    setsid imv "$out" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then
    setsid xdg-open "$out" >/dev/null 2>&1 &
  else
    say "open it with any image viewer"
  fi
  say "this is composited from the installed theme assets, not a mock-up"
  say "for the real thing on a spare VT: boot-splash preview --real"
}

# ── pre-flight check ────────────────────────────────────────────────
# Everything that can be verified WITHOUT rebooting. Run before enable.
do_check() {
  local fail=0 st esp themes ob cb

  # `st=0; <test> || st=1` rather than a bare `[[ ... ]]` on its own line:
  # under `set -e` a bare failing test aborts the script, so the FIRST
  # failing check would end the run and hide every check after it. A
  # pre-flight that stops at the first problem is the opposite of useful.
  _c() {
    if [[ "$1" == 0 ]]; then
      printf '  %s✓%s %s\n' "$g" "$o" "$2"
    else
      printf '  %s✗%s %s\n' "$r" "$o" "$2"; fail=1
    fi
  }

  st=0; pacman -Qq plymouth >/dev/null 2>&1 || st=1
  _c $st "plymouth installed"

  st=0; [[ -f "$THEME_DIR/$THEME_NAME.script" ]] || st=1
  _c $st "theme script installed"

  st=0; [[ -s "$THEME_DIR/title.png" ]] || st=1
  _c $st "title image rendered and non-empty"

  # A leftover placeholder means the colour substitution silently failed,
  # and plymouth cannot parse the script at boot -- a black screen.
  st=0; grep -qE '\b(BG_R|BG_G|BG_B|BGTOP_R|BGTOP_G|BGTOP_B|FG_R|FG_G|FG_B|SPIN_FRAMES|PROG_FRAMES)\b' \
        "$THEME_DIR/$THEME_NAME.script" 2>/dev/null && st=1
  _c $st "colour + frame-count placeholders substituted"

  # Balanced braces is a cheap proxy for "plymouth can parse this"; its
  # script language has no offline syntax checker.
  ob="$(tr -cd '{' < "$THEME_DIR/$THEME_NAME.script" 2>/dev/null | wc -c || echo 0)"
  cb="$(tr -cd '}' < "$THEME_DIR/$THEME_NAME.script" 2>/dev/null | wc -c || echo 0)"
  st=0; [[ "$ob" == "$cb" && "$ob" != 0 ]] || st=1
  _c $st "theme script braces balanced ($ob/$cb)"

  # Captured, not piped into grep -q: under `set -o pipefail`, grep exiting
  # early on a match closes the pipe and the producer dies with SIGPIPE,
  # aborting the run at the first PASSING test.
  themes="$(plymouth-set-default-theme --list 2>/dev/null || true)"
  st=0; grep -qx "$THEME_NAME" <<<"$themes" || st=1
  _c $st "plymouth recognises the theme"

  st=0; grep -q '^HOOKS=.*\budev\b' "$MKINITCPIO" || st=1
  _c $st "mkinitcpio has a udev hook to anchor to"

  # The script loops over exactly these counts and indexes the arrays, so a
  # missing frame is not a cosmetic problem -- it is a black screen at boot.
  local declared_spin declared_prog n
  declared_spin="$(sed -n 's/^spin_frames = \([0-9]*\);/\1/p' "$THEME_DIR/$THEME_NAME.script" 2>/dev/null)"
  declared_prog="$(sed -n 's/^prog_frames = \([0-9]*\);/\1/p' "$THEME_DIR/$THEME_NAME.script" 2>/dev/null)"
  n=0; while [[ -f "$THEME_DIR/spin_$n.png" ]]; do n=$((n+1)); done
  st=0; [[ -n "$declared_spin" && "$n" == "$declared_spin" ]] || st=1
  _c $st "spin frames present (${n}/${declared_spin:-?})"
  n=0; while [[ -f "$THEME_DIR/ring_prog_$n.png" ]]; do n=$((n+1)); done
  st=0; [[ -n "$declared_prog" && "$n" == "$declared_prog" ]] || st=1
  _c $st "progress frames present (${n}/${declared_prog:-?})"

  st=0; [[ -s "$THEME_DIR/ring_track.png" && -s "$THEME_DIR/mark.png" ]] || st=1
  _c $st "ring track + centre mark present"

  # The static frame systemd-boot shows before the kernel starts. Checked
  # for FORMAT, not just existence: systemd-boot reads uncompressed 24-bit
  # BMP and silently draws nothing for anything else, which would look
  # exactly like the theme being broken.
  st=0; [[ -s "$BOOT_BMP" ]] || st=1
  _c $st "static boot frame rendered ($BOOT_BMP)"
  if [[ "$st" == 0 ]]; then
    st=0
    [[ "$(magick identify -format '%m %[bit-depth]' "$BOOT_BMP" 2>/dev/null)" == "BMP3 8" ]] || st=1
    _c $st "boot frame is uncompressed 24-bit BMP3 ($(magick identify -format '%m %wx%h' "$BOOT_BMP" 2>/dev/null || echo unreadable))"
  fi

  # If a UKI preset still points at the distro bitmap, the Arch logo will
  # bookend the splash however good the theme is.
  if [[ -d "$PRESET_DIR" ]]; then
    local stale=0 p
    for p in "$PRESET_DIR"/*.preset; do
      [[ -f "$p" ]] || continue
      sudo grep -qE '^[[:space:]]*[a-z_]+_uki=' "$p" || continue
      sudo grep -q -- "--splash $BOOT_BMP" "$p" || stale=1
    done
    _c $stale "UKI presets point at our boot frame, not the distro logo"
  fi

  st=0; sudo test -d /boot || st=1
  _c $st "/boot present"

  # The recovery path. Without a verbose fallback entry, a splash that
  # hangs leaves nothing to boot into that shows why.
  esp="$(sudo bootctl --print-esp-path 2>/dev/null || echo /boot)"
  st=0; sudo test -f "$esp/loader/entries/arch-lts.conf" || st=1
  _c $st "verbose LTS fallback entry exists (recovery path)"
  if [[ "$st" == 0 ]]; then
    st=0
    sudo grep -qE '^options .*(quiet|splash)' "$esp/loader/entries/arch-lts.conf" && st=1
    _c $st "fallback entry is NOT splashed"
  fi

  st=0; sudo test -f "$esp/vmlinuz-linux-lts" || st=1
  _c $st "LTS kernel present on the ESP"

  echo
  if (( fail )); then
    printf '%s✗ not safe to enable — fix the above%s\n' "$r" "$o"
    return 1
  fi
  printf '%s✓ all pre-flight checks passed%s\n' "$g" "$o"
  printf '%sremaining risk: plymouth cannot be fully proven without a reboot.%s\n' "$d" "$o"
  printf '%sIf the splash misbehaves, pick the LTS entry at the menu -- it stays verbose.%s\n' "$d" "$o"
}

# ── enable / disable ────────────────────────────────────────────────
do_enable() {
  need mkinitcpio
  pacman -Qq plymouth >/dev/null 2>&1 || die "plymouth not installed (modules/splash.yaml)"
  do_generate
  # Before the check, not after: one of the checks is "the UKI presets point
  # at our boot frame", and doing this afterwards would make enable refuse
  # to run on the very condition it exists to create.
  patch_uki_splash
  # Refuse rather than half-apply: a failed check here means a black screen
  # at boot, and the cost of finding out then is a machine you cannot see.
  do_check || die "pre-flight checks failed — nothing has been changed"

  # 1. mkinitcpio hook. Must sit directly after `udev` (or `systemd`):
  #    plymouth needs the device manager running to find the framebuffer,
  #    and must come before `autodetect` trims modules it depends on.
  local hooks
  hooks="$(grep '^HOOKS=' "$MKINITCPIO")"
  if grep -q 'plymouth' <<<"$hooks"; then
    say "plymouth hook already present"
  else
    sudo cp "$MKINITCPIO" "$MKINITCPIO.bak-boot-splash"
    sudo sed -i 's/^\(HOOKS=([^)]*\)\budev\b/\1udev plymouth/' "$MKINITCPIO"
    grep '^HOOKS=' "$MKINITCPIO" | grep -q plymouth \
      || die "could not add the plymouth hook — restore $MKINITCPIO.bak-boot-splash"
    ok "plymouth hook added (backup: $MKINITCPIO.bak-boot-splash)"
  fi

  # 2. Kernel cmdline. `quiet` silences the log, `splash` tells plymouth to
  #    draw. Without BOTH you get either a splash fighting kernel text, or
  #    silence with no splash at all.
  if [[ -f "$KCMDLINE" ]]; then
    local cur; cur="$(sudo cat "$KCMDLINE")"
    local add=""
    grep -qw quiet  <<<"$cur" || add+=" quiet"
    grep -qw splash <<<"$cur" || add+=" splash"
    if [[ -n "$add" ]]; then
      sudo cp "$KCMDLINE" "$KCMDLINE.bak-boot-splash"
      printf '%s%s\n' "$cur" "$add" | sudo tee "$KCMDLINE" >/dev/null
      ok "cmdline now:$(printf '%s' " $(sudo cat "$KCMDLINE")")"
    else
      say "cmdline already has quiet + splash"
    fi
  else
    warn "$KCMDLINE not found — this system may not build a UKI."
    warn "Add 'quiet splash' to your bootloader's options line by hand."
  fi

  sudo plymouth-set-default-theme "$THEME_NAME"

  # 3. Rebuild. -P does every preset, which includes the UKI.
  say "rebuilding initramfs (this takes a minute)"
  sudo mkinitcpio -P || die "mkinitcpio failed — splash NOT active, nothing to recover"
  write_stamp

  ok "enabled. The LTS entries stay verbose on purpose:"
  ok "if a splashed boot ever hangs, pick 'Arch Linux (LTS fallback)' to see why."
}

do_disable() {
  say "reversing"
  if [[ -f "$MKINITCPIO.bak-boot-splash" ]]; then
    sudo mv "$MKINITCPIO.bak-boot-splash" "$MKINITCPIO"
    ok "mkinitcpio.conf restored"
  else
    sudo sed -i 's/^\(HOOKS=([^)]*\)[[:space:]]*\bplymouth\b/\1/' "$MKINITCPIO"
    ok "plymouth hook removed"
  fi
  if [[ -f "$KCMDLINE.bak-boot-splash" ]]; then
    sudo mv "$KCMDLINE.bak-boot-splash" "$KCMDLINE"
    ok "kernel cmdline restored"
  elif [[ -f "$KCMDLINE" ]]; then
    sudo sed -i 's/[[:space:]]*\bquiet\b//g; s/[[:space:]]*\bsplash\b//g' "$KCMDLINE"
    ok "quiet/splash removed from cmdline"
  fi
  # Restore the preset backups, so the UKI goes back to whatever splash the
  # distro shipped. Leaving our bitmap baked in would mean `disable` still
  # left a boot screen on the machine.
  local p
  for p in "$PRESET_DIR"/*.preset.bak-boot-splash; do
    [[ -f "$p" ]] || continue
    sudo mv "$p" "${p%.bak-boot-splash}"
    ok "$(basename "${p%.bak-boot-splash}") restored"
  done
  say "rebuilding initramfs"
  sudo mkinitcpio -P || warn "mkinitcpio failed — check before rebooting"
  ok "disabled"
}

write_stamp() {
  read_palette
  printf '%s|%s|%s|%s\n' "$USER" "$BG" "$FG" "$ACCENT" | sudo tee "$STAMP" >/dev/null
}

# Push the current theme into the initramfs. Separate from `generate`
# because it is the slow half, and because rebuilding the initramfs is not
# something a colour change should do behind your back.
do_sync() {
  grep -q '^HOOKS=.*plymouth' "$MKINITCPIO" 2>/dev/null \
    || die "splash is not enabled — nothing to sync (see: boot-splash enable)"
  do_generate
  # Re-asserted on every sync, not just at enable: a pacman upgrade of the
  # linux package restores Arch's preset and with it Arch's splash bitmap.
  patch_uki_splash
  say "rebuilding initramfs so the boot screen matches the current theme"
  sudo mkinitcpio -P || die "mkinitcpio failed"
  write_stamp
  ok "initramfs now carries the current splash"
}

do_status() {
  printf 'plymouth pkg : %s\n' "$(pacman -Qq plymouth 2>/dev/null || echo 'not installed')"
  printf 'theme dir    : %s\n' "$( [[ -d "$THEME_DIR" ]] && echo "$THEME_DIR" || echo 'not generated' )"
  printf 'default theme: %s\n' "$(plymouth-set-default-theme 2>/dev/null || echo '-')"
  printf 'mkinitcpio   : %s\n' "$(grep '^HOOKS=' "$MKINITCPIO" | grep -q plymouth && echo 'plymouth hook present' || echo 'no plymouth hook')"
  printf 'cmdline      : %s\n' "$(sudo cat "$KCMDLINE" 2>/dev/null || cat /proc/cmdline)"
  # The frame before and after plymouth. Reported separately from the theme
  # because it can go stale on its own: a pacman upgrade of the linux
  # package restores Arch's preset and the distro logo comes back.
  printf 'boot frame   : %s\n' \
    "$( [[ -s "$BOOT_BMP" ]] && magick identify -format '%m %wx%h' "$BOOT_BMP" 2>/dev/null || echo 'not rendered' )"
  local p stale=0 seen=0
  for p in "$PRESET_DIR"/*.preset; do
    [[ -f "$p" ]] || continue
    sudo grep -qE '^[[:space:]]*[a-z_]+_uki=' "$p" || continue
    seen=1
    sudo grep -q -- "--splash $BOOT_BMP" "$p" || stale=1
  done
  if (( ! seen )); then
    printf 'uki splash   : %s\n' 'no UKI presets on this system'
  elif (( stale )); then
    printf 'uki splash   : %sdistro logo still baked in — run: boot-splash sync%s\n' "$y" "$o"
  else
    printf 'uki splash   : %sours%s\n' "$g" "$o"
  fi
  read_palette
  local want="$USER|$BG|$FG|$ACCENT" have
  have="$(sudo cat "$STAMP" 2>/dev/null || echo '(never synced)')"
  printf 'in initramfs : %s\n' "$have"
  printf 'current theme: %s\n' "$want"
  if [[ "$want" == "$have" ]]; then
    printf 'sync         : %sup to date%s\n' "$g" "$o"
  else
    printf 'sync         : %sout of date — run: boot-splash sync%s\n' "$y" "$o"
  fi
}

case "${1:-status}" in
  generate) do_generate ;;
  preview)  do_preview "$@" ;;
  check)    do_check ;;
  sync)     do_sync ;;
  enable)   do_enable ;;
  disable)  do_disable ;;
  status)   do_status ;;
  --help|-h) sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '${1}' (generate|preview|check|sync|enable|disable|status)" ;;
esac
