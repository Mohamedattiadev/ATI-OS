#!/usr/bin/env bash
# ati-run-in-terminal <cmd> — thin CLI wrapper around ati-rofi-common.sh's
# run_in_terminal(), for callers that can only spawn a plain shell command
# rather than source a bash function. Exists specifically for ati-menu.json
# action strings: Omarchy's own Menu.qml runs `action` via
# `Quickshell.execDetached(["bash","-lc", action])` (Util.qml, unmodified
# here), a fire-and-forget background exec with nowhere for a sudo prompt or
# install output to go — same reasoning that made this repo's own rofi
# picker route "terminal": true entries through run_in_terminal instead of
# backgrounding them directly.
set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/../lib/ati-rofi-common.sh"

[[ $# -ge 1 ]] || { echo "usage: ati-run-in-terminal <cmd>" >&2; exit 2; }

run_in_terminal --class docs-view --title "ati-menu" -e bash -c \
  "$1; ec=\$?; echo; read -rp 'press enter to close (exit '\"\$ec\"')' _"
