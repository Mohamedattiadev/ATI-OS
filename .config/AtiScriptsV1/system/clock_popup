#!/bin/bash

# -----------------------------------------------------------------------------
# CONFIGURATION (user-based ATITODOS directory)
# -----------------------------------------------------------------------------

# Username → uppercase (ati → ATI)
USER_NAME="$(whoami | tr '[:lower:]' '[:upper:]')"

# Folder → ATITODOS, SUSUTODOS, etc.
TODOS_DIR="$HOME/${USER_NAME}TODOS"

# Same single store rofi_todo uses. This read todos.md while rofi_todo
# has moved to the Simplenote-synced TODOS.md; left alone it would have
# gone permanently blank once rofi_todo retired the old file.
TODO_FILE="$TODOS_DIR/TODOS.md"

# Create directory & file if missing
mkdir -p "$TODOS_DIR"
touch "$TODO_FILE"

# -----------------------------------------------------------------------------
# DATE INFO
# -----------------------------------------------------------------------------

today=$(date "+%Y-%m-%d")
header=$(date "+%A, %d %B %Y")

process_tasks() {
  mode="$1"
  awk -v mode="$mode" '
        # Function: deterministic color based on tag name
        function tag_color(tag,   sum, i, c, r, g, b) {
            sum = 0
            for (i=1; i<=length(tag); i++) {
                c = ord(substr(tag,i,1))
                sum += c * i
            }
            r = (sum * 53) % 256
            g = (sum * 97) % 256
            b = (sum * 193) % 256
            return sprintf("#%02X%02X%02X", r, g, b)
        }
        # Function: get ASCII code of character
        function ord(c) { return sprintf("%d", index("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", c)) }
        {
            prio = 2
            line = $0
            color = ""
            if (match(line, /@Color\([^)]+\)/)) {
                color_tag = substr(line, RSTART, RLENGTH)
                sub(/@Color\([^)]+\)/, "", line)
                color = color_tag
                gsub(/@Color\(|\)/, "", color)
            }
            if (sub(/@Prio\(high\)/, "(High)", line)) { prio = 1 }
            else if (sub(/@Prio\(low\)/, "(Low)", line)) { prio = 3 }
            else if (sub(/@Prio\(normal\)/, "(Normal)", line)) { prio = 2 }
            
            tag_html = ""
            while (match(line, /@Tag\([^)]+\)/)) {
                full_tag = substr(line, RSTART, RLENGTH)
                tag_name = full_tag
                gsub(/@Tag\(|\)/,"",tag_name)
                tag_html = tag_html "<span foreground=\"" tag_color(tag_name) "\">#" tag_name "</span> "
                line = substr(line,1,RSTART-1) substr(line,RSTART+RLENGTH)
            }
            sub(/- \[.?\] */, "", line)
            sub(/ *@([0-9]{4}-[0-9]{2}-[0-9]{2}).*/, "", line)
            gsub(/^[ \t]+|[ \t]+$/, "", line)
            box = (mode=="done") ? "  - [x] " : "  - [  ] "
            final_line = box line " " tag_html
            if (color != "") { final_line = "<span foreground=\"" color "\">" final_line "</span>" }
            print prio "|" final_line
        }' | sort -n | cut -d'|' -f2-
}

highlight_priority() {
  sed -e 's/(High)/<span foreground=\"#FF6B6B\">(High)<\/span>/g' \
    -e 's/(Low)/<span foreground=\"#FFD580\">(Low)<\/span>/g' \
    -e 's/(Normal)/<span foreground=\"#ffffff\">(Normal)<\/span>/g'
}

due_today=$(grep "\[ \].*@${today}" "$TODO_FILE" | process_tasks "undone" | highlight_priority)
done_today=$(grep "\[x\].*@${today}" "$TODO_FILE" | process_tasks "done" | highlight_priority)
general=$(awk -v d="$today" '/- \[ \] .*@([0-9]{4}-[0-9]{2}-[0-9]{2})/ { match($0, /@([0-9]{4}-[0-9]{2}-[0-9]{2})/, a); if (a[1] < d) print $0; }' "$TODO_FILE" | process_tasks | shuf | head -n 4 | highlight_priority)

future=$(
  awk -v d="$today" '/- \[ \] .*@([0-9]{4}-[0-9]{2}-[0-9]{2})/ {match($0, /@([0-9]{4}-[0-9]{2}-[0-9]{2})/, a);if (a[1] > d) print $0;}' "$TODO_FILE" | process_tasks | shuf | head -n 4 | highlight_priority
)

[ -z "$due_today" ] && due_today="<i>  (No tasks due today)</i>"
[ -z "$done_today" ] && done_today="<i>  (No tasks completed today)</i>"
[ -z "$general" ] && general="<i>  (No overdue tasks)</i>"
[ -z "$future" ] && future="<i>(No future tasks)</i>"

# Palette from theme-apply's dump so the popup tracks the active mode.
# The old version hardcoded #ffffff/#c678dd/#70D78F/#FF6B6B/#98c379 and
# stayed doom-one coloured under every other theme.
read -r P_FG P_MUTED P_GREEN P_RED P_YELLOW P_BLUE <<<"$(
python3 <<'PY' 2>/dev/null
import json, os
try:
    d = json.load(open(os.path.expanduser("~/.cache/qtile/current_palette.json")))
    def mix(a, b, t=0.45):
        pa = [int(a[i:i+2], 16) for i in (1, 3, 5)]
        pb = [int(b[i:i+2], 16) for i in (1, 3, 5)]
        return "#{:02x}{:02x}{:02x}".format(*(round(x + (y - x) * t) for x, y in zip(pa, pb)))
    print(d["fg"], mix(d["bg"], d["fg"]), d["green"], d["red"], d["yellow"], d["blue"])
except Exception:
    print("#bbc2cf", "#5b6268", "#98be65", "#ff6c6b", "#ecbe7b", "#51afef")
PY
)"
[[ -n "${P_BLUE:-}" ]] || read -r P_FG P_MUTED P_GREEN P_RED P_YELLOW P_BLUE \
  <<<"#bbc2cf #5b6268 #98be65 #ff6c6b #ecbe7b #51afef"

# Sections are separated by blank lines rather than rows of dashes. A
# fixed-width dash rule cannot work here: dunst's UI font is proportional
# and the popup width is a range (260-340), so the old
# "-----------------" either overflowed and wrapped onto a second line or
# fell short of the edge. Whitespace reads just as clearly and cannot
# wrap. Only section headers are bold now -- previously every line was
# wrapped in <b>, so nothing stood out from anything else.
notify-send -u low -h string:markup:1 -t 40000 \
  -h string:x-dunst-stack-tag:plantoday \
  "Today's plan" \
  "<span foreground='${P_MUTED}'>$header</span>

<b><span foreground='${P_BLUE}'>🗓  Due today</span></b>
<span foreground='${P_FG}'>$due_today</span>

<b><span foreground='${P_GREEN}'>✅  Done today</span></b>
<span foreground='${P_FG}'>$done_today</span>

<b><span foreground='${P_RED}'>📝  Past due</span></b>
<span foreground='${P_FG}'>$general</span>

<b><span foreground='${P_YELLOW}'>⏳  Upcoming</span></b>
<span foreground='${P_FG}'>$future</span>"
