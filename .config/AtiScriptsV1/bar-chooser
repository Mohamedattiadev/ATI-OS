#!/usr/bin/env bash
# bar-chooser — "which shape do you want", in rofi.
#
# The ROFI half of the bar chooser. The island half is island-picker.py's
# `bars` menu, and `ati-bar-action tide showPicker bars` picks between them by the
# current mode — so one key gives you the chooser in whichever shell is up.
#
# Three shapes: the capsule/panel shell (Island), the redesign's own 28 px
# top chip layout (Relic, qtile-STYLED), and shell.qml, the actual
# qtile-faithful Quickshell port (Frindo — "keep it, i love it", see
# topbar.sh's header). The redesign's 40 px bottom "normal user" layout
# (was "Nova") is no longer offered here on request; the QML itself is
# untouched, it is just not a picker row any more.
#
# Everything goes through bar-switch and the topbar's IPC rather than writing
# ~/.cache/bar-mode directly. bar-switch owns the one rule that must not go
# wrong — no path may leave the session without a bar — and a second writer of
# that state would be a second owner of it.

set -euo pipefail

STATE_FILE="$HOME/.cache/bar-mode"
POS_FILE="$HOME/.cache/topbar-position"
IMPL_FILE="$HOME/.cache/topbar-impl"

read_or() { [[ -r "$1" ]] && tr -d '[:space:]' < "$1" || printf '%s' "$2"; }

mode="$(read_or "$STATE_FILE" island)"
impl="$(read_or "$IMPL_FILE" redesign)"
[[ "$mode" == native ]] || mode=island

mark() { [[ "$1" == yes ]] && printf '   ✓' || true; }

# The rows carry their marker in the label because rofi -dmenu has no detail
# column; the island's version puts it in `detail` instead. Same information,
# each in the form its own menu can show.
#
# No position word in any label. "Island" is the capsule/panel shell.
# "Relic" is the redesign's own 28 px top chip layout (qtile-STYLED, not
# qtile itself -- it held the "Qtile" name briefly before the real one
# came back, per direct correction, and "Frindo" is that real one's name
# now). "Frindo" is shell.qml, the genuinely qtile-faithful port. Labels
# only where Relic is concerned: bar-mode/topbar-position keep meaning
# what they always did. Frindo additionally needs topbar-impl=legacy,
# which is new state -- see topbar.sh and bar-switch's topbar_entry() for
# the other end of it.
rows="$(printf '%s\n%s\n%s' \
  "Island$(mark "$([[ $mode == island ]] && echo yes)")" \
  "Relic$(mark "$([[ $mode == native && $impl != legacy ]] && echo yes)")" \
  "Frindo$(mark "$([[ $mode == native && $impl == legacy ]] && echo yes)")")"

if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v ati-menu-select >/dev/null 2>&1; then
  pick="$(printf '%s' "$rows" | ati-menu-select --mode select --prompt "Which bar?")" || exit 0
else
  pick="$(printf '%s' "$rows" | rofi -dmenu -i -p "Which bar?" \
          -theme-str 'window {width: 30%;}' 2>/dev/null)" || exit 0
fi
[[ -n "$pick" ]] || exit 0

case "$pick" in
  Island*) setsid -f bar-switch island >/dev/null 2>&1 ;;
  Relic*)
    # Impl and position FIRST, so the bar comes up already in the requested
    # shape rather than appearing and then moving/swapping. The IPC is a
    # no-op while the topbar is down, which is exactly when the file writes
    # are what count. Position is always "top" now that Nova (bottom) is
    # not a row any more.
    printf '%s\n' redesign > "$IMPL_FILE"
    printf '%s\n' top > "$POS_FILE"
    # qsipc if it is installed (same argv shape as qs -- see its own
    # header), qs otherwise.
    ipc_bin=qs
    command -v qsipc >/dev/null 2>&1 && ipc_bin=qsipc
    "$ipc_bin" -p "$HOME/.config/quickshell/topbar" ipc call topbar top >/dev/null 2>&1 || true
    setsid -f bar-switch native >/dev/null 2>&1
    ;;
  Frindo*)
    # No position write: shell.qml reads the same topbar-position file and
    # answers the same `topbar top/bottom/toggle` IPC contract Relic does
    # (same `target: "topbar"` IpcHandler, see its own header), so whatever
    # position was last set carries over rather than being forced.
    printf '%s\n' legacy > "$IMPL_FILE"
    setsid -f bar-switch native >/dev/null 2>&1
    ;;
esac
