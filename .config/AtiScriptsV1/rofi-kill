#!/usr/bin/env bash
# Rofi process killer. Palette follows wallpaper via rofi_common.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=rofi_common.sh
source "$SCRIPT_DIR/rofi_common.sh"

require_cmd rofi ps awk || exit 1
load_palette

ROFI_THEME="$HOME/.config/rofi/themes/kill-large.rasi"
STATE_FILE="/tmp/rofi-kill-sort-mode"
ROW_STATE_FILE="/tmp/rofi-kill-selected-row"

SORT_MODE="${1:-$(cat "$STATE_FILE" 2>/dev/null || echo 'mem_desc')}"
LAST_ROW="${2:-$(cat "$ROW_STATE_FILE" 2>/dev/null || echo 0)}"

# Noise procs. Regex anchored on comm (widened to 32 chars via ps -o).
EXCLUDE='^(bash|zsh|sh|fish|rofi|Xorg|gnome-shell|systemd|systemd-.*|ps|awk|sed|dbus.*|kwin.*|plasmashell|pipewire.*|wireplumber|gpg-agent|ibus.*|xdg-.*|at-spi.*|gvfsd.*|goa-.*|Thread.*|kworker.*|ksoftirqd.*|migration.*|rcu_.*|watchdog.*|scsi_.*|kthreadd|khugepaged|kswapd.*|ksmd|kcompactd.*|khungtaskd|snapd|udisksd|polkitd|NetworkManager|wpa_supplicant|avahi-daemon|cron|agetty)$'

BAR_CHARS=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

get_sort_flag() {
    case "$1" in
        cpu_asc)  echo "%cpu" ;;
        cpu_desc) echo "-%cpu" ;;
        mem_asc)  echo "%mem" ;;
        mem_desc) echo "-%mem" ;;
        *)        echo "-%mem" ;;
    esac
}

next_sort_mode() {
    case "$1" in
        cpu_desc) echo "cpu_asc" ;;
        cpu_asc)  echo "cpu_desc" ;;
        mem_desc) echo "mem_asc" ;;
        mem_asc)  echo "mem_desc" ;;
        *)        echo "mem_desc" ;;
    esac
}

draw_bar() {
    local value=$1
    local levels=${#BAR_CHARS[@]}
    local index=$(((value * (levels - 1)) / 100))
    (( index < 0 )) && index=0
    (( index >= levels )) && index=$((levels-1))
    printf "%s" "${BAR_CHARS[$index]}"
}

# Accent colors (name tint per-proc). Use palette accents for consistency.
NAME_COLORS=("$PAL_SEL" "$PAL_SEL1" "$PAL_ACTIVE" "#F1FA8C" "#FFB86C" "#FF79C6" "#D6ACFF" "#9AEDFE" "#C1FF72" "#FAF594")

get_process_list() {
    ps -eo pid,comm:32,pcpu,pmem,etime,user --sort="$(get_sort_flag "$SORT_MODE")" | \
    awk -v exclude="$EXCLUDE" \
        -v colors="${NAME_COLORS[*]}" \
        -v urgent="$PAL_URGENT" \
        -v active="$PAL_ACTIVE" \
        -v fg="$PAL_FG" '
        BEGIN {
            n = split(colors, name_colors, " ")
        }
        NR==1 { next }
        {
            pid  = $1
            cmd  = $2
            cpu  = $3 + 0
            mem  = $4 + 0
            etime= $5
            user = $6
            if (cmd ~ exclude) next

            hash = 0
            for (i = 1; i <= length(cmd); i++) hash += index("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", substr(cmd, i, 1))
            color = name_colors[(hash % n) + 1]

            # Nerd Font PUA glyphs (single-width in Mono variant).
            icon = ""                                    # gear
            if      (cmd ~ /firefox/)  icon = ""         # firefox
            else if (cmd ~ /brave/)    icon = ""         # lion
            else if (cmd ~ /chrom/)    icon = ""         # chrome
            else if (cmd ~ /nautilus|thunar|nemo|pcmanfm/) icon = ""   # folder
            else if (cmd ~ /code|nvim|vim/) icon = ""    # code
            else if (cmd ~ /steam/)    icon = ""         # steam
            else if (cmd ~ /vlc|mpv/)  icon = ""         # play
            else if (cmd ~ /spotify/)  icon = ""         # spotify
            else if (cmd ~ /discord/)  icon = ""         # discord
            else if (cmd ~ /python|node|ruby|java/) icon = ""  # code

            cpu_color = (cpu >= 50) ? urgent : (cpu >= 20 ? "#E5C07B" : fg)
            mem_color = (mem >= 30) ? urgent : (mem >= 10 ? "#E5C07B" : fg)

            printf "%s|%s|%s|%.1f|%.1f|%s|%s|%s|%s|%s\n", pid, icon, cmd, cpu, mem, etime, user, color, cpu_color, mem_color
        }
    '
}

build_titles_map() {
    declare -gA WIN_TITLES=()
    command -v wmctrl &>/dev/null || return 0
    local wid desk pid host title existing
    while read -r wid desk pid host title; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ -z "$title" ]] && continue
        existing="${WIN_TITLES[$pid]:-}"
        if [[ -n "$existing" ]]; then
            WIN_TITLES[$pid]="$existing · $title"
        else
            WIN_TITLES[$pid]="$title"
        fi
    done < <(wmctrl -lp 2>/dev/null)
}

# Truncate + escape pango.
fmt_title() {
    local t="$1"
    local max=45
    (( ${#t} > max )) && t="${t:0:max}…"
    t="${t//&/&amp;}"
    t="${t//</&lt;}"
    t="${t//>/&gt;}"
    printf '%s' "$t"
}

# Plain-text form for width calc (no escaping).
fmt_title_plain() {
    local t="$1"
    local max=45
    (( ${#t} > max )) && t="${t:0:max}…"
    printf '%s' "$t"
}

build_rofi_input() {
    local sep="<span foreground=\"$PAL_SEL1\">│</span>"
    # Column widths (char counts, monospace assumed).
    local W_PID=7 W_NAME=52 W_CPU=13 W_MEM=13 W_UP=10 W_USER=8
    # Header row (non-selectable). Plain-text pad first, then wrap in span.
    local h_pid h_name h_cpu h_mem h_up h_user
    printf -v h_pid  "%-${W_PID}s"  "PID"
    printf -v h_name "%-${W_NAME}s" "PROCESS [WINDOW]"
    printf -v h_cpu  "%-${W_CPU}s"  "CPU"
    printf -v h_mem  "%-${W_MEM}s"  "MEM"
    printf -v h_up   "%-${W_UP}s"   "UPTIME"
    printf -v h_user "%-${W_USER}s" "USER"
    printf "<span foreground=\"%s\" weight=\"bold\">%s</span>%s<span foreground=\"%s\" weight=\"bold\">%s</span>%s<span foreground=\"%s\" weight=\"bold\">%s</span>%s<span foreground=\"%s\" weight=\"bold\">%s</span>%s<span foreground=\"%s\" weight=\"bold\">%s</span>%s<span foreground=\"%s\" weight=\"bold\">%s</span>\0meta\x1fnonselectable\x1ftrue\n" \
        "$PAL_SEL" "$h_pid" "$sep" "$PAL_SEL" " $h_name" "$sep" "$PAL_SEL" " $h_cpu" "$sep" "$PAL_SEL" " $h_mem" "$sep" "$PAL_SEL" " $h_up" "$sep" "$PAL_SEL" " $h_user"
    build_titles_map
    # Build PID→PPID map once (single ps call) for ancestry lookup.
    declare -A PPID_MAP=()
    while read -r p pp; do
        PPID_MAP[$p]="$pp"
    done < <(ps -eo pid=,ppid=)
    # Walk ancestry up to 6 hops to find a windowed ancestor's title.
    lookup_title() {
        local cur="$1" hops=0 t
        while (( hops < 6 )) && [[ -n "$cur" && "$cur" != "1" && "$cur" != "0" ]]; do
            t="${WIN_TITLES[$cur]:-}"
            [[ -n "$t" ]] && { printf '%s' "$t"; return; }
            cur="${PPID_MAP[$cur]:-}"
            hops=$((hops+1))
        done
    }
    get_process_list | while IFS='|' read -r pid icon cmd cpu mem etime user color cpu_color mem_color; do
        cpu_bar=$(draw_bar "${cpu%.*}")
        mem_bar=$(draw_bar "${mem%.*}")
        title="${WIN_TITLES[$pid]:-}"
        # For GUI apps without direct title, walk PPID chain.
        if [[ -z "$title" && "$cmd" =~ (brave|chrom|firefox|electron|code|discord|slack|thunderbird) ]]; then
            title=$(lookup_title "$pid")
        fi
        title_span=""
        if [[ -n "$title" ]]; then
            title_span=" <span foreground=\"$PAL_ACTIVE\">[$(fmt_title "$title")]</span>"
        fi
        # Build plain-text NAME cell then pad + truncate.
        title_plain=""
        [[ -n "$title" ]] && title_plain=" [$(fmt_title_plain "$title")]"
        name_plain="$icon $cmd$title_plain"
        if (( ${#name_plain} > W_NAME )); then
            name_plain="${name_plain:0:$((W_NAME-1))}…"
        fi
        printf -v name_padded "%-${W_NAME}s" "$name_plain"

        cpu_cell=$(printf "%s %.1f%%" "$cpu_bar" "$cpu")
        printf -v cpu_padded "%-${W_CPU}s" "$cpu_cell"

        mem_cell=$(printf "%s %.1f%%" "$mem_bar" "$mem")
        printf -v mem_padded "%-${W_MEM}s" "$mem_cell"

        printf -v etime_padded "%-${W_UP}s" "$etime"
        printf -v user_padded  "%-${W_USER}s" "$user"
        printf -v pid_padded   "%-${W_PID}s" "$pid"

        printf "<span foreground=\"%s\">%s</span>%s <span foreground=\"%s\">%s</span>%s <span foreground=\"%s\">%s</span>%s <span foreground=\"%s\">%s</span>%s <span foreground=\"%s\">%s</span>%s <span foreground=\"%s\">%s</span>\n" \
            "$PAL_SEL1" "$pid_padded" "$sep" \
            "$color"    "$name_padded" "$sep" \
            "$cpu_color" "$cpu_padded" "$sep" \
            "$mem_color" "$mem_padded" "$sep" \
            "$PAL_FG"    "$etime_padded" "$sep" \
            "$PAL_FG"    "$user_padded"
    done
}

# Prompt suffix shows sort mode.
sort_label() {
    case "$SORT_MODE" in
        cpu_desc) echo "CPU↓" ;;
        cpu_asc)  echo "CPU↑" ;;
        mem_desc) echo "MEM↓" ;;
        mem_asc)  echo "MEM↑" ;;
    esac
}

chosen=$(
    build_rofi_input | rofi -markup-rows -dmenu -i \
        -theme "$ROFI_THEME" \
        -p "Kill [$(sort_label)]" \
        -mesg "<b>↵</b> kill  <b>Alt+k</b> force  <b>Alt+c</b> CPU  <b>Alt+m</b> MEM  <b>Alt+p</b> yank path  <b>Ctrl+y</b> yank PID" \
        -selected-row "$LAST_ROW" \
        -format 'i s' \
        -kb-custom-1 "Alt+c" \
        -kb-custom-2 "Alt+m" \
        -kb-custom-3 "Alt+p" \
        -kb-custom-4 "Alt+k" \
        -kb-custom-5 "Control+y"
)
ret=$?

# -format 'i s' → first line = index, second = text
sel_row=$(printf '%s\n' "$chosen" | sed -n '1p')
sel_line=$(printf '%s\n' "$chosen" | sed -n '2p')
[[ "$sel_row" =~ ^[0-9]+$ ]] || sel_row="$LAST_ROW"
echo "$sel_row" > "$ROW_STATE_FILE"

pid=""
# Strip pango markup then grab first integer (which is PID).
sel_stripped=$(printf '%s' "$sel_line" | sed 's/<[^>]*>//g')
[[ "$sel_stripped" =~ ([0-9]+) ]] && pid="${BASH_REMATCH[1]}"

reexec() {
    exec "$0" "$SORT_MODE" "$sel_row"
}

case "$ret" in
    10) # Alt+c toggle CPU
        new_mode=$([[ $SORT_MODE == cpu_* ]] && next_sort_mode "$SORT_MODE" || echo "cpu_desc")
        echo "$new_mode" >"$STATE_FILE"
        SORT_MODE="$new_mode"; reexec
        ;;
    11) # Alt+m toggle MEM
        new_mode=$([[ $SORT_MODE == mem_* ]] && next_sort_mode "$SORT_MODE" || echo "mem_desc")
        echo "$new_mode" >"$STATE_FILE"
        SORT_MODE="$new_mode"; reexec
        ;;
    12) # Alt+p yank path
        if [[ -n "$pid" ]]; then
            path=$(ps -p "$pid" -o args= 2>/dev/null)
            if [[ -n "$path" ]]; then
                copy_to_clipboard "$path"
                notify_safe "📋 Yanked path" "$path"
            else
                notify_safe "❌ PID $pid gone"
            fi
        fi
        reexec
        ;;
    13) # Alt+k force kill
        if [[ -n "$pid" ]]; then
            if rofi_confirm "Force kill PID $pid?" "$(ps -p "$pid" -o comm= 2>/dev/null)"; then
                kill -9 "$pid" 2>/dev/null && notify_safe "☠️ Killed PID $pid" || notify_safe "❌ Failed to kill PID $pid"
            fi
        fi
        reexec
        ;;
    14) # Ctrl+y yank PID
        if [[ -n "$pid" ]]; then
            copy_to_clipboard "$pid"
            notify_safe "📋 Copied PID" "$pid"
        fi
        reexec
        ;;
    0) # Enter — regular kill
        if [[ -n "$pid" ]]; then
            if rofi_confirm "Kill PID $pid?" "$(ps -p "$pid" -o comm= 2>/dev/null)"; then
                kill -15 "$pid" 2>/dev/null && notify_safe "✅ Killed PID $pid" || notify_safe "❌ Failed to kill PID $pid"
            fi
            reexec
        else
            reexec
        fi
        ;;
    1) # Esc
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
