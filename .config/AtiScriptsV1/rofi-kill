#!/usr/bin/env bash
# Rofi process killer. Palette follows wallpaper via rofi_common.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=rofi_common.sh
source "$SCRIPT_DIR/rofi_common.sh"

require_cmd rofi ps awk || exit 1
load_palette

ROFI_THEME="$HOME/.config/rofi/themes/kill-large.rasi"
STATE_FILE="/tmp/rofi-kill-sort-mode"
ROW_STATE_FILE="/tmp/rofi-kill-selected-row"

SORT_MODE="${1:-$(cat "$STATE_FILE" 2>/dev/null || echo 'mem_desc')}"
LAST_ROW="${2:-$(cat "$ROW_STATE_FILE" 2>/dev/null || echo 0)}"

# Noise procs. Regex anchored on comm (widened to 32 chars via ps -o).
EXCLUDE='^(bash|zsh|sh|fish|rofi|Xorg|gnome-shell|systemd|systemd-.*|ps|awk|sed|dbus.*|kwin.*|plasmashell|pipewire.*|wireplumber|gpg-agent|ibus.*|xdg-.*|at-spi.*|gvfsd.*|goa-.*|Thread.*|kworker.*|ksoftirqd.*|migration.*|rcu_.*|watchdog.*|scsi_.*|kthreadd|khugepaged|kswapd.*|ksmd|kcompactd.*|khungtaskd|snapd|udisksd|polkitd|NetworkManager|wpa_supplicant|avahi-daemon|cron|agetty)$'

BAR_CHARS=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

get_sort_flag() {
    case "$1" in
        cpu_asc)  echo "%cpu" ;;
        cpu_desc) echo "-%cpu" ;;
        mem_asc)  echo "%mem" ;;
        mem_desc) echo "-%mem" ;;
        *)        echo "-%mem" ;;
    esac
}

next_sort_mode() {
    case "$1" in
        cpu_desc) echo "cpu_asc" ;;
        cpu_asc)  echo "cpu_desc" ;;
        mem_desc) echo "mem_asc" ;;
        mem_asc)  echo "mem_desc" ;;
        *)        echo "mem_desc" ;;
    esac
}

draw_bar() {
    local value=$1
    local levels=${#BAR_CHARS[@]}
    local index=$(((value * (levels - 1)) / 100))
    (( index < 0 )) && index=0
    (( index >= levels )) && index=$((levels-1))
    printf "%s" "${BAR_CHARS[$index]}"
}

# Accent colors (name tint per-proc). Use palette accents for consistency.
NAME_COLORS=("$PAL_SEL" "$PAL_SEL1" "$PAL_ACTIVE" "#F1FA8C" "#FFB86C" "#FF79C6" "#D6ACFF" "#9AEDFE" "#C1FF72" "#FAF594")

get_process_list() {
    ps -eo pid,comm:32,pcpu,pmem,etime,user --sort="$(get_sort_flag "$SORT_MODE")" | \
    awk -v exclude="$EXCLUDE" \
        -v colors="${NAME_COLORS[*]}" \
        -v urgent="$PAL_URGENT" \
        -v active="$PAL_ACTIVE" \
        -v fg="$PAL_FG" '
        BEGIN {
            n = split(colors, name_colors, " ")
        }
        NR==1 { next }
        {
            pid  = $1
            cmd  = $2
            cpu  = $3 + 0
            mem  = $4 + 0
            etime= $5
            user = $6
            if (cmd ~ exclude) next

            hash = 0
            for (i = 1; i <= length(cmd); i++) hash += index("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", substr(cmd, i, 1))
            color = name_colors[(hash % n) + 1]

            # Nerd Font PUA glyphs (single-width in Mono variant).
            icon = ""                                    # gear
            if      (cmd ~ /firefox/)  icon = ""         # firefox
            else if (cmd ~ /brave/)    icon = ""         # lion
            else if (cmd ~ /chrom/)    icon = ""         # chrome
            else if (cmd ~ /nautilus|thunar|nemo|pcmanfm/) icon = ""   # folder
            else if (cmd ~ /code|nvim|vim/) icon = ""    # code
            else if (cmd ~ /steam/)    icon = ""         # steam
            else if (cmd ~ /vlc|mpv/)  icon = ""         # play
            else if (cmd ~ /spotify/)  icon = ""         # spotify
            else if (cmd ~ /discord/)  icon = ""         # discord
            else if (cmd ~ /python|node|ruby|java/) icon = ""  # code

            cpu_color = (cpu >= 50) ? urgent : (cpu >= 20 ? "#E5C07B" : fg)
            mem_color = (mem >= 30) ? urgent : (mem >= 10 ? "#E5C07B" : fg)

            printf "%s|%s|%s|%.1f|%.1f|%s|%s|%s|%s|%s\n", pid, icon, cmd, cpu, mem, etime, user, color, cpu_color, mem_color
        }
    '
}

build_titles_map() {
    declare -gA WIN_TITLES=()
    command -v wmctrl &>/dev/null || return 0
    local wid desk pid host title existing
    while read -r wid desk pid host title; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ -z "$title" ]] && continue
        existing="${WIN_TITLES[$pid]:-}"
        if [[ -n "$existing" ]]; then
            WIN_TITLES[$pid]="$existing · $title"
        else
            WIN_TITLES[$pid]="$title"
        fi
    done < <(wmctrl -lp 2>/dev/null)
}

# Truncate + escape pango.
fmt_title() {
    local t="$1"
    local max=45
    (( ${#t} > max )) && t="${t:0:max}…"
    t="${t//&/&amp;}"
    t="${t//</&lt;}"
    t="${t//>/&gt;}"
    printf '%s' "$t"
}

# Plain-text form for width calc (no escaping).
fmt_title_plain() {
    local t="$1"
    local max=45
    (( ${#t} > max )) && t="${t:0:max}…"
    printf '%s' "$t"
}

build_rofi_input() {
    # Single-pass awk render. Previously a bash while-read loop for
    # ~280 processes took 9-18s (rofi couldn't open until stdin EOF).
    # Awk version: <200ms. Pre-collect titles + ppid map into stream
    # tagged lines so awk can build lookups in memory.
    local sep_color="$PAL_SEL1"
    {
        # Tag 'T': window titles (wmctrl -lp: id desk pid host title...).
        if command -v wmctrl >/dev/null 2>&1; then
            wmctrl -lp 2>/dev/null | awk '{
                pid=$3; if (pid !~ /^[0-9]+$/) next;
                title=""; for(i=5;i<=NF;i++) title=title (i>5?" ":"") $i;
                if (title=="") next;
                printf "T\t%s\t%s\n", pid, title;
            }'
        fi
        # Tag 'P': ppid map.
        ps -eo pid=,ppid= | awk '{printf "P\t%s\t%s\n", $1, $2}'
        # Tag 'R': process rows.
        ps -eo pid,comm:32,pcpu,pmem,etime,user \
            --sort="$(get_sort_flag "$SORT_MODE")" \
            | awk 'NR>1{printf "R\t%s\t%s\t%s\t%s\t%s\t%s\n", $1,$2,$3,$4,$5,$6}'
    } | awk -F'\t' \
        -v exclude="$EXCLUDE" \
        -v colors="${NAME_COLORS[*]}" \
        -v urgent="$PAL_URGENT" \
        -v active="$PAL_ACTIVE" \
        -v fg="$PAL_FG" \
        -v sel="$PAL_SEL" \
        -v sel1="$PAL_SEL1" \
        -v sep_color="$sep_color" '
        BEGIN {
            n_colors = split(colors, name_colors, " ")
            split("▁ ▂ ▃ ▄ ▅ ▆ ▇ █", bars, " ")
            W_PID=7; W_NAME=52; W_CPU=13; W_MEM=13
            # Force pango monospace family only inside the row content
            # (prompt + mesg keep the base proportional font). This is
            # the only way divider bars align without touching base.rasi.
            sep = "<span foreground=\"" sep_color "\">│</span>"
            row_open  = "<span face=\"monospace\">"
            row_close = "</span>"
            printf("%s<span foreground=\"%s\" weight=\"bold\">%-*s</span>%s<span foreground=\"%s\" weight=\"bold\"> %-*s</span>%s<span foreground=\"%s\" weight=\"bold\"> %-*s</span>%s<span foreground=\"%s\" weight=\"bold\"> %-*s</span>%s\0meta\x1fnonselectable\x1ftrue\n",
                row_open,
                sel, W_PID, "PID", sep,
                sel, W_NAME, "PROCESS [WINDOW]", sep,
                sel, W_CPU, "CPU", sep,
                sel, W_MEM, "MEM",
                row_close)
        }
        function draw_bar(v,   idx) {
            idx = int((v * 7) / 100)
            if (idx < 0) idx = 0
            if (idx > 7) idx = 7
            return bars[idx+1]
        }
        function pango_escape(s) {
            gsub(/&/, "\\&amp;", s)
            gsub(/</, "\\&lt;", s)
            gsub(/>/, "\\&gt;", s)
            return s
        }
        function truncate(s, max) {
            if (length(s) > max) return substr(s, 1, max-1) "…"
            return s
        }
        function hash_color(cmd,   h, i) {
            h = 0
            for (i = 1; i <= length(cmd); i++) h += index("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", substr(cmd, i, 1))
            return name_colors[(h % n_colors) + 1]
        }
        function pick_icon(cmd) {
            if (cmd ~ /firefox/) return ""
            if (cmd ~ /brave/) return ""
            if (cmd ~ /chrom/) return ""
            if (cmd ~ /nautilus|thunar|nemo|pcmanfm/) return ""
            if (cmd ~ /code|nvim|vim/) return ""
            if (cmd ~ /steam/) return ""
            if (cmd ~ /vlc|mpv/) return ""
            if (cmd ~ /spotify/) return ""
            if (cmd ~ /discord/) return ""
            if (cmd ~ /python|node|ruby|java/) return ""
            return ""
        }
        function lookup_title(pid,   cur, hops, t) {
            cur = pid; hops = 0
            while (hops < 6 && cur != "" && cur != "1" && cur != "0") {
                t = titles[cur]
                if (t != "") return t
                cur = ppid_of[cur]
                hops++
            }
            return ""
        }
        $1 == "T" {
            if (titles[$2] == "") titles[$2] = $3
            else titles[$2] = titles[$2] " · " $3
            next
        }
        $1 == "P" { ppid_of[$2] = $3; next }
        $1 == "R" {
            pid = $2; cmd = $3; cpu = $4 + 0; mem = $5 + 0
            etime = $6; user = $7
            if (cmd ~ exclude) next
            color = hash_color(cmd)
            icon = pick_icon(cmd)
            cpu_col = (cpu >= 50) ? urgent : (cpu >= 20 ? "#E5C07B" : fg)
            mem_col = (mem >= 30) ? urgent : (mem >= 10 ? "#E5C07B" : fg)
            title = titles[pid]
            if (title == "" && cmd ~ /brave|chrom|firefox|electron|code|discord|slack|thunderbird/) {
                title = lookup_title(pid)
            }
            title_plain = ""
            if (title != "") title_plain = " [" truncate(title, 45) "]"
            name_plain = icon " " cmd title_plain
            if (length(name_plain) > W_NAME) name_plain = substr(name_plain, 1, W_NAME-1) "…"
            name_plain = pango_escape(name_plain)
            cpu_cell = sprintf("%s %.1f%%", draw_bar(int(cpu)), cpu)
            mem_cell = sprintf("%s %.1f%%", draw_bar(int(mem)), mem)
            printf("<span face=\"monospace\"><span foreground=\"%s\">%-*s</span>%s <span foreground=\"%s\">%-*s</span>%s <span foreground=\"%s\">%-*s</span>%s <span foreground=\"%s\">%-*s</span></span>\n",
                sel1, W_PID, pid, sep,
                color, W_NAME, name_plain, sep,
                cpu_col, W_CPU, cpu_cell, sep,
                mem_col, W_MEM, mem_cell)
        }
    '
}

# Prompt suffix shows sort mode.
sort_label() {
    case "$SORT_MODE" in
        cpu_desc) echo "CPU↓" ;;
        cpu_asc)  echo "CPU↑" ;;
        mem_desc) echo "MEM↓" ;;
        mem_asc)  echo "MEM↑" ;;
    esac
}

chosen=$(
    build_rofi_input | rofi -markup-rows -dmenu -i \
        -theme "$ROFI_THEME" \
        -p "Kill [$(sort_label)]" \
        -mesg "<b>↵</b> kill  <b>Alt+k</b> force  <b>Alt+c</b> CPU  <b>Alt+m</b> MEM  <b>Alt+p</b> yank path  <b>Ctrl+y</b> yank PID" \
        -selected-row "$LAST_ROW" \
        -format 'i s' \
        -kb-custom-1 "Alt+c" \
        -kb-custom-2 "Alt+m" \
        -kb-custom-3 "Alt+p" \
        -kb-custom-4 "Alt+k" \
        -kb-custom-5 "Control+y"
)
ret=$?

# -format 'i s' → first line = index, second = text
sel_row=$(printf '%s\n' "$chosen" | sed -n '1p')
sel_line=$(printf '%s\n' "$chosen" | sed -n '2p')
[[ "$sel_row" =~ ^[0-9]+$ ]] || sel_row="$LAST_ROW"
echo "$sel_row" > "$ROW_STATE_FILE"

pid=""
# Strip pango markup then grab first integer (which is PID).
sel_stripped=$(printf '%s' "$sel_line" | sed 's/<[^>]*>//g')
[[ "$sel_stripped" =~ ([0-9]+) ]] && pid="${BASH_REMATCH[1]}"

reexec() {
    exec "$0" "$SORT_MODE" "$sel_row"
}

case "$ret" in
    10) # Alt+c toggle CPU
        new_mode=$([[ $SORT_MODE == cpu_* ]] && next_sort_mode "$SORT_MODE" || echo "cpu_desc")
        echo "$new_mode" >"$STATE_FILE"
        SORT_MODE="$new_mode"; reexec
        ;;
    11) # Alt+m toggle MEM
        new_mode=$([[ $SORT_MODE == mem_* ]] && next_sort_mode "$SORT_MODE" || echo "mem_desc")
        echo "$new_mode" >"$STATE_FILE"
        SORT_MODE="$new_mode"; reexec
        ;;
    12) # Alt+p yank path
        if [[ -n "$pid" ]]; then
            path=$(ps -p "$pid" -o args= 2>/dev/null)
            if [[ -n "$path" ]]; then
                copy_to_clipboard "$path"
                notify_safe "📋 Yanked path" "$path"
            else
                notify_safe "❌ PID $pid gone"
            fi
        fi
        reexec
        ;;
    13) # Alt+k force kill (skip grace, go straight to SIGKILL)
        if [[ -n "$pid" ]]; then
            if rofi_confirm "Force kill PID $pid?" "$(ps -p "$pid" -o comm= 2>/dev/null)"; then
                kill_guaranteed "$pid" force
            fi
        fi
        reexec
        ;;
    14) # Ctrl+y yank PID
        if [[ -n "$pid" ]]; then
            copy_to_clipboard "$pid"
            notify_safe "📋 Copied PID" "$pid"
        fi
        reexec
        ;;
    0) # Enter — regular kill, guaranteed
        if [[ -n "$pid" ]]; then
            proc_name="$(ps -p "$pid" -o comm= 2>/dev/null)"
            if [[ -z "$proc_name" ]]; then
                notify_safe "❌ PID $pid already gone"
                reexec
            fi
            # Debug: log to /tmp so we can inspect the flow.
            printf '[%s] kill Enter pid=%s comm=%s ret=%s\n' \
                "$(date +%H:%M:%S)" "$pid" "$proc_name" "$ret" \
                >>/tmp/rofi-kill.log
            if rofi_confirm "Kill PID $pid ($proc_name)?" ""; then
                printf '  confirmed, killing\n' >>/tmp/rofi-kill.log
                kill_guaranteed "$pid"
            else
                printf '  cancelled\n' >>/tmp/rofi-kill.log
            fi
            reexec
        else
            notify_safe "❌ Could not extract PID from selection"
            reexec
        fi
        ;;
    1) # Esc
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
