      -e "s|{{FG}}|$fg|g" \
      -e "s|{{BG_CRIT}}|$bg_crit|g" \
      -e "s|{{FG_CRIT}}|$fg_crit|g" \
      -e "s|{{ACCENT}}|$accent|g" \
      -e "s|{{OK}}|$ok|g" \
      -e "s|{{URGENT}}|$urgent|g" \
      -e "s|@HOME@|$HOME|g" \
      "$DUNST_TMPL" >"$DUNSTRC"
}

