#!/usr/bin/env bash
# theme-apply <mode>
#
# Supported modes:
#   doomone dracula gruvbox nord tokyonight catppuccin  -> preset palette
#   wal                                                  -> pywal from ~/.cache/wall
#
# For each mode we symlink:
#   ~/.config/kitty/themes/current.conf     -> kitty palette (SIGUSR1 reloads live)
#   ~/.config/rofi/themes/current-palette.rasi -> rofi color vars
# then reload qtile so lib/colors.py picks up the new mode via
# ~/.cache/qtile/theme_mode.
#
# Wal mode passes -s -t and --saturate 0.75 to punch up dim wallpapers.

set -euo pipefail

MODE="${1:-doomone}"
CACHE_DIR="$HOME/.cache/qtile"
STATE_FILE="$CACHE_DIR/theme_mode"

mkdir -p "$CACHE_DIR"

PRESETS=(doomone dracula gruvbox nord tokyonight catppuccin)

is_preset() {
  local m="$1"
  for p in "${PRESETS[@]}"; do
    [[ "$p" == "$m" ]] && return 0
  done
  return 1
}

if [[ "$MODE" != "wal" ]] && ! is_preset "$MODE"; then
  echo "usage: theme-apply <doomone|dracula|gruvbox|nord|tokyonight|catppuccin|wal>" >&2
  exit 1
fi

KITTY_THEMES="$HOME/.config/kitty/themes"
ROFI_THEMES="$HOME/.config/rofi/themes"

if [[ "$MODE" == "wal" ]]; then
  if ! command -v wal >/dev/null; then
    notify-send -u critical "theme-apply" "pywal not installed"
    exit 1
  fi
  WALL_LINK="$HOME/.cache/wall"
  if [[ ! -f "$WALL_LINK" ]]; then
    notify-send -u critical "theme-apply" "~/.cache/wall missing — set a wallpaper first"
    exit 1
  fi
  # Default backend + max saturation. Monochromatic wallpapers still
  # produce single-hue palettes; colors.py falls back to DoomOne accents
  # (keeping only wal bg/fg) when the accent hues span <60 degrees.
  # colorz backend uses k-means clustering — much better for multi-color
  # wallpapers (paint splatters, city photos) than the default wal backend
  # which tends to pick a single dominant hue.
  # If colorz isn't installed, pywal silently falls back to the default.
  wal --backend colorz -i "$(cat "$WALL_LINK")" -n -s -t -q --saturate 1.0 2>/dev/null \
    || wal -i "$(cat "$WALL_LINK")" -n -s -t -q --saturate 1.0 2>/dev/null

  # Monochrome / desaturated wallpapers produce useless palettes (all
  # one hue). Detect via HSV hue spread AND mean saturation on
  # color9-14; if either fails, overwrite accents with DoomOne while
  # keeping wal bg/fg. Thresholds match WAL_AUDIT_REPORT.md findings.
  python3 <<'PYEOF' 2>/dev/null || true
import json, os, colorsys
p = os.path.expanduser("~/.cache/wal/colors.json")
with open(p) as f:
    d = json.load(f)
accents = [d["colors"][f"color{i}"] for i in range(9, 15)]
def hsv(hx):
    r, g, b = int(hx[1:3],16)/255, int(hx[3:5],16)/255, int(hx[5:7],16)/255
    return colorsys.rgb_to_hsv(r, g, b)
hs = [hsv(a)[0] * 360 for a in accents]
ss = [hsv(a)[1] for a in accents]
spread = max(hs) - min(hs)
sat_mean = sum(ss) / len(ss)
if spread < 60 or sat_mean < 0.25:
    doomone = {
        "color1":"#ff6c6b","color9":"#ff6c6b",
        "color2":"#98be65","color10":"#98be65",
        "color3":"#da8548","color11":"#da8548",
        "color4":"#51afef","color12":"#51afef",
        "color5":"#c678dd","color13":"#c678dd",
        "color6":"#46d9ff","color14":"#46d9ff",
    }
    d["colors"].update(doomone)
    with open(p, "w") as f:
        json.dump(d, f, indent=4)
PYEOF

  # Regenerate wal template outputs so kitty/rofi files reflect the
  # post-processed colors.json.
  wal -R -q 2>/dev/null || true

  # ---- Build wal-flavored rofi palette from wal cache ----
  BG="$(jq -r .special.background ~/.cache/wal/colors.json)"
  FG="$(jq -r .special.foreground ~/.cache/wal/colors.json)"
  BG_ALT="$(jq -r .colors.color0 ~/.cache/wal/colors.json)"
  SEL="$(jq -r .colors.color14 ~/.cache/wal/colors.json)"
  SEL2="$(jq -r .colors.color12 ~/.cache/wal/colors.json)"
  URG="$(jq -r .colors.color9 ~/.cache/wal/colors.json)"
  ACT="$(jq -r .colors.color10 ~/.cache/wal/colors.json)"
  cat >"$ROFI_THEMES/palette-wal.rasi" <<EOF
* {
    background:     $BG;
    background-alt: $BG_ALT;
    foreground:     $FG;
    selected:       $SEL;
    selectedone:    $SEL2;
    urgent:         $URG;
    active:         $ACT;
}
EOF
  ln -sfn "$HOME/.cache/wal/colors-kitty.conf" "$KITTY_THEMES/current.conf"
  ln -sfn palette-wal.rasi "$ROFI_THEMES/current-palette.rasi"
else
  ln -sfn "$MODE.conf" "$KITTY_THEMES/current.conf"
  ln -sfn "palette-$MODE.rasi" "$ROFI_THEMES/current-palette.rasi"
fi

# ---- Qutebrowser homepage CSS vars ----
# Inline the palette into homepage.html between BEGIN-THEME-VARS /
# END-THEME-VARS markers. Editing the HTML itself defeats file:// CSS
# caching that file:// stylesheets have for the qutebrowser --temp
# window used by the homepage.
QB_HTML="$HOME/.config/qutebrowser/html/homepage.html"
gen_qb_css() {
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  [[ -f "$QB_HTML" ]] || return
  python3 - "$QB_HTML" "$bg" "$bg_alt" "$fg" "$red" "$green" "$yellow" "$blue" "$purple" "$cyan" <<'PYEOF'
import sys, re
path = sys.argv[1]
bg, bg_alt, fg, red, green, yellow, blue, purple, cyan = sys.argv[2:11]
with open(path) as f:
    src = f.read()
block = (
    "    <!-- BEGIN-THEME-VARS (rewritten by theme-apply) -->\n"
    "    <style id=\"theme-vars\">\n"
    "      :root {\n"
    f"        --bg: {bg};\n"
    f"        --bg-alt: {bg_alt};\n"
    f"        --fg: {fg};\n"
    f"        --red: {red};\n"
    f"        --green: {green};\n"
    f"        --yellow: {yellow};\n"
    f"        --blue: {blue};\n"
    f"        --purple: {purple};\n"
    f"        --cyan: {cyan};\n"
    "      }\n"
    "    </style>\n"
    "    <!-- END-THEME-VARS -->"
)
new = re.sub(
    r"    <!-- BEGIN-THEME-VARS.*?<!-- END-THEME-VARS -->",
    block,
    src,
    count=1,
    flags=re.DOTALL,
)
with open(path, 'w') as f:
    f.write(new)
PYEOF
}

case "$MODE" in
  wal)
    W=~/.cache/wal/colors.json
    gen_qb_css \
      "$(jq -r .special.background "$W")" \
      "$(jq -r .colors.color0 "$W")" \
      "$(jq -r .special.foreground "$W")" \
      "$(jq -r .colors.color9 "$W")" \
      "$(jq -r .colors.color10 "$W")" \
      "$(jq -r .colors.color11 "$W")" \
      "$(jq -r .colors.color12 "$W")" \
      "$(jq -r .colors.color13 "$W")" \
      "$(jq -r .colors.color14 "$W")"
    ;;
  doomone)   gen_qb_css "#282c34" "#1e222a" "#dcdfe4" "#ff6c6b" "#98be65" "#ecbe7b" "#51afef" "#c678dd" "#46d9ff" ;;
  dracula)   gen_qb_css "#282a36" "#21222c" "#f8f8f2" "#ff5555" "#50fa7b" "#f1fa8c" "#bd93f9" "#ff79c6" "#8be9fd" ;;
  nord)      gen_qb_css "#2e3440" "#3b4252" "#d8dee9" "#bf616a" "#a3be8c" "#ebcb8b" "#81a1c1" "#b48ead" "#88c0d0" ;;
  gruvbox)   gen_qb_css "#282828" "#1d2021" "#ebdbb2" "#fb4934" "#b8bb26" "#fabd2f" "#83a598" "#d3869b" "#8ec07c" ;;
  tokyonight) gen_qb_css "#1a1b26" "#16161e" "#c0caf5" "#f7768e" "#9ece6a" "#e0af68" "#7aa2f7" "#bb9af7" "#7dcfff" ;;
  catppuccin) gen_qb_css "#1e1e2e" "#181825" "#cdd6f4" "#f38ba8" "#a6e3a1" "#f9e2af" "#89b4fa" "#cba6f7" "#94e2d5" ;;
esac

echo "$MODE" >"$STATE_FILE"

# Live-reload all running kitty instances. kitty listens on
# unix:/tmp/kitty-<pid>, one socket per top-level kitty. SIGUSR1 alone
# rereads the config but the include'd palette file often stays cached,
# so push the palette explicitly via `kitty @ set-colors --all`.
for sock in /tmp/kitty-*; do
  [[ -S "$sock" ]] || continue
  kitty @ --to "unix:$sock" set-colors --all --configured \
    "$KITTY_THEMES/current.conf" 2>/dev/null || true
done
for pid in $(pgrep -x kitty || true); do
  kill -SIGUSR1 "$pid" 2>/dev/null || true
done

# ---- Dunst ----
# Render dunstrc from ~/.dotfiles/.config/dunst/dunstrc.tmpl with palette
# substitutions. Retint only the 3 urgency levels + global frame_color;
# named notification classes (success/warning/todo/spotify/etc) keep
# their semantic hardcoded colors.
DUNSTRC="$HOME/.config/dunst/dunstrc"
DUNST_TMPL="$HOME/.dotfiles/.config/dunst/dunstrc.tmpl"
render_dunstrc() {
  local bg="$1" fg="$2" bg_crit="$3" fg_crit="$4" accent="$5" ok="$6" urgent="$7"
  # Break any stow symlink to dunstrc — we'll manage the real file now.
  [[ -L "$DUNSTRC" ]] && rm "$DUNSTRC"
  sed -e "s|{{BG}}|$bg|g" \
      -e "s|{{FG}}|$fg|g" \
      -e "s|{{BG_CRIT}}|$bg_crit|g" \
      -e "s|{{FG_CRIT}}|$fg_crit|g" \
      -e "s|{{ACCENT}}|$accent|g" \
      -e "s|{{OK}}|$ok|g" \
      -e "s|{{URGENT}}|$urgent|g" \
      "$DUNST_TMPL" >"$DUNSTRC"
}

if [[ -f "$DUNST_TMPL" ]]; then
  case "$MODE" in
    wal)
      W=~/.cache/wal/colors.json
      render_dunstrc \
        "$(jq -r .special.background "$W")" \
        "$(jq -r .special.foreground "$W")" \
        "$(jq -r .colors.color0 "$W")" \
        "$(jq -r .special.foreground "$W")" \
        "$(jq -r .colors.color12 "$W")" \
        "$(jq -r .colors.color10 "$W")" \
        "$(jq -r .colors.color9 "$W")"
      ;;
    doomone)   render_dunstrc "#1c2028" "#bbc2cf" "#2b1517" "#ffdada" "#51afef" "#98be65" "#ff6c6b" ;;
    dracula)   render_dunstrc "#21222c" "#f8f8f2" "#3d1e2c" "#ffdada" "#bd93f9" "#50fa7b" "#ff5555" ;;
    nord)      render_dunstrc "#2e3440" "#d8dee9" "#3b1f22" "#ffdada" "#88c0d0" "#a3be8c" "#bf616a" ;;
    gruvbox)   render_dunstrc "#282828" "#ebdbb2" "#3c1f1c" "#ffdada" "#fabd2f" "#b8bb26" "#fb4934" ;;
    tokyonight) render_dunstrc "#1a1b26" "#c0caf5" "#3d1f2a" "#ffdada" "#7aa2f7" "#9ece6a" "#f7768e" ;;
    catppuccin) render_dunstrc "#1e1e2e" "#cdd6f4" "#3d1f2a" "#ffdada" "#cba6f7" "#a6e3a1" "#f38ba8" ;;
  esac
  # Restart dunst so it re-reads dunstrc
  pkill -x dunst 2>/dev/null || true
  sleep 0.2
  dunst >/dev/null 2>&1 &
  disown
fi

# ---- GTK overlay (pcmanfm + any GTK3/4 app that picks up @define-color) ----
# Writes ~/.cache/qtile/gtk-wal.css with wal-derived accent colors and
# ensures ~/.config/gtk-{3.0,4.0}/gtk.css @imports it. Underlying GTK
# theme (Sweet-Dark etc) still supplies structure; only the accents
# shift with the palette.
GTK_CSS="$CACHE_DIR/gtk-wal.css"
gen_gtk_css() {
  local bg="$1" bg_alt="$2" fg="$3" accent="$4" urgent="$5" ok="$6"
  cat >"$GTK_CSS" <<EOF
@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $bg;
@define-color window_bg_color $bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color $bg_alt;
@define-color headerbar_fg_color $fg;
@define-color card_bg_color $bg_alt;
@define-color card_fg_color $fg;
@define-color destructive_color $urgent;
@define-color destructive_bg_color $urgent;
@define-color success_color $ok;
@define-color success_bg_color $ok;
@define-color theme_selected_bg_color $accent;
@define-color theme_selected_fg_color $bg;
EOF
}

case "$MODE" in
  wal)
    W=~/.cache/wal/colors.json
    gen_gtk_css \
      "$(jq -r .special.background "$W")" \
      "$(jq -r .colors.color0 "$W")" \
      "$(jq -r .special.foreground "$W")" \
      "$(jq -r .colors.color12 "$W")" \
      "$(jq -r .colors.color9 "$W")" \
      "$(jq -r .colors.color10 "$W")"
    ;;
  doomone)   gen_gtk_css "#282c34" "#1e222a" "#dcdfe4" "#51afef" "#ff6c6b" "#98be65" ;;
  dracula)   gen_gtk_css "#282a36" "#21222c" "#f8f8f2" "#bd93f9" "#ff5555" "#50fa7b" ;;
  nord)      gen_gtk_css "#2e3440" "#3b4252" "#d8dee9" "#88c0d0" "#bf616a" "#a3be8c" ;;
  gruvbox)   gen_gtk_css "#282828" "#1d2021" "#ebdbb2" "#fabd2f" "#fb4934" "#b8bb26" ;;
  tokyonight) gen_gtk_css "#1a1b26" "#16161e" "#c0caf5" "#7aa2f7" "#f7768e" "#9ece6a" ;;
  catppuccin) gen_gtk_css "#1e1e2e" "#181825" "#cdd6f4" "#cba6f7" "#f38ba8" "#a6e3a1" ;;
esac

# Wire @import into gtk-3.0/gtk.css (create if missing)
ensure_gtk_import() {
  local target="$1"
  local marker="/* theme-apply wal overlay */"
  mkdir -p "$(dirname "$target")"
  touch "$target"
  if ! grep -q "theme-apply wal overlay" "$target" 2>/dev/null; then
    printf '\n%s\n@import url("%s");\n' "$marker" "$GTK_CSS" >>"$target"
  fi
}
ensure_gtk_import "$HOME/.config/gtk-3.0/gtk.css"
ensure_gtk_import "$HOME/.config/gtk-4.0/gtk.css"

# Restart pcmanfm so it re-reads GTK CSS
if pgrep -x pcmanfm >/dev/null; then
  pkill -x pcmanfm 2>/dev/null || true
  sleep 0.3
  DISPLAY="${DISPLAY:-:0}" pcmanfm --daemon-mode >/dev/null 2>&1 &
  disown
fi

# Reload qtile. reload_config doesn't refresh widget backgrounds that
# read colors[] at instantiation time, so also fire a restart which
# rebuilds every widget from scratch.
if command -v qtile >/dev/null; then
  qtile cmd-obj -o cmd -f reload_config 2>/dev/null || true
  qtile cmd-obj -o cmd -f restart 2>/dev/null || true
fi

# Reload qutebrowser: :config-source re-runs config.py (which reads the
# new palette). Then :reload --force-color-scheme actually rebuilds
# the current page so cached file:// CSS is dropped.
if pgrep -x qutebrowser >/dev/null; then
  qutebrowser ":config-source" 2>/dev/null || true
  qutebrowser ":reload -f" 2>/dev/null || true
fi

notify-send "theme-apply" "Theme -> $MODE"
