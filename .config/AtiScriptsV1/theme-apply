# Wire @import into gtk-3.0/gtk.css (create if missing)
ensure_gtk_import() {
  local target="$1"
  local marker="/* theme-apply wal overlay */"
  mkdir -p "$(dirname "$target")"
  touch "$target"
  if ! grep -q "theme-apply wal overlay" "$target" 2>/dev/null; then
    printf '\n%s\n@import url("%s");\n' "$marker" "$GTK_CSS" >>"$target"
  fi
}
ensure_gtk_import "$HOME/.config/gtk-3.0/gtk.css"
ensure_gtk_import "$HOME/.config/gtk-4.0/gtk.css"

# ---- Base GTK theme + icon theme swap per palette ----
# Sweet-Dark forces dark bg in all GTK apps (pcmanfm/nautilus etc); the
# per-palette @import overlay can't override background colors. Swap the
# BASE theme name + icon theme so light palettes actually render light.
case "$MODE" in
  mono-light) GTK_THEME="Breeze"; GTK_ICON="Papirus-Light" ;;
  *)          GTK_THEME="Sweet-Dark"; GTK_ICON="Papirus-Dark" ;;
esac
SETTINGS_INI="$HOME/.config/gtk-3.0/settings.ini"
if [[ -f "$SETTINGS_INI" ]]; then
  sed -i "s|^gtk-theme-name=.*|gtk-theme-name=$GTK_THEME|" "$SETTINGS_INI"
  sed -i "s|^gtk-application-prefer-dark-theme=.*|gtk-application-prefer-dark-theme=$([ "$MODE" = mono-light ] && echo 0 || echo 1)|" "$SETTINGS_INI"
  sed -i "s|^gtk-icon-theme-name=.*|gtk-icon-theme-name=$GTK_ICON|" "$SETTINGS_INI"
fi
# gtk-4.0 too
mkdir -p "$HOME/.config/gtk-4.0"
touch "$HOME/.config/gtk-4.0/settings.ini"

# ---- Papirus folder color per palette ----
# papirus-folders (yay -S papirus-folders papirus-icon-theme) accepts a
# fixed set of color keywords. Map the active accent hue to the closest
# one so folder icons follow the palette.
if command -v papirus-folders >/dev/null; then
  case "$MODE" in
    doomone|nord|kanagawa|oxocarbon|nightowl|onedark|palenight|github-dark) ICON_COLOR="blue" ;;
    dracula|catppuccin|rose-pine)    ICON_COLOR="violet" ;;
    gruvbox|monokai)                 ICON_COLOR="yellow" ;;
    tokyonight)                      ICON_COLOR="indigo" ;;
    everforest)                      ICON_COLOR="green" ;;
    cyberpunk-neon|synthwave)        ICON_COLOR="pink" ;;
    matrix)                          ICON_COLOR="green" ;;
    mono-dark|mono-light)            ICON_COLOR="grey" ;;
    ayu-mirage)                      ICON_COLOR="cyan" ;;
    wal)
      # Precompile JSON stores the mapped papirus_color directly; use
      # that when available. Fallback to hue-from-color9 for wallpapers
      # without a precompile cache entry.
      WSTEM="$(basename "$(cat "$HOME/.cache/wall" 2>/dev/null)" 2>/dev/null)"
      WSTEM="${WSTEM%.*}"
      ICON_COLOR_OVERRIDE=$(python3 -c "
import json,os
p=os.path.expanduser('~/.cache/qtile/palettes/$WSTEM.json')
if os.path.exists(p):
    pc = json.load(open(p)).get('papirus_color')
    if pc: print(pc)
" 2>/dev/null)
      if [[ -n "$ICON_COLOR_OVERRIDE" ]]; then
        ICON_COLOR="$ICON_COLOR_OVERRIDE"
        HUE=""
      else
        HUE=$(python3 -c "
import json,colorsys,os
d=json.load(open(os.path.expanduser('~/.cache/wal/colors.json')))
c=d['colors']['color9']
r,g,b=int(c[1:3],16)/255,int(c[3:5],16)/255,int(c[5:7],16)/255
print(int(colorsys.rgb_to_hsv(r,g,b)[0]*360))
")
      fi
      if [[ -n "$HUE" ]]; then
        if   (( HUE < 15 || HUE >= 345 )); then ICON_COLOR="red"
        elif (( HUE < 45 ));  then ICON_COLOR="orange"
        elif (( HUE < 65 ));  then ICON_COLOR="yellow"
        elif (( HUE < 165 )); then ICON_COLOR="green"
        elif (( HUE < 200 )); then ICON_COLOR="teal"
        elif (( HUE < 260 )); then ICON_COLOR="blue"
        elif (( HUE < 290 )); then ICON_COLOR="violet"
        elif (( HUE < 345 )); then ICON_COLOR="pink"
        else                       ICON_COLOR="blue"
        fi
      fi
      ;;
    *) ICON_COLOR="blue" ;;
  esac
  # papirus-folders swaps the folder-color symlink (fast, ~200ms).
  # -u would ALSO rebuild the whole theme icon cache (20+ seconds) —
  # not worth it: open pcmanfm windows won't hot-reload icons anyway,
  # and cold windows read the swapped symlink directly.
  # sudo -n stays non-interactive; needs NOPASSWD in /etc/sudoers.d.
  ( if ! sudo -n papirus-folders -C "$ICON_COLOR" -t "$GTK_ICON" >/dev/null 2>&1; then
      papirus-folders -C "$ICON_COLOR" -t "$GTK_ICON" >/dev/null 2>&1 \
        || notify-send "theme-apply" "papirus-folders needs passwordless sudo — icons stale"
    fi ) &
  disown
fi

# pcmanfm caches icons per-process — GTK provides no hot-reload API.
# Kill every pcmanfm (windows + daemon) and relaunch each visible
# window at $HOME. Preserves the "file manager is open" state at the
# cost of losing per-window cwd. Daemon restarts for desktop icons.
if pgrep -x pcmanfm >/dev/null 2>&1; then
  had_windows=0
  xdotool search --class "Pcmanfm" >/dev/null 2>&1 && had_windows=1
  pkill -x pcmanfm 2>/dev/null || true
  ( sleep 0.3
    DISPLAY="${DISPLAY:-:0}" pcmanfm --daemon-mode >/dev/null 2>&1 &
    if [[ "$had_windows" == 1 ]]; then
      DISPLAY="${DISPLAY:-:0}" pcmanfm "$HOME" >/dev/null 2>&1 &
    fi ) &
  disown
fi

# Try LIVE palette swap first (no restart). Walks bar widgets +
# decorations, remaps slot-matched hexes, redraws. Config.py exposes
# apply_palette_live() which returns True on success. Fall back to
# `restart` only if the live call fails or times out.
if command -v qtile >/dev/null; then
  LIVE_MARKER="$HOME/.cache/qtile/.palette_live_ok"
  rm -f "$LIVE_MARKER"
  # Multi-statement eval → success indicated by marker file, not
  # return value (qtile eval returns "" for exec paths).
  timeout 2 qtile cmd-obj -o cmd -f eval -a \
    'import sys; sys.path.insert(0, "/home/ati/.dotfiles/.config/qtile"); import config; config.apply_palette_live()' \
    >/dev/null 2>&1
  if [[ ! -f "$LIVE_MARKER" ]]; then
    # Live swap failed — fall back to full restart.
    setsid -f bash -c 'timeout 5 qtile cmd-obj -o cmd -f restart' \
      >/dev/null 2>&1 </dev/null || true
  fi
fi

# Reload qutebrowser + notify chrome/brave. qb has IPC; brave-family
# has no live-reload path (GTK theme change requires restart), so we
# notify the user instead of killing browser tabs.
if pgrep -x qutebrowser >/dev/null; then
  # :config-source alone doesn't re-read wal cache colors. :restart
  # reboots qb process preserving open tabs via session save/restore.
  ( timeout 3 qutebrowser ":config-source" 2>/dev/null
    timeout 3 qutebrowser ":restart" 2>/dev/null ) &
  disown
fi
# Regenerate a Chromium theme extension so brave/chrome UI colors track
