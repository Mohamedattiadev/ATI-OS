#!/usr/bin/env bash
# theme-apply <mode>
#
# Supported modes:
#   doomone dracula gruvbox nord tokyonight catppuccin  -> preset palette
#   wal                                                  -> pywal from ~/.cache/wall
#
# For each mode we symlink:
#   ~/.config/kitty/themes/current.conf     -> kitty palette (SIGUSR1 reloads live)
#   ~/.config/rofi/themes/current-palette.rasi -> rofi color vars
# then reload qtile so lib/colors.py picks up the new mode via
# ~/.cache/qtile/theme_mode.
#
# Wal mode passes -s -t and --saturate 0.75 to punch up dim wallpapers.

set -euo pipefail

MODE="${1:-doomone}"
CACHE_DIR="$HOME/.cache/qtile"
STATE_FILE="$CACHE_DIR/theme_mode"

mkdir -p "$CACHE_DIR"

PRESETS=(doomone dracula gruvbox nord tokyonight catppuccin monokai everforest rose-pine kanagawa oxocarbon)

is_preset() {
  local m="$1"
  for p in "${PRESETS[@]}"; do
    [[ "$p" == "$m" ]] && return 0
  done
  return 1
}

if [[ "$MODE" != "wal" ]] && ! is_preset "$MODE"; then
  echo "usage: theme-apply <doomone|dracula|gruvbox|nord|tokyonight|catppuccin|monokai|everforest|rose-pine|kanagawa|oxocarbon|wal>" >&2
  exit 1
fi

KITTY_THEMES="$HOME/.config/kitty/themes"
ROFI_THEMES="$HOME/.config/rofi/themes"

if [[ "$MODE" == "wal" ]]; then
  if ! command -v wal >/dev/null; then
    notify-send -u critical "theme-apply" "pywal not installed"
    exit 1
  fi
  WALL_LINK="$HOME/.cache/wall"
  if [[ ! -f "$WALL_LINK" ]]; then
    notify-send -u critical "theme-apply" "~/.cache/wall missing — set a wallpaper first"
    exit 1
  fi
  WALL_PATH="$(cat "$WALL_LINK")"
  WALL_STEM="$(basename "$WALL_PATH")"; WALL_STEM="${WALL_STEM%.*}"
  PRECOMPILED="$HOME/.cache/qtile/palettes/$WALL_STEM.json"

  if [[ -f "$PRECOMPILED" ]]; then
    # Fast path: precompiled palette contains pre-rendered consumer
    # templates. Write them directly, skip wal binary + wal -R.
    mkdir -p "$HOME/.cache/wal" "$HOME/.config/qtile/browser-theme"
    python3 - "$PRECOMPILED" "$KITTY_THEMES" "$ROFI_THEMES" <<'PYEOF' 2>/dev/null || true
import json, os, sys, time
src   = json.load(open(sys.argv[1]))
kdir  = sys.argv[2]
rdir  = sys.argv[3]
cons  = src["consumers"]
def w(p, s):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    open(p, "w").write(s)
w(os.path.expanduser("~/.cache/wal/colors.json"),
  json.dumps(src["wal_colors"], indent=4))
w(os.path.expanduser("~/.cache/wal/colors-kitty.conf"),
  cons["kitty_conf"])
w(os.path.join(rdir, "palette-wal.rasi"), cons["rofi_rasi"])
# also emit a minimal colors-wal.vim so any tool still expecting it works
wc = src["wal_colors"]["colors"]
w(os.path.expanduser("~/.cache/wal/colors-wal.vim"),
  "let background = \"{}\"\n".format(src["bg"]) +
  "let foreground = \"{}\"\n".format(src["fg"]) +
  "".join(f'let color{i} = "{wc["color"+str(i)]}"\n' for i in range(16)))
# brave manifest with fresh version so chromium reloads
mf = dict(cons["brave_theme"])
mf["version"] = "1.0." + str(int(time.time()))
w(os.path.expanduser("~/.config/qtile/browser-theme/manifest.json"),
  json.dumps(mf, indent=2))
# gtk css overlay (~/.cache/qtile/gtk-wal.css already @imported)
w(os.path.expanduser("~/.cache/qtile/gtk-wal.css"), cons["gtk_css"])
PYEOF
    # Skip wal -R: precompiled templates already cover kitty+rofi+brave+gtk.
    ln -sfn "$HOME/.cache/wal/colors-kitty.conf" "$KITTY_THEMES/current.conf"
    ln -sfn palette-wal.rasi "$ROFI_THEMES/current-palette.rasi"
    PRECOMPILED_APPLIED=1
  else
    # Fallback: live wal extraction. Colorz backend + saturation punch.
    wal --backend colorz -i "$WALL_PATH" -n -s -t -q --saturate 1.0 2>/dev/null \
      || wal -i "$WALL_PATH" -n -s -t -q --saturate 1.0 2>/dev/null

    # Monochrome / desaturated wallpapers produce useless palettes (all
    # one hue). Detect via HSV hue spread AND mean saturation on
    # color9-14; if either fails, overwrite accents with DoomOne while
    # keeping wal bg/fg. Thresholds match WAL_AUDIT_REPORT.md findings.
    python3 <<'PYEOF' 2>/dev/null || true
import json, os, colorsys
p = os.path.expanduser("~/.cache/wal/colors.json")
with open(p) as f:
    d = json.load(f)
accents = [d["colors"][f"color{i}"] for i in range(9, 15)]
def hsv(hx):
    r, g, b = int(hx[1:3],16)/255, int(hx[3:5],16)/255, int(hx[5:7],16)/255
    return colorsys.rgb_to_hsv(r, g, b)
hs = [hsv(a)[0] * 360 for a in accents]
ss = [hsv(a)[1] for a in accents]
spread = max(hs) - min(hs)
sat_mean = sum(ss) / len(ss)
if spread < 60 or sat_mean < 0.25:
    doomone = {
        "color1":"#ff6c6b","color9":"#ff6c6b",
        "color2":"#98be65","color10":"#98be65",
        "color3":"#da8548","color11":"#da8548",
        "color4":"#51afef","color12":"#51afef",
        "color5":"#c678dd","color13":"#c678dd",
        "color6":"#46d9ff","color14":"#46d9ff",
    }
    d["colors"].update(doomone)
    with open(p, "w") as f:
        json.dump(d, f, indent=4)
PYEOF
  fi

  if [[ "${PRECOMPILED_APPLIED:-0}" != 1 ]]; then
    # No precompile — legacy path needs wal -R to regenerate kitty conf
    # then build rofi rasi from live wal cache.
    wal -R -q 2>/dev/null || true
    BG="$(jq -r .special.background ~/.cache/wal/colors.json)"
    FG="$(jq -r .special.foreground ~/.cache/wal/colors.json)"
    BG_ALT="$(jq -r .colors.color0 ~/.cache/wal/colors.json)"
    SEL="$(jq -r .colors.color14 ~/.cache/wal/colors.json)"
    SEL2="$(jq -r .colors.color12 ~/.cache/wal/colors.json)"
    URG="$(jq -r .colors.color9 ~/.cache/wal/colors.json)"
    ACT="$(jq -r .colors.color10 ~/.cache/wal/colors.json)"
    cat >"$ROFI_THEMES/palette-wal.rasi" <<EOF
* {
    background:     $BG;
    background-alt: $BG_ALT;
    foreground:     $FG;
    selected:       $SEL;
    selectedone:    $SEL2;
    urgent:         $URG;
    active:         $ACT;
}
EOF
    ln -sfn "$HOME/.cache/wal/colors-kitty.conf" "$KITTY_THEMES/current.conf"
    ln -sfn palette-wal.rasi "$ROFI_THEMES/current-palette.rasi"
  fi
else
  ln -sfn "$MODE.conf" "$KITTY_THEMES/current.conf"
  ln -sfn "palette-$MODE.rasi" "$ROFI_THEMES/current-palette.rasi"
fi

# ---- Qutebrowser homepage CSS vars ----
# Inline the palette into homepage.html between BEGIN-THEME-VARS /
# END-THEME-VARS markers. Editing the HTML itself defeats file:// CSS
# caching that file:// stylesheets have for the qutebrowser --temp
# window used by the homepage.
QB_HTML="$HOME/.config/qutebrowser/html/homepage.html"
gen_qb_css() {
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  [[ -f "$QB_HTML" ]] || return
  python3 - "$QB_HTML" "$bg" "$bg_alt" "$fg" "$red" "$green" "$yellow" "$blue" "$purple" "$cyan" <<'PYEOF'
import sys, re
path = sys.argv[1]
bg, bg_alt, fg, red, green, yellow, blue, purple, cyan = sys.argv[2:11]
with open(path) as f:
    src = f.read()
block = (
    "    <!-- BEGIN-THEME-VARS (rewritten by theme-apply) -->\n"
    "    <style id=\"theme-vars\">\n"
    "      :root {\n"
    f"        --bg: {bg};\n"
    f"        --bg-alt: {bg_alt};\n"
    f"        --fg: {fg};\n"
    f"        --red: {red};\n"
    f"        --green: {green};\n"
    f"        --yellow: {yellow};\n"
    f"        --blue: {blue};\n"
    f"        --purple: {purple};\n"
    f"        --cyan: {cyan};\n"
    "      }\n"
    "    </style>\n"
    "    <!-- END-THEME-VARS -->"
)
new = re.sub(
    r"    <!-- BEGIN-THEME-VARS.*?<!-- END-THEME-VARS -->",
    block,
    src,
    count=1,
    flags=re.DOTALL,
)
with open(path, 'w') as f:
    f.write(new)
PYEOF
}

case "$MODE" in
  wal)
    W=~/.cache/wal/colors.json
    gen_qb_css \
      "$(jq -r .special.background "$W")" \
      "$(jq -r .colors.color0 "$W")" \
      "$(jq -r .special.foreground "$W")" \
      "$(jq -r .colors.color9 "$W")" \
      "$(jq -r .colors.color10 "$W")" \
      "$(jq -r .colors.color11 "$W")" \
      "$(jq -r .colors.color12 "$W")" \
      "$(jq -r .colors.color13 "$W")" \
      "$(jq -r .colors.color14 "$W")"
    ;;
  doomone)   gen_qb_css "#282c34" "#1e222a" "#dcdfe4" "#ff6c6b" "#98be65" "#ecbe7b" "#51afef" "#c678dd" "#46d9ff" ;;
  dracula)   gen_qb_css "#282a36" "#21222c" "#f8f8f2" "#ff5555" "#50fa7b" "#f1fa8c" "#bd93f9" "#ff79c6" "#8be9fd" ;;
  nord)      gen_qb_css "#2e3440" "#3b4252" "#d8dee9" "#bf616a" "#a3be8c" "#ebcb8b" "#81a1c1" "#b48ead" "#88c0d0" ;;
  gruvbox)   gen_qb_css "#282828" "#1d2021" "#ebdbb2" "#fb4934" "#b8bb26" "#fabd2f" "#83a598" "#d3869b" "#8ec07c" ;;
  tokyonight) gen_qb_css "#1a1b26" "#16161e" "#c0caf5" "#f7768e" "#9ece6a" "#e0af68" "#7aa2f7" "#bb9af7" "#7dcfff" ;;
  catppuccin) gen_qb_css "#1e1e2e" "#181825" "#cdd6f4" "#f38ba8" "#a6e3a1" "#f9e2af" "#89b4fa" "#cba6f7" "#94e2d5" ;;
  monokai)   gen_qb_css "#272822" "#1e1f1c" "#f8f8f2" "#f92672" "#a6e22e" "#f4bf75" "#66d9ef" "#ae81ff" "#a1efe4" ;;
  everforest) gen_qb_css "#2d353b" "#232a2e" "#d3c6aa" "#e67e80" "#a7c080" "#dbbc7f" "#7fbbb3" "#d699b6" "#83c092" ;;
  rose-pine) gen_qb_css "#191724" "#1f1d2e" "#e0def4" "#eb6f92" "#31748f" "#f6c177" "#9ccfd8" "#c4a7e7" "#ebbcba" ;;
  kanagawa)  gen_qb_css "#1f1f28" "#16161d" "#dcd7ba" "#e46876" "#98bb6c" "#e6c384" "#7e9cd8" "#957fb8" "#7aa89f" ;;
  oxocarbon) gen_qb_css "#161616" "#262626" "#f2f4f8" "#ee5396" "#42be65" "#ffe97b" "#33b1ff" "#be95ff" "#3ddbd9" ;;
esac

echo "$MODE" >"$STATE_FILE"

# Live-reload all running kitty instances. kitty listens on
# unix:/tmp/kitty-<pid>, one socket per top-level kitty. SIGUSR1 alone
# rereads the config but the include'd palette file often stays cached,
# so push the palette explicitly via `kitty @ set-colors --all`.
# Fan out to every live kitty in parallel so one hung instance doesn't
# serialize the rest at 1s each. wait ensures we still see if all fired.
for sock in /tmp/kitty-*; do
  [[ -S "$sock" ]] || continue
  timeout 1 kitty @ --to "unix:$sock" set-colors --all --configured \
    "$KITTY_THEMES/current.conf" 2>/dev/null &
done
for pid in $(pgrep -x kitty || true); do
  kill -SIGUSR1 "$pid" 2>/dev/null || true
done
wait 2>/dev/null || true

# ---- Dunst ----
# Render dunstrc from ~/.dotfiles/.config/dunst/dunstrc.tmpl with palette
# substitutions. Retint only the 3 urgency levels + global frame_color;
# named notification classes (success/warning/todo/spotify/etc) keep
# their semantic hardcoded colors.
DUNSTRC="$HOME/.config/dunst/dunstrc"
DUNST_TMPL="$HOME/.dotfiles/.config/dunst/dunstrc.tmpl"
render_dunstrc() {
  local bg="$1" fg="$2" bg_crit="$3" fg_crit="$4" accent="$5" ok="$6" urgent="$7"
  # Break any stow symlink to dunstrc — we'll manage the real file now.
  [[ -L "$DUNSTRC" ]] && rm "$DUNSTRC"
  sed -e "s|{{BG}}|$bg|g" \
      -e "s|{{FG}}|$fg|g" \
      -e "s|{{BG_CRIT}}|$bg_crit|g" \
      -e "s|{{FG_CRIT}}|$fg_crit|g" \
      -e "s|{{ACCENT}}|$accent|g" \
      -e "s|{{OK}}|$ok|g" \
      -e "s|{{URGENT}}|$urgent|g" \
      "$DUNST_TMPL" >"$DUNSTRC"
}

if [[ -f "$DUNST_TMPL" ]]; then
  case "$MODE" in
    wal)
      W=~/.cache/wal/colors.json
      render_dunstrc \
        "$(jq -r .special.background "$W")" \
        "$(jq -r .special.foreground "$W")" \
        "$(jq -r .colors.color0 "$W")" \
        "$(jq -r .special.foreground "$W")" \
        "$(jq -r .colors.color12 "$W")" \
        "$(jq -r .colors.color10 "$W")" \
        "$(jq -r .colors.color9 "$W")"
      ;;
    doomone)   render_dunstrc "#1c2028" "#bbc2cf" "#2b1517" "#ffdada" "#51afef" "#98be65" "#ff6c6b" ;;
    dracula)   render_dunstrc "#21222c" "#f8f8f2" "#3d1e2c" "#ffdada" "#bd93f9" "#50fa7b" "#ff5555" ;;
    nord)      render_dunstrc "#2e3440" "#d8dee9" "#3b1f22" "#ffdada" "#88c0d0" "#a3be8c" "#bf616a" ;;
    gruvbox)   render_dunstrc "#282828" "#ebdbb2" "#3c1f1c" "#ffdada" "#fabd2f" "#b8bb26" "#fb4934" ;;
    tokyonight) render_dunstrc "#1a1b26" "#c0caf5" "#3d1f2a" "#ffdada" "#7aa2f7" "#9ece6a" "#f7768e" ;;
    catppuccin) render_dunstrc "#1e1e2e" "#cdd6f4" "#3d1f2a" "#ffdada" "#cba6f7" "#a6e3a1" "#f38ba8" ;;
    monokai)   render_dunstrc "#272822" "#f8f8f2" "#3d1f2a" "#ffdada" "#66d9ef" "#a6e22e" "#f92672" ;;
    everforest) render_dunstrc "#2d353b" "#d3c6aa" "#3d1f22" "#ffdada" "#7fbbb3" "#a7c080" "#e67e80" ;;
    rose-pine) render_dunstrc "#191724" "#e0def4" "#3d1f2a" "#ffdada" "#c4a7e7" "#9ccfd8" "#eb6f92" ;;
    kanagawa)  render_dunstrc "#1f1f28" "#dcd7ba" "#3d1f22" "#ffdada" "#7e9cd8" "#98bb6c" "#e46876" ;;
    oxocarbon) render_dunstrc "#161616" "#f2f4f8" "#3d1f2a" "#ffdada" "#33b1ff" "#42be65" "#ee5396" ;;
  esac
  # Restart dunst so it re-reads dunstrc
  pkill -x dunst 2>/dev/null || true
  sleep 0.2
  dunst >/dev/null 2>&1 &
  disown
fi

# ---- GTK overlay (pcmanfm + any GTK3/4 app that picks up @define-color) ----
# Writes ~/.cache/qtile/gtk-wal.css with wal-derived accent colors and
# ensures ~/.config/gtk-{3.0,4.0}/gtk.css @imports it. Underlying GTK
# theme (Sweet-Dark etc) still supplies structure; only the accents
# shift with the palette.
GTK_CSS="$CACHE_DIR/gtk-wal.css"
gen_gtk_css() {
  local bg="$1" bg_alt="$2" fg="$3" accent="$4" urgent="$5" ok="$6"
  cat >"$GTK_CSS" <<EOF
@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $bg;
@define-color window_bg_color $bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color $bg_alt;
@define-color headerbar_fg_color $fg;
@define-color card_bg_color $bg_alt;
@define-color card_fg_color $fg;
@define-color destructive_color $urgent;
@define-color destructive_bg_color $urgent;
@define-color success_color $ok;
@define-color success_bg_color $ok;
@define-color theme_selected_bg_color $accent;
@define-color theme_selected_fg_color $bg;
EOF
}

case "$MODE" in
  wal)
    W=~/.cache/wal/colors.json
    gen_gtk_css \
      "$(jq -r .special.background "$W")" \
      "$(jq -r .colors.color0 "$W")" \
      "$(jq -r .special.foreground "$W")" \
      "$(jq -r .colors.color12 "$W")" \
      "$(jq -r .colors.color9 "$W")" \
      "$(jq -r .colors.color10 "$W")"
    ;;
  doomone)   gen_gtk_css "#282c34" "#1e222a" "#dcdfe4" "#51afef" "#ff6c6b" "#98be65" ;;
  dracula)   gen_gtk_css "#282a36" "#21222c" "#f8f8f2" "#bd93f9" "#ff5555" "#50fa7b" ;;
  nord)      gen_gtk_css "#2e3440" "#3b4252" "#d8dee9" "#88c0d0" "#bf616a" "#a3be8c" ;;
  gruvbox)   gen_gtk_css "#282828" "#1d2021" "#ebdbb2" "#fabd2f" "#fb4934" "#b8bb26" ;;
  tokyonight) gen_gtk_css "#1a1b26" "#16161e" "#c0caf5" "#7aa2f7" "#f7768e" "#9ece6a" ;;
  catppuccin) gen_gtk_css "#1e1e2e" "#181825" "#cdd6f4" "#cba6f7" "#f38ba8" "#a6e3a1" ;;
  monokai)   gen_gtk_css "#272822" "#1e1f1c" "#f8f8f2" "#66d9ef" "#f92672" "#a6e22e" ;;
  everforest) gen_gtk_css "#2d353b" "#232a2e" "#d3c6aa" "#7fbbb3" "#e67e80" "#a7c080" ;;
  rose-pine) gen_gtk_css "#191724" "#1f1d2e" "#e0def4" "#c4a7e7" "#eb6f92" "#9ccfd8" ;;
  kanagawa)  gen_gtk_css "#1f1f28" "#16161d" "#dcd7ba" "#7e9cd8" "#e46876" "#98bb6c" ;;
  oxocarbon) gen_gtk_css "#161616" "#262626" "#f2f4f8" "#33b1ff" "#ee5396" "#42be65" ;;
esac

# Wire @import into gtk-3.0/gtk.css (create if missing)
ensure_gtk_import() {
  local target="$1"
  local marker="/* theme-apply wal overlay */"
  mkdir -p "$(dirname "$target")"
  touch "$target"
  if ! grep -q "theme-apply wal overlay" "$target" 2>/dev/null; then
    printf '\n%s\n@import url("%s");\n' "$marker" "$GTK_CSS" >>"$target"
  fi
}
ensure_gtk_import "$HOME/.config/gtk-3.0/gtk.css"
ensure_gtk_import "$HOME/.config/gtk-4.0/gtk.css"

# ---- Papirus folder color per palette ----
# papirus-folders (yay -S papirus-folders papirus-icon-theme) accepts a
# fixed set of color keywords. Map the active accent hue to the closest
# one so folder icons follow the palette.
if command -v papirus-folders >/dev/null; then
  case "$MODE" in
    doomone|nord|kanagawa|oxocarbon) ICON_COLOR="blue" ;;
    dracula|catppuccin|rose-pine)    ICON_COLOR="violet" ;;
    gruvbox|monokai)                 ICON_COLOR="yellow" ;;
    tokyonight)                      ICON_COLOR="indigo" ;;
    everforest)                      ICON_COLOR="green" ;;
    wal)
      # Precompile JSON stores the mapped papirus_color directly; use
      # that when available. Fallback to hue-from-color9 for wallpapers
      # without a precompile cache entry.
      WSTEM="$(basename "$(cat "$HOME/.cache/wall" 2>/dev/null)" 2>/dev/null)"
      WSTEM="${WSTEM%.*}"
      ICON_COLOR_OVERRIDE=$(python3 -c "
import json,os
p=os.path.expanduser('~/.cache/qtile/palettes/$WSTEM.json')
if os.path.exists(p):
    pc = json.load(open(p)).get('papirus_color')
    if pc: print(pc)
" 2>/dev/null)
      if [[ -n "$ICON_COLOR_OVERRIDE" ]]; then
        ICON_COLOR="$ICON_COLOR_OVERRIDE"
        HUE=""
      else
        HUE=$(python3 -c "
import json,colorsys,os
d=json.load(open(os.path.expanduser('~/.cache/wal/colors.json')))
c=d['colors']['color9']
r,g,b=int(c[1:3],16)/255,int(c[3:5],16)/255,int(c[5:7],16)/255
print(int(colorsys.rgb_to_hsv(r,g,b)[0]*360))
")
      fi
      if [[ -n "$HUE" ]]; then
        if   (( HUE < 15 || HUE >= 345 )); then ICON_COLOR="red"
        elif (( HUE < 45 ));  then ICON_COLOR="orange"
        elif (( HUE < 65 ));  then ICON_COLOR="yellow"
        elif (( HUE < 165 )); then ICON_COLOR="green"
        elif (( HUE < 200 )); then ICON_COLOR="teal"
        elif (( HUE < 260 )); then ICON_COLOR="blue"
        elif (( HUE < 290 )); then ICON_COLOR="violet"
        elif (( HUE < 345 )); then ICON_COLOR="pink"
        else                       ICON_COLOR="blue"
        fi
      fi
      ;;
    *) ICON_COLOR="blue" ;;
  esac
  # papirus-folders swaps the folder-color symlink (fast, ~200ms).
  # -u would ALSO rebuild the whole theme icon cache (20+ seconds) —
  # not worth it: open pcmanfm windows won't hot-reload icons anyway,
  # and cold windows read the swapped symlink directly.
  # sudo -n stays non-interactive; needs NOPASSWD in /etc/sudoers.d.
  ( if ! sudo -n papirus-folders -C "$ICON_COLOR" -t Papirus-Dark >/dev/null 2>&1; then
      papirus-folders -C "$ICON_COLOR" -t Papirus-Dark >/dev/null 2>&1 \
        || notify-send "theme-apply" "papirus-folders needs passwordless sudo — icons stale"
    fi ) &
  disown

  # Ensure GTK icon theme is Papirus-Dark (rewrite settings.ini once)
  SETTINGS_INI="$HOME/.config/gtk-3.0/settings.ini"
  if [[ -f "$SETTINGS_INI" ]] && ! grep -q '^gtk-icon-theme-name=Papirus-Dark' "$SETTINGS_INI"; then
    sed -i 's|^gtk-icon-theme-name=.*|gtk-icon-theme-name=Papirus-Dark|' "$SETTINGS_INI"
  fi
fi

# pcmanfm caches icons per-process — GTK provides no hot-reload API.
# Kill every pcmanfm (windows + daemon) and relaunch each visible
# window at $HOME. Preserves the "file manager is open" state at the
# cost of losing per-window cwd. Daemon restarts for desktop icons.
if pgrep -x pcmanfm >/dev/null 2>&1; then
  had_windows=0
  xdotool search --class "Pcmanfm" >/dev/null 2>&1 && had_windows=1
  pkill -x pcmanfm 2>/dev/null || true
  ( sleep 0.3
    DISPLAY="${DISPLAY:-:0}" pcmanfm --daemon-mode >/dev/null 2>&1 &
    if [[ "$had_windows" == 1 ]]; then
      DISPLAY="${DISPLAY:-:0}" pcmanfm "$HOME" >/dev/null 2>&1 &
    fi ) &
  disown
fi

# Reload qtile. reload_config re-imports colors.py so widgets that
# recompute their colors from the module (screens.py) refresh on
# reload. Full restart was 5-10x slower and froze the compositor when
# invoked from the WallpaperPopup path. Detach anyway.
if command -v qtile >/dev/null; then
  setsid -f bash -c 'timeout 3 qtile cmd-obj -o cmd -f reload_config' \
    >/dev/null 2>&1 </dev/null || true
fi

# Reload qutebrowser + notify chrome/brave. qb has IPC; brave-family
# has no live-reload path (GTK theme change requires restart), so we
# notify the user instead of killing browser tabs.
if pgrep -x qutebrowser >/dev/null; then
  # :config-source alone doesn't re-read wal cache colors. :restart
  # reboots qb process preserving open tabs via session save/restore.
  ( timeout 3 qutebrowser ":config-source" 2>/dev/null
    timeout 3 qutebrowser ":restart" 2>/dev/null ) &
  disown
fi
# Regenerate a Chromium theme extension so brave/chrome UI colors track
# the wallpaper. --load-extension=<dir> in *-flags.conf keeps it loaded
# across launches. Extension is a bare theme manifest; each apply
# rewrites the manifest with new palette RGB triples, then restarts
# each running browser so the theme swap takes effect.
BROWSER_EXT="$HOME/.config/qtile/browser-theme"
mkdir -p "$BROWSER_EXT"
# Skip regeneration if wal fast path already wrote a fresh manifest.
if [[ "${PRECOMPILED_APPLIED:-0}" != 1 ]]; then
python3 - "$BROWSER_EXT/manifest.json" "$MODE" <<'PYEOF' 2>/dev/null || true
import json, os, sys, colorsys, time
outp, mode = sys.argv[1], sys.argv[2]
def hx(s): return [int(s[i:i+2],16) for i in (1,3,5)]
def hls(s):
    r,g,b = [int(s[i:i+2],16)/255 for i in (1,3,5)]
    return colorsys.rgb_to_hls(r,g,b)
def hex_from_hls(h,l,s):
    r,g,b = colorsys.hls_to_rgb(h,l,s)
    return "#{:02x}{:02x}{:02x}".format(int(r*255),int(g*255),int(b*255))
if mode == "wal":
    d = json.load(open(os.path.expanduser("~/.cache/wal/colors.json")))
    bg = d["special"]["background"]; fg = d["special"]["foreground"]
    c  = d["colors"]
    accent = c["color4"]; alt = c["color0"]
else:
    # preset palettes hard-coded to match theme-apply per-mode blocks
    presets = {
      "doomone":   ("#282c34","#dcdfe4","#1e222a","#51afef"),
      "dracula":   ("#282a36","#f8f8f2","#21222c","#bd93f9"),
      "nord":      ("#2e3440","#d8dee9","#3b4252","#88c0d0"),
      "gruvbox":   ("#282828","#ebdbb2","#1d2021","#fabd2f"),
      "tokyonight":("#1a1b26","#c0caf5","#16161e","#7aa2f7"),
      "catppuccin":("#1e1e2e","#cdd6f4","#181825","#cba6f7"),
      "monokai":   ("#272822","#f8f8f2","#1e1f1c","#66d9ef"),
      "everforest":("#2d353b","#d3c6aa","#232a2e","#7fbbb3"),
      "rose-pine": ("#191724","#e0def4","#1f1d2e","#c4a7e7"),
      "kanagawa":  ("#1f1f28","#dcd7ba","#16161d","#7e9cd8"),
      "oxocarbon": ("#161616","#f2f4f8","#262626","#33b1ff"),
    }
    bg, fg, alt, accent = presets.get(mode, presets["doomone"])
def rgb(h): return hx(h)
manifest = {
  "manifest_version": 3,
  # Bump version each apply so Chromium detects an "update" and
  # reloads the theme instead of keeping the cached previous colors.
  "version": "1.0." + str(int(time.time())),
  "name": "Wal Theme",
  "description": "Generated by theme-apply.",
  "theme": {
    "colors": {
      "frame":               rgb(alt),
      "frame_inactive":      rgb(alt),
      "frame_incognito":     rgb(alt),
      "toolbar":             rgb(bg),
      "tab_text":            rgb(fg),
      "tab_background_text": rgb(fg),
      "bookmark_text":       rgb(fg),
      "ntp_background":      rgb(bg),
      "ntp_text":            rgb(fg),
      "ntp_link":            rgb(accent),
      "button_background":   rgb(alt),
      "omnibox_background":  rgb(alt),
      "omnibox_text":        rgb(fg),
    }
  }
}
open(outp,"w").write(json.dumps(manifest, indent=2))
PYEOF
fi

# Ensure --load-extension flag is in each browser's flags file so the
# theme extension survives restart.
add_load_ext() {
  local f="$1"
  [[ -f "$f" ]] || return
  local line="--load-extension=$BROWSER_EXT"
  grep -q -- "--load-extension=" "$f" 2>/dev/null && return
  printf '\n%s\n' "$line" >>"$f"
}
add_load_ext "$HOME/.config/brave-flags.conf"
add_load_ext "$HOME/.config/chromium-flags.conf"
add_load_ext "$HOME/.config/chrome-flags.conf"

BROWSER_CRX="$HOME/.config/qtile/browser-theme.crx"
BROWSER_PEM="$HOME/.config/qtile/browser-theme.pem"
BROWSER_UPDATES="$HOME/.config/qtile/browser-theme-updates.xml"
EXT_ID="fommfacojlllmdogognehdgombidbpjg"

# brave/chrome/chromium have no live-theme-reload API. Kill running
# browsers FIRST, then repack .crx (chrome pack needs no lock), then
# relaunch — so chrome sees the fresh crx + bumped updates.xml on
# startup and force-installs. Set THEME_APPLY_NO_BROWSER=1 to skip.
if [[ "${THEME_APPLY_NO_BROWSER:-0}" != 1 ]]; then
  RESTART_PROCS=()
  for proc in brave chromium chrome google-chrome brave-browser; do
    if pgrep -x "$proc" >/dev/null 2>&1; then
      RESTART_PROCS+=("$proc")
      pkill -x "$proc" 2>/dev/null || true
    fi
  done
  # Wait for locks to release before repack.
  [[ ${#RESTART_PROCS[@]} -gt 0 ]] && sleep 1

  # Repack .crx + bump updates.xml (chrome policy force-installs on
  # next launch). Now safe: no chrome process holding the pack lock.
  if [[ -f "$BROWSER_PEM" ]] && [[ -x /opt/google/chrome/chrome ]]; then
    CHROME_BIN="${CHROME_BIN:-/opt/google/chrome/chrome}"
    "$CHROME_BIN" --pack-extension="$BROWSER_EXT" --pack-extension-key="$BROWSER_PEM" --no-message-box >/dev/null 2>&1 || true
    VER=$(python3 -c "import json;print(json.load(open('$BROWSER_EXT/manifest.json'))['version'])" 2>/dev/null)
    if [[ -n "$VER" ]]; then
      cat > "$BROWSER_UPDATES" <<EOF
<?xml version='1.0' encoding='UTF-8'?>
<gupdate xmlns='http://www.google.com/update2/response' protocol='2.0'>
  <app appid='$EXT_ID'>
    <updatecheck codebase='file://$BROWSER_CRX' version='$VER' />
  </app>
</gupdate>
EOF
    fi
    # Chrome caches installed extension + polls update_url only every
    # few hours. Purge cached extension dir so force_installed policy
    # reinstalls fresh .crx on next launch. Same for chromium.
    for prof in \
      "$HOME/.config/google-chrome/Default/Extensions/$EXT_ID" \
      "$HOME/.config/chromium/Default/Extensions/$EXT_ID"; do
      [[ -d "$prof" ]] && rm -rf "$prof"
    done
  fi

  # Relaunch each killed browser. Map process name → binary path since
  # `chrome`/`chromium` are not in PATH on Arch (installed under /opt).
  browser_bin() {
    case "$1" in
      chrome|google-chrome) echo "/opt/google/chrome/chrome" ;;
      brave|brave-browser)  echo "$(command -v brave || echo /opt/brave-bin/brave)" ;;
      chromium)             echo "$(command -v chromium || echo /usr/bin/chromium)" ;;
      *) command -v "$1" ;;
    esac
  }
  for proc in "${RESTART_PROCS[@]}"; do
    bin=$(browser_bin "$proc")
    [[ -x "$bin" ]] || continue
    ( DISPLAY="${DISPLAY:-:0}" setsid "$bin" >/dev/null 2>&1 </dev/null & disown ) &
    disown
  done
fi

notify-send "theme-apply" "Theme -> $MODE"
