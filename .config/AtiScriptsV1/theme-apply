# Ensure --load-extension flag is in each browser's flags file so the
# theme extension survives restart.
add_load_ext() {
  local f="$1"
  [[ -f "$f" ]] || return
  local line="--load-extension=$BROWSER_EXT"
  grep -q -- "--load-extension=" "$f" 2>/dev/null && return
  printf '\n%s\n' "$line" >>"$f"
}
add_load_ext "$HOME/.config/brave-flags.conf"
add_load_ext "$HOME/.config/chromium-flags.conf"
add_load_ext "$HOME/.config/chrome-flags.conf"

BROWSER_CRX="$HOME/.config/qtile/browser-theme.crx"
BROWSER_PEM="$HOME/.config/qtile/browser-theme.pem"
BROWSER_UPDATES="$HOME/.config/qtile/browser-theme-updates.xml"
EXT_ID="fommfacojlllmdogognehdgombidbpjg"

# brave/chrome/chromium have no live-theme-reload API. Kill running
# browsers FIRST, then repack .crx (chrome pack needs no lock), then
# relaunch — so chrome sees the fresh crx + bumped updates.xml on
# startup and force-installs. Set THEME_APPLY_NO_BROWSER=1 to skip.
if [[ "${THEME_APPLY_NO_BROWSER:-0}" != 1 ]]; then
  RESTART_PROCS=()
  for proc in brave chromium chrome google-chrome brave-browser; do
    if pgrep -x "$proc" >/dev/null 2>&1; then
      RESTART_PROCS+=("$proc")
      pkill -x "$proc" 2>/dev/null || true
    fi
  done
  # Wait for locks to release before repack.
  [[ ${#RESTART_PROCS[@]} -gt 0 ]] && sleep 1

  # Repack .crx + bump updates.xml (chrome policy force-installs on
  # next launch). Now safe: no chrome process holding the pack lock.
  if [[ -f "$BROWSER_PEM" ]] && [[ -x /opt/google/chrome/chrome ]]; then
    CHROME_BIN="${CHROME_BIN:-/opt/google/chrome/chrome}"
    "$CHROME_BIN" --pack-extension="$BROWSER_EXT" --pack-extension-key="$BROWSER_PEM" --no-message-box >/dev/null 2>&1 || true
    VER=$(python3 -c "import json;print(json.load(open('$BROWSER_EXT/manifest.json'))['version'])" 2>/dev/null)
    if [[ -n "$VER" ]]; then
      cat > "$BROWSER_UPDATES" <<EOF
<?xml version='1.0' encoding='UTF-8'?>
<gupdate xmlns='http://www.google.com/update2/response' protocol='2.0'>
  <app appid='$EXT_ID'>
    <updatecheck codebase='file://$BROWSER_CRX' version='$VER' />
  </app>
</gupdate>
EOF
    fi
    # Chrome caches the installed .crx AND records its path in
    # Preferences. Even after we delete Extensions/<id>/, Chrome loads
    # from the stale Preferences path (or ignores the update_url poll
    # which happens every ~5h). Purge BOTH: Extensions dir + Preferences
    # entry. On next launch chrome sees force_installed policy with no
    # local trace → downloads fresh .crx from update_url immediately.
    for base in "$HOME/.config/google-chrome/Default" "$HOME/.config/chromium/Default"; do
      [[ -d "$base" ]] || continue
      rm -rf "$base/Extensions/$EXT_ID"
      python3 - "$base/Preferences" "$EXT_ID" <<'PYPURGE' 2>/dev/null || true
import json, sys
path, ext_id = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    sys.exit(0)
ext = d.get("extensions", {}).get("settings", {})
if ext_id in ext:
    del ext[ext_id]
    open(path, "w").write(json.dumps(d, separators=(',', ':')))
PYPURGE
    done
  fi

  # Relaunch each killed browser. Map process name → binary path since
  # `chrome`/`chromium` are not in PATH on Arch (installed under /opt).
  browser_bin() {
    case "$1" in
      chrome|google-chrome) echo "/opt/google/chrome/chrome" ;;
      brave|brave-browser)  echo "$(command -v brave || echo /opt/brave-bin/brave)" ;;
      chromium)             echo "$(command -v chromium || echo /usr/bin/chromium)" ;;
      *) command -v "$1" ;;
    esac
  }
  for proc in "${RESTART_PROCS[@]}"; do
    bin=$(browser_bin "$proc")
    [[ -x "$bin" ]] || continue
    ( DISPLAY="${DISPLAY:-:0}" setsid "$bin" >/dev/null 2>&1 </dev/null & disown ) &
    disown
  done
fi

notify-send "theme-apply" "Theme -> $MODE"
