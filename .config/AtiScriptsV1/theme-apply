# Live-reload all running kitty instances. kitty listens on
# $XDG_RUNTIME_DIR/kitty-<pid>, one socket per top-level kitty. SIGUSR1
# alone rereads the config but the include'd palette file often stays
# cached, so push the palette explicitly via `kitty @ set-colors --all`.
# Fan out to every live kitty in parallel so one hung instance doesn't
# serialize the rest at 1s each. wait ensures we still see if all fired.
#
# /tmp is globbed too, for two reasons: a kitty started before kitty.conf
# moved the socket is still listening there, and a session with no
# XDG_RUNTIME_DIR never got the new path at all. The `-S` test is what
# makes globbing a shared directory safe here -- and other accounts'
# sockets showing up in it is exactly why the default moved off /tmp.
#
# ---- AND THE OPACITY, WHICH IS PER-PALETTE ----
#
# Reported as "the text not visible and the light not looking good" on
# mono-light. `$term` starts a terminal at 0.55, which is 45% of a
# near-black page on twenty palettes and 45% of a near-WHITE one on
# mono-light — over a photograph, with light-grey text on top. The value
# has to follow the palette, and an ALREADY-OPEN terminal has to be told,
# or the theme change leaves every existing window unreadable and only new
# ones right.
#
# gen_hypr_colors computes it from the background's luminance and writes it
# to colors.conf for `$term`; this is the same number for windows that
# already exist. Recomputed here rather than read back out of that file,
# because sourcing a Hyprland config from bash is not a thing.
#
# Needs `dynamic_background_opacity yes` in kitty.conf, which is why that
# line was turned on. Without it kitty refuses with a message on stdout and
# exits 0 — one more silent no-op of exactly the kind this script keeps
# collecting.
#
# Read from ~/.cache/wal/colors.json, which THIS script writes for every
# mode including the presets — not from `$BG`, which only exists inside the
# `wal` branch and under `set -u` would abort the whole theme change on the
# other twenty-one palettes.
_bg_for_opacity="$(jq -r '.special.background // empty' ~/.cache/wal/colors.json 2>/dev/null | tr -d '#')"
# Kept equal to gen_hypr_colors' own default above — this path re-derives
# the same number for windows that already exist, and the two drifting
# would mean a theme change leaves already-open terminals at one opacity
# and freshly spawned ones at another.
_term_opacity=0.65
if [[ ${#_bg_for_opacity} -eq 6 ]] && python3 -c "
import sys
h='$_bg_for_opacity'
r,g,b=(int(h[i:i+2],16)/255 for i in (0,2,4))
f=lambda c: c/12.92 if c<=0.03928 else ((c+0.055)/1.055)**2.4
sys.exit(0 if 0.2126*f(r)+0.7152*f(g)+0.0722*f(b) >= 0.5 else 1)
" 2>/dev/null; then
  _term_opacity=0.92
fi

# Reported: terminals opened under qtile/X11 were "not visible" — 0.65
# is tuned for Hyprland's hyprglass PLUGIN frosting the glass behind it
# (see hypr/hyprglass.conf); outside Hyprland there is no such thing, and
# picom's blur is deliberately OFF on this GPU (dual_kawase logged a
# continuous GL_INVALID_FRAMEBUFFER_OPERATION — see picom.conf's BLUR
# section). With nothing behind it, 0.65 of a busy dark wallpaper reads
# as no terminal at all rather than glass.
#
# HYPRLAND_INSTANCE_SIGNATURE is the same guard the live `hyprctl reload`
# above uses to tell the two sessions apart. Outside it, floor the
# opacity at 0.90 — just under the light branch's 0.92, since that value
# is already proven legible with nothing behind it either.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && awk "BEGIN{exit !($_term_opacity < 0.90)}" 2>/dev/null; then
  _term_opacity=0.90
fi

# Session-agnostic (this block runs on every mode, not just under
# Hyprland — unlike gen_hypr_colors' colors.conf, which is Hyprland-only
# syntax). Written so qtile's OWN terminal spawn (myTerm in config.py) can
# read the same number a NEWLY opened kitty should start at, rather than
# only already-open sockets getting it via the loop below. Without this,
# a kitty spawned under qtile after this script last ran starts at
# kitty.conf's static background_opacity (0.95, effectively opaque) and
# only catches up on the NEXT theme change — measured live: qtile's
# myTerm carried no -o override at all before this, so its terminals were
# never glassy regardless of picom's blur.
mkdir -p ~/.cache/qtile
echo "$_term_opacity" >~/.cache/qtile/term_opacity

for sock in "${XDG_RUNTIME_DIR:-/nonexistent}"/kitty-* /tmp/kitty-*; do
  [[ -S "$sock" ]] || continue
  timeout 1 kitty @ --to "unix:$sock" set-colors --all --configured \
    "$KITTY_THEMES/current.conf" 2>/dev/null &
  timeout 1 kitty @ --to "unix:$sock" set-background-opacity \
    "$_term_opacity" 2>/dev/null &
done
for pid in $(pgrep -x kitty || true); do
  kill -SIGUSR1 "$pid" 2>/dev/null || true
done
wait 2>/dev/null || true

# ---- Dunst ----
# Render dunstrc from ~/.dotfiles/.config/dunst/dunstrc.tmpl with palette
# substitutions. Retint only the 3 urgency levels + global frame_color;
# named notification classes (success/warning/todo/spotify/etc) keep
# their semantic hardcoded colors.
DUNSTRC="$HOME/.config/dunst/dunstrc"
DUNST_TMPL="$HOME/.dotfiles/.config/dunst/dunstrc.tmpl"
render_dunstrc() {
  local bg="$1" fg="$2" bg_crit="$3" fg_crit="$4" accent="$5" ok="$6" urgent="$7"
  # Break any stow symlink to dunstrc — we'll manage the real file now.
  [[ -L "$DUNSTRC" ]] && rm "$DUNSTRC"
