    gruvbox)   render_dunstrc "#282828" "#ebdbb2" "#3c1f1c" "#ffdada" "#fabd2f" "#b8bb26" "#fb4934" ;;
    tokyonight) render_dunstrc "#1a1b26" "#c0caf5" "#3d1f2a" "#ffdada" "#7aa2f7" "#9ece6a" "#f7768e" ;;
    catppuccin) render_dunstrc "#1e1e2e" "#cdd6f4" "#3d1f2a" "#ffdada" "#cba6f7" "#a6e3a1" "#f38ba8" ;;
    monokai)   render_dunstrc "#272822" "#f8f8f2" "#3d1f2a" "#ffdada" "#66d9ef" "#a6e22e" "#f92672" ;;
    everforest) render_dunstrc "#2d353b" "#d3c6aa" "#3d1f22" "#ffdada" "#7fbbb3" "#a7c080" "#e67e80" ;;
    rose-pine) render_dunstrc "#191724" "#e0def4" "#3d1f2a" "#ffdada" "#c4a7e7" "#9ccfd8" "#eb6f92" ;;
    kanagawa)  render_dunstrc "#1f1f28" "#dcd7ba" "#3d1f22" "#ffdada" "#7e9cd8" "#98bb6c" "#e46876" ;;
    oxocarbon) render_dunstrc "#161616" "#f2f4f8" "#3d1f2a" "#ffdada" "#33b1ff" "#42be65" "#ee5396" ;;
    cyberpunk-neon) render_dunstrc "#0a0e27" "#d1f7ff" "#3d1f2a" "#ffdada" "#00fff9" "#00ff9f" "#ff2740" ;;
    synthwave) render_dunstrc "#241b30" "#f4e9d0" "#3d1f2a" "#ffdada" "#36f9f6" "#72f1b8" "#fe4450" ;;
    matrix)    render_dunstrc "#000000" "#00ff41" "#1a0000" "#ffdada" "#00ff9f" "#00ff41" "#ff0000" ;;
    mono-dark) render_dunstrc "#000000" "#e0e0e0" "#2a2a2a" "#ffdada" "#b0b0b0" "#a0a0a0" "#808080" ;;
    mono-light) render_dunstrc "#f4f4f2" "#1c1c1c" "#ffd0d0" "#600000" "#1a5fd0" "#006000" "#c00000" ;;
    nightowl)  render_dunstrc "#011627" "#d6deeb" "#3d1f2a" "#ffdada" "#82aaff" "#22da6e" "#ef5350" ;;
    onedark)   render_dunstrc "#282c34" "#abb2bf" "#3d1f2a" "#ffdada" "#61afef" "#98c379" "#e06c75" ;;
