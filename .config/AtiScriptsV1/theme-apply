# Wire @import into gtk-3.0/gtk.css (create if missing)
ensure_gtk_import() {
  local target="$1"
  local marker="/* theme-apply wal overlay */"
  mkdir -p "$(dirname "$target")"
  touch "$target"
  if ! grep -q "theme-apply wal overlay" "$target" 2>/dev/null; then
    printf '\n%s\n@import url("%s");\n' "$marker" "$GTK_CSS" >>"$target"
  fi
}
ensure_gtk_import "$HOME/.config/gtk-3.0/gtk.css"
ensure_gtk_import "$HOME/.config/gtk-4.0/gtk.css"

# ---- Base GTK theme + icon theme swap per palette ----
# Sweet-Dark forces dark bg in all GTK apps (pcmanfm/nautilus etc); the
# per-palette @import overlay can't override background colors. Swap the
# BASE theme name + icon theme so light palettes actually render light.
case "$MODE" in
  mono-light) GTK_THEME="Breeze"; GTK_ICON="Papirus-Light" ;;
  *)          GTK_THEME="Sweet-Dark"; GTK_ICON="Papirus-Dark" ;;
esac
SETTINGS_INI="$HOME/.config/gtk-3.0/settings.ini"
if [[ -f "$SETTINGS_INI" ]]; then
  sed -i "s|^gtk-theme-name=.*|gtk-theme-name=$GTK_THEME|" "$SETTINGS_INI"
  sed -i "s|^gtk-application-prefer-dark-theme=.*|gtk-application-prefer-dark-theme=$([ "$MODE" = mono-light ] && echo 0 || echo 1)|" "$SETTINGS_INI"
  sed -i "s|^gtk-icon-theme-name=.*|gtk-icon-theme-name=$GTK_ICON|" "$SETTINGS_INI"
fi
# gtk-4.0 too
mkdir -p "$HOME/.config/gtk-4.0"
touch "$HOME/.config/gtk-4.0/settings.ini"

# ---- Papirus folder color per palette ----
# papirus-folders (yay -S papirus-folders papirus-icon-theme) accepts a
# fixed set of color keywords. Map the active accent hue to the closest
# one so folder icons follow the palette.
if command -v papirus-folders >/dev/null; then
  case "$MODE" in
    doomone|nord|kanagawa|oxocarbon|nightowl|onedark|palenight|github-dark) ICON_COLOR="blue" ;;
    dracula|catppuccin|rose-pine)    ICON_COLOR="violet" ;;
    gruvbox|monokai)                 ICON_COLOR="yellow" ;;
    tokyonight)                      ICON_COLOR="indigo" ;;
    everforest)                      ICON_COLOR="green" ;;
    cyberpunk-neon|synthwave)        ICON_COLOR="pink" ;;
    matrix)                          ICON_COLOR="green" ;;
    mono-dark|mono-light)            ICON_COLOR="grey" ;;
    ayu-mirage)                      ICON_COLOR="cyan" ;;
    wal)
      # Precompile JSON stores the mapped papirus_color directly; use
      # that when available. Fallback to hue-from-color9 for wallpapers
      # without a precompile cache entry.
      #
      # Seeded first so neither lookup below is load-bearing: with `set -u`
      # in force, a run where both come back empty reached
      # `papirus-folders -C "$ICON_COLOR"` with ICON_COLOR never assigned
      # at all, and an unbound-variable abort here takes the qtile restart
      # with it.
      ICON_COLOR="blue"
      WSTEM="$(basename "$(readlink -f "$HOME/.cache/wall" 2>/dev/null)" 2>/dev/null)"
      WSTEM="${WSTEM%.*}"
      # The stem goes in as argv, never spliced into the python source. It
      # comes from a wallpaper FILENAME, and one containing an apostrophe
      # closed the string literal and turned the whole block into a syntax
      # error -- which, being 2>/dev/null'd, looked exactly like "this
      # wallpaper has no precompiled colour".
      ICON_COLOR_OVERRIDE=$(python3 -c "
import json,os,sys
p=os.path.expanduser('~/.cache/qtile/palettes/%s.json' % sys.argv[1])
if os.path.exists(p):
    pc = json.load(open(p)).get('papirus_color')
    if pc: print(pc)
" "$WSTEM" 2>/dev/null || true)
      if [[ -n "$ICON_COLOR_OVERRIDE" ]]; then
        ICON_COLOR="$ICON_COLOR_OVERRIDE"
        HUE=""
      else
        # `|| true`, because this runs under `set -e` and an assignment
        # takes the substitution's exit status. A missing or truncated
        # ~/.cache/wal/colors.json therefore did not merely skip the
        # folder colour -- it killed theme-apply outright, right before
        # the qtile restart, so the palette was half applied and the
        # desktop never reloaded.
        HUE=$(python3 -c "
import json,colorsys,os
d=json.load(open(os.path.expanduser('~/.cache/wal/colors.json')))
c=d['colors']['color9']
r,g,b=int(c[1:3],16)/255,int(c[3:5],16)/255,int(c[5:7],16)/255
print(int(colorsys.rgb_to_hsv(r,g,b)[0]*360))
" 2>/dev/null || true)
      fi
      if [[ -n "$HUE" ]]; then
        if   (( HUE < 15 || HUE >= 345 )); then ICON_COLOR="red"
        elif (( HUE < 45 ));  then ICON_COLOR="orange"
        elif (( HUE < 65 ));  then ICON_COLOR="yellow"
        elif (( HUE < 165 )); then ICON_COLOR="green"
        elif (( HUE < 200 )); then ICON_COLOR="teal"
        elif (( HUE < 260 )); then ICON_COLOR="blue"
        elif (( HUE < 290 )); then ICON_COLOR="violet"
        elif (( HUE < 345 )); then ICON_COLOR="pink"
        else                       ICON_COLOR="blue"
        fi
      fi
      ;;
    *) ICON_COLOR="blue" ;;
  esac
  # papirus-folders swaps the folder-color symlink (fast, ~200ms).
  # -u would ALSO rebuild the whole theme icon cache (20+ seconds) —
  # not worth it: open pcmanfm windows won't hot-reload icons anyway,
  # and cold windows read the swapped symlink directly.
  # sudo -n stays non-interactive; needs NOPASSWD in /etc/sudoers.d.
  ( if ! sudo -n papirus-folders -C "$ICON_COLOR" -t "$GTK_ICON" >/dev/null 2>&1; then
      papirus-folders -C "$ICON_COLOR" -t "$GTK_ICON" >/dev/null 2>&1 \
        || notify-send "theme-apply" "papirus-folders needs passwordless sudo — icons stale"
    fi ) &
  disown
fi

# The file manager caches its icon theme per-process, and neither GTK nor
# Qt exposes a hot-reload API for it — qt6ct live-swaps the *palette* of a
# running app but not QIcon::themeName. So: kill every file-manager process
# (windows + daemon) and relaunch each visible window at $HOME. Preserves
# the "file manager is open" state at the cost of losing per-window cwd.
# Daemon restarts for desktop icons.
#
# pcmanfm-qt is the declared file manager (arch-config/modules/apps.yaml);
# the GTK pcmanfm is still installed as an LXDE dep, so handle both. Note
# the flags differ: `-d` vs `--daemon-mode`, and the WM_CLASS xdotool wants
# is "pcmanfm-qt" (lowercase, both fields) vs GTK's "Pcmanfm".
#
# ---- WHY THE WINDOW PROBE IS NOT JUST xdotool ANY MORE ----
#
# `xdotool search --class` cannot see a Wayland client. Under Hyprland it
# does not error in any visible way — it simply finds nothing and exits
# non-zero — so had_windows stayed 0, and the branch below relaunched
# pcmanfm-qt in daemon mode ONLY. Net effect of every theme change on this
# session: the file manager window you had open on workspace 3 was killed
# and never came back, silently, with the daemon running so `pgrep` still
# said the app was alive. Measured: pcmanfm-qt was running with one window
# on workspace 3 (`hyprctl clients`), and `xdotool search --class
# pcmanfm-qt` under Wayland returns nothing.
#
# So: ask the compositor when there is one, and keep xdotool for the X11
# session, which shares this script. hyprctl's `class` is the xdg-shell
# app_id, and for both file managers it happens to equal the WM_CLASS
# spelling already passed in ($2) — pcmanfm-qt reports "pcmanfm-qt", which
# is why the same argument serves both probes.
_fm_has_windows() {  # $1=class
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl clients -j 2>/dev/null |
      python3 -c "
import json,sys
try: cs = json.load(sys.stdin)
except Exception: sys.exit(1)
sys.exit(0 if any(c.get('class','').lower() == sys.argv[1].lower() for c in cs) else 1)
" "$1"
    return $?
  fi
  xdotool search --class "$1" >/dev/null 2>&1
}

_restart_fm() {  # $1=binary  $2=WM_CLASS / app_id  $3=daemon flag
  pgrep -x "$1" >/dev/null 2>&1 || return 0
  local had_windows=0
  _fm_has_windows "$2" && had_windows=1
  pkill -x "$1" 2>/dev/null || true
  # The two invocations are SERIALISED, and that is not tidiness.
  #
  # They used to be fired as two background jobs from the same subshell,
  # 0.3s after the kill and with nothing between them. That was invisible
  # for as long as _fm_has_windows could not see a Wayland window, because
  # the second one never ran. The first apply after that probe was fixed
  # produced TWO pcmanfm-qt windows from ONE pid (measured: addresses
  # 0x55f99c861e40 and 0x55f99c8b1410, both titled "ati", both pid 1354594,
  # both on workspace 3) — the daemon had not finished claiming the
  # single-instance socket when the second invocation checked for it, so
  # both calls asked for a window and the surviving instance opened both.
  # Waiting for the daemon to actually exist before asking it for a window
  # is what makes the second call a request to an existing instance rather
  # than a race with one that is still starting.
  ( sleep 0.3
    DISPLAY="${DISPLAY:-:0}" "$1" "$3" >/dev/null 2>&1 &
    if [[ "$had_windows" == 1 ]]; then
      for _ in $(seq 20); do
        pgrep -x "$1" >/dev/null 2>&1 && break
        sleep 0.1
      done
      sleep 0.4
      DISPLAY="${DISPLAY:-:0}" "$1" "$HOME" >/dev/null 2>&1 &
    fi ) &
  disown
}
_restart_fm pcmanfm-qt "pcmanfm-qt" -d
_restart_fm pcmanfm    "Pcmanfm"    --daemon-mode

# ---- TRY THE LIVE PALETTE SWAP FIRST — NO RESTART AT ALL ----
#
# Reported: "the animation works but then the bar reappears and reload the
# whole qtile can we avoid this? and just have the animiton?" Measured
# with `vmstat 1` during a themed restart: 50-70%+ CPU, run queue up to 9,
# for the ENTIRE covered window — a full qtile restart (Python reimport,
# ~79 keybindings, every widget reinitializing) competing with the reveal
# animation for CPU is exactly what a stutter looks like. Hyprland has no
# equivalent cost; it never restarts anything for a theme change.
#
# apply_palette_live() (config.py) does the swap now — see its own
# docstring for the hex-matching bug that made the old attempt at this
# "visual coverage across all themes proved unreliable" and the
# current_palette.prev.json snapshot near the top of this script that
# fixes it. SYNCHRONOUS on purpose, not `setsid -f`'d like the restart
# below: this call cannot execv anything out from under itself, so there
# is no connection-dies-on-success trap here, and the whole point is to
# know the answer before deciding whether a restart is needed at all.
_live_ok=0
if command -v qtile >/dev/null; then
  probe=$(qtile cmd-obj -o cmd -f eval -a \
    "str(int(hasattr(__import__(\"sys\").modules.get(\"config\"), \"apply_palette_live\")))" 2>&1 || true)
  probe=$(printf %s "$probe" | tr -d "\042\047" | tr -d "[:space:]")
  if [ "$probe" = "1" ]; then
    result=$(qtile cmd-obj -o cmd -f eval -a \
      "str(__import__(\"sys\").modules[\"config\"].apply_palette_live())" 2>&1 || true)
    result=$(printf %s "$result" | tr -d "\042\047" | tr -d "[:space:]")
    [ "$result" = "True" ] && _live_ok=1
  fi
fi

# ---- FALL BACK: full restart, behind the veil — only when the swap
#      above did not happen ----
#
# In practice this is a ONE-TIME path: apply_palette_live() only refuses
# when current_palette.prev.json does not exist yet (no snapshot to map
# FROM), which is true on the very first theme change after install or a
# cache clear and false on every one after it. Unchanged otherwise from
# before this session's live-swap work — same veil, same
# THEME_APPLY_COVERED-gated invisibility, same wait for the restart to
# actually settle.
if [[ "$_live_ok" != 1 ]] && command -v qtile >/dev/null; then
  # Go through smooth_restart (exposed on the qtile object by config.py's
  # startup_complete hook) rather than the raw `restart` command, so a
  # theme change gets the same veil Super+Shift+R does. Without this the
  # restart that follows a theme switch shows the whole boot window pile
  # uncovered. Falls back to the raw restart if the attribute is missing
  # — e.g. an older config.py, or a restart that happened before
  # startup_complete fired — so a theme change can never fail to apply.
  # Probe FIRST, then commit. The obvious shape — call smooth_restart and
  # fall back if it errors — is wrong: smooth_restart ends in execv, so
  # the IPC connection always dies mid-call and every success looks like
  # a failure. That fallback would fire a second restart every time.
  setsid -f bash -c '
    # This subshell inherits `set -euo pipefail`. Both qtile calls below
    # routinely exit non-zero -- the probe if the IPC socket is busy, and
    # the restart call ALWAYS, because _smooth_restart ends in execv and
    # kills the connection it was answering on. Under `set -e` that made
    # the subshell abort before restarting anything at all. Same trap the
    # qutebrowser block below documents.
    set +e
    # THEME_APPLY_COVERED is a real process environment variable (set by
    # ThemeTransitionWindow.qml on applyProcess, see the top of this
    # script), so it survives into this child bash exactly like any other
    # inherited env var would — no passing-through-quotes trick needed.
    _py_covered=False
    [ -n "${THEME_APPLY_COVERED:-}" ] && _py_covered=True
    # Probe the CONFIG MODULE, not a qtile attribute. qtile.smooth_restart
    # is attached by a startup_complete hook, so it only exists on an
    # instance that has already restarted into a config new enough to
    # attach it — meaning the very first theme switch after any config
    # change silently falls back to the raw restart and shows no veil.
    # _smooth_restart has lived in the config module far longer, and this
    # is the same entry point the Super+Shift+R binding uses.
    # `qtile cmd-obj -f eval` prints the returned string wrapped in
    # DOUBLE quotes: literally  "1"  — not a tuple repr, not a bare 1.
    # Matching a quoting style instead of stripping the quotes is how this
    # silently fell through to the raw restart on every theme switch, so
    # normalise first and compare exactly.
    probe=$(qtile cmd-obj -o cmd -f eval -a \
      "str(int(hasattr(__import__(\"sys\").modules.get(\"config\"), \"_smooth_restart\")))" 2>&1)
    # Strips double-quote (octal 042) and apostrophe (octal 047).
    # Written as octal, and described in words rather than shown: this
    # whole block lives inside setsid -f bash -c + single quotes, so a
    # literal apostrophe ANYWHERE here -- including in a comment --
    # terminates that string early and silently truncates the script.
    # bash -n does not catch it, because the remainder happens to
    # re-balance into something still syntactically valid.
    probe=$(printf %s "$probe" | tr -d "\042\047" | tr -d "[:space:]")
    if [ "$probe" = "1" ]; then
      qtile cmd-obj -o cmd -f eval -a \
        "str(__import__(\"sys\").modules[\"config\"]._smooth_restart(self, $_py_covered))"
    else
      qtile cmd-obj -o cmd -f restart
    fi
  ' >/dev/null 2>&1 </dev/null || true

  # ---- IF SOMETHING IS COVERING THE SCREEN, WAIT FOR THE RESTART TO
  #      ACTUALLY SETTLE, NOT JUST FOR THE TRIGGER TO FIRE ----
  #
  # Only when $_covered — i.e. only when this script is running behind the
  # overlay's own frozen frame (see THEME_APPLY_COVERED at the top). In
  # that case the veil above was just launched INVISIBLE, so nothing else
  # is covering the restart, and this loop is now the only thing standing
  # between the marker below and an exposed window pile.
  #
  # Not covered — theme-animate's own fallback exec, or a bare manual
  # invocation — skips this entirely and keeps the original fast timing:
  # the VISIBLE veil launched above already covers the whole restart on
  # its own account, waiting again here would only add dead time to a
  # transition nothing is freezing for.
  #
  # The `setsid -f bash -c '...'` above returns the instant it has forked —
  # it does not and cannot wait for _smooth_restart to finish, because
  # _smooth_restart ends in execv and kills the very IPC connection that
  # call is answering on. So without this loop, THE VISIBLE-REPAINT MARKER
  # below would print within milliseconds of the restart being TRIGGERED,
  # not of qtile having actually finished restarting (~7s measured wall
  # time on this config) — the circular-reveal overlay would lift onto a
  # desktop still mid-restart.
  #
  # veil_done is the exact signal to wait for: config.py's
  # _veil_signal_done() writes it from a startup_complete hook on the NEW
  # qtile instance, 0.40s after startup_complete once the layout/focus
  # restores have settled (_VEIL_SIGNAL_DELAY) — not merely "the IPC socket
  # answers again", which happens earlier, before the bar has finished
  # laying out (see the "widget could not compute length" warnings a
  # restart logs while its widgets are still sizing). The invisible veil
  # writes this file exactly the same way the visible one does — see
  # run_invisible()'s own docstring in qtile-restart-veil.py.
  #
  # Bounded, not open-ended: a wedged restart must never hang a theme
  # change forever. 15s, just under the veil's own 20s watchdog
  # (_VEIL_MAX_SECONDS) — this loop existing is not a substitute for that
  # watchdog, it is a best-effort wait that gives up and lets the marker
  # print anyway, exactly like every other timing guard in this script.
  if [[ "$_covered" = 1 ]]; then
    _veil_done_file="$HOME/.cache/qtile/veil_done"
    for _ in $(seq 150); do
      [[ -f "$_veil_done_file" ]] && break
      sleep 0.1
    done
  fi
fi

# Reload qutebrowser. It has real IPC, so it is the one browser here that
# never needs to be killed.
#
# ---- THE `:restart` THAT USED TO BE HERE, AND THE STALE CLAIM BEHIND IT ----
#
# This block used to end with `qutebrowser ":restart"`, justified in a
# comment reading ":config-source alone doesn't re-read wal cache colors".
# That was true when it was written and has not been true for a long time.
# It described a qb config.py that read ~/.cache/wal/colors.json at import
# time only. The current ~/.config/qutebrowser/config.py has _apply_palette()
# (config.py:22), which opens ~/.cache/qtile/current_palette.json and sets
# c.colors.* from it, and is CALLED at the bottom of the file — its own
# comment says "`:config-source` (fired by theme-apply) re-runs this whole
# file, so switching theme or wallpaper re-applies live". `:config-source`
# re-executes config.py, config.py re-opens the palette file, so the palette
# is re-read. The restart was buying nothing that the line above it had not
# already bought.
#
# What it cost was the complaint this change exists to fix: a restarting qb
# maps a fresh window, and a fresh window matching the `workspace 2` rule in
# hypr/rules.conf used to drag the whole session onto workspace 2. Those
# rules are `silent` now, so even a restart would no longer teleport you —
# but the cheapest window to not get teleported by is the one that is never
# created.
#
# What is genuinely lost, recorded so it is not mistaken for a bug: the
# homepage. gen_qb_css above rewrites the :root block inside
# html/homepage.html, and an already-loaded tab keeps the HTML it parsed. A
# restart re-opened the start page and so re-read it; :config-source cannot.
# An open homepage tab therefore keeps the previous palette until it is
# reloaded (:r) or navigated to again. Every other qb surface — tabs,
# statusbar, completion, hints, prompts, downloads, webpage bg — is a
# c.colors.* setting and does change immediately. One stale tab is a much
# smaller price than losing your place in the session on every theme click,
# and `:reload-all` was rejected as the fix because reloading every open tab
# to retint one of them is worse than the disease.
#
# The `|| true` and the generous timeout stay, and the reason is unchanged:
# this subshell inherits `set -e`, and the qb IPC client spawns a full
# python that takes ~2s even idle, so a tight timeout returns 124 and tears
# the subshell down. setsid detaches it from theme-apply's process group so
# it survives both this script exiting and the preemption `kill` that a
# rapid second theme switch sends.
if pgrep -x qutebrowser >/dev/null; then
  setsid -f bash -c '
    timeout 15 qutebrowser ":config-source" >/dev/null 2>&1 || true
  ' >/dev/null 2>&1 </dev/null || true
fi

# ---------------------------------------------------------------------
# THE VISIBLE-REPAINT MARKER
# ---------------------------------------------------------------------
# One line on stdout, at the point after which nothing this script does
# repaints a window that is ALREADY ON SCREEN.
#
# It exists for the Hyprland session's theme-change animation
# (quickshell tide-island-fork, qml/theme/ThemeTransitionWindow.qml),
# which freezes the desktop as a screenshot, runs this script underneath
# it, and then wipes the frozen frame away. That wipe has to start when
# the desktop under the frame has finished changing. Gating it on this
# script EXITING was the obvious reading of "finished" and it is wrong by
# a factor of three: measured with `bash -x` and PS4=$EPOCHREALTIME on
# this machine (5 kitty, brave and qutebrowser up), the last visible
# repaint is dispatched at 1.27 s and the script exits at 3.39 s. The
# user spent the difference looking at a screenshot with a pixel-diff of
# exactly 0.00 between consecutive frames.
#
# WHAT IS BEHIND THIS LINE, i.e. what the wipe is allowed to wait for:
#   hyprctl reload (L462) .................... 0.11 s  borders, gaps, blur
#   ~/.cache/tide-island/colors.json (L466) .. 0.11 s  the island itself
#   eww reload/restart (L949) ................ 0.24 s  backgrounded
#   kitty set-colors + SIGUSR1 (L982) ........ 0.86 s  every open terminal
#   dunstrc + dunst restart (L1050) .......... 1.10 s
#   GTK overlay css + settings.ini (L1056) ... 1.14 s
#   papirus-folders (L1150) .................. backgrounded
#   file-manager restart (L1279) ............. backgrounded
#   qtile restart (L1316) .................... triggered detached; WAITED
#                                                ON via veil_done, up to
#                                                7s+, but ONLY when this
#                                                script is running covered
#                                                by an overlay ($_covered)
#                                                — 0s on Hyprland (qtile
#                                                is not running there) and
#                                                0s on an uncovered qtile
#                                                invocation (the visible
#                                                veil covers that restart
#                                                on its own, this script
#                                                does not need to wait for
#                                                it too)
#   qutebrowser :config-source (L1414) ....... 1.27 s  detached
#
# WHAT IS AHEAD OF IT, and why none of it can be waited for:
#   the Chromium theme extension is repacked and brave/chrome are KILLED
#   and relaunched (1.27 s -> 3.28 s, the whole remaining two thirds);
#   firefox likewise; boot-splash is backgrounded and outlives this
#   script by minutes. A killed browser does not repaint, it disappears
#   and comes back seconds later on its own schedule — no overlay can
#   cover that, so holding the frozen frame for it buys nothing and costs
#   two seconds of dead screen.
#
# Printed unconditionally, including on the qtile session and on a bare
# terminal invocation, because a marker that only appears under one
# session is a marker that rots. Nothing captures this script's stdout
# (checked across the tree: every caller either discards it or runs the
# script with `exec`), so a single extra line is inert everywhere it is
# not wanted. bash's printf builtin flushes to a pipe per call — verified,
# because a marker sitting in a 4 KB stdio buffer until exit would be a
# silent no-op that looks exactly like the bug it fixes.
# ------------------------------------------------------------
#  The theme's wallpaper (ask #5), BEFORE the marker
# ------------------------------------------------------------
#  This used to sit AFTER the marker, and the reasoning was sound: the
#  island freezes the screen until it sees THEME_APPLY_VISIBLE_DONE, and
#  awww's wave takes about a second, so moving the wallpaper ahead of the
#  marker would add all of it to a freeze that is already a known problem.
#
#  What that reasoning missed is that the wave is only there to stop a
#  hard cut on a LIVE desktop. Under the cover there is no live desktop —
#  the island is holding a frozen frame over the whole screen — so the
#  wave was a second animation nobody could see, and the seam the user
#  reported ("i want also the theme and the wallpaper change in the same
#  time no glitch at all one animation") was the cover lifting on the old
#  wallpaper and the wave then starting in full view.
#
#  So it moves ahead of the marker and is applied with `instant`, and the
#  cover's own sweep becomes the transition for the palette AND the
#  wallpaper together. One reveal with everything already changed behind
#  it, rather than two animations that have to be synchronised.
#
#  The freeze does not grow, and that was measured rather than hoped for.
#  ThemeTransitionWindow's own header records a static stretch — frames
#  differing by an RMSE of exactly 0.00 — of 960 ms under the cover, which
#  is dead time the wallpaper decode now runs inside. Before/after numbers
#  are in the commit that made this change.
#
#  NOT for wal. In wal mode the wallpaper is the INPUT to the palette, so
#  a per-theme wallpaper is meaningless there — and this is also one of
#  the two guards against a loop, since wallpaper-set.sh re-runs
#  `theme-apply wal` after a pick. The other guard is that theme-wallpaper
#  pokes the daemon itself and never calls wallpaper-set.sh.
#
#  `|| true` because a theme with no wallpaper must not fail a theme
#  change, and because this is the shared script — a qtile session with no
#  xwallpaper should still get its colours.
# WALL_APPLIED is read only by the notification at the end of this script,
# which says "and the wallpaper too" and must not say it when the wallpaper
# did not move. Compared by resolved target rather than by theme-wallpaper's
# exit code: the `|| true` above swallows that code by design, and a theme
# with an empty set exits 0 having changed nothing.
WALL_BEFORE="$(readlink -f "$HOME/.cache/wall" 2>/dev/null || true)"
if [ "$MODE" != "wal" ] && command -v theme-wallpaper >/dev/null 2>&1; then
  theme-wallpaper apply "$MODE" instant || true
fi
WALL_APPLIED="$(readlink -f "$HOME/.cache/wall" 2>/dev/null || true)"
[ "$WALL_APPLIED" = "$WALL_BEFORE" ] && WALL_APPLIED=""

printf '%s\n' 'THEME_APPLY_VISIBLE_DONE'

# Resolve the four palette roles (background / foreground / alt-surface /
# accent) for the active $MODE, as four space-separated #rrggbb values.
#
# Single source of truth on purpose: both the Chromium theme extension
# below and the Firefox userChrome block further down need the exact same
# palette, and when the preset table lived inline in the Chromium
# generator the only way to add a second consumer was to copy all 21
# entries -- which then silently drifts the first time a preset is
# retuned in one copy and not the other.
resolve_palette() {
  python3 - "$1" <<'PYPALETTE'
import json, os, sys
mode = sys.argv[1]
if mode == "wal":
    d = json.load(open(os.path.expanduser("~/.cache/wal/colors.json")))
    bg = d["special"]["background"]; fg = d["special"]["foreground"]
    c  = d["colors"]
    accent = c["color4"]; alt = c["color0"]
else:
    # preset palettes hard-coded to match theme-apply per-mode blocks
    presets = {
      "doomone":   ("#282c34","#dcdfe4","#1e222a","#51afef"),
      "dracula":   ("#282a36","#f8f8f2","#21222c","#bd93f9"),
      "nord":      ("#2e3440","#d8dee9","#3b4252","#88c0d0"),
      "gruvbox":   ("#282828","#ebdbb2","#1d2021","#fabd2f"),
      "tokyonight":("#1a1b26","#c0caf5","#16161e","#7aa2f7"),
      "catppuccin":("#1e1e2e","#cdd6f4","#181825","#cba6f7"),
      "monokai":   ("#272822","#f8f8f2","#1e1f1c","#66d9ef"),
      "everforest":("#2d353b","#d3c6aa","#232a2e","#7fbbb3"),
      "rose-pine": ("#191724","#e0def4","#1f1d2e","#c4a7e7"),
      "kanagawa":  ("#1f1f28","#dcd7ba","#16161d","#7e9cd8"),
      "oxocarbon": ("#161616","#f2f4f8","#262626","#33b1ff"),
      "cyberpunk-neon": ("#0a0e27","#d1f7ff","#000000","#00fff9"),
      "synthwave": ("#241b30","#f4e9d0","#1a1428","#36f9f6"),
      "matrix":    ("#000000","#00ff41","#0a0a0a","#00ff9f"),
      "mono-dark": ("#000000","#e0e0e0","#0a0a0a","#b0b0b0"),
      # mono-light was (#ffffff, #000000, #e0e0e0, #000080) and was
      # reported as "too bad, the text inside not readable and the light
      # is too bad". Three separate faults, all from taking "mono" to
      # mean the extremes of the axis rather than a range along it:
      #
      #   #ffffff  a full-white desktop is glare, not a light theme. No
      #            shipped light theme uses it — Solarized Light is
      #            #fdf6e3, GitHub Light #ffffff only for CARDS over a
      #            grey page. It also leaves bg_alt nowhere to go but
      #            darker, so every raised surface reads as a hole.
      #   #000000  maximum contrast is not maximum readability. Pure
      #            black on pure white is the pairing every typographic
      #            guide names as fatiguing.
      #   #000080  navy at 12% luminance on a 100% background. It is
      #            the accent, so it lands on the smallest text and the
      #            thinnest strokes, and at that size it reads as black.
      #
      # The new accent is #1a5fd0 rather than the brighter #2f6fed it
      # was first set to: 4.13:1 against the page fails WCAG AA for
      # normal text, and an ACCENT is exactly what lands on small
      # text. 5.31:1 clears it with the hue still legible as blue.
      #
      # Now a warm off-white page, near-black ink, a bg_alt that is a
      # real step rather than a shadow, and an accent with enough chroma
      # to be seen as a colour at 10 px.
      "mono-light":("#f4f4f2","#1c1c1c","#e4e4e0","#1a5fd0"),
      "nightowl":  ("#011627","#d6deeb","#010e1a","#82aaff"),
      "onedark":   ("#282c34","#abb2bf","#21252b","#61afef"),
      "palenight": ("#292d3e","#a6accd","#1e2030","#82b1ff"),
      "github-dark":("#0d1117","#c9d1d9","#010409","#58a6ff"),
      "ayu-mirage":("#1f2430","#cbccc6","#171b24","#5ccfe6"),
    }
    bg, fg, alt, accent = presets.get(mode, presets["doomone"])
print(bg, fg, alt, accent)
PYPALETTE
}

# Read once; every browser block below consumes these. Falls back to the
# doomone palette if wal's colors.json is missing/corrupt so a broken
# cache tints the browsers wrong rather than leaving them untouched.
read -r PAL_BG PAL_FG PAL_ALT PAL_ACCENT < <(resolve_palette "$MODE" 2>/dev/null) || true
: "${PAL_BG:=#282c34}" "${PAL_FG:=#dcdfe4}" "${PAL_ALT:=#1e222a}" "${PAL_ACCENT:=#51afef}"

# Regenerate a Chromium theme extension so brave/chrome UI colors track
# the wallpaper. --load-extension=<dir> in *-flags.conf keeps it loaded
# across launches. Extension is a bare theme manifest; each apply
# rewrites the manifest with new palette RGB triples, then restarts
# each running browser so the theme swap takes effect.
BROWSER_EXT="$HOME/.config/qtile/browser-theme"
mkdir -p "$BROWSER_EXT"
# Skip regeneration if wal fast path already wrote a fresh manifest.
if [[ "${PRECOMPILED_APPLIED:-0}" != 1 ]]; then
python3 - "$BROWSER_EXT/manifest.json" "$PAL_BG" "$PAL_FG" "$PAL_ALT" "$PAL_ACCENT" <<'PYEOF' 2>/dev/null || true
import json, sys, time
outp, bg, fg, alt, accent = sys.argv[1:6]
def rgb(s): return [int(s[i:i+2],16) for i in (1,3,5)]
manifest = {
  "manifest_version": 3,
  # Bump version each apply so Chromium detects an "update" and
  # reloads the theme instead of keeping the cached previous colors.
  "version": "1.0." + str(int(time.time())),
  "name": "Wal Theme",
  "description": "Generated by theme-apply.",
  "theme": {
    "colors": {
      "frame":               rgb(alt),
      "frame_inactive":      rgb(alt),
      "frame_incognito":     rgb(alt),
      "toolbar":             rgb(bg),
      "tab_text":            rgb(fg),
      "tab_background_text": rgb(fg),
      "bookmark_text":       rgb(fg),
      "ntp_background":      rgb(bg),
      "ntp_text":            rgb(fg),
      "ntp_link":            rgb(accent),
      "button_background":   rgb(alt),
      "omnibox_background":  rgb(alt),
      "omnibox_text":        rgb(fg),
    }
  }
}
open(outp,"w").write(json.dumps(manifest, indent=2))
PYEOF
fi

# Ensure --load-extension flag is in each browser's flags file so the
# theme extension survives restart.
add_load_ext() {
  local f="$1"
  [[ -f "$f" ]] || return
  local line="--load-extension=$BROWSER_EXT"
  grep -q -- "--load-extension=" "$f" 2>/dev/null && return
  printf '\n%s\n' "$line" >>"$f"
}
add_load_ext "$HOME/.config/brave-flags.conf"
add_load_ext "$HOME/.config/chromium-flags.conf"
add_load_ext "$HOME/.config/chrome-flags.conf"

BROWSER_CRX="$HOME/.config/qtile/browser-theme.crx"
BROWSER_PEM="$HOME/.config/qtile/browser-theme.pem"
BROWSER_UPDATES="$HOME/.config/qtile/browser-theme-updates.xml"

# A Chromium extension's id is sha256(DER pubkey)[:32] mapped 0-f -> a-p,
# so it is a pure function of the signing key. It MUST be derived from
# browser-theme.pem, never hardcoded: wizard.sh generates that key
# per-machine and writes /etc/opt/chrome/policies/managed/wal-theme.json
# keyed by the derived id. A hardcoded literal here (previously
# "fommfacojlllmdogognehdgombidbpjg") made every apply rewrite
# updates.xml with an appid the policy does not reference, so Chrome's
# force_installed poll found no matching <app> and silently never
# installed the theme -- while Chromium looked fine, because it picks
# the theme up through --load-extension instead of policy.
ext_id_from_pem() {
  [[ -f "$BROWSER_PEM" ]] || return 1
  openssl rsa -in "$BROWSER_PEM" -pubout -outform DER 2>/dev/null |
    python3 -c "
import hashlib, sys
h = hashlib.sha256(sys.stdin.buffer.read()).hexdigest()[:32]
print(''.join(chr(ord('a') + int(c, 16)) for c in h))
" 2>/dev/null
}
EXT_ID="$(ext_id_from_pem || true)"

# brave/chrome/chromium have no live-theme-reload API. Kill running
# browsers FIRST, then repack .crx (chrome pack needs no lock), then
# relaunch — so chrome sees the fresh crx + bumped updates.xml on
# startup and force-installs. Set THEME_APPLY_NO_BROWSER=1 to skip.
if [[ "${THEME_APPLY_NO_BROWSER:-0}" != 1 ]]; then
  RESTART_PROCS=()
  for proc in brave chromium chrome google-chrome brave-browser; do
    if pgrep -x "$proc" >/dev/null 2>&1; then
      RESTART_PROCS+=("$proc")
      pkill -x "$proc" 2>/dev/null || true
    fi
  done
  # Wait for locks to release before repack.
  [[ ${#RESTART_PROCS[@]} -gt 0 ]] && sleep 1

  # Repack .crx + bump updates.xml (chrome policy force-installs on
  # next launch). Now safe: no chrome process holding the pack lock.
  # Any chromium-family binary can --pack-extension; don't require Chrome
  # specifically or a chromium-only machine never gets a packed .crx.
  if [[ -z "${CHROME_BIN:-}" ]]; then
    for _c in /opt/google/chrome/chrome /usr/bin/chromium /opt/brave-bin/brave; do
      [[ -x "$_c" ]] && { CHROME_BIN="$_c"; break; }
    done
  fi
  # EXT_ID empty means the pem is missing or openssl/python3 failed.
  # Bail out rather than continue: an empty id would write appid='' into
  # updates.xml and, worse, expand `rm -rf "$base/Extensions/$EXT_ID"`
  # into deleting the entire Extensions directory.
  if [[ -f "$BROWSER_PEM" ]] && [[ -n "$EXT_ID" ]] && [[ -n "${CHROME_BIN:-}" ]]; then
    "$CHROME_BIN" --pack-extension="$BROWSER_EXT" --pack-extension-key="$BROWSER_PEM" --no-message-box >/dev/null 2>&1 || true
    # Path as argv, and `|| true`: the manifest write above is itself
    # `|| true`, so this can legitimately find no file -- and under
    # `set -e` the failing substitution aborted the whole apply here,
    # after the browsers had already been killed. Splicing $HOME into the
    # python source also broke outright for any home directory containing
    # an apostrophe.
    VER=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['version'])" \
      "$BROWSER_EXT/manifest.json" 2>/dev/null || true)
    if [[ -n "$VER" ]]; then
      cat > "$BROWSER_UPDATES" <<EOF
<?xml version='1.0' encoding='UTF-8'?>
<gupdate xmlns='http://www.google.com/update2/response' protocol='2.0'>
  <app appid='$EXT_ID'>
    <updatecheck codebase='file://$BROWSER_CRX' version='$VER' />
  </app>
</gupdate>
EOF
    fi
    # Chrome caches the installed .crx AND records its path in
    # Preferences. Even after we delete Extensions/<id>/, Chrome loads
    # from the stale Preferences path (or ignores the update_url poll
    # which happens every ~5h). Purge BOTH: Extensions dir + Preferences
    # entry. On next launch chrome sees force_installed policy with no
    # local trace → downloads fresh .crx from update_url immediately.
    for base in "$HOME/.config/google-chrome/Default" "$HOME/.config/chromium/Default"; do
      [[ -d "$base" ]] || continue
      rm -rf "$base/Extensions/$EXT_ID"
      python3 - "$base/Preferences" "$EXT_ID" <<'PYPURGE' 2>/dev/null || true
import json, sys
path, ext_id = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    sys.exit(0)
ext = d.get("extensions", {}).get("settings", {})
if ext_id in ext:
    del ext[ext_id]
    open(path, "w").write(json.dumps(d, separators=(',', ':')))
PYPURGE
    done
  fi

  # Relaunch each killed browser. Map process name → launcher path.
  #
  # ALWAYS prefer the /usr/bin wrapper script over the real binary under
  # /opt. On Arch the wrapper is what sources ~/.config/<name>-flags.conf
  # and appends --load-extension=<browser-theme> to the command line;
  # /opt/google/chrome/chrome is the bare binary and ignores that file
  # entirely. Relaunching Chrome via the bare binary is why Chrome came
  # back untinted after every apply while Chromium (whose /usr/bin entry
  # already IS a wrapper) picked the theme up fine.
  browser_bin() {
    case "$1" in
      chrome|google-chrome)
        for b in /usr/bin/google-chrome-stable /usr/bin/google-chrome \
                 /opt/google/chrome/google-chrome /opt/google/chrome/chrome; do
          [[ -x "$b" ]] && { echo "$b"; return; }
        done ;;
      brave|brave-browser)  echo "$(command -v brave || echo /opt/brave-bin/brave)" ;;
      chromium)             echo "$(command -v chromium || echo /usr/bin/chromium)" ;;
      *) command -v "$1" ;;
    esac
  }
  for proc in "${RESTART_PROCS[@]}"; do
    bin=$(browser_bin "$proc")
    [[ -x "$bin" ]] || continue
    ( DISPLAY="${DISPLAY:-:0}" setsid "$bin" >/dev/null 2>&1 </dev/null & disown ) &
    disown
  done
fi

# ---------------------------------------------------------------------
# Firefox
# ---------------------------------------------------------------------
# Firefox cannot be themed the way the Chromium family is above. A theme
# extension there must be a signed .xpi -- release Firefox hard-refuses
# unsigned add-ons and `xpinstall.signatures.required=false` is ignored
# outside Nightly/ESR/Developer -- so the .crx trick has no counterpart.
#
# The route that does work on a stock release build is userChrome.css:
# Firefox maps its entire chrome UI onto a documented set of `--lwt-*` /
# `--toolbar-*` custom properties (the same ones lightweight themes drive),
# so overriding those on :root retints the whole browser without touching
# add-on signing at all. It is gated behind one pref, which we write into
# the profile's user.js.
#
# Two consequences worth knowing:
#   - userChrome.css is read exactly once, at startup. Rewriting it under
#     a running Firefox does nothing at all, which is why the restart
#     below is not optional cosmetics -- without it an apply looks like a
#     silent no-op until the next manual restart.
#   - user.js is re-applied over prefs.js on every startup by design, so
#     the pref cannot drift back off.
if [[ "${THEME_APPLY_NO_BROWSER:-0}" != 1 ]]; then
  # Both the native and flatpak profile roots; either may be absent.
  FF_ROOTS=(
    "$HOME/.mozilla/firefox"
    "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox"
  )

  # Firefox's own built-in theme paints over the lwt variables unless a
  # matching light/dark base is active, so pick the base from the
  # palette's actual background luminance rather than assuming dark --
  # mono-light is a real preset and would otherwise render black-on-black.
  FF_THEME_ID=$(python3 -c "
import sys
bg = sys.argv[1]
r, g, b = (int(bg[i:i+2], 16) for i in (1, 3, 5))
# Rec.601 luma; >128 is a light background.
print('firefox-compact-light@mozilla.org' if (0.299*r + 0.587*g + 0.114*b) > 128
      else 'firefox-compact-dark@mozilla.org')
" "$PAL_BG" 2>/dev/null || echo 'firefox-compact-dark@mozilla.org')

  FF_PROFILES=()
  for root in "${FF_ROOTS[@]}"; do
    [[ -d "$root" ]] || continue
    # profiles.ini is authoritative: globbing *.default* misses profiles
    # created by `firefox -P` and picks up leftovers of deleted ones.
    if [[ -f "$root/profiles.ini" ]]; then
      while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        # IsRelative=0 entries store an absolute Path.
        if [[ "$rel" == /* ]]; then
          [[ -d "$rel" ]] && FF_PROFILES+=("$rel")
        else
          [[ -d "$root/$rel" ]] && FF_PROFILES+=("$root/$rel")
        fi
      done < <(sed -n 's/^Path=//p' "$root/profiles.ini")
    else
      for p in "$root"/*.default*; do
        [[ -d "$p" ]] && FF_PROFILES+=("$p")
      done
    fi
  done

  for prof in "${FF_PROFILES[@]}"; do
    mkdir -p "$prof/chrome"

    cat > "$prof/chrome/userChrome.css" <<EOF
/* Generated by theme-apply -- mode: $MODE. Edits are overwritten. */
@namespace url("http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul");

:root {
  --lwt-accent-color: $PAL_ALT !important;
  --lwt-accent-color-inactive: $PAL_ALT !important;
  --lwt-text-color: $PAL_FG !important;

  --toolbar-bgcolor: $PAL_ALT !important;
  --toolbar-color: $PAL_FG !important;
  --toolbarbutton-icon-fill: $PAL_FG !important;

  --tab-selected-bgcolor: $PAL_BG !important;
  --tab-selected-textcolor: $PAL_FG !important;

  --toolbar-field-background-color: $PAL_BG !important;
  --toolbar-field-color: $PAL_FG !important;
  --toolbar-field-focus-background-color: $PAL_BG !important;
  --toolbar-field-focus-color: $PAL_FG !important;
  --toolbar-field-border-color: $PAL_ALT !important;
  --toolbar-field-focus-border-color: $PAL_ACCENT !important;

  --arrowpanel-background: $PAL_ALT !important;
  --arrowpanel-color: $PAL_FG !important;
  --arrowpanel-border-color: $PAL_BG !important;

  --lwt-sidebar-background-color: $PAL_ALT !important;
  --lwt-sidebar-text-color: $PAL_FG !important;

  --focus-outline-color: $PAL_ACCENT !important;
  --link-color: $PAL_ACCENT !important;
}

#navigator-toolbox,
#TabsToolbar,
#nav-bar,
#PersonalToolbar {
  background-color: $PAL_ALT !important;
  color: $PAL_FG !important;
}

/* Accent underline on the active tab -- the one place the palette's
   accent shows up as more than a focus ring. */
.tabbrowser-tab[selected] .tab-background {
  background: $PAL_BG !important;
  box-shadow: inset 0 -2px 0 0 $PAL_ACCENT !important;
}

findbar,
#sidebar-header,
#sidebar-box {
  background-color: $PAL_ALT !important;
  color: $PAL_FG !important;
}
EOF

    cat > "$prof/chrome/userContent.css" <<EOF
/* Generated by theme-apply -- mode: $MODE. Edits are overwritten. */
/* about: pages render as content, not chrome, so they need their own
   rules or every new tab flashes default white between navigations. */
@-moz-document url("about:blank"),
               url("about:newtab"),
               url("about:home"),
               url("about:privatebrowsing") {
  :root, body {
    background-color: $PAL_BG !important;
    color: $PAL_FG !important;
  }
}
EOF

    # user.js is merged over prefs.js at every startup, so these stick.
    # Rewritten wholesale each apply -- appending would grow the file
    # without bound and leave a stale activeThemeID ahead of the new one.
    cat > "$prof/user.js" <<EOF
// Generated by theme-apply -- mode: $MODE. Edits are overwritten.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("extensions.activeThemeID", "$FF_THEME_ID");
user_pref("browser.newtabpage.activity-stream.newNewtabExperience.colors", "$PAL_ACCENT");
EOF
  done

  # Restart Firefox so the freshly written userChrome.css is actually
  # read. SIGTERM (pkill's default), never -9: Firefox only writes its
  # session-restore state on a clean shutdown, so KILL here would cost
  # the user every open tab.
  if [[ ${#FF_PROFILES[@]} -gt 0 ]] && pgrep -x firefox >/dev/null 2>&1; then
    pkill -x firefox 2>/dev/null || true
    # Firefox holds a profile lock briefly after the process exits;
    # relaunching into it too early aborts with "already running".
    for _ in $(seq 20); do
      pgrep -x firefox >/dev/null 2>&1 || break
      sleep 0.25
    done
    if FF_BIN=$(command -v firefox); then
      ( DISPLAY="${DISPLAY:-:0}" setsid "$FF_BIN" >/dev/null 2>&1 </dev/null & disown ) &
      disown
    fi
  fi
fi

# ---------------------------------------------------------------------
# Boot splash
# ---------------------------------------------------------------------
# Re-render the plymouth splash in the new palette, so the boot screen
# matches the desktop instead of being frozen in whatever theme happened
# to be active when it was first generated. Without this, switching from
# gruvbox to nord leaves you booting into a gruvbox-coloured splash.
#
# Guarded three ways, because a theme switch must never block:
#   * skipped entirely unless the theme is already installed -- generating
#     it here would be a surprising side effect of changing colours
#   * `sudo -n` only: writing to /usr/share needs root, and a password
#     prompt in the middle of a theme switch would hang it with no
#     terminal to type into
#   * backgrounded and silenced, so a failure costs nothing
if [[ -d /usr/share/plymouth/themes/dotfiles ]] \
   && command -v boot-splash >/dev/null 2>&1 \
   && sudo -n true 2>/dev/null; then
  # Regenerate (fast), then hand the BOOT screen to autosync.
  #
  # The theme is embedded in the initramfs, so the boot screen only follows
  # once mkinitcpio reruns -- about a minute. Doing that inline on every
  # colour change would be intolerable while you are flicking through
  # themes deciding, and the previous behaviour (notify and let the user
  # remember) meant rebooting into last week's colours.
  #
  # `boot-splash autosync` waits out a debounce and then rebuilds ONCE, for
  # whichever theme you settled on. It is a no-op when the boot screen is
  # already current, when the splash is not enabled, or when passwordless
  # sudo is unavailable, and it notifies on failure -- a silent failed sync
  # would leave the initramfs holding the old splash with nothing to say so.
  (
    boot-splash generate >/dev/null 2>&1
    boot-splash autosync >/dev/null 2>&1
  ) >/dev/null 2>&1 &
fi

# ---- The "theme changed" notification ----
#
# It used to read
#
#     theme-apply
#     Theme -> monokai
#
# which is the script talking to its author. The summary was the FILENAME
# of the program that ran, and the body was a shell arrow joined to an
# internal mode string — neither is a thing the person who just picked a
# theme has any use for, and "theme-apply" as the app name is what the
# island prints above it, so the notification announced itself twice and
# the choice once.
#
# What it says now is the choice, in the words the choice was offered in:
# the picker lists "Rose Pine", so this says "Rose Pine". `$MODE` stays out
# of sight where it belongs.
#
# The body names the WALLPAPER, and that is the point of the rewrite rather
# than a decoration. A theme now draws one image at random out of its set,
# so "which one did I get" is a real question with a real follow-up — the
# answer is what you pass to `theme-wallpaper bind` if you want to keep it.
# It is omitted, not faked, when nothing moved: wal mode derives the palette
# FROM the wallpaper and never sets one, and a theme with an empty set exits
# 0 having changed nothing.
THEME_LABEL="$(printf '%s' "$MODE" | sed -e 's/-/ /g' -e 's/\b\(.\)/\u\1/g')"
if [ -n "${WALL_APPLIED:-}" ]; then
  WALL_NAME="$(basename "$WALL_APPLIED")"
  NOTIFY_BODY="Palette and wallpaper · ${WALL_NAME%.*}"
elif [ "$MODE" = "wal" ]; then
  NOTIFY_BODY="Palette generated from the wallpaper"
else
  NOTIFY_BODY="Palette applied"
fi
notify-send -a "Theme" -u low -t 4000 -i preferences-desktop-theme \
  "$THEME_LABEL" "$NOTIFY_BODY" 2>/dev/null || true

# Extension point: anything dropped in hooks/post-theme-apply.d/ runs
# here, after every app has been retinted, with the mode name as $1. See
# ati-hook.
command -v ati-hook >/dev/null 2>&1 && ati-hook post-theme-apply "$MODE"
