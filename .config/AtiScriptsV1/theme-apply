#!/usr/bin/env bash
# theme-apply <mode>
#
# Supported modes:
#   doomone dracula gruvbox nord tokyonight catppuccin  -> preset palette
#   wal                                                  -> pywal from ~/.cache/wall
#
# For each mode we symlink:
#   ~/.config/kitty/themes/current.conf     -> kitty palette (SIGUSR1 reloads live)
#   ~/.config/rofi/themes/current-palette.rasi -> rofi color vars
# then reload qtile so lib/colors.py picks up the new mode via
# ~/.cache/qtile/theme_mode.
#
# Wal mode passes -s -t and --saturate 0.75 to punch up dim wallpapers.

set -euo pipefail

MODE="${1:-doomone}"
CACHE_DIR="$HOME/.cache/qtile"
STATE_FILE="$CACHE_DIR/theme_mode"

mkdir -p "$CACHE_DIR"

PRESETS=(doomone dracula gruvbox nord tokyonight catppuccin)

is_preset() {
  local m="$1"
  for p in "${PRESETS[@]}"; do
    [[ "$p" == "$m" ]] && return 0
  done
  return 1
}

if [[ "$MODE" != "wal" ]] && ! is_preset "$MODE"; then
  echo "usage: theme-apply <doomone|dracula|gruvbox|nord|tokyonight|catppuccin|wal>" >&2
  exit 1
fi

KITTY_THEMES="$HOME/.config/kitty/themes"
ROFI_THEMES="$HOME/.config/rofi/themes"

if [[ "$MODE" == "wal" ]]; then
  if ! command -v wal >/dev/null; then
    notify-send -u critical "theme-apply" "pywal not installed"
    exit 1
  fi
  WALL_LINK="$HOME/.cache/wall"
  if [[ ! -f "$WALL_LINK" ]]; then
    notify-send -u critical "theme-apply" "~/.cache/wall missing — set a wallpaper first"
    exit 1
  fi
  # Default backend + max saturation. Monochromatic wallpapers still
  # produce single-hue palettes; colors.py falls back to DoomOne accents
  # (keeping only wal bg/fg) when the accent hues span <60 degrees.
  # 2>/dev/null suppresses pywal's harmless kitty remote-control failure
  # (unix:/tmp/kitty_pywal socket doesn't exist; we reload kitty via SIGUSR1).
  wal -i "$(cat "$WALL_LINK")" -n -s -t -q --saturate 1.0 2>/dev/null

  # ---- Build wal-flavored rofi palette from wal cache ----
  BG="$(jq -r .special.background ~/.cache/wal/colors.json)"
  FG="$(jq -r .special.foreground ~/.cache/wal/colors.json)"
  BG_ALT="$(jq -r .colors.color0 ~/.cache/wal/colors.json)"
  SEL="$(jq -r .colors.color14 ~/.cache/wal/colors.json)"
  SEL2="$(jq -r .colors.color12 ~/.cache/wal/colors.json)"
  URG="$(jq -r .colors.color9 ~/.cache/wal/colors.json)"
  ACT="$(jq -r .colors.color10 ~/.cache/wal/colors.json)"
  cat >"$ROFI_THEMES/palette-wal.rasi" <<EOF
* {
    background:     $BG;
    background-alt: $BG_ALT;
    foreground:     $FG;
    selected:       $SEL;
    selectedone:    $SEL2;
    urgent:         $URG;
    active:         $ACT;
}
EOF
  ln -sfn "$HOME/.cache/wal/colors-kitty.conf" "$KITTY_THEMES/current.conf"
  ln -sfn palette-wal.rasi "$ROFI_THEMES/current-palette.rasi"
else
  ln -sfn "$MODE.conf" "$KITTY_THEMES/current.conf"
  ln -sfn "palette-$MODE.rasi" "$ROFI_THEMES/current-palette.rasi"
fi

# ---- Qutebrowser homepage CSS vars ----
QB_CSS="$CACHE_DIR/qutebrowser-vars.css"
gen_qb_css() {
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  cat >"$QB_CSS" <<EOF
:root {
  --bg: $bg;
  --bg-alt: $bg_alt;
  --fg: $fg;
  --red: $red;
  --green: $green;
  --yellow: $yellow;
  --blue: $blue;
  --purple: $purple;
  --cyan: $cyan;
}
EOF
}

case "$MODE" in
  wal)
    W=~/.cache/wal/colors.json
    gen_qb_css \
      "$(jq -r .special.background "$W")" \
      "$(jq -r .colors.color0 "$W")" \
      "$(jq -r .special.foreground "$W")" \
      "$(jq -r .colors.color9 "$W")" \
      "$(jq -r .colors.color10 "$W")" \
      "$(jq -r .colors.color11 "$W")" \
      "$(jq -r .colors.color12 "$W")" \
      "$(jq -r .colors.color13 "$W")" \
      "$(jq -r .colors.color14 "$W")"
    ;;
  doomone)   gen_qb_css "#282c34" "#1e222a" "#dcdfe4" "#ff6c6b" "#98be65" "#ecbe7b" "#51afef" "#c678dd" "#46d9ff" ;;
  dracula)   gen_qb_css "#282a36" "#21222c" "#f8f8f2" "#ff5555" "#50fa7b" "#f1fa8c" "#bd93f9" "#ff79c6" "#8be9fd" ;;
  nord)      gen_qb_css "#2e3440" "#3b4252" "#d8dee9" "#bf616a" "#a3be8c" "#ebcb8b" "#81a1c1" "#b48ead" "#88c0d0" ;;
  gruvbox)   gen_qb_css "#282828" "#1d2021" "#ebdbb2" "#fb4934" "#b8bb26" "#fabd2f" "#83a598" "#d3869b" "#8ec07c" ;;
  tokyonight) gen_qb_css "#1a1b26" "#16161e" "#c0caf5" "#f7768e" "#9ece6a" "#e0af68" "#7aa2f7" "#bb9af7" "#7dcfff" ;;
  catppuccin) gen_qb_css "#1e1e2e" "#181825" "#cdd6f4" "#f38ba8" "#a6e3a1" "#f9e2af" "#89b4fa" "#cba6f7" "#94e2d5" ;;
esac

echo "$MODE" >"$STATE_FILE"

# Live-reload all running kitty instances
for pid in $(pgrep -x kitty || true); do
  kill -SIGUSR1 "$pid" 2>/dev/null || true
done

# ---- Dunst ----
# Render dunstrc from ~/.dotfiles/.config/dunst/dunstrc.tmpl with palette
# substitutions. Retint only the 3 urgency levels + global frame_color;
# named notification classes (success/warning/todo/spotify/etc) keep
# their semantic hardcoded colors.
DUNSTRC="$HOME/.config/dunst/dunstrc"
DUNST_TMPL="$HOME/.dotfiles/.config/dunst/dunstrc.tmpl"
render_dunstrc() {
  local bg="$1" fg="$2" bg_crit="$3" fg_crit="$4" accent="$5" ok="$6" urgent="$7"
  # Break any stow symlink to dunstrc — we'll manage the real file now.
  [[ -L "$DUNSTRC" ]] && rm "$DUNSTRC"
  sed -e "s|{{BG}}|$bg|g" \
      -e "s|{{FG}}|$fg|g" \
      -e "s|{{BG_CRIT}}|$bg_crit|g" \
      -e "s|{{FG_CRIT}}|$fg_crit|g" \
      -e "s|{{ACCENT}}|$accent|g" \
      -e "s|{{OK}}|$ok|g" \
      -e "s|{{URGENT}}|$urgent|g" \
      "$DUNST_TMPL" >"$DUNSTRC"
}

if [[ -f "$DUNST_TMPL" ]]; then
  case "$MODE" in
    wal)
      W=~/.cache/wal/colors.json
      render_dunstrc \
        "$(jq -r .special.background "$W")" \
        "$(jq -r .special.foreground "$W")" \
        "$(jq -r .colors.color0 "$W")" \
        "$(jq -r .special.foreground "$W")" \
        "$(jq -r .colors.color12 "$W")" \
        "$(jq -r .colors.color10 "$W")" \
        "$(jq -r .colors.color9 "$W")"
      ;;
    doomone)   render_dunstrc "#1c2028" "#bbc2cf" "#2b1517" "#ffdada" "#51afef" "#98be65" "#ff6c6b" ;;
    dracula)   render_dunstrc "#21222c" "#f8f8f2" "#3d1e2c" "#ffdada" "#bd93f9" "#50fa7b" "#ff5555" ;;
    nord)      render_dunstrc "#2e3440" "#d8dee9" "#3b1f22" "#ffdada" "#88c0d0" "#a3be8c" "#bf616a" ;;
    gruvbox)   render_dunstrc "#282828" "#ebdbb2" "#3c1f1c" "#ffdada" "#fabd2f" "#b8bb26" "#fb4934" ;;
    tokyonight) render_dunstrc "#1a1b26" "#c0caf5" "#3d1f2a" "#ffdada" "#7aa2f7" "#9ece6a" "#f7768e" ;;
    catppuccin) render_dunstrc "#1e1e2e" "#cdd6f4" "#3d1f2a" "#ffdada" "#cba6f7" "#a6e3a1" "#f38ba8" ;;
  esac
  # Restart dunst so it re-reads dunstrc
  pkill -x dunst 2>/dev/null || true
  sleep 0.2
  dunst >/dev/null 2>&1 &
  disown
fi

# Reload qtile
command -v qtile >/dev/null && qtile cmd-obj -o cmd -f reload_config 2>/dev/null || true

# Reload qutebrowser (picks up new wal colors from ~/.cache/wal/colors.json)
if pgrep -x qutebrowser >/dev/null; then
  qutebrowser ":config-source" 2>/dev/null || true
fi

notify-send "theme-apply" "Theme -> $MODE"
