#!/usr/bin/env bash
# theme-apply <mode>
#
# Supported modes:
#   doomone dracula gruvbox nord tokyonight catppuccin  -> preset palette
#   wal                                                  -> pywal from ~/.cache/wall
#
# For each mode we symlink:
#   ~/.config/kitty/themes/current.conf     -> kitty palette (SIGUSR1 reloads live)
#   ~/.config/rofi/themes/current-palette.rasi -> rofi color vars
# then reload qtile so lib/colors.py picks up the new mode via
# ~/.cache/qtile/theme_mode.
#
# Wal mode passes -s -t and --saturate 0.75 to punch up dim wallpapers.

set -euo pipefail

# Re-exec under setsid so this invocation is always its own session AND
# process-group leader (pgid == pid), regardless of how the caller spawned
# us (some callers already use start_new_session, others just background
# with `&`, which leaves us sharing the caller's pgid). This matters for
# the preemption kill below: it targets a process GROUP, and that is only
# safe/complete if every synchronous child we spawn (the python3 heredocs
# that write colors.json, kitty conf, etc.) shares our pgid rather than
# some ancestor's.
if [[ "${THEME_APPLY_REEXEC:-0}" != 1 ]]; then
  export THEME_APPLY_REEXEC=1
  exec setsid "$0" "$@"
fi

MODE="${1:-doomone}"
CACHE_DIR="$HOME/.cache/qtile"
STATE_FILE="$CACHE_DIR/theme_mode"

mkdir -p "$CACHE_DIR"

# Prevent concurrent invocations. flock(1) can't be used here: theme-
# apply spawns brave/chrome which inherit the lock FD and hold it
# forever after theme-apply exits — every subsequent apply then no-ops
# with "already running". Use a PID-file lock instead: cheap TOCTOU
# race is acceptable for interactive keybind spam.
LOCK="$CACHE_DIR/.theme-apply.pid"
# Preempt any in-flight run so rapid picker clicks always land the
# latest choice instead of silently no-op'ing on the lock.
#
# Kill the whole process GROUP (-old_pid), not just old_pid itself. A
# plain `kill old_pid` only signals the outer bash script; a synchronous
# child it's currently blocked on (e.g. one of the python3 heredocs below
# that writes ~/.cache/wal/colors.json) is never touched, gets orphaned,
# and keeps running to completion in the background. Since none of those
# writes are atomic, an orphaned writer from a SUPERSEDED wallpaper/theme
# pick can finish after the new invocation and silently overwrite the
# palette you actually picked with the stale one — invisible during the
# live session (qtile just keeps its already-applied state) but wrong on
# the next cold boot, when colors.py reads the file fresh off disk. The
# re-exec above guarantees old_pid is a process-group leader so `-old_pid`
# reliably reaches every synchronous child.
if [[ -f "$LOCK" ]]; then
  old_pid="$(cat "$LOCK" 2>/dev/null || true)"
  if [[ -n "$old_pid" ]] && [[ "$old_pid" != "$$" ]] && kill -0 "$old_pid" 2>/dev/null; then
    if grep -q theme-apply "/proc/$old_pid/cmdline" 2>/dev/null; then
      kill -- -"$old_pid" 2>/dev/null || true
      # Give it a moment to release resources.
      for _ in 1 2 3 4 5; do
        kill -0 "$old_pid" 2>/dev/null || break
        sleep 0.1
      done
      kill -9 -- -"$old_pid" 2>/dev/null || true
    fi
  fi
fi
echo $$ >"$LOCK"
trap 'rm -f "$LOCK"' EXIT INT TERM

PRESETS=(doomone dracula gruvbox nord tokyonight catppuccin monokai everforest rose-pine kanagawa oxocarbon cyberpunk-neon synthwave matrix mono-dark mono-light nightowl onedark palenight github-dark ayu-mirage)

is_preset() {
  local m="$1"
  for p in "${PRESETS[@]}"; do
    [[ "$p" == "$m" ]] && return 0
  done
  return 1
}

if [[ "$MODE" != "wal" ]] && ! is_preset "$MODE"; then
  echo "usage: theme-apply <doomone|dracula|gruvbox|nord|tokyonight|catppuccin|monokai|everforest|rose-pine|kanagawa|oxocarbon|cyberpunk-neon|synthwave|matrix|mono-dark|mono-light|nightowl|onedark|palenight|github-dark|ayu-mirage|wal>" >&2
  exit 1
fi

# ---- SNAPSHOT THE OUTGOING PALETTE, BEFORE ANYTHING OVERWRITES IT ----
#
# qtile's apply_palette_live() (config.py) needs the palette THIS script
# is about to replace, by exact hex value per named slot — not a guess
# reconstructed from the 20-odd hardcoded _PRESETS tables afterwards, which
# is the bug its own docstring used to record ("visual coverage across all
# themes proved unreliable" — real for anything touching `wal` mode, whose
# hex values are wallpaper-derived and appear in no static table at all).
# One `cp`, before gen_island_colors (~line 936, further down) has a
# chance to overwrite current_palette.json with the INCOMING palette.
# Missing on the very first run after install — apply_palette_live()
# reads that as "nothing to map from" and returns False, which is the
# correct answer: a one-time restart-path fallback, not a wrong swap.
if [[ -f "$HOME/.cache/qtile/current_palette.json" ]]; then
  cp -f "$HOME/.cache/qtile/current_palette.json" "$HOME/.cache/qtile/current_palette.prev.json" 2>/dev/null || true
fi

# ---- IS SOMETHING ALREADY COVERING THE SCREEN FOR US? ----
#
# Set by ThemeTransitionWindow.qml's applyProcess ONLY — the overlay
# spawns this script as its own child specifically to run theme-apply
# BEHIND its frozen frame, and sets this so theme-apply knows it does not
# need its own cover. Every other caller (theme-animate's own fallback
# `exec theme-apply "$mode"` when no shell answers the IPC probe; a bare
# manual `theme-apply <mode>` from a terminal) runs with nothing covering
# the screen at all, and MUST still get the full visible veil under qtile
# — that is the ONLY thing hiding the palette-swap-then-restart flicker in
# those cases, exactly as it always has.
_covered=0
[[ -n "${THEME_APPLY_COVERED:-}" ]] && _covered=1

# ---- Raise the restart veil NOW, before any palette is written ----
# The restart at the end of this script is what the veil normally covers,
# but everything between here and there -- ~10 app palettes, GTK, qt5ct,
# rofi, dunst, papirus -- takes about 4s, and the user watched all of it
# happen on a naked desktop: colours visibly swapping, a pause, and only
# then a loading screen. Raising the veil first hides that whole window.
#
# Fire-and-forget in the background: this must never delay or fail the
# theme change. Same probe-the-config-module pattern as the restart call
# below (a qtile attribute may not be attached yet; the module function
# has been there far longer).
#
# DISOWNED, and that is not tidiness — without it this job is waited on.
# The kitty fan-out ~900 lines below ends in a bare `wait`, and a bare
# `wait` collects EVERY background job the shell still owns, not the ones
# the line above it started. So this call sat on the critical path to
# THEME_APPLY_VISIBLE_DONE, which is the marker the Hyprland session's
# transition cover holds a frozen screenshot until it sees.
#
# It costs the most on the session where it can do the least. Under
# Hyprland qtile is not running, so `qtile cmd-obj` cannot connect and
# only fails after its own timeout — measured at 503 ms, against ~30 ms
# for each of the three kitty sockets the `wait` is actually there for.
# Half a second of frozen desktop, every theme change, spent on an IPC
# call to a window manager that is not running.
#
# The eww block below already disowns for the same reason; this one was
# missed, and nothing reported it because the veil call is fire-and-forget
# by design — it fails silently, which is correct, and so the only symptom
# was the freeze being half a second longer than it needed to be.
# invisible = $_covered: when an overlay spawned this script (see
# THEME_APPLY_COVERED above), it is ALREADY the circular-reveal cover for
# this theme change, so a second, VISIBLE veil stacked on top of it is a
# redundant animation — reported directly: "now i have animation while
# changing theme ok i want disable this but keep for reloading the
# qtile". The veil itself, and the state-save/xmodmap-safe wait it does
# before restarting, are still exactly as needed either way; only its
# drawing is conditionally skipped. When NOT covered — theme-animate's own
# fallback, or a bare manual `theme-apply <mode>` — the veil stays fully
# visible, because nothing else is hiding the transition in that case.
# Manual Super+Shift+R restarts are a completely separate call site
# (config.py's own keybind, _smooth_restart with no argument) and always
# show the full veil regardless of any of this.
#
# ONLY RAISED WHEN THE LIVE PALETTE SWAP CANNOT POSSIBLY WORK — i.e. only
# when current_palette.prev.json does not exist yet (the snapshot copy a
# few lines up would have written it if there was anything to snapshot;
# see apply_palette_live()'s own docstring in config.py). That is a
# one-time condition, true only on the very first theme change after
# install or after the cache is cleared — every run after it has a
# snapshot and goes through the no-restart live-swap path further down,
# where nothing needs covering at all.
#
# Reported: "can we avoid this [restart] and just have the animiton?",
# measured (vmstat during a themed restart: 50-70%+ CPU, run queue up to
# 9, for the whole covered window) as the actual cause of the reveal
# animation stuttering — a whole extra Python+GTK process is real
# overhead, and there is no reason to pay it speculatively on every theme
# change just to cover a restart that essentially never happens once a
# snapshot exists.
if [[ ! -f "$HOME/.cache/qtile/current_palette.prev.json" ]]; then
  (
    qtile cmd-obj -o cmd -f eval -a \
      "str(__import__(\"sys\").modules[\"config\"]._veil_hold($([[ $_covered = 1 ]] && echo True || echo False)))" \
      >/dev/null 2>&1 || true
  ) &
  disown
fi

# ---- FAST PATH: WALLPAPER-ONLY, SAME THEME — SKIP EVERYTHING BELOW ----
#
# Reported: "the animation of wave of hyperland's changing the wallpaper
# not the same here... it is slow make it faster like hyper." Measured
# where the time actually goes for an ordinary run of this script: the
# Chromium theme extension is repacked and brave/chrome are KILLED AND
# RELAUNCHED (see "THE VISIBLE-REPAINT MARKER" note further down — its
# own numbers put this at 1.27s -> 3.28s, the whole remaining two thirds
# of a run), on top of kitty/GTK/qt5ct/rofi/dunst all regenerating from
# scratch. Every one of those is redundant work when only the WALLPAPER
# changed and the theme did not: every app palette below would come out
# byte-identical to what is already on disk, so writing it again buys
# nothing and killing/relaunching a browser for it is actively disruptive
# — real windows flashing closed and reopening over a wallpaper pick.
#
# Signalled by a marker file rather than an argument, because the actual
# call into this script (when an overlay is covering it) is a QML
# `Process` spawned by ThemeTransitionWindow.qml — threading a second
# argument through applyThemeAnimated()'s IPC signature the same way
# THEME_APPLY_COVERED needed a real Process.environment property would be
# a change on both shell.qml and popups.qml for what a cache file already
# answers just as well, and this script already reads several of those
# ($MODE aside) without anyone objecting.
#
# Consumed (removed) immediately, not left for the next run to find —
# stale would mean the NEXT real theme change from a script or a crash
# recovery silently skips the retheming pipeline it actually needs.
# WallpaperPopup.py's apply_wallpaper() is the only writer today.
WALLPAPER_ONLY_MARKER="$HOME/.cache/qtile/.wallpaper_only_pending"
if [[ -f "$WALLPAPER_ONLY_MARKER" ]]; then
  rm -f "$WALLPAPER_ONLY_MARKER"
  # wal is excluded on purpose: there the wallpaper IS the palette, so a
  # "wallpaper-only" pick in wal mode is a real palette change and needs
  # the full pipeline same as always. Only a NAMED preset can have a
  # wallpaper swap that touches nothing else.
  if [[ "$MODE" != "wal" ]]; then
    if command -v theme-wallpaper >/dev/null 2>&1; then
      theme-wallpaper apply "$MODE" instant || true
    fi
    printf '%s\n' 'THEME_APPLY_VISIBLE_DONE'
    exit 0
  fi
fi

KITTY_THEMES="$HOME/.config/kitty/themes"
ROFI_THEMES="$HOME/.config/rofi/themes"
ALACRITTY_THEMES="$HOME/.config/alacritty/themes"

# Alacritty preset name (upstream repo uses snake_case, our modes use
# kebab/short). Maps preset mode -> themes/themes/<file>.toml.
alacritty_preset_for() {
  case "$1" in
    doomone)    echo doom_one ;;
    dracula)    echo dracula ;;
    gruvbox)    echo gruvbox_dark ;;
    nord)       echo nord ;;
    tokyonight) echo tokyo_night ;;
    catppuccin) echo catppuccin_mocha ;;
    monokai)    echo monokai_pro ;;
    everforest) echo everforest_dark ;;
    rose-pine)  echo rose_pine ;;
    kanagawa)   echo kanagawa_wave ;;
    oxocarbon)  echo oxocarbon ;;
    cyberpunk-neon) echo cyber_punk_neon ;;
    synthwave)  echo synthwave_84 ;;
    matrix)     echo hardhacker ;;
    mono-dark)  echo alabaster_dark ;;
    mono-light) echo alabaster ;;
    nightowl)   echo night_owl ;;
    onedark)    echo one_dark ;;
    palenight)  echo palenight ;;
    github-dark) echo github_dark ;;
    ayu-mirage) echo ayu_mirage ;;
    *)          echo doom_one ;;
  esac
}

if [[ "$MODE" == "wal" ]]; then
  if ! command -v wal >/dev/null; then
    notify-send -u critical "theme-apply" "pywal not installed"
    exit 1
  fi
  WALL_LINK="$HOME/.cache/wall"
  if [[ ! -f "$WALL_LINK" ]]; then
    # shellcheck disable=SC2088  # ~ is prose in a message, not a path
    notify-send -u critical "theme-apply" "~/.cache/wall missing — set a wallpaper first"
    exit 1
  fi
  # Prefer symlink target; fall back to file contents for legacy plain-text
  # `~/.cache/wall` written by older dm-setbg / WallpaperPopup versions.
  if [[ -L "$WALL_LINK" ]]; then
    WALL_PATH="$(readlink -f "$WALL_LINK")"
  else
    WALL_PATH="$(head -n 1 "$WALL_LINK" 2>/dev/null | tr -d '\r\n\0')"
    # Migrate to symlink so future runs take the fast path.
    if [[ -f "$WALL_PATH" ]]; then
      ln -sfn "$WALL_PATH" "$WALL_LINK" 2>/dev/null || true
    fi
  fi
  # Guard: wall path stale (file deleted after cache write).
  if [[ ! -f "$WALL_PATH" ]]; then
    notify-send -u critical "theme-apply" "wallpaper file missing: $WALL_PATH"
    exit 1
  fi
  WALL_STEM="$(basename "$WALL_PATH")"; WALL_STEM="${WALL_STEM%.*}"
  PRECOMPILED="$HOME/.cache/qtile/palettes/$WALL_STEM.json"

  # New wallpaper (not in precompile cache) — generate its palette on
  # demand so the fast path can be used. Falls through to legacy live
  # wal only if wal-precompile itself fails or is missing.
  if [[ ! -f "$PRECOMPILED" ]] && command -v wal-precompile >/dev/null; then
    wal-precompile --only "$(basename "$WALL_PATH")" --force >/dev/null 2>&1 || true
  fi

  if [[ -f "$PRECOMPILED" ]]; then
    # Fast path: precompiled palette contains pre-rendered consumer
    # templates. Write them directly, skip wal binary + wal -R.
    mkdir -p "$HOME/.cache/wal" "$HOME/.config/qtile/browser-theme"
    python3 - "$PRECOMPILED" "$KITTY_THEMES" "$ROFI_THEMES" <<'PYEOF' 2>/dev/null || true
import json, os, sys, time
src   = json.load(open(sys.argv[1]))
kdir  = sys.argv[2]
rdir  = sys.argv[3]
cons  = src["consumers"]
def w(p, s):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    open(p, "w").write(s)
w(os.path.expanduser("~/.cache/wal/colors.json"),
  json.dumps(src["wal_colors"], indent=4))
w(os.path.expanduser("~/.cache/wal/colors-kitty.conf"),
  cons["kitty_conf"])
w(os.path.join(rdir, "palette-wal.rasi"), cons["rofi_rasi"])
# also emit a minimal colors-wal.vim so any tool still expecting it works
wc = src["wal_colors"]["colors"]
w(os.path.expanduser("~/.cache/wal/colors-wal.vim"),
  "let background = \"{}\"\n".format(src["bg"]) +
  "let foreground = \"{}\"\n".format(src["fg"]) +
  "".join(f'let color{i} = "{wc["color"+str(i)]}"\n' for i in range(16)))
# brave manifest with fresh version so chromium reloads
mf = dict(cons["brave_theme"])
mf["version"] = "1.0." + str(int(time.time()))
w(os.path.expanduser("~/.config/qtile/browser-theme/manifest.json"),
  json.dumps(mf, indent=2))
# gtk css overlay (~/.cache/qtile/gtk-wal.css already @imported)
w(os.path.expanduser("~/.cache/qtile/gtk-wal.css"), cons["gtk_css"])
PYEOF
    # Skip wal -R: precompiled templates already cover kitty+rofi+brave+gtk.
    # Alacritty wal palette from precompiled consumers.alacritty_toml
    # Both paths as argv rather than spliced into the source: $PRECOMPILED
    # carries a wallpaper filename and $HOME an arbitrary username, and
    # either containing an apostrophe closed the string literal and made
    # this a silent no-op behind the 2>/dev/null.
    python3 -c "
import json, sys
d=json.load(open(sys.argv[1]))
t=d['consumers'].get('alacritty_toml','')
open(sys.argv[2],'w').write(t)
" "$PRECOMPILED" "$HOME/.cache/wal/colors-alacritty.toml" 2>/dev/null || true
    ln -sfn "$HOME/.cache/wal/colors-kitty.conf" "$KITTY_THEMES/current.conf"
    ln -sfn palette-wal.rasi "$ROFI_THEMES/current-palette.rasi"
    ln -sfn "$HOME/.cache/wal/colors-alacritty.toml" "$ALACRITTY_THEMES/current.toml"
    PRECOMPILED_APPLIED=1
  else
    # Fallback: live wal extraction. Colorz backend + saturation punch.
    wal --backend colorz -i "$WALL_PATH" -n -s -t -q --saturate 1.0 2>/dev/null \
      || wal -i "$WALL_PATH" -n -s -t -q --saturate 1.0 2>/dev/null

    # Monochrome / desaturated wallpapers produce useless palettes (all
    # one hue). Detect via HSV hue spread AND mean saturation on
    # color9-14; if either fails, overwrite accents with DoomOne while
    # keeping wal bg/fg. Thresholds match WAL_AUDIT_REPORT.md findings.
    python3 <<'PYEOF' 2>/dev/null || true
import json, os, colorsys
p = os.path.expanduser("~/.cache/wal/colors.json")
with open(p) as f:
    d = json.load(f)
accents = [d["colors"][f"color{i}"] for i in range(9, 15)]
def hsv(hx):
    r, g, b = int(hx[1:3],16)/255, int(hx[3:5],16)/255, int(hx[5:7],16)/255
    return colorsys.rgb_to_hsv(r, g, b)
hs = [hsv(a)[0] * 360 for a in accents]
ss = [hsv(a)[1] for a in accents]
spread = max(hs) - min(hs)
sat_mean = sum(ss) / len(ss)
if spread < 60 or sat_mean < 0.25:
    doomone = {
        "color1":"#ff6c6b","color9":"#ff6c6b",
        "color2":"#98be65","color10":"#98be65",
        "color3":"#da8548","color11":"#da8548",
        "color4":"#51afef","color12":"#51afef",
        "color5":"#c678dd","color13":"#c678dd",
        "color6":"#46d9ff","color14":"#46d9ff",
    }
    d["colors"].update(doomone)
    with open(p, "w") as f:
        json.dump(d, f, indent=4)
PYEOF
  fi

  if [[ "${PRECOMPILED_APPLIED:-0}" != 1 ]]; then
    # No precompile — legacy path needs wal -R to regenerate kitty conf
    # then build rofi rasi from live wal cache.
    wal -R -q 2>/dev/null || true
    # jq is not a declared dependency of anything else on this path, and
    # it is the only thing that reads the palette here. Without it every
    # assignment below came back empty and the rasi was written with bare
    # `background: ;` lines -- which rofi refuses to parse, so every menu
    # on the desktop stopped opening after a wallpaper change, with the
    # theme switch itself reporting success.
    if ! command -v jq >/dev/null 2>&1; then
      notify-send -u critical "theme-apply" "jq is not installed — cannot build the wal rofi palette"
      exit 1
    fi
    BG="$(jq -r .special.background ~/.cache/wal/colors.json)"
    FG="$(jq -r .special.foreground ~/.cache/wal/colors.json)"
    BG_ALT="$(jq -r .colors.color0 ~/.cache/wal/colors.json)"
    SEL="$(jq -r .colors.color14 ~/.cache/wal/colors.json)"
    SEL2="$(jq -r .colors.color12 ~/.cache/wal/colors.json)"
    URG="$(jq -r .colors.color9 ~/.cache/wal/colors.json)"
    ACT="$(jq -r .colors.color10 ~/.cache/wal/colors.json)"
    cat >"$ROFI_THEMES/palette-wal.rasi" <<EOF
* {
    background:     $BG;
    background-alt: $BG_ALT;
    foreground:     $FG;
    selected:       $SEL;
    selectedone:    $SEL2;
    urgent:         $URG;
    active:         $ACT;
}
EOF
    ln -sfn "$HOME/.cache/wal/colors-kitty.conf" "$KITTY_THEMES/current.conf"
    ln -sfn palette-wal.rasi "$ROFI_THEMES/current-palette.rasi"
    ln -sfn "$HOME/.cache/wal/colors-alacritty.toml" "$ALACRITTY_THEMES/current.toml"
  fi
else
  ln -sfn "$MODE.conf" "$KITTY_THEMES/current.conf"
  ln -sfn "palette-$MODE.rasi" "$ROFI_THEMES/current-palette.rasi"
  ln -sfn "themes/$(alacritty_preset_for "$MODE").toml" "$ALACRITTY_THEMES/current.toml"
fi

# ---- Qutebrowser homepage CSS vars ----
# Inline the palette into homepage.html between BEGIN-THEME-VARS /
# END-THEME-VARS markers. Editing the HTML itself defeats file:// CSS
# caching that file:// stylesheets have for the qutebrowser --temp
# window used by the homepage.
QB_HTML="$HOME/.config/qutebrowser/html/homepage.html"
gen_qb_css() {
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  [[ -f "$QB_HTML" ]] || return
  python3 - "$QB_HTML" "$bg" "$bg_alt" "$fg" "$red" "$green" "$yellow" "$blue" "$purple" "$cyan" <<'PYEOF'
import sys, re
path = sys.argv[1]
bg, bg_alt, fg, red, green, yellow, blue, purple, cyan = sys.argv[2:11]
with open(path) as f:
    src = f.read()


def mix(a, b, t=0.5):
    """Blend two hexes -- the 9-slot palette has no dim/border slot."""
    a, b = a.lstrip("#"), b.lstrip("#")
    return "#%02x%02x%02x" % tuple(
        round(int(a[i:i + 2], 16) * (1 - t) + int(b[i:i + 2], 16) * t)
        for i in (0, 2, 4)
    )


block = (
    "    <!-- BEGIN-THEME-VARS (rewritten by theme-apply) -->\n"
    "    <style id=\"theme-vars\">\n"
    "      :root {\n"
    f"        --bg: {bg};\n"
    f"        --bg-alt: {bg_alt};\n"
    f"        --fg: {fg};\n"
    f"        --red: {red};\n"
    f"        --green: {green};\n"
    f"        --yellow: {yellow};\n"
    f"        --blue: {blue};\n"
    f"        --purple: {purple};\n"
    f"        --cyan: {cyan};\n"
    # Blue, not green: qutebrowser's config.py tints its own chrome
    # (selected tab, hints, prompts) from the blue slot, and the
    # homepage sits directly under that tab bar -- emitting green here
    # meant the page and the chrome around it showed two unrelated
    # accents on every palette.
    f"        --accent: {blue};\n"
    f"        --urgent: {red};\n"
    # homepage.css also references --dim / --highlight / --border,
    # which had no slot here and so silently fell back to the
    # stylesheet's hardcoded Doom One values on every other theme.
    f"        --dim: {mix(fg, bg, 0.45)};\n"
    f"        --highlight: {mix(bg_alt, fg, 0.14)};\n"
    f"        --border: {mix(bg_alt, fg, 0.22)};\n"
    "      }\n"
    "    </style>\n"
    "    <!-- END-THEME-VARS -->"
)
new = re.sub(
    r"    <!-- BEGIN-THEME-VARS.*?<!-- END-THEME-VARS -->",
    block,
    src,
    count=1,
    flags=re.DOTALL,
)
with open(path, 'w') as f:
    f.write(new)
PYEOF
}

gen_eww_scss() {
  # eww uses scss compiled at window-open. Rewrite colors.scss so all
  # eww widgets (cheatsheet, onboarding, bar tooltips) track wallpaper.
  # Slot map: bg/bg-alt/fg + accent=dominant (color5 slot passed here
  # is the dominant hue since caller passes color10 = precompile dh).
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  local scss="$HOME/.config/eww/colors.scss"
  [[ -d "$(dirname "$scss")" ]] || return
  cat >"$scss" <<EOF
// Generated by theme-apply. Do not edit — regenerated per palette.
\$bg: $bg;
\$bg-alt: $bg_alt;
\$fg: $fg;
\$accent: $green;
\$black: $bg_alt;
\$lightblack: $bg_alt;
\$red: $red;
\$blue: $blue;
\$cyan: $cyan;
\$magenta: $purple;
\$green: $green;
\$yellow: $yellow;
\$archicon: $green;
EOF
}

gen_hypr_colors() {
  # Hyprland reads plain `$name = rgb(hex)` assignments and cannot parse
  # JSON or scss, so it gets its own generated file sourced from
  # looks.conf. Purely additive: guarded on ~/.config/hypr existing, so
  # on a machine that only runs qtile this is a no-op and nothing in the
  # existing pipeline changes.
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  local dir="$HOME/.config/hypr"
  [[ -d "$dir" ]] || return
  local out="$dir/colors.conf"

  # Hyprland wants bare hex without the leading '#', in rgb()/rgba().
  local h_bg="${bg#\#}" h_bg_alt="${bg_alt#\#}" h_fg="${fg#\#}"
  local h_red="${red#\#}" h_green="${green#\#}" h_yellow="${yellow#\#}"
  local h_blue="${blue#\#}" h_purple="${purple#\#}" h_cyan="${cyan#\#}"

  # The signature colour, same one GTK and the GroupBox get. NOT a fixed
  # palette slot -- see accent_of_mode. $7 is blue, its fallback.
  local h_accent; h_accent="$(accent_of_mode "$MODE" "$7")"; h_accent="${h_accent#\#}"

  # ---- IS THIS A LIGHT PALETTE? ----
  #
  # Two things downstream are wrong on a light theme and were STATIC, so
  # neither could ever be right on both sides:
  #
  #   hyprglass `default_theme`   pinned to `dark`, so a light palette ran
  #                               the dark preset's `adaptive_dim`, which
  #                               pulls BRIGHT areas down — the exact
  #                               opposite of what a light theme needs, and
  #                               a `:light` variant sat defined and unused.
  #
  #   kitty `background_opacity`  pinned to 0.55. On a dark palette that is
  #                               45% of a near-black page, which still
  #                               reads as a terminal. On mono-light it is
  #                               45% of a near-WHITE page over a
  #                               photograph, and the reported symptom was
  #                               exactly that: "the text not visible and
  #                               the light not looking good".
  #
  # Computed from relative luminance rather than from a list of theme
  # names, so a palette added later gets the right answer without being
  # added anywhere. The 0.5 threshold is deliberate and is NOT the island's
  # 0.18: that one asks "is this dark enough for light ink", a perceptual
  # question about text. This one asks "is this page brighter than mid",
  # which is the plain arithmetic question.
  local bg_lum
  bg_lum="$(python3 -c "
import sys
h='$h_bg'
r,g,b=(int(h[i:i+2],16)/255 for i in (0,2,4))
f=lambda c: c/12.92 if c<=0.03928 else ((c+0.055)/1.055)**2.4
print('%.4f' % (0.2126*f(r)+0.7152*f(g)+0.0722*f(b)))
" 2>/dev/null || echo 0)"
  # 0.55 -> 0.65: reported the text wasn't visible enough over glass,
  # fullscreen and windowed both (fullscreen was ALSO missing its blur
  # entirely at the time — see hyprglass.conf — but the dark-theme opacity
  # itself was asked to come up too, independent of that). Still short of
  # the light branch's 0.92 so the glass has something left to refract.
  local glass_theme=dark term_opacity=0.65
  if awk "BEGIN{exit !($bg_lum >= 0.5)}" 2>/dev/null; then
    glass_theme=light
    # 0.92, not 0.65. A light terminal needs to be nearly opaque or the
    # wallpaper competes with the text for the same pixels — and unlike a
    # dark theme there is no luminance gap left to win that competition
    # with. Still short of 1.0 so the glass has something to work on.
    term_opacity=0.92
  fi

  cat >"$out" <<EOF
# Generated by theme-apply. Do not edit — regenerated per palette.
\$bg      = rgb($h_bg)
\$bg_alt  = rgb($h_bg_alt)
\$fg      = rgb($h_fg)
\$red     = rgb($h_red)
\$green   = rgb($h_green)
\$yellow  = rgb($h_yellow)
\$blue    = rgb($h_blue)
\$purple  = rgb($h_purple)
\$cyan    = rgb($h_cyan)

# Roles consumed by looks.conf and hyprlock.conf.
#
# \$accent was previously the GREEN slot, on the reasoning that green is
# the dominant hue in wal mode. That was wrong for every named theme: it
# made the focused window border green in all 20+ of them, so switching
# theme appeared to do nothing to the borders. It is now accent_of_mode,
# the same hand-picked signature colour GTK and the qtile GroupBox use.
\$accent   = rgb($h_accent)
\$inactive = rgb($h_bg_alt)

# Window borders. WAS the CYAN slot, for qtile parity: qtile's
# layout_theme sets border_focus = colors[8]. That parity is now
# DELIBERATELY BROKEN, on request, and the reason is that the reference
# point moved.
#
# Under qtile the bar and the border were drawn by the same program out
# of the same palette module, so "match qtile" and "match the bar" were
# one instruction. Under Hyprland the thing at the top of the screen is
# the island, and it does not use the cyan slot for anything. Its
# layout glyph and its workspace digit — the two marks that flank the
# clock, and the only persistent coloured ink on the resting desktop —
# are both bound to \`IslandTheme.accent\`, which is the raw \`accent\`
# key of ~/.cache/tide-island/colors.json, which gen_island_colors
# writes from accent_of_mode. The same function that fills \$accent
# three lines above.
#
# So on gruvbox the island drew its glyph and digit in #fabd2f and the
# focused border came out #8ec07c, and there was no palette in which the
# two agreed. Pointing the border at \$accent makes it the same value by
# construction rather than by coincidence, on all 21 palettes plus wal —
# not "a colour that looks similar", the identical byte, because both
# now read accent_of_mode.
#
# \$accent is kept as a separate NAME rather than collapsing the two,
# because hyprlock.conf reads \$accent for its field colour and a future
# palette may well want the border and the lock field to diverge again.
# What is fixed here is the VALUE they resolve to today.
#
# qtile uses border_normal = colors[1] (the FG slot, a light grey). That
# is deliberately not mirrored here: at border_size 2 a bright border on
# every unfocused window reads as noise under Hyprland's gaps. Swap
# \$border_inactive to rgb($h_fg) if you want literal parity.
\$border_active   = rgb($h_accent)
\$border_inactive = rgb($h_bg_alt)

# hyprglass tint: 0xRRGGBBAA, alpha last. 0x40 == 25%, a gentle tint
# that lets the refraction read rather than colouring the whole slab.
\$glass_tint = 0x${h_bg}40

# Light or dark, decided from the background's luminance above. Read by
# hyprglass.conf's \`default_theme\` — which was pinned to \`dark\`, so a
# light palette ran the dark preset's adaptive_dim and washed out.
\$glass_theme = $glass_theme

# kitty's background_opacity, for the same reason: 0.55 of a near-black
# page is a terminal, 0.55 of a near-white one over a photograph is not.
# Read by \`\$term\` in binds.conf, and pushed to already-open terminals
# further down this script.
\$term_opacity = $term_opacity
EOF

  # Apply live, but only if Hyprland is the running compositor. Guarded
  # so running theme-apply from an X11/qtile session never shells out to
  # a socket that isn't there.
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
  fi
}

gen_island_colors() {
  # The Quickshell target REQUIREMENTS.md item 4 left open until the notch
  # bar existed. It exists, and the user has now overruled DESIGN-SPEC.md's
  # rule that the notch shape must stay hardcoded #000000: the island
  # background follows the theme.
  #
  # JSON rather than the `$name = rgb(hex)` form gen_hypr_colors emits,
  # because the consumer is QML and JSON.parse is one line there, whereas
  # Hyprland's own parser cannot read JSON at all. Two formats for two
  # parsers is not duplication -- the palette is still generated once, from
  # the same nine arguments, in the same function call.
  #
  # Written to ~/.cache rather than ~/.config: it is generated state, it is
  # regenerated on every theme change, and putting it under .config would
  # put a machine-local file inside a stow-managed tree.
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  local dir="$HOME/.cache/tide-island"
  local out="$dir/colors.json"
  local accent; accent="$(accent_of_mode "$MODE" "$7")"

  mkdir -p "$dir" 2>/dev/null || return

  # Written IN PLACE, not written-then-renamed, and that is the opposite of
  # the usual advice for a reason that was measured rather than assumed.
  #
  # The island watches this path with a Quickshell FileView, which is a
  # QFileSystemWatcher underneath, and QFileSystemWatcher watches the INODE.
  # An atomic `mv` replaces the inode, so the watch is left pointing at the
  # unlinked old file and onFileChanged never fires again -- the island keeps
  # whatever palette it loaded at startup, forever, while every other target
  # repaints. It looks exactly like "the island does not follow the theme",
  # which is the bug this whole function exists to fix.
  #
  # A truncate-and-write can in principle be read torn. In practice this is
  # one ~280 byte heredoc, written by one write(2), and the reader's
  # JSON.parse is wrapped so a failed parse keeps the colours it already has
  # -- and the close triggers a second change event anyway. That is a better
  # trade than a watcher that is guaranteed to stop working.
  cat >"$out" <<EOF
{
  "theme": "$MODE",
  "bg": "$bg",
  "bgAlt": "$bg_alt",
  "fg": "$fg",
  "red": "$red",
  "green": "$green",
  "yellow": "$yellow",
  "blue": "$blue",
  "purple": "$purple",
  "cyan": "$cyan",
  "accent": "$accent"
}
EOF
}

gen_btop_theme() {
  # btop has never been themed by this setup (pure defaults) -- generate
  # a proper .theme file from the current 9-slot palette and point
  # btop.conf at it. Applies on btop's next launch (no signal-based
  # live-reload API to force an already-running instance to pick it up).
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  local dir="$HOME/.config/btop/themes"
  local theme_file="$dir/wal-theme.theme"
  local conf="$HOME/.config/btop/btop.conf"
  mkdir -p "$dir"
  python3 - "$theme_file" "$bg" "$bg_alt" "$fg" "$red" "$green" "$yellow" "$blue" "$purple" "$cyan" <<'PYEOF' 2>/dev/null || true
import sys, colorsys
outp, bg, bg_alt, fg, red, green, yellow, blue, purple, cyan = sys.argv[1:11]

def hex_to_hls(hx):
    hx = hx.lstrip('#')
    r, g, b = int(hx[0:2], 16) / 255, int(hx[2:4], 16) / 255, int(hx[4:6], 16) / 255
    return colorsys.rgb_to_hls(r, g, b)

def hls_to_hex(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h, l, s)
    return '#{:02x}{:02x}{:02x}'.format(round(r * 255), round(g * 255), round(b * 255))

def gradient(hexcolor, lights=(0.75, 0.55, 0.40)):
    h, l, s = hex_to_hls(hexcolor)
    s = max(s, 0.55)
    return [hls_to_hex(h, lv, s) for lv in lights]

temp, cpug, freeg = gradient(red), gradient(purple), gradient(blue)
cacheg, availg, usedg = gradient(cyan), gradient(yellow), gradient(green)
downg, upg = gradient(blue), gradient(purple)
procg = gradient(green, (0.60, 0.45, 0.30))

lines = [
    f'theme[main_bg]="{bg}"', f'theme[main_fg]="{fg}"', f'theme[title]="{fg}"',
    f'theme[hi_fg]="{blue}"', f'theme[selected_bg]="{purple}"', f'theme[selected_fg]="{bg}"',
    f'theme[inactive_fg]="{bg_alt}"', f'theme[graph_text]="{fg}"', f'theme[meter_bg]="{bg_alt}"',
    f'theme[proc_misc]="{purple}"', f'theme[cpu_box]="{blue}"', f'theme[mem_box]="{green}"',
    f'theme[net_box]="{red}"', f'theme[proc_box]="{cyan}"', f'theme[div_line]="{bg_alt}"',
    f'theme[temp_start]="{temp[0]}"', f'theme[temp_mid]="{temp[1]}"', f'theme[temp_end]="{temp[2]}"',
    f'theme[cpu_start]="{cpug[0]}"', f'theme[cpu_mid]="{cpug[1]}"', f'theme[cpu_end]="{cpug[2]}"',
    f'theme[free_start]="{freeg[0]}"', f'theme[free_mid]="{freeg[1]}"', f'theme[free_end]="{freeg[2]}"',
    f'theme[cached_start]="{cacheg[0]}"', f'theme[cached_mid]="{cacheg[1]}"', f'theme[cached_end]="{cacheg[2]}"',
    f'theme[available_start]="{availg[0]}"', f'theme[available_mid]="{availg[1]}"', f'theme[available_end]="{availg[2]}"',
    f'theme[used_start]="{usedg[0]}"', f'theme[used_mid]="{usedg[1]}"', f'theme[used_end]="{usedg[2]}"',
    f'theme[download_start]="{downg[0]}"', f'theme[download_mid]="{downg[1]}"', f'theme[download_end]="{downg[2]}"',
    f'theme[upload_start]="{upg[0]}"', f'theme[upload_mid]="{upg[1]}"', f'theme[upload_end]="{upg[2]}"',
    f'theme[process_start]="{procg[0]}"', f'theme[process_mid]="{procg[1]}"', f'theme[process_end]="{procg[2]}"',
]
with open(outp, 'w') as f:
    f.write('\n'.join(lines) + '\n')
PYEOF
  if [[ -f "$conf" ]]; then
    if grep -q '^color_theme' "$conf"; then
      sed -i 's|^color_theme.*|color_theme = "wal-theme"|' "$conf"
    else
      printf '\ncolor_theme = "wal-theme"\n' >>"$conf"
    fi
  else
    printf 'color_theme = "wal-theme"\ntheme_background = true\n' >"$conf"
  fi
}

gen_qt_colors() {
  # Qt apps (telegram-desktop, any qt5/qt6 GUI) do NOT follow the GTK
  # theme. With no QT_QPA_PLATFORMTHEME set they fall back to Qt's
  # built-in palette, which is LIGHT -- that is why telegram and friends
  # rendered white on an otherwise dark desktop.
  #
  # .xinitrc exports QT_QPA_PLATFORMTHEME=qt6ct, and qt6ct/qt5ct read a
  # palette file. Generate that palette from the active theme so Qt apps
  # track every mode like every other consumer.
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  local sel_fg="$bg"
  for dir in "$HOME/.config/qt6ct" "$HOME/.config/qt5ct"; do
    mkdir -p "$dir/colors"
    # QPalette role order, 21 entries -- qt6ct is positional, so the
    # count and order matter. Wrong length = silently ignored palette.
    #  WindowText Button Light Midlight Dark Mid Text BrightText
    #  ButtonText Base Window Shadow Highlight HighlightedText Link
    #  LinkVisited AlternateBase NoRole ToolTipBase ToolTipText
    #  PlaceholderText
    local roles="$fg, $bg_alt, $bg_alt, $bg_alt, $bg, $bg, $fg, $red, $fg, $bg, $bg, #000000, $blue, $sel_fg, $cyan, $purple, $bg_alt, $bg, $bg_alt, $fg, $fg"
    cat >"$dir/colors/current.conf" <<EOF
[ColorScheme]
active_colors=$roles
inactive_colors=$roles
disabled_colors=$roles
EOF
    local conf="$dir/${dir##*/}.conf"
    cat >"$conf" <<EOF
[Appearance]
color_scheme_path=$dir/colors/current.conf
custom_palette=true
standard_dialogs=default
style=Fusion
icon_theme=$([[ "$MODE" == mono-light ]] && echo Papirus-Light || echo Papirus-Dark)
EOF
  done
}

accent_of_mode() {
  # The one colour that means "this desktop" -- the GTK accent_color, the
  # qtile GroupBox highlight, the focused border. It is NOT a fixed slot of
  # the 9-slot palette: it is blue for most themes, but cyan for nord and
  # the neon set, purple for rose-pine and catppuccin, yellow for gruvbox.
  # Hand-picked per theme, because the slot that reads as "the signature
  # colour" differs by theme.
  #
  # These values are the 4th argument of the gen_gtk_css call for the same
  # mode further down. Keep the two in step.
  case "$1" in
    doomone)        echo "#51afef" ;;
    dracula)        echo "#bd93f9" ;;
    nord)           echo "#88c0d0" ;;
    gruvbox)        echo "#fabd2f" ;;
    tokyonight)     echo "#7aa2f7" ;;
    catppuccin)     echo "#cba6f7" ;;
    monokai)        echo "#66d9ef" ;;
    everforest)     echo "#7fbbb3" ;;
    rose-pine)      echo "#c4a7e7" ;;
    kanagawa)       echo "#7e9cd8" ;;
    oxocarbon)      echo "#33b1ff" ;;
    cyberpunk-neon) echo "#00fff9" ;;
    synthwave)      echo "#36f9f6" ;;
    matrix)         echo "#00ff9f" ;;
    mono-dark)      echo "#b0b0b0" ;;
    mono-light)     echo "#1a5fd0" ;;
    nightowl)       echo "#82aaff" ;;
    onedark)        echo "#61afef" ;;
    palenight)      echo "#82b1ff" ;;
    github-dark)    echo "#58a6ff" ;;
    ayu-mirage)     echo "#5ccfe6" ;;
    # wal has no fixed accent -- colour12 is the bright variant of the
    # wallpaper's dominant hue, which is what GTK is handed too. jq can
    # return the literal "null" for a key that is absent rather than
    # failing, so check the shape, not just the exit status.
    wal)
      local c12
      c12="$(jq -r '.colors.color12 // empty' ~/.cache/wal/colors.json 2>/dev/null || true)"
      if [[ "$c12" =~ ^#[0-9a-fA-F]{6}$ ]]; then echo "$c12"; else echo "$2"; fi
      ;;
    *)              echo "$2" ;;
  esac
}

dump_palette_json() {
  # Dump current 9-slot palette to ~/.cache/qtile/current_palette.json so
  # nvim (+ any other consumer) can render themes for modes that don't
  # have a dedicated plugin (matrix, mono-*, synthwave, cyberpunk-neon,
  # palenight, github-dark, ayu-mirage, onedark, nightowl, ...).
  #
  # `accent` is dumped alongside the 9 slots because it cannot be derived
  # from them -- see accent_of_mode. nvim paints the dashboard banner with
  # it so the ATIVIM logo is the same colour as the GroupBox in the bar.
  local out="$HOME/.cache/qtile/current_palette.json"
  local accent; accent="$(accent_of_mode "$MODE" "$7")"
  mkdir -p "$(dirname "$out")"
  cat >"$out" <<EOF
{
  "mode": "$MODE",
  "bg": "$1",
  "bg_alt": "$2",
  "fg": "$3",
  "red": "$4",
  "green": "$5",
  "yellow": "$6",
  "blue": "$7",
  "purple": "$8",
  "cyan": "$9",
  "accent": "$accent"
}
EOF
}

gen_glow_style() {
  # glow renders every markdown page rofi_docs opens -- README,
  # TROUBLESHOOTING, the System panels -- and it was the last thing on this
  # desktop still painting itself in its OWN colors. Switching the theme
  # retinted the terminal around it and left the document inside reading
  # dracula pink and blue, which is exactly the drift the rest of this
  # script exists to prevent. nvim already follows theme_mode; now glow
  # does too.
  #
  # This is a glamour style file (glow -s <path>). Only the fields that
  # carry color are set from the palette; spacing and the marker glyphs are
  # deliberately fixed, since those are layout, not theme.
  local bg="$1" bg_alt="$2" fg="$3" red="$4" green="$5" yellow="$6" blue="$7" purple="$8" cyan="$9"
  local out="$HOME/.cache/qtile/glow.json"
  mkdir -p "$(dirname "$out")"

  # De-emphasised text (rules, code comments, image captions) needs a colour
  # that is dimmer than fg but still READABLE. bg_alt is the obvious-looking
  # choice and is wrong in both directions: on the dark themes it is darker
  # than bg, and on mono-light it is #e0e0e0 against a #ffffff page -- either
  # way it is a near-invisible smear rather than muted text. Blend fg toward
  # bg instead, which lands mid-contrast whichever side of the spectrum the
  # theme sits on.
  #
  # 0.72, not an even mix: measured across the darkest and lightest palettes
  # here, half-and-half bottoms out at 1.9:1 against the page (nord,
  # mono-light), under the 3:1 floor for non-body text. 0.72 holds ~2.9:1 at
  # worst while still sitting ~1.3:1 away from fg, so it reads as dimmed
  # rather than as a second shade of body text.
  local muted
  muted="$(python3 - "$fg" "$bg" <<'PYEOF' 2>/dev/null || echo "$fg"
import sys
def rgb(h):
    h = h.lstrip('#')
    return [int(h[i:i+2], 16) for i in (0, 2, 4)]
f, b = rgb(sys.argv[1]), rgb(sys.argv[2])
print('#{:02x}{:02x}{:02x}'.format(*[round(c * 0.72 + d * 0.28) for c, d in zip(f, b)]))
PYEOF
)"
  cat >"$out" <<EOF
{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "${fg}", "margin": 1 },
  "block_quote": { "color": "${cyan}", "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "${blue}", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "${bg}", "background_color": "${blue}", "bold": true },
  "h2": { "prefix": "▌ ", "color": "${yellow}", "bold": true },
  "h3": { "prefix": "  ", "color": "${green}", "bold": true },
  "h4": { "prefix": "   ", "color": "${cyan}" },
  "h5": { "prefix": "    ", "color": "${purple}" },
  "h6": { "prefix": "     ", "color": "${purple}", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "${yellow}", "italic": true },
  "strong": { "color": "${fg}", "bold": true },
  "hr": { "color": "${muted}", "format": "\n──────────────────────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "${cyan}", "underline": true },
  "link_text": { "color": "${purple}", "bold": true },
  "image": { "color": "${cyan}", "underline": true },
  "image_text": { "color": "${muted}", "format": "Image: {{.text}} →" },
  "code": { "color": "${red}", "background_color": "${bg_alt}" },
  "code_block": {
    "color": "${fg}",
    "margin": 1,
    "chroma": {
      "text": { "color": "${fg}" },
      "error": { "color": "${red}" },
      "comment": { "color": "${muted}", "italic": true },
      "comment_preproc": { "color": "${purple}" },
      "keyword": { "color": "${purple}" },
      "keyword_reserved": { "color": "${purple}" },
      "keyword_namespace": { "color": "${red}" },
      "keyword_type": { "color": "${yellow}" },
      "operator": { "color": "${cyan}" },
      "punctuation": { "color": "${fg}" },
      "name": { "color": "${fg}" },
      "name_builtin": { "color": "${yellow}" },
      "name_tag": { "color": "${red}" },
      "name_attribute": { "color": "${green}" },
      "name_class": { "color": "${yellow}", "bold": true },
      "name_constant": { "color": "${purple}" },
      "name_decorator": { "color": "${green}" },
      "name_function": { "color": "${blue}" },
      "literal_number": { "color": "${purple}" },
      "literal_string": { "color": "${green}" },
      "literal_string_escape": { "color": "${cyan}" },
      "generic_deleted": { "color": "${red}" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "${green}" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "${blue}" },
      "background": { "background_color": "${bg_alt}" }
