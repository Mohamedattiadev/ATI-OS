#!/usr/bin/env bash
# ati-install-gaming-xbox-controllers — install xpadneo (the actively
# maintained Xbox-controller driver) and blacklist the kernel's stock xpad
# so they don't fight over the same device. Ported from Omarchy's
# bin/omarchy-install-gaming-xbox-controllers (MIT, see NOTICE.md).
#
# Adapted: this repo's Bluetooth pairing lives in AtiScriptsV1 (no
# Super+Ctrl+B binding here the way Omarchy's message referenced), so the
# post-install note just says "pair it from the Bluetooth panel" instead of
# naming a keybind this repo doesn't have.
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/../lib/ati-rofi-common.sh"

require_cmd gum || exit 1

echo "Installing Xbox controller Bluetooth support..."
dcli install linux-headers
dcli install xpadneo-dkms

echo blacklist xpad | sudo tee /etc/modprobe.d/blacklist-xpad.conf >/dev/null
echo hid_xpadneo | sudo tee /etc/modules-load.d/xpadneo.conf >/dev/null

needs_reboot=false
if ! id -nG "$USER" | grep -qw input; then
  sudo usermod -aG input "$USER"
  needs_reboot=true
fi

if lsmod | grep -q '^xpad '; then
  sudo modprobe -r xpad 2>/dev/null || needs_reboot=true
fi

if $needs_reboot; then
  if gum confirm "Reboot needed to finish setup. Reboot now?"; then
    sudo reboot now
  fi
  exit 0
fi

sudo modprobe hid_xpadneo

echo
echo "Pair your Xbox controller from the Bluetooth panel (menu → Trigger → Bluetooth panel)."
