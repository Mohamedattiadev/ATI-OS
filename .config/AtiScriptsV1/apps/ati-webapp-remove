#!/usr/bin/env bash
# ati-webapp-remove [name] — remove a web app's .desktop launcher and icon.
# Ported from Omarchy's bin/omarchy-webapp-remove (MIT, see NOTICE.md).
# With no name given, lists every installed web app (any .desktop whose
# Exec calls ati-launch-webapp) through the same picker convention
# ati-default-app already uses: ati-menu-select under Hyprland, rofi under
# qtile/X11.
set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/../lib/ati-rofi-common.sh"

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"

APP_NAME="${*:-}"

if [[ -z "$APP_NAME" ]]; then
  web_apps=()
  while IFS= read -r -d '' file; do
    grep -q '^Exec=.*ati-launch-webapp' "$file" && web_apps+=("$(basename "${file%.desktop}")")
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null)

  if (( ${#web_apps[@]} == 0 )); then
    echo "No web apps to remove."
    exit 1
  fi
  mapfile -t web_apps < <(printf '%s\n' "${web_apps[@]}" | sort)

  # ati-menu-select only under native — see ati-default-app's own comment
  # on this exact condition for why.
  if use_ati_menu_select; then
    APP_NAME="$(printf '%s\n' "${web_apps[@]}" | ati-menu-select --mode select --prompt "Remove web app")"
  else
    APP_NAME="$(printf '%s\n' "${web_apps[@]}" | rofi -dmenu -i \
      -theme "$HOME/.config/rofi/themes/base.rasi" \
      -theme-str 'listview { lines: 8; dynamic: false; }' -p "Remove web app")"
  fi
fi

[[ -z "$APP_NAME" ]] && exit 0

icon_name="$(printf '%s\n' "$APP_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')"
rm -f "$DESKTOP_DIR/$APP_NAME.desktop"
rm -f "$ICON_DIR/$icon_name.png" "$ICON_DIR/$APP_NAME.png"

update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
notify_safe "Web app removed" "$APP_NAME"
