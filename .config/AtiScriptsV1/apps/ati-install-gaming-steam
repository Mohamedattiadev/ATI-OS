#!/usr/bin/env bash
# ati-install-gaming-steam — install Steam, enabling [multilib] first if it
# isn't already (this repo's pacman.conf ships it commented out, unlike
# Omarchy's base install where it's already on -- see
# bin/omarchy-install-gaming-steam, MIT, NOTICE.md, which assumes it and
# skips this step entirely). Also installs the lib32 Vulkan driver matching
# whatever GPU vendor lspci reports, same detection Omarchy's own
# omarchy-install-gaming-gpu-lib32 does, simplified to Intel/AMD (no NVIDIA
# GSP/non-GSP branch -- this machine has neither, and dcli install below
# still gets the base package running without it).
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/../lib/ati-rofi-common.sh"

PACMAN_CONF=/etc/pacman.conf

if ! grep -q '^\[multilib\]' "$PACMAN_CONF"; then
  echo "Enabling [multilib]..."
  sudo sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' "$PACMAN_CONF"
  sudo pacman -Sy
fi

PACKAGES=(steam)
if lspci | grep -iE '(VGA|Display).*Intel' >/dev/null; then
  PACKAGES+=(lib32-vulkan-intel)
fi
if lspci | grep -iE '(VGA|Display).*AMD' >/dev/null; then
  PACKAGES+=(lib32-vulkan-radeon)
fi

echo "Installing: ${PACKAGES[*]}"
for pkg in "${PACKAGES[@]}"; do
  dcli install "$pkg"
done

echo
echo "Steam will start now. This might take a while the first time..."
setsid gtk-launch steam >/dev/null 2>&1 &
