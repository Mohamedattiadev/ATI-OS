#!/usr/bin/env bash
#
# Script name: rofi_ilovepdf
# Description: An offline PDF toolkit in rofi. Everything ilovepdf.com is
#              normally used for, done locally -- no upload, no account, no
#              page limit, no watermark on the way out.
# Usage:       rofi_ilovepdf [file...]   -- files given here skip the browser
# Dependencies: rofi, qpdf, poppler-utils, ghostscript, imagemagick,
#               libreoffice. Optional: tesseract (enables OCR).
# License: MIT
#
# --- Esc is "back", everywhere, once ---------------------------------
#
#   tool list  --Esc-->  quit          (the only exit)
#   folders    --Esc-->  tool list
#   browser    --Esc-->  up a folder, or out to the folder list
#   options    --Esc-->  the browser, in the folder you were just in
#   done       --Esc-->  tool list
#
# Nothing in the middle of a job closes the window. Every step returns a
# code its caller reads -- 0 chose / 1 go back / 2 cancelled -- and no
# return value is ever left to `set -e` to interpret, which is what turned
# "go back" into "exit" throughout the previous version.

set -euo pipefail

# BASH_SOURCE, not $0: $0 is the *invoking* script when this file is
# sourced, so the helper next to it could not be found from anywhere but a
# direct run -- which also made the conversion logic untestable.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=rofi_common.sh
source "$SCRIPT_DIR/rofi_common.sh"

# pdfinfo was a declared dependency that was never checked, so "Split PDF"
# reached its page-count call and failed there instead of saying what was
# missing. qpdf is what the page-level operations are built on. pdfimages
# was in the same position: "Extract images" is the only caller, and a
# poppler install without it reported "no embedded images" for every file.
require_cmd rofi libreoffice gs pdfinfo qpdf pdftoppm pdftotext pdfimages || exit 1

# ImageMagick 7 renamed the entry point; `convert` is a deprecated shim that
# prints a warning to stderr on every call and is not guaranteed to exist.
IM=magick
command -v magick >/dev/null 2>&1 || IM=convert
require_cmd "$IM" || exit 1

BASE_DIR="$HOME/ILovePdf_Style_Docs"
SEPARATOR="›"

# LibreOffice refuses to run headless while a GUI instance holds the default
# profile: it exits 0 having converted nothing, which -- before this script
# checked its output -- was reported to the user as success. A private
# profile directory makes the headless run independent of the desktop.
LO_PROFILE="${XDG_RUNTIME_DIR:-/tmp}/ilovepdf-lo-profile"

# --- rofi geometry ----------------------------------------------------
#
# NO -theme flag anywhere in this file, deliberately.
#
# rofi with no -theme picks up ~/.config/rofi/config.rasi, which points at
# themes/current.rasi -- 45% width, 8 lines, and re-pointed by every theme
# switch. That is what rofi_light, the drun launcher and dm-satty all get,
# so leaving it alone is what makes this window the same size and colour as
# every other rofi on the desktop. An earlier version passed
# `-theme base.rasi`, which skips current.rasi's width/lines override and
# drew a visibly narrower, shorter window than the rest of the system.
#
# Every rofi call also captures its exit status with `|| rc=$?`. Under
# `set -e` a bare `x=$(... rofi ...)` terminates the whole script when rofi
# exits non-zero -- and rofi exits 1 on Esc. That is what made the Esc
# handling, the navigation stack, and "Esc goes up one directory"
# unreachable code in the previous version: Esc quit the program instead of
# going back. rofi also distinguishes 1 (Esc) from >1 (failed to start),
# and those must not be treated alike.

# menu <prompt> <mesg> [extra rofi args...]  -- list arrives on stdin.
# Returns 0 with the choice on stdout, 1 for Esc, 2 for a rofi failure.
#
# The mesg is passed through an ARRAY, not `${mesg:+-mesg "$mesg"}`. That
# form leaves the expansion unquoted -- it has to be, or the whole thing
# collapses to one empty argument when mesg is empty -- so every hint got
# split on its spaces and rofi received "↵ choose" as two arguments, one of
# them a stray positional. rofi_hint's output is nothing but spaces and
# markup, so this affected every prompt in the file.
menu() {
	local prompt="$1" mesg="${2:-}"
	shift 2 || true
	local -a m=(); [[ -n "$mesg" ]] && m=(-mesg "$mesg")
	local out rc=0
	out="$(rofi -dmenu -i -p "$prompt" "${m[@]}" "$@")" || rc=$?
	(( rc > 1 )) && return 2
	(( rc == 1 )) && return 1
	printf '%s' "$out"
	return 0
}

# Text and password prompts, local rather than rofi_common's rofi_input /
# rofi_input_secret. Those two pin `-theme base.rasi`, which skips
# current.rasi's width override -- so every prompt came up a different width
# from the menu that led to it, inside a single run. These inherit the same
# default as menu() above and only zero the list, which is what an input box
# wants. `-l 0` as well as the theme string, because a rofi built against an
# older theme grammar ignores one or the other.
ask_text() {
	local prompt="$1" mesg="${2:-}" out rc=0
	local -a m=(); [[ -n "$mesg" ]] && m=(-mesg "$mesg")
	out="$(printf '' | rofi -dmenu -i -p "$prompt" "${m[@]}" \
		-l 0 -theme-str 'listview { lines: 0; }')" || rc=$?
	(( rc != 0 )) && return 1
	printf '%s' "$out"
}
ask_secret() {
	local prompt="$1" mesg="${2:-}" out rc=0
	local -a m=(); [[ -n "$mesg" ]] && m=(-mesg "$mesg")
	# rofi's -password hides the characters; it does NOT keep the value out
	# of this process's argv, so the answer is read from stdout and never
	# passed to anything as a command-line argument by this function.
	out="$(printf '' | rofi -dmenu -i -password -p "$prompt" "${m[@]}" \
		-l 0 -theme-str 'listview { lines: 0; }')" || rc=$?
	(( rc != 0 )) && return 1
	printf '%s' "$out"
}

# --- The toolkit ------------------------------------------------------
#
# One flat, searchable list rather than nested categories. rofi filters as
# you type, so "rot" reaches Rotate in three keystrokes; a category tree
# would cost two extra selections to save scrolling that fuzzy search
# already removes. The icons are for scanning, not decoration -- they group
# the list visually while it stays flat.
#
# The table is the single source of truth for each action's accepted
# extensions and whether it takes several files. Keeping those in separate
# parallel case statements is how they drift apart.
declare -A ACTION_EXT=(
	["󰈬  Word → PDF"]="doc docx odt rtf txt"
	["󰈛  Excel → PDF"]="xls xlsx ods csv"
	["󰈧  PowerPoint → PDF"]="ppt pptx odp"
	["󰋩  Images → PDF"]="jpg jpeg png bmp tif tiff webp"
	["󰈭  PDF → Word"]="pdf"
	["󰈟  PDF → JPG"]="pdf"
	["󰈟  PDF → PNG"]="pdf"
	["󰈙  PDF → Text"]="pdf"
	["󰆽  Extract images"]="pdf"
	["󰐗  Merge PDFs"]="pdf"
	["󰆔  Split into pages"]="pdf"
	["󰆐  Extract page range"]="pdf"
	["󰗨  Delete pages"]="pdf"
	["󰑧  Rotate"]="pdf"
	["󰑥  Reverse page order"]="pdf"
	["󰗇  Compress"]="pdf"
	["󰌾  Protect with password"]="pdf"
	["󰿆  Remove password"]="pdf"
	["󰑐  Watermark"]="pdf"
	["󰆃  Add page numbers"]="pdf"
	["󰁨  Repair"]="pdf"
	["󰩫  OCR — make text selectable"]="pdf"
	["󰩭  Resize image"]="jpg jpeg png gif bmp webp tif tiff"
)
# Order is deliberate and an associative array has none: into PDF, out of
# PDF, page surgery, then the things done to a finished document.
ACTION_ORDER=(
	"󰈬  Word → PDF" "󰈛  Excel → PDF" "󰈧  PowerPoint → PDF" "󰋩  Images → PDF"
	"󰈭  PDF → Word" "󰈟  PDF → JPG" "󰈟  PDF → PNG" "󰈙  PDF → Text" "󰆽  Extract images"
	"󰐗  Merge PDFs" "󰆔  Split into pages" "󰆐  Extract page range" "󰗨  Delete pages"
	"󰑧  Rotate" "󰑥  Reverse page order"
	"󰗇  Compress" "󰌾  Protect with password" "󰿆  Remove password"
	"󰑐  Watermark" "󰆃  Add page numbers" "󰁨  Repair"
	"󰩫  OCR — make text selectable"
	"󰩭  Resize image"
)
# Actions that take more than one file. rofi's -multi-select returns the
# lines in list order, not click order, so the selection always arrives
# alphabetical -- right for "scan1, scan2, scan3" and wrong for anything
# else, which is why order_files() gets a say before the work starts.
MULTI_ACTIONS=("󰐗  Merge PDFs" "󰋩  Images → PDF")

# OCR is the one action with a dependency that is not otherwise needed.
# Rather than shipping a menu entry that fails, it is dropped from the list
# when tesseract is absent -- everything the menu offers, works.
HAVE_OCR=0
command -v tesseract >/dev/null 2>&1 && HAVE_OCR=1

# --- Browsable roots --------------------------------------------------
#
# This used to hardcode Documents/Downloads/Pictures/Desktop. Two of those
# do not exist on this machine, so the browser offered dead entries that
# opened an empty listing. Ask xdg-user-dir where it can, fall back to the
# conventional name, and only offer what is actually on disk.
declare -A MAIN_DIR_MAP
add_dir() {
	local label="$1" dir="$2"
	[[ -d "$dir" ]] && MAIN_DIR_MAP["$label"]="$dir"
	return 0
}
xdg_or() {
	local key="$1" fallback="$2" got=""
	command -v xdg-user-dir >/dev/null 2>&1 && got="$(xdg-user-dir "$key" 2>/dev/null)"
	[[ -n "$got" && "$got" != "$HOME" ]] && { printf '%s' "$got"; return; }
	printf '%s' "$fallback"
}

# Created up front, not lazily. It used to be added to the menu only if it
# already existed, so on a first run the one folder this script writes to
# was the one folder you could not browse to.
mkdir -p "$BASE_DIR"

add_dir "Documents"   "$(xdg_or DOCUMENTS "$HOME/Documents")"
add_dir "Downloads"   "$(xdg_or DOWNLOAD  "$HOME/Downloads")"
add_dir "Pictures"    "$(xdg_or PICTURES  "$HOME/Pictures")"
add_dir "Desktop"     "$(xdg_or DESKTOP   "$HOME/Desktop")"
add_dir "Screenshots" "$HOME/Screenshots"
add_dir "Videos"      "$(xdg_or VIDEOS    "$HOME/Videos")"
add_dir "Converted"   "$BASE_DIR"

if (( ${#MAIN_DIR_MAP[@]} == 0 )); then
	notify_safe "iLovePDF" "No browsable folders found in $HOME"
	exit 1
fi

# --- Small helpers ----------------------------------------------------

# Never silently overwrite. Running the same conversion twice used to
# replace the first result with no warning; now the second lands beside it.
unique_path() {
	local path="$1" dir base ext n=2
	dir="$(dirname "$path")"; base="$(basename "$path")"
	if [[ "$base" == *.* ]]; then ext=".${base##*.}"; base="${base%.*}"; else ext=""; fi
	while [[ -e "$path" ]]; do
		path="$dir/${base}-${n}${ext}"
		(( n++ ))
	done
	printf '%s' "$path"
}

# Same idea for the actions that emit a NUMBERED SERIES -- "<stem>_001.jpg",
# "<stem>_page_1.pdf". unique_path() cannot express that: it tests one
# concrete filename, so it either never collides (and the series overwrites
# silently) or appends its suffix mid-pattern, giving "doc_000-2.jpg_000.jpg".
unique_stem() {
	local dir="$1" base="$2" glob="$3" n=2
	# Separate `local`: a variable assigned earlier in the SAME local
	# statement is not yet visible to a later one on that line.
	local stem="$dir/$base"
	while compgen -G "${stem}${glob}" >/dev/null 2>&1; do
		stem="$dir/${base}-${n}"
		(( n++ ))
	done
	printf '%s' "$stem"
}

human_size() {
	local b="${1:-0}"
	if   (( b > 1048576 )); then awk -v b="$b" 'BEGIN{printf "%.1f MB", b/1048576}'
	elif (( b > 1024 ));    then awk -v b="$b" 'BEGIN{printf "%.0f KB", b/1024}'
	else printf '%d B' "$b"; fi
}
file_size() { stat -c '%s' "$1" 2>/dev/null || echo 0; }

pdf_pages() { pdfinfo "$1" 2>/dev/null | awk '/^Pages:/{print $2}'; }
pdf_width()  { pdfinfo "$1" 2>/dev/null | awk '/^Page size:/{printf "%d", $3}'; }
pdf_height() { pdfinfo "$1" 2>/dev/null | awk '/^Page size:/{printf "%d", $5}'; }

# An encrypted PDF makes every later step fail in a way that looks like
# corruption. Detect it up front and say so.
pdf_is_encrypted() {
	pdfinfo "$1" 2>&1 | grep -qi "Encrypted:.*yes" && return 0
	qpdf --is-encrypted "$1" 2>/dev/null && return 0
	return 1
}

# LibreOffice writes <input-basename>.<target-ext> into --outdir and gives
# no way to name the output. Convert into a scratch directory, then move
# the single file it produced to where we actually want it.
lo_convert() {
	local infile="$1" target="$2" outfile="$3" infilter="${4:-}"
	local tmp; tmp="$(mktemp -d)"
	local -a args=(-env:UserInstallation="file://$LO_PROFILE" --headless --norestore)
	[[ -n "$infilter" ]] && args+=(--infilter="$infilter")
	args+=(--convert-to "$target" "$infile" --outdir "$tmp")

	libreoffice "${args[@]}" >/dev/null 2>&1 || true

	local produced
	produced="$(find "$tmp" -maxdepth 1 -type f -print -quit 2>/dev/null || true)"
	if [[ -z "$produced" ]]; then rm -rf "$tmp"; return 1; fi
	mv -- "$produced" "$outfile"
	rm -rf "$tmp"
	return 0
}

# --- Prompts ----------------------------------------------------------
#
# All of these use rofi. An earlier version shelled out to zenity for the
# resize dialog -- a GTK window with its own theme dropped into the middle
# of a run of palette-themed rofi menus. rofi_common already has an input
# prompt that follows the active palette, so zenity is not a dependency.

ask_size() {
	local a
	a="$(ask_text "New size" "50%  ·  800x600  ·  1920x (keeps ratio)")" || return 1
	[[ -n "$a" ]] || return 1
	if [[ ! "$a" =~ ^[0-9]+%$ && ! "$a" =~ ^[0-9]*x?[0-9]*[\!\>\<\^]?$ ]]; then
		notify_safe "iLovePDF" "Not a valid size: $a"; return 1
	fi
	printf '%s' "$a"
}

# qpdf page ranges: "1-3,5,8-z" (z = last), "rN" counts back from the end.
# Validated here rather than passed through, because qpdf's own error for a
# bad range goes to stderr where nobody launched from a menu will see it.
#
# The old check was a single character-class regex, so it accepted "9-12" on
# a 5-page file (qpdf then failed, and the user was told the whole operation
# "could not process" the document) and it accepted stray junk like "1--2"
# or "3-r" that merely happened to use legal characters. Each part is now
# parsed and bounds-checked against the real page count.
expand_range() {
	local spec="$1" total="$2"
	local -a out=()
	local part a b p
	for part in ${spec//,/ }; do
		[[ -n "$part" ]] || continue
		part="${part//z/$total}"
		# rN -> the Nth page from the end. r1 is the last page.
		while [[ "$part" =~ r([0-9]+) ]]; do
			p=$(( total + 1 - BASH_REMATCH[1] ))
			(( p < 1 )) && return 1
			part="${part/r${BASH_REMATCH[1]}/$p}"
		done
		if [[ "$part" =~ ^([0-9]+)-([0-9]+)$ ]]; then
			a="${BASH_REMATCH[1]}"; b="${BASH_REMATCH[2]}"
		elif [[ "$part" =~ ^[0-9]+$ ]]; then
			a="$part"; b="$part"
		else
			return 1
		fi
		(( a >= 1 && b >= 1 && a <= total && b <= total )) || return 1
		if (( a <= b )); then
			for (( p = a; p <= b; p++ )); do out+=("$p"); done
		else
			for (( p = a; p >= b; p-- )); do out+=("$p"); done
		fi
	done
	(( ${#out[@]} )) || return 1
	local IFS=,
	printf '%s' "${out[*]}"
}

ask_pages() {
	local total="$1" prompt="$2" a expanded
	[[ "$total" =~ ^[0-9]+$ ]] || { notify_safe "iLovePDF" "Could not read a page count"; return 1; }

	# This was a bare text box, and it is the only prompt in the whole
	# script that demands syntax rather than a choice -- the one place
	# someone who does not already know qpdf page ranges gets stuck. The
	# common answers are now on a list, spelled out in words with the pages
	# they resolve to, and typing a range by hand is one entry down.
	#
	# A list rather than a text box with the presets mixed in: rofi's Enter
	# takes the highlighted ENTRY when the typed text matches one, so a
	# combined prompt would answer "1" with whatever preset happened to
	# contain a 1. Choosing "type one" first removes that guess entirely.
	local pl="pages"; (( total == 1 )) && pl="page"
	local custom="✎  Type a range myself…"
	if (( total >= 2 )); then
		local half=$(( total / 2 ))
		local -a labels=() vals=()
		labels+=("󰎥  First page only")                 vals+=("1")
		labels+=("󰎨  Last page only  (page $total)")   vals+=("z")
		labels+=("󰆐  Everything except the first")     vals+=("2-z")
		labels+=("󰆐  Everything except the last")      vals+=("1-r2")
		if (( total >= 4 )); then
			labels+=("󰡎  First half  (1–$half)")        vals+=("1-$half")
			labels+=("󰡎  Second half  ($((half+1))–$total)") vals+=("$((half+1))-$total")
		fi
		labels+=("$custom")

		local pick rc=0 i
		pick="$(printf '%s\n' "${labels[@]}" | menu "$prompt" \
			"$total $pl  ·  $(rofi_hint "Esc back")")" || rc=$?
		(( rc != 0 )) && return 1
		[[ -n "$pick" ]] || return 1
		if [[ "$pick" != "$custom" ]]; then
			for i in "${!labels[@]}"; do
				if [[ "${labels[i]}" == "$pick" ]]; then
					expand_range "${vals[i]}" "$total" && return 0
					return 1
				fi
			done
			return 1
		fi
	fi

	while true; do
		a="$(ask_text "$prompt" "$total $pl · e.g. 2-5  ·  1,3,7  ·  2-z (to the end)")" || return 1
		[[ -n "$a" ]] || return 1
		a="${a// /}"
		# Re-ask rather than abandon the job: a typo in a page range is the
		# single most likely mistake here, and losing the file selection
		# over it means starting the whole thing again.
		if expanded="$(expand_range "$a" "$total")"; then
			printf '%s' "$expanded"
			return 0
		fi
		notify_safe "iLovePDF" "Not a valid range for $total pages: $a"
	done
}

ask_password() {
	local p
	p="$(ask_secret "$1" "${2:-}")" || return 1
	[[ -n "$p" ]] || return 1
	printf '%s' "$p"
}

# --- Selection --------------------------------------------------------

SELECTED_FILES=()

# The folder browsed last run, offered at the top of the roots menu and
# pre-selected, so the common case -- same folder as last time -- is Enter,
# Enter. Stored rather than guessed: there is no way to infer it.
LAST_DIR_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/rofi_ilovepdf_lastdir"
remember_dir() { mkdir -p "$(dirname "$LAST_DIR_FILE")" 2>/dev/null; printf '%s' "$1" >"$LAST_DIR_FILE" 2>/dev/null || true; }
recall_dir()   { [[ -r "$LAST_DIR_FILE" ]] && head -1 "$LAST_DIR_FILE"; return 0; }

# Ask for a starting folder. Prints the directory; returns 1 for Esc, which
# the caller reads as "go back to the tool list".
pick_root() {
	local label="$1"
	local -a roots=()
	mapfile -t roots < <(printf '%s\n' "${!MAIN_DIR_MAP[@]}" | sort)

	local last recent="" ; last="$(recall_dir)"
	local -a entries=()
	if [[ -n "$last" && -d "$last" ]]; then
		# Folder name first, location after it. The whole path was the
		# entry text, and rofi truncates on the right -- so a deep folder
		# showed a long identical prefix and cut off the one part that
		# says which folder it actually is.
		local parent; parent="$(dirname "$last")"
		recent="󰋚  $(basename "$last")   ·   ${parent/#$HOME/\~}"
		entries=("$recent")
	fi
	entries+=("${roots[@]}")

	local root rc=0
	root="$(printf '%s\n' "${entries[@]}" | menu "$label $SEPARATOR from" \
		"$(rofi_hint "↵ open" "Esc back to tools")" -selected-row 0)" || rc=$?
	(( rc != 0 )) && return 1
	[[ -n "$root" ]] || return 1
	if [[ -n "$recent" && "$root" == "$recent" ]]; then printf '%s' "$last"; return 0; fi
	[[ -v "MAIN_DIR_MAP[$root]" ]] || return 1
	printf '%s' "${MAIN_DIR_MAP[$root]}"
}

# Confirm or change the order of a multi-file selection. Rewrites
# SELECTED_FILES; returns 1 if the user backed out.
#
# rofi's -multi-select hands back the marked lines in LIST order, never in
# the order they were clicked, so "merge the cover, then the body, then the
# appendix" was alphabetical whatever you did -- and the only workaround
# was to go and rename the files. Alphabetical is still the default and
# still right for scan_01/scan_02/scan_03, so it is one keypress to accept;
# the other orders are for when it is not.
order_files() {
	local label="$1"; shift
	local -a files=("$@")
	(( ${#files[@]} > 1 )) || return 0

	local -a names=()
	local f; for f in "${files[@]}"; do names+=("$(basename "$f")"); done

	local keep="󰄬  Keep this order"
	local rev="󰑥  Reverse it"
	local custom="✎  Put them in my own order…"
	local preview; preview="$(printf '%s → ' "${names[@]:0:3}")"
	preview="${preview% → }"
	(( ${#files[@]} > 3 )) && preview+=" → …"

	local pick rc=0
	pick="$(printf '%s\n%s\n%s\n' "$keep" "$rev" "$custom" \
		| menu "$label $SEPARATOR order" \
		  "${#files[@]} files  ·  $preview  ·  $(rofi_hint "Esc back")" -selected-row 0)" || rc=$?
	(( rc != 0 )) && return 1
	[[ -n "$pick" ]] || return 1

	case "$pick" in
	"$keep") return 0 ;;
	"$rev")
		local -a r=()
		local i
		for (( i = ${#files[@]} - 1; i >= 0; i-- )); do r+=("${files[i]}"); done
		SELECTED_FILES=("${r[@]}")
		return 0 ;;
	esac

	# Custom: pick the next file, repeatedly, until none are left. Backing
	# out of the middle of it returns to the order menu rather than losing
	# the whole selection.
	local -a remaining=("${files[@]}") ordered=()
	while (( ${#remaining[@]} )); do
		if (( ${#remaining[@]} == 1 )); then ordered+=("${remaining[0]}"); break; fi
		local -a rnames=()
		for f in "${remaining[@]}"; do rnames+=("$(basename "$f")"); done
		local n=$(( ${#ordered[@]} + 1 )) sel r2=0
		sel="$(printf '%s\n' "${rnames[@]}" | menu "Which file is #$n?" \
			"$((${#remaining[@]})) left  ·  $(rofi_hint "Esc back")" -selected-row 0)" || r2=$?
		(( r2 != 0 )) && return 1
		[[ -n "$sel" ]] || return 1
		local -a rest=()
		local matched=0
		for f in "${remaining[@]}"; do
			if (( ! matched )) && [[ "$(basename "$f")" == "$sel" ]]; then
				ordered+=("$f"); matched=1
			else
				rest+=("$f")
			fi
		done
		(( matched )) || return 1
		remaining=(${rest[@]+"${rest[@]}"})
	done
	SELECTED_FILES=("${ordered[@]}")
	return 0
}

# Everything is a loop back to the step before it. The only way out is Esc
# on the tool list (or opening a result), so no dead end ever closes the
# window on you halfway through a job.
run() {
	local -a cli_files=("$@")

	local -a offered=()
	local a
	for a in "${ACTION_ORDER[@]}"; do
		[[ "$a" == *OCR* && $HAVE_OCR -eq 0 ]] && continue
		offered+=("$a")
	done

	while true; do   # ---- tool list ------------------------------------
		local ACTION rc=0
		ACTION="$(printf '%s\n' "${offered[@]}" | menu "PDF tools" \
			"$(rofi_hint "↵ choose" "type to filter" "Esc quits")")" || rc=$?
		(( rc != 0 )) && return 0
		[[ -n "$ACTION" ]] || return 0
		[[ -v "ACTION_EXT[$ACTION]" ]] || { notify_safe "iLovePDF" "Unknown action"; continue; }

		local -a EXT_ARRAY
		read -r -a EXT_ARRAY <<<"${ACTION_EXT[$ACTION]}"
		local multi="false"
		for a in "${MULTI_ACTIONS[@]}"; do [[ "$a" == "$ACTION" ]] && multi="true"; done

		# The folder the last selection came from. Cancelling an option
		# prompt drops straight back into the browser HERE rather than out
		# to the folder list -- backing out of "which rotation?" should
		# return you to the files, not two steps further away.
		local resume_dir=""

		while true; do   # ---- file choice -------------------------------
			SELECTED_FILES=()

			# Files named on the command line skip browsing entirely, but
			# only for the first tool -- after that the picker takes over,
			# or "do another thing" would silently reuse the same input.
			if (( ${#cli_files[@]} )); then
				SELECTED_FILES=("${cli_files[@]}")
				cli_files=()
			else
				local start="" nrc=0
				if [[ -n "$resume_dir" && -d "$resume_dir" ]]; then
					start="$resume_dir"; resume_dir=""
				else
					start="$(pick_root "${ACTION#*  }")" || break   # Esc -> tool list
				fi
				# `|| nrc=$?`, never a bare `navigate ...` followed by
				# `case $?`. Under `set -e` a simple command that returns
				# non-zero and is not part of a condition kills the shell
				# before the case is ever reached -- so navigate's "1 = go
				# back" closed the whole window instead, which is precisely
				# the Esc-quits behaviour its return codes exist to avoid.
				navigate "$start" "$ACTION" "$multi" "${EXT_ARRAY[@]}" || nrc=$?
				case $nrc in
					0) : ;;            # chose files
					1) continue ;;     # Esc at a root -> folder list again
					*) return 0 ;;     # rofi itself failed
				esac
			fi
			(( ${#SELECTED_FILES[@]} )) || continue

			# Confirm the order before doing the work, not after.
			if [[ "$multi" == "true" ]] && (( ${#SELECTED_FILES[@]} > 1 )); then
				local orc=0
				order_files "${ACTION#*  }" "${SELECTED_FILES[@]}" || orc=$?
				if (( orc != 0 )); then
					resume_dir="$(dirname "${SELECTED_FILES[0]}")"
					continue
				fi
			fi

			# 0 done, 1 failed, 2 cancelled at an option prompt. Cancelling
			# an option used to `return 0` out of the whole program, which
			# is exactly the "Esc closes it" complaint: Esc at the DPI or
			# rotation prompt quit instead of stepping back to the files.
			local crc=0
			convert_files "$ACTION" "${SELECTED_FILES[@]}" || crc=$?
			case $crc in
				2) resume_dir="$(dirname "${SELECTED_FILES[0]}")"
				   continue ;;    # back to the browser, same folder
				0) offer_open "$LAST_OUT_DIR" "$LAST_PRODUCED" || return 0 ;;
			esac
			break                 # done or failed -> tool list
		done
	done
}

# --- The work ---------------------------------------------------------

# Returns 0 on success, 1 on failure, 2 when the user pressed Esc at one of
# the option prompts. 2 is a distinct code so run() can step BACK to the
# file picker instead of treating a cancel as a finished job.
LAST_OUT_DIR=""
LAST_PRODUCED=""
convert_files() {
	local ACTION="$1"; shift
	local -a files=("$@")
	local LABEL="${ACTION#*  }"   # menu text without the icon
	LAST_OUT_DIR=""; LAST_PRODUCED=""

	if [[ "$ACTION" == *"Merge PDFs"* && ${#files[@]} -lt 2 ]]; then
		notify_safe "iLovePDF" "Merge needs at least two PDFs — pick more with Shift or Ctrl."
		return 1
	fi

	# gs and ImageMagick report a missing input on stdout, not stderr, so a
	# bad path used to spray a stack dump into whatever launched this.
	local f
	for f in "${files[@]}"; do
		[[ -r "$f" ]] || { notify_safe "iLovePDF" "Cannot read $(basename "$f")"; return 1; }
	done

	local FIRST="${files[0]}"
	local FILENAME NAME
	FILENAME="$(basename "$FIRST")"
	NAME="${FILENAME%.*}"

	# Every page-level operation fails confusingly on an encrypted file.
	# "Remove password" is the one that is supposed to meet one.
	#
	# Checked across ALL the files, not just the first: a merge whose third
	# input was encrypted passed this test and then failed inside qpdf with
	# the generic "could not process" message.
	if [[ "${ACTION_EXT[$ACTION]}" == "pdf" && "$ACTION" != *"Remove password"* ]]; then
		for f in "${files[@]}"; do
			if pdf_is_encrypted "$f"; then
				notify_safe "iLovePDF" "$(basename "$f") is password-protected. Use 'Remove password' first."
				return 1
			fi
		done
	fi

	local OUT_DIR="$BASE_DIR/$LABEL"
	mkdir -p "$OUT_DIR"

	local ok=1 produced="" out extra=""

	# "working…" is announced per-operation, after that operation's
	# options have been answered -- not unconditionally before the case.
	# Firing it up front meant Esc at the rotation or quality prompt still
	# left a "Rotate — working…" notification on screen for work that never
	# started. It is also only worth saying for the operations slow enough
	# to look stalled; for the instant ones the result notification lands
	# before a "working" toast would have finished animating in.
	announce() { notify_safe "iLovePDF" "$LABEL — working…"; }

	case "$ACTION" in
	*"Word → PDF"* | *"Excel → PDF"* | *"PowerPoint → PDF"*)
		out="$(unique_path "$OUT_DIR/${NAME}.pdf")"
		announce
		lo_convert "$FIRST" pdf "$out" && { ok=0; produced="$out"; }
		;;

	*"Images → PDF"*)
		# One PDF from all the selected images, in list order.
		out="$(unique_path "$OUT_DIR/${NAME}.pdf")"
		announce
		"$IM" "${files[@]}" -auto-orient "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		extra="${#files[@]} images"
		;;

	*"PDF → Word"*)
		# `--convert-to docx` on a PDF fails outright: LibreOffice has no
		# route from PDF to Writer without being told to use the PDF import
		# filter AND the explicit target filter name. Measured: the old
		# command exited 1 and produced nothing, while the notification
		# still said the conversion had completed.
		out="$(unique_path "$OUT_DIR/${NAME}.docx")"
		announce
		lo_convert "$FIRST" "docx:MS Word 2007 XML" "$out" writer_pdf_import \
			&& { ok=0; produced="$out"; }
		;;

	*"PDF → JPG"* | *"PDF → PNG"*)
		local ext=jpg; [[ "$ACTION" == *"PNG"* ]] && ext=png
		local dpi
		dpi="$(printf '150 — screen\n300 — print\n600 — archive\n72 — small\n' \
			| menu "Quality" "dots per inch")" || return 2
		dpi="${dpi%% *}"
		[[ "$dpi" =~ ^[0-9]+$ ]] || dpi=150
		local stem; stem="$(unique_stem "$OUT_DIR" "$NAME" "-*.${ext}")"
		# pdftoppm, not ImageMagick: IM shells out to Ghostscript for PDF
		# input and rasterises the whole file in memory at once, which on a
		# large document is the difference between a second and a minute.
		announce
		local pf=(-r "$dpi"); [[ "$ext" == jpg ]] && pf+=(-jpeg) || pf+=(-png)
		if pdftoppm "${pf[@]}" "$FIRST" "$stem" >/dev/null 2>&1; then
			produced="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")-*.${ext}" | sort | head -1)"
			[[ -n "$produced" ]] && ok=0
			extra="$(pdf_pages "$FIRST") pages at ${dpi} dpi"
		fi
		;;

	*"PDF → Text"*)
		out="$(unique_path "$OUT_DIR/${NAME}.txt")"
		# -layout keeps columns and tables readable instead of interleaving
		# them into one stream.
		pdftotext -layout "$FIRST" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		# Not `-s`. pdftotext emits a form feed per page even when the page
		# holds no text at all, so a 40-page scan produced a "non-empty"
		# 40-byte file of nothing but \f and was reported as a success --
		# the exact case this check exists to catch. Test for a character
		# that is actually text.
		if [[ -n "$produced" ]] && ! grep -q '[^[:space:]]' "$produced" 2>/dev/null; then
			notify_safe "iLovePDF" "$FILENAME has no text layer — it is scanned images. Try OCR."
			rm -f "$produced"; return 1
		fi
		;;

	*"Extract images"*)
		# The images as they were embedded, not a re-render of the page.
		local stem; stem="$(unique_stem "$OUT_DIR" "$NAME" "-*")"
		announce
		if pdfimages -all "$FIRST" "$stem" >/dev/null 2>&1; then
			produced="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")-*" | sort | head -1)"
			if [[ -z "$produced" ]]; then
				notify_safe "iLovePDF" "No embedded images in $FILENAME"
				return 1
			fi
			ok=0
			extra="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")-*" | wc -l) images"
		fi
		;;

	*"Merge PDFs"*)
		out="$(unique_path "$OUT_DIR/${NAME}_merged.pdf")"
		# qpdf, not gs: Ghostscript re-writes every page through its
		# interpreter, which silently drops form fields, annotations and
		# bookmarks. qpdf copies the page objects across intact.
		qpdf --empty --pages "${files[@]}" -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		extra="${#files[@]} files → $(pdf_pages "$out" 2>/dev/null) pages"
		;;

	*"Split into pages"*)
		local pages; pages="$(pdf_pages "$FIRST")"
		[[ "$pages" =~ ^[0-9]+$ ]] || { notify_safe "iLovePDF" "Could not read a page count"; return 1; }
		(( pages < 2 )) && { notify_safe "iLovePDF" "$FILENAME is one page — nothing to split."; return 0; }
		local stem; stem="$(unique_stem "$OUT_DIR" "$NAME" "_page_*.pdf")"
		if qpdf --split-pages "$FIRST" "${stem}_page_%d.pdf" >/dev/null 2>&1; then
			produced="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")_page_*.pdf" | sort | head -1)"
			[[ -n "$produced" ]] && ok=0
			extra="$pages pages"
		fi
		;;

	*"Extract page range"*)
		local pages range; pages="$(pdf_pages "$FIRST")"
		range="$(ask_pages "$pages" "Keep which pages?")" || return 2
		# Named from the first and last page kept, not from the range text.
		# ask_pages now returns the range fully expanded, so "2-z" on a
		# 40-page file used to build a 90-character filename.
		out="$(unique_path "$OUT_DIR/${NAME}_p${range%%,*}-${range##*,}.pdf")"
		qpdf "$FIRST" --pages . "$range" -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		[[ -n "$produced" ]] && extra="$(pdf_pages "$out") of $pages pages"
		;;

	*"Delete pages"*)
		local pages range; pages="$(pdf_pages "$FIRST")"
		range="$(ask_pages "$pages" "Delete which pages?")" || return 2
		out="$(unique_path "$OUT_DIR/${NAME}_trimmed.pdf")"
		# qpdf has no "remove these pages" -- only "keep these". A
		# ":"-suffixed range like "1-z:2,4" looks like an exclusion but is
		# not: qpdf 12 answers `expected :even or :odd`. So the pages to
		# keep are computed here and handed over as a normal range.
		local keep
		keep="$(complement_range "$range" "$pages")" || keep=""
		if [[ -z "$keep" ]]; then
			notify_safe "iLovePDF" "That would delete every page."
			return 1
		fi
		qpdf "$FIRST" --pages . "$keep" -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		[[ -n "$produced" ]] && extra="$(pdf_pages "$out") of $pages pages left"
		;;

	*"Rotate"*)
		local deg
		deg="$(printf '90 — quarter turn right\n180 — upside down\n270 — quarter turn left\n' \
			| menu "Rotate by" "applies to every page")" || return 2
		deg="${deg%% *}"
		[[ "$deg" =~ ^(90|180|270)$ ]] || return 2
		out="$(unique_path "$OUT_DIR/${NAME}_rot${deg}.pdf")"
		qpdf "$FIRST" --rotate="+${deg}" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		;;

	*"Reverse page order"*)
		out="$(unique_path "$OUT_DIR/${NAME}_reversed.pdf")"
		qpdf "$FIRST" --pages . z-1 -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		;;

	*"Compress"*)
		local q
		q="$(printf 'ebook — good quality, much smaller\nscreen — smallest, on-screen only\nprinter — print quality\nprepress — highest quality\n' \
			| menu "Compression" "$(human_size "$(file_size "$FIRST")") now")" || return 2
		q="${q%% *}"
		[[ "$q" =~ ^(screen|ebook|printer|prepress)$ ]] || q=ebook
		out="$(unique_path "$OUT_DIR/${NAME}_compressed.pdf")"
		announce
		if gs -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -dPDFSETTINGS="/$q" \
			-dNOPAUSE -dBATCH -dQUIET -sOutputFile="$out" "$FIRST" >/dev/null 2>&1; then
			ok=0; produced="$out"
			local before after
			before="$(file_size "$FIRST")"; after="$(file_size "$out")"
			# Compression that makes the file BIGGER is a real outcome on an
			# already-optimised PDF. Say so rather than calling it a saving.
			if (( after >= before )); then
				extra="no saving — already optimised ($(human_size "$before"))"
			else
				extra="$(human_size "$before") → $(human_size "$after")  (−$(( 100 - after*100/before ))%)"
			fi
		fi
		;;

	*"Protect with password"*)
		local pw pw2
		pw="$(ask_password "New password" "needed to open the file")" || return 2
		pw2="$(ask_password "Confirm password" "type it again")" || return 2
		[[ "$pw" == "$pw2" ]] || { notify_safe "iLovePDF" "Passwords did not match."; return 1; }
		out="$(unique_path "$OUT_DIR/${NAME}_protected.pdf")"
		# 256-bit AES. qpdf reads both passwords from argv, which is visible
		# in /proc for the moment the process lives -- unavoidable with
		# qpdf's CLI, and the file is the thing being protected, not the
		# machine it was made on.
		qpdf --encrypt "$pw" "$pw" 256 -- "$FIRST" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		extra="AES-256"
		;;

	*"Remove password"*)
		local pw
		pw="$(ask_password "Password" "the one that opens $FILENAME")" || return 2
		out="$(unique_path "$OUT_DIR/${NAME}_unlocked.pdf")"
		if qpdf --password="$pw" --decrypt "$FIRST" "$out" >/dev/null 2>&1; then
			ok=0; produced="$out"
		else
			notify_safe "iLovePDF" "Wrong password, or $FILENAME is not encrypted."
			return 1
		fi
		;;

	*"Watermark"*)
		local text
		text="$(ask_text "Watermark text" "drawn diagonally across every page")" || return 2
		[[ -n "$text" ]] || return 2
		out="$(unique_path "$OUT_DIR/${NAME}_watermarked.pdf")"
		make_watermark "$FIRST" "$text" && \
			qpdf "$FIRST" --overlay "$WM_TMP" --repeat=1 -- "$out" >/dev/null 2>&1 \
			&& { ok=0; produced="$out"; }
		rm -f "$WM_TMP" 2>/dev/null || true
		;;

	*"Add page numbers"*)
		out="$(unique_path "$OUT_DIR/${NAME}_numbered.pdf")"
		make_numbers "$FIRST" && \
			qpdf "$FIRST" --overlay "$NUM_TMP" -- "$out" >/dev/null 2>&1 \
			&& { ok=0; produced="$out"; }
		rm -f "$NUM_TMP" 2>/dev/null || true
		;;

	*"Repair"*)
		out="$(unique_path "$OUT_DIR/${NAME}_repaired.pdf")"
		announce
		# Two passes: qpdf rebuilds the cross-reference table, and if the
		# damage is deeper than that, Ghostscript re-interprets the content
		# streams. The second is lossier, so it is the fallback.
		if qpdf --linearize "$FIRST" "$out" >/dev/null 2>&1 && [[ -s "$out" ]]; then
			ok=0; produced="$out"; extra="rebuilt index"
		elif gs -o "$out" -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress "$FIRST" >/dev/null 2>&1 \
			&& [[ -s "$out" ]]; then
			ok=0; produced="$out"; extra="rebuilt by re-interpreting"
		fi
		;;

	*"OCR"*)
		local lang npages
		lang="$(ask_ocr_lang)" || return 2
		out="$(unique_path "$OUT_DIR/${NAME}_ocr.pdf")"
		# The one operation slow enough to look hung. Say how much work it
		# is before starting it, not after.
		npages="$(pdf_pages "$FIRST")"
		notify_safe "iLovePDF" "OCR of ${npages:-?} pages ($lang) — this takes a while…"
		ocr_pdf "$FIRST" "$out" "$lang" && { ok=0; produced="$out"; extra="text layer added ($lang)"; }
		;;

	*"Resize image"*)
		local size
		size="$(ask_size)" || return 2
		out="$(unique_path "$OUT_DIR/${NAME}_resized.${FIRST##*.}")"
		"$IM" "$FIRST" -resize "$size" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		;;
	esac

	# The old script notified "completed" unconditionally, at the end of a
	# case statement that never checked a single exit status. A failed
	# LibreOffice run and a successful one produced the same message.
	if (( ok != 0 )) || [[ -z "$produced" || ! -e "$produced" ]]; then
		notify_safe "iLovePDF — failed" "$LABEL could not process $FILENAME"
		return 1
	fi

	notify_safe "iLovePDF ✓ $LABEL" "${extra:-$(human_size "$(file_size "$produced")")} · ${OUT_DIR/#$HOME/\~}"
	# Handed back rather than acted on here, so run() decides what happens
	# next -- this function stays a pure "do the work" call for the tests.
	LAST_OUT_DIR="$OUT_DIR"; LAST_PRODUCED="$produced"
	return 0
}

# Which pages survive deleting <spec> from a <total>-page document.
# "2,4" of 5 -> "1,3,5". Pure bash: adding a python3 dependency for set
# arithmetic on a few dozen integers is not a trade worth making, and this
# script is already the only thing standing between the user and a website.
# Returns 1 if nothing would be left.
#
# <spec> arrives already expanded to a plain comma list by ask_pages. This
# used to re-parse "2-5" and "z" itself, and had no case for the "rN" form
# that ask_pages advertised in its own hint -- so deleting "r1" (the last
# page) fell through to "that would delete every page" and refused.
complement_range() {
	local spec="$1" total="$2"
	local -a drop=()
	local p
	for p in ${spec//,/ }; do
		[[ "$p" =~ ^[0-9]+$ ]] || return 1
		drop[p]=1
	done
	local -a keep=()
	for (( p = 1; p <= total; p++ )); do
		[[ -n "${drop[p]:-}" ]] || keep+=("$p")
	done
	(( ${#keep[@]} )) || return 1
	local IFS=,
	printf '%s' "${keep[*]}"
}

# --- Overlays ---------------------------------------------------------
#
# Both stamp layers are drawn as PostScript and turned into PDF by
# Ghostscript, NOT rendered to a PNG by ImageMagick and wrapped.
#
# The old raster route produced a 72-dpi bitmap the size of the page and
# laid that over the document: crisp at 100% zoom and visibly soft at any
# magnification or on paper, which is exactly where a watermark is read. It
# also weighed a few hundred KB per page-numbered document. Text drawn in
# PostScript stays vector through pdfwrite, so it is sharp at any zoom and
# the whole overlay is a couple of KB.
#
# -dALLOWPSTRANSPARENCY is required: Ghostscript 9.53+ refuses the
# transparency operators to PostScript input without it, and silently drew
# the watermark at full opacity -- a solid red bar over the text.

# PostScript string literals: \ ( ) are the three characters that need it.
ps_escape() {
	local s="$1"
	s="${s//\\/\\\\}"; s="${s//(/\\(}"; s="${s//)/\\)}"
	printf '%s' "$s"
}

ps_to_pdf() {
	local ps="$1" pdf="$2" w="$3" h="$4"
	gs -o "$pdf" -sDEVICE=pdfwrite -dQUIET -dNOPAUSE -dBATCH \
		-dALLOWPSTRANSPARENCY \
		-dDEVICEWIDTHPOINTS="$w" -dDEVICEHEIGHTPOINTS="$h" -dFIXEDMEDIA \
		"$ps" >/dev/null 2>&1 || return 1
	[[ -s "$pdf" ]]
}

# A single transparent page carrying the text on the diagonal. The point
# size is not guessed: PostScript measures the string with `stringwidth` and
# scales it to 92% of the page width, so "OK" and "STRICTLY CONFIDENTIAL"
# both come out spanning the page instead of one being a rounding error.
WM_TMP=""
make_watermark() {
	local src="$1" text="$2"
	local w h; w="$(pdf_width "$src")"; h="$(pdf_height "$src")"
	[[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || return 1
	(( w > 0 && h > 0 )) || return 1

	local ps; ps="$(mktemp --suffix=.ps)"
	WM_TMP="$(mktemp --suffix=.pdf)"
	cat >"$ps" <<-PS
	%!PS-Adobe-3.0
	/txt ($(ps_escape "$text")) def
	/Helvetica-Bold findfont 100 scalefont setfont
	txt stringwidth pop dup 0 eq { pop 1 } if /w100 exch def
	/sz 100 $w 0.92 mul mul w100 div def
	/Helvetica-Bold findfont sz scalefont setfont
	txt stringwidth pop /tw exch def
	0.30 .setfillconstantalpha
	0.80 0.08 0.08 setrgbcolor
	$w 2 div $h 2 div translate
	30 rotate
	tw -2 div sz 0.36 mul neg moveto
	txt show
	showpage
	PS
	ps_to_pdf "$ps" "$WM_TMP" "$w" "$h" || { rm -f "$ps"; return 1; }
	rm -f "$ps"
	return 0
}

# One stamp page per document page, each carrying its own number, so the
# overlay lands page-for-page rather than repeating a single stamp.
NUM_TMP=""
make_numbers() {
	local src="$1"
	local n w h; n="$(pdf_pages "$src")"; w="$(pdf_width "$src")"; h="$(pdf_height "$src")"
	[[ "$n" =~ ^[0-9]+$ && "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || return 1
	(( n > 0 && w > 0 && h > 0 )) || return 1
	local pt=$(( h / 60 )); (( pt < 9 )) && pt=9
	local margin=$(( h / 32 )); (( margin < 18 )) && margin=18

	local ps; ps="$(mktemp --suffix=.ps)"
	NUM_TMP="$(mktemp --suffix=.pdf)"
	{
		printf '%%!PS-Adobe-3.0\n/Helvetica findfont %d scalefont setfont\n' "$pt"
		printf '0 setgray\n'
		# `n 1 1 n {...} for` in PostScript would be shorter, but emitting
		# the pages from the shell keeps the numbering visible in the file
		# and costs nothing at these sizes.
		local i
		for (( i = 1; i <= n; i++ )); do
			printf '(%d) dup stringwidth pop 2 div %s exch sub %d moveto show showpage\n' \
				"$i" "$(( w / 2 ))" "$margin"
		done
	} >"$ps"
	ps_to_pdf "$ps" "$NUM_TMP" "$w" "$h" || { rm -f "$ps"; return 1; }
	rm -f "$ps"
	return 0
}

# Languages tesseract can actually load, minus "osd" -- that is the
# orientation/script detection model, not a language, and picking it
# produces a PDF with no text in it.
ocr_langs() {
	tesseract --list-langs 2>/dev/null | tail -n +2 | grep -vx 'osd' | sort
}

# Only asks when there is something to ask about. On a stock install this is
# "eng" alone, and a one-item menu is pure friction; the moment a second
# language pack is installed the prompt appears on its own.
ask_ocr_lang() {
	local -a langs=()
	mapfile -t langs < <(ocr_langs)
	(( ${#langs[@]} == 0 )) && { printf 'eng'; return 0; }
	(( ${#langs[@]} == 1 )) && { printf '%s' "${langs[0]}"; return 0; }
	local pick rc=0
	pick="$(printf '%s\n' "${langs[@]}" | menu "Language" "the language of the text in the scan")" || rc=$?
	(( rc != 0 )) && return 1
	[[ -n "$pick" ]] || return 1
	printf '%s' "$pick"
}

# Render each page, OCR it, and reassemble -- tesseract's own pdf output
# carries an invisible text layer over the image it was given.
#
# The per-page tesseract runs go through `xargs -P`: OCR is the slowest
# thing in this script by a wide margin and it is entirely CPU-bound per
# page, so a 20-page scan went from serial minutes to roughly minutes/ncpu.
ocr_pdf() {
	local src="$1" dst="$2" lang="${3:-eng}"
	local tmpdir; tmpdir="$(mktemp -d)"
	pdftoppm -r 300 -png "$src" "$tmpdir/p" >/dev/null 2>&1 || { rm -rf "$tmpdir"; return 1; }

	local -a pages=()
	mapfile -t -d '' pages < <(find "$tmpdir" -maxdepth 1 -type f -iname 'p-*.png' -print0 | sort -z)
	if (( ${#pages[@]} == 0 )); then rm -rf "$tmpdir"; return 1; fi

	printf '%s\0' "${pages[@]}" \
		| xargs -0 -P "$(nproc 2>/dev/null || echo 2)" -I{} \
			tesseract {} {} -l "$lang" pdf >/dev/null 2>&1 || true

	local page parts=()
	for page in "${pages[@]}"; do
		# tesseract appends .pdf to the name it was given, which here was
		# the full "p-01.png" -- so the output is "p-01.png.pdf".
		[[ -s "${page}.pdf" ]] && parts+=("${page}.pdf")
	done
	if (( ${#parts[@]} == 0 )); then rm -rf "$tmpdir"; return 1; fi
	qpdf --empty --pages "${parts[@]}" -- "$dst" >/dev/null 2>&1 || { rm -rf "$tmpdir"; return 1; }
	rm -rf "$tmpdir"
	[[ -s "$dst" ]]
}

# Offer the result rather than just naming a path.
#
# Returns 0 to stay in the toolkit (back to the tool list) and 1 to stop.
# Opening the result is the one action that means "I am finished with this",
# so it is also the one that closes the menu -- popping rofi back up on top
# of the document you just asked to see is not helpful. Esc is "back", the
# same as everywhere else in this script.
offer_open() {
	local dir="$1" file="$2"
	[[ -n "$file" ]] || return 0
	command -v xdg-open >/dev/null 2>&1 || return 0
	local ans rc=0
	ans="$(printf '󰁍  Another tool\n󰈔  Open file\n󰉋  Open folder\n󰅖  Quit\n' \
		| menu "Done ✓" "$(basename "$file")  $SEPARATOR  $(rofi_hint "Esc back to tools")" \
		-selected-row 0)" || rc=$?
	(( rc != 0 )) && return 0
	case "$ans" in
		*"Open folder") setsid xdg-open "$dir"  >/dev/null 2>&1 & return 1 ;;
		*"Open file")   setsid xdg-open "$file" >/dev/null 2>&1 & return 1 ;;
		*"Quit")        return 1 ;;
	esac
	return 0
}

# --- Browser ----------------------------------------------------------
#
# Returns 0 when files were chosen, 1 to go back to the roots menu, 2 to
# quit. SELECTED_FILES is the output.
navigate() {
	local current_dir="$1"
	local action="$2"
	local multi_select="$3"
	shift 3
	local ext_array=("$@")
	local label="${action#*  }"

	local -a navigation_stack=()
	local -a rofi_extra=()
	[[ "$multi_select" == "true" ]] && rofi_extra=(-multi-select)

	# There is no is_root() test any more. It existed to decide whether to
	# show "../", and got the answer from a `grep -q "^${dir}$"` that treats
	# the path as a regular expression, so a folder with a '+' or '[' in its
	# name showed the wrong entry. The navigation stack already knows
	# whether we descended, which is the same question without the regex.
	while true; do
		local -a DIRS=() FILES=() ENTRIES=()

		while IFS= read -r -d '' d; do
			local dn; dn="$(basename "$d")"
			[[ "$dn" == .* ]] && continue
			DIRS+=("$dn/")
		done < <(find "$current_dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)

		while IFS= read -r -d '' f; do
			local fn; fn="$(basename "$f")"
			[[ "$fn" == .* ]] && continue
			# A file with no dot at all has no extension; "${fn##*.}" would
			# return the whole name and could match by accident.
			[[ "$fn" == *.* ]] || continue
			local fe="${fn##*.}" e
			for e in "${ext_array[@]}"; do
				if [[ "${fe,,}" == "$e" ]]; then FILES+=("$fn"); break; fi
			done
		done < <(find "$current_dir" -mindepth 1 -maxdepth 1 -type f -print0 2>/dev/null | sort -z)

		# One "back" entry rather than the old pair of "../" and
		# "🏠 Main Menu". They did different things from the same place,
		# and neither matched Esc; now the entry and the key agree -- up a
		# level if we descended, otherwise out to the folder list.
		ENTRIES=("󰁍  Back")
		# Taking every usable file in the folder is the whole job for a
		# merge, and doing it by hand means Ctrl-clicking each one.
		local ALL_ENTRY=""
		if [[ "$multi_select" == "true" ]] && (( ${#FILES[@]} > 1 )); then
			ALL_ENTRY="󰒆  All ${#FILES[@]} files here"
			ENTRIES+=("$ALL_ENTRY")
		fi
		(( ${#DIRS[@]}  )) && ENTRIES+=("${DIRS[@]}")
		(( ${#FILES[@]} )) && ENTRIES+=("${FILES[@]}")

		local rel="${current_dir/#"$HOME"/\~}"
		local mesg
		if (( ${#FILES[@]} == 0 )); then
			mesg="nothing here it can use · wants: ${ext_array[*]}"
		elif [[ "$multi_select" == "true" ]]; then
			mesg="$(rofi_hint "Shift+↵ to pick several" "you set the order next" "Esc back")"
		else
			mesg="$(rofi_hint "↵ choose" "Esc back")"
		fi

		local choice rc=0
		choice="$(printf '%s\n' "${ENTRIES[@]}" | menu "$label $SEPARATOR $rel" "$mesg" "${rofi_extra[@]}")" || rc=$?

		(( rc > 1 )) && return 2

		if (( rc != 0 )) || [[ -z "$choice" ]]; then
			# Esc: up one level if we descended, otherwise back to the roots
			# menu. This is the behaviour that `set -e` made unreachable.
			if (( ${#navigation_stack[@]} == 0 )); then return 1; fi
			current_dir="${navigation_stack[-1]}"
			unset 'navigation_stack[-1]'
			continue
		fi

		case "$choice" in
		"󰁍  Back")
			# Identical to Esc, deliberately.
			if (( ${#navigation_stack[@]} == 0 )); then return 1; fi
			current_dir="${navigation_stack[-1]}"
			unset 'navigation_stack[-1]'
			;;
		*/)
			navigation_stack+=("$current_dir")
			current_dir="$current_dir/${choice%/}"
			;;
		*)
			local -a picked=()
			if [[ -n "$ALL_ENTRY" && "$choice" == "$ALL_ENTRY" ]]; then
				picked=("${FILES[@]}")
			else
				# `echo -e` here mangled any filename containing a backslash
				# -- it interprets \t, \n and friends inside the name itself.
				mapfile -t picked <<<"$choice"
			fi
			local item
			for item in "${picked[@]}"; do
				[[ -n "$item" ]] || continue
				[[ -f "$current_dir/$item" ]] || continue
				SELECTED_FILES+=("$current_dir/$item")
			done
			if (( ${#SELECTED_FILES[@]} )); then
				remember_dir "$current_dir"
				return 0
			fi
			;;
		esac
	done
}

# --- Entry point ------------------------------------------------------
#
# An `if` rather than `[[ ... ]] && run`, because the && form leaves the
# file's exit status at 1 when the guard is false -- and this file turns on
# `set -e`, so sourcing it for a test killed the shell doing the sourcing.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	# Files given on the command line skip the browser, so a file manager's
	# "Open with" or a shell `rofi_ilovepdf scan.pdf` lands straight on the
	# tool list with the input already chosen. Anything unreadable is
	# dropped here rather than failing later with a path the user cannot
	# see, and an empty list just means the normal interactive run.
	declare -a _args=()
	for _a in "$@"; do
		[[ -f "$_a" && -r "$_a" ]] && _args+=("$(readlink -f -- "$_a")")
	done
	run ${_args[@]+"${_args[@]}"}
fi
