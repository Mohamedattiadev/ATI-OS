#!/usr/bin/env bash
#
# Script name: rofi_ilovepdf
# Description: An offline PDF toolkit in rofi. Everything ilovepdf.com is
#              normally used for, done locally -- no upload, no account, no
#              page limit, no watermark on the way out.
# Dependencies: rofi, qpdf, poppler-utils, ghostscript, imagemagick,
#               libreoffice. Optional: tesseract (enables OCR).
# License: MIT

set -euo pipefail

# BASH_SOURCE, not $0: $0 is the *invoking* script when this file is
# sourced, so the helper next to it could not be found from anywhere but a
# direct run -- which also made the conversion logic untestable.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=rofi_common.sh
source "$SCRIPT_DIR/rofi_common.sh"

# pdfinfo was a declared dependency that was never checked, so "Split PDF"
# reached its page-count call and failed there instead of saying what was
# missing. qpdf is what the page-level operations are built on.
require_cmd rofi libreoffice gs pdfinfo qpdf pdftoppm pdftotext || exit 1

# ImageMagick 7 renamed the entry point; `convert` is a deprecated shim that
# prints a warning to stderr on every call and is not guaranteed to exist.
IM=magick
command -v magick >/dev/null 2>&1 || IM=convert
require_cmd "$IM" || exit 1

BASE_DIR="$HOME/ILovePdf_Style_Docs"
SEPARATOR="›"

# LibreOffice refuses to run headless while a GUI instance holds the default
# profile: it exits 0 having converted nothing, which -- before this script
# checked its output -- was reported to the user as success. A private
# profile directory makes the headless run independent of the desktop.
LO_PROFILE="${XDG_RUNTIME_DIR:-/tmp}/ilovepdf-lo-profile"

# --- rofi geometry ----------------------------------------------------
#
# NO -theme flag anywhere in this file, deliberately.
#
# rofi with no -theme picks up ~/.config/rofi/config.rasi, which points at
# themes/current.rasi -- 45% width, 8 lines, and re-pointed by every theme
# switch. That is what rofi_light, the drun launcher and dm-satty all get,
# so leaving it alone is what makes this window the same size and colour as
# every other rofi on the desktop. An earlier version passed
# `-theme base.rasi`, which skips current.rasi's width/lines override and
# drew a visibly narrower, shorter window than the rest of the system.
#
# Every rofi call also captures its exit status with `|| rc=$?`. Under
# `set -e` a bare `x=$(... rofi ...)` terminates the whole script when rofi
# exits non-zero -- and rofi exits 1 on Esc. That is what made the Esc
# handling, the navigation stack, and "Esc goes up one directory"
# unreachable code in the previous version: Esc quit the program instead of
# going back. rofi also distinguishes 1 (Esc) from >1 (failed to start),
# and those must not be treated alike.

# menu <prompt> <mesg> [extra rofi args...]  -- list arrives on stdin.
# Returns 0 with the choice on stdout, 1 for Esc, 2 for a rofi failure.
menu() {
	local prompt="$1" mesg="${2:-}"
	shift 2 || true
	local out rc=0
	out="$(rofi -dmenu -i -p "$prompt" ${mesg:+-mesg "$mesg"} "$@")" || rc=$?
	(( rc > 1 )) && return 2
	(( rc == 1 )) && return 1
	printf '%s' "$out"
	return 0
}

# Text and password prompts, local rather than rofi_common's rofi_input /
# rofi_input_secret. Those two pin `-theme base.rasi`, which skips
# current.rasi's width override -- so every prompt came up a different width
# from the menu that led to it, inside a single run. These inherit the same
# default as menu() above and only zero the list, which is what an input box
# wants. `-l 0` as well as the theme string, because a rofi built against an
# older theme grammar ignores one or the other.
ask_text() {
	local prompt="$1" mesg="${2:-}" out rc=0
	out="$(printf '' | rofi -dmenu -i -p "$prompt" ${mesg:+-mesg "$mesg"} \
		-l 0 -theme-str 'listview { lines: 0; }')" || rc=$?
	(( rc != 0 )) && return 1
	printf '%s' "$out"
}
ask_secret() {
	local prompt="$1" mesg="${2:-}" out rc=0
	# rofi's -password hides the characters; it does NOT keep the value out
	# of this process's argv, so the answer is read from stdout and never
	# passed to anything as a command-line argument by this function.
	out="$(printf '' | rofi -dmenu -i -password -p "$prompt" ${mesg:+-mesg "$mesg"} \
		-l 0 -theme-str 'listview { lines: 0; }')" || rc=$?
	(( rc != 0 )) && return 1
	printf '%s' "$out"
}

# --- The toolkit ------------------------------------------------------
#
# One flat, searchable list rather than nested categories. rofi filters as
# you type, so "rot" reaches Rotate in three keystrokes; a category tree
# would cost two extra selections to save scrolling that fuzzy search
# already removes. The icons are for scanning, not decoration -- they group
# the list visually while it stays flat.
#
# The table is the single source of truth for each action's accepted
# extensions and whether it takes several files. Keeping those in separate
# parallel case statements is how they drift apart.
declare -A ACTION_EXT=(
	["󰈬  Word → PDF"]="doc docx odt rtf txt"
	["󰈛  Excel → PDF"]="xls xlsx ods csv"
	["󰈧  PowerPoint → PDF"]="ppt pptx odp"
	["󰋩  Images → PDF"]="jpg jpeg png bmp tif tiff webp"
	["󰈭  PDF → Word"]="pdf"
	["󰈟  PDF → JPG"]="pdf"
	["󰈟  PDF → PNG"]="pdf"
	["󰈙  PDF → Text"]="pdf"
	["󰆽  Extract images"]="pdf"
	["󰐗  Merge PDFs"]="pdf"
	["󰆔  Split into pages"]="pdf"
	["󰆐  Extract page range"]="pdf"
	["󰗨  Delete pages"]="pdf"
	["󰑧  Rotate"]="pdf"
	["󰑥  Reverse page order"]="pdf"
	["󰗇  Compress"]="pdf"
	["󰌾  Protect with password"]="pdf"
	["󰿆  Remove password"]="pdf"
	["󰑐  Watermark"]="pdf"
	["󰆃  Add page numbers"]="pdf"
	["󰁨  Repair"]="pdf"
	["󰩫  OCR — make text selectable"]="pdf"
	["󰩭  Resize image"]="jpg jpeg png gif bmp webp tif tiff"
)
# Order is deliberate and an associative array has none: into PDF, out of
# PDF, page surgery, then the things done to a finished document.
ACTION_ORDER=(
	"󰈬  Word → PDF" "󰈛  Excel → PDF" "󰈧  PowerPoint → PDF" "󰋩  Images → PDF"
	"󰈭  PDF → Word" "󰈟  PDF → JPG" "󰈟  PDF → PNG" "󰈙  PDF → Text" "󰆽  Extract images"
	"󰐗  Merge PDFs" "󰆔  Split into pages" "󰆐  Extract page range" "󰗨  Delete pages"
	"󰑧  Rotate" "󰑥  Reverse page order"
	"󰗇  Compress" "󰌾  Protect with password" "󰿆  Remove password"
	"󰑐  Watermark" "󰆃  Add page numbers" "󰁨  Repair"
	"󰩫  OCR — make text selectable"
	"󰩭  Resize image"
)
# Actions that take more than one file. rofi's -multi-select returns the
# lines in list order, not click order, so both of these are alphabetical
# by filename -- which is what you want for "scan1, scan2, scan3" and is
# stated in the prompt so it is not a surprise.
MULTI_ACTIONS=("󰐗  Merge PDFs" "󰋩  Images → PDF")

# OCR is the one action with a dependency that is not otherwise needed.
# Rather than shipping a menu entry that fails, it is dropped from the list
# when tesseract is absent -- everything the menu offers, works.
HAVE_OCR=0
command -v tesseract >/dev/null 2>&1 && HAVE_OCR=1

# --- Browsable roots --------------------------------------------------
#
# This used to hardcode Documents/Downloads/Pictures/Desktop. Two of those
# do not exist on this machine, so the browser offered dead entries that
# opened an empty listing. Ask xdg-user-dir where it can, fall back to the
# conventional name, and only offer what is actually on disk.
declare -A MAIN_DIR_MAP
add_dir() {
	local label="$1" dir="$2"
	[[ -d "$dir" ]] && MAIN_DIR_MAP["$label"]="$dir"
	return 0
}
xdg_or() {
	local key="$1" fallback="$2" got=""
	command -v xdg-user-dir >/dev/null 2>&1 && got="$(xdg-user-dir "$key" 2>/dev/null)"
	[[ -n "$got" && "$got" != "$HOME" ]] && { printf '%s' "$got"; return; }
	printf '%s' "$fallback"
}

# Created up front, not lazily. It used to be added to the menu only if it
# already existed, so on a first run the one folder this script writes to
# was the one folder you could not browse to.
mkdir -p "$BASE_DIR"

add_dir "Documents"   "$(xdg_or DOCUMENTS "$HOME/Documents")"
add_dir "Downloads"   "$(xdg_or DOWNLOAD  "$HOME/Downloads")"
add_dir "Pictures"    "$(xdg_or PICTURES  "$HOME/Pictures")"
add_dir "Desktop"     "$(xdg_or DESKTOP   "$HOME/Desktop")"
add_dir "Screenshots" "$HOME/Screenshots"
add_dir "Videos"      "$(xdg_or VIDEOS    "$HOME/Videos")"
add_dir "Converted"   "$BASE_DIR"

if (( ${#MAIN_DIR_MAP[@]} == 0 )); then
	notify_safe "iLovePDF" "No browsable folders found in $HOME"
	exit 1
fi

# --- Small helpers ----------------------------------------------------

# Never silently overwrite. Running the same conversion twice used to
# replace the first result with no warning; now the second lands beside it.
unique_path() {
	local path="$1" dir base ext n=2
	dir="$(dirname "$path")"; base="$(basename "$path")"
	if [[ "$base" == *.* ]]; then ext=".${base##*.}"; base="${base%.*}"; else ext=""; fi
	while [[ -e "$path" ]]; do
		path="$dir/${base}-${n}${ext}"
		(( n++ ))
	done
	printf '%s' "$path"
}

# Same idea for the actions that emit a NUMBERED SERIES -- "<stem>_001.jpg",
# "<stem>_page_1.pdf". unique_path() cannot express that: it tests one
# concrete filename, so it either never collides (and the series overwrites
# silently) or appends its suffix mid-pattern, giving "doc_000-2.jpg_000.jpg".
unique_stem() {
	local dir="$1" base="$2" glob="$3" n=2
	# Separate `local`: a variable assigned earlier in the SAME local
	# statement is not yet visible to a later one on that line.
	local stem="$dir/$base"
	while compgen -G "${stem}${glob}" >/dev/null 2>&1; do
		stem="$dir/${base}-${n}"
		(( n++ ))
	done
	printf '%s' "$stem"
}

human_size() {
	local b="${1:-0}"
	if   (( b > 1048576 )); then awk -v b="$b" 'BEGIN{printf "%.1f MB", b/1048576}'
	elif (( b > 1024 ));    then awk -v b="$b" 'BEGIN{printf "%.0f KB", b/1024}'
	else printf '%d B' "$b"; fi
}
file_size() { stat -c '%s' "$1" 2>/dev/null || echo 0; }

pdf_pages() { pdfinfo "$1" 2>/dev/null | awk '/^Pages:/{print $2}'; }
pdf_width()  { pdfinfo "$1" 2>/dev/null | awk '/^Page size:/{printf "%d", $3}'; }
pdf_height() { pdfinfo "$1" 2>/dev/null | awk '/^Page size:/{printf "%d", $5}'; }

# An encrypted PDF makes every later step fail in a way that looks like
# corruption. Detect it up front and say so.
pdf_is_encrypted() {
	pdfinfo "$1" 2>&1 | grep -qi "Encrypted:.*yes" && return 0
	qpdf --is-encrypted "$1" 2>/dev/null && return 0
	return 1
}

# LibreOffice writes <input-basename>.<target-ext> into --outdir and gives
# no way to name the output. Convert into a scratch directory, then move
# the single file it produced to where we actually want it.
lo_convert() {
	local infile="$1" target="$2" outfile="$3" infilter="${4:-}"
	local tmp; tmp="$(mktemp -d)"
	local -a args=(-env:UserInstallation="file://$LO_PROFILE" --headless --norestore)
	[[ -n "$infilter" ]] && args+=(--infilter="$infilter")
	args+=(--convert-to "$target" "$infile" --outdir "$tmp")

	libreoffice "${args[@]}" >/dev/null 2>&1 || true

	local produced
	produced="$(find "$tmp" -maxdepth 1 -type f -print -quit 2>/dev/null || true)"
	if [[ -z "$produced" ]]; then rm -rf "$tmp"; return 1; fi
	mv -- "$produced" "$outfile"
	rm -rf "$tmp"
	return 0
}

# --- Prompts ----------------------------------------------------------
#
# All of these use rofi. An earlier version shelled out to zenity for the
# resize dialog -- a GTK window with its own theme dropped into the middle
# of a run of palette-themed rofi menus. rofi_common already has an input
# prompt that follows the active palette, so zenity is not a dependency.

ask_size() {
	local a
	a="$(ask_text "New size" "50%  ·  800x600  ·  1920x (keeps ratio)")" || return 1
	[[ -n "$a" ]] || return 1
	if [[ ! "$a" =~ ^[0-9]+%$ && ! "$a" =~ ^[0-9]*x?[0-9]*[\!\>\<\^]?$ ]]; then
		notify_safe "iLovePDF" "Not a valid size: $a"; return 1
	fi
	printf '%s' "$a"
}

# qpdf page ranges: "1-3,5,8-z" (z = last), "r3-r1" counts from the end.
# Validated here rather than passed through, because qpdf's own error for a
# bad range goes to stderr where nobody launched from a menu will see it.
ask_pages() {
	local total="$1" prompt="$2" a
	a="$(ask_text "$prompt" "$total pages · e.g. 2-5  ·  1,3,7  ·  2-z (to the end)")" || return 1
	[[ -n "$a" ]] || return 1
	if [[ ! "$a" =~ ^[0-9zr,．-]+$ ]] || [[ "$a" =~ ^[,-] ]] || [[ "$a" =~ [,-]$ ]]; then
		notify_safe "iLovePDF" "Not a valid page range: $a"; return 1
	fi
	printf '%s' "$a"
}

ask_password() {
	local p
	p="$(ask_secret "$1" "${2:-}")" || return 1
	[[ -n "$p" ]] || return 1
	printf '%s' "$p"
}

# --- Selection --------------------------------------------------------

SELECTED_FILES=()

run() {
	local -a offered=()
	local a
	for a in "${ACTION_ORDER[@]}"; do
		[[ "$a" == *OCR* && $HAVE_OCR -eq 0 ]] && continue
		offered+=("$a")
	done

	local ACTION rc=0
	ACTION="$(printf '%s\n' "${offered[@]}" | menu "PDF tools" \
		"$(rofi_hint "↵ choose" "type to filter" "Esc closes")")" || rc=$?
	(( rc != 0 )) && exit 0
	[[ -n "$ACTION" ]] || exit 0
	[[ -v "ACTION_EXT[$ACTION]" ]] || { notify_safe "iLovePDF" "Unknown action"; exit 1; }

	local -a EXT_ARRAY
	read -r -a EXT_ARRAY <<<"${ACTION_EXT[$ACTION]}"

	local multi="false"
	for a in "${MULTI_ACTIONS[@]}"; do [[ "$a" == "$ACTION" ]] && multi="true"; done

	while true; do
		SELECTED_FILES=()
		local -a roots=()
		mapfile -t roots < <(printf '%s\n' "${!MAIN_DIR_MAP[@]}" | sort)

		local root r2=0
		root="$(printf '%s\n' "${roots[@]}" | menu "${ACTION#*  } $SEPARATOR start in" \
			"$(rofi_hint "↵ open" "Esc closes")")" || r2=$?
		(( r2 != 0 )) && exit 0
		[[ -n "$root" && -v "MAIN_DIR_MAP[$root]" ]] || continue

		navigate "${MAIN_DIR_MAP[$root]}" "$ACTION" "$multi" "${EXT_ARRAY[@]}"
		case $? in
			0) break ;;
			1) continue ;;
			*) exit 0 ;;
		esac
	done

	(( ${#SELECTED_FILES[@]} > 0 )) || exit 0
	# convert_files returns rather than exits, so it stays callable from a
	# test harness; run() turns a failure into the process exit status.
	convert_files "$ACTION" "${SELECTED_FILES[@]}" || exit 1
}

# --- The work ---------------------------------------------------------

convert_files() {
	local ACTION="$1"; shift
	local -a files=("$@")
	local LABEL="${ACTION#*  }"   # menu text without the icon

	if [[ "$ACTION" == *"Merge PDFs"* && ${#files[@]} -lt 2 ]]; then
		notify_safe "iLovePDF" "Merge needs at least two PDFs — pick more with Shift or Ctrl."
		return 1
	fi

	# gs and ImageMagick report a missing input on stdout, not stderr, so a
	# bad path used to spray a stack dump into whatever launched this.
	local f
	for f in "${files[@]}"; do
		[[ -r "$f" ]] || { notify_safe "iLovePDF" "Cannot read $(basename "$f")"; return 1; }
	done

	local FIRST="${files[0]}"
	local FILENAME NAME
	FILENAME="$(basename "$FIRST")"
	NAME="${FILENAME%.*}"

	# Every page-level operation fails confusingly on an encrypted file.
	# "Remove password" is the one that is supposed to meet one.
	if [[ "${ACTION_EXT[$ACTION]}" == "pdf" && "$ACTION" != *"Remove password"* ]]; then
		if pdf_is_encrypted "$FIRST"; then
			notify_safe "iLovePDF" "$FILENAME is password-protected. Use 'Remove password' first."
			return 1
		fi
	fi

	local OUT_DIR="$BASE_DIR/$LABEL"
	mkdir -p "$OUT_DIR"

	local ok=1 produced="" out extra=""
	notify_safe "iLovePDF" "$LABEL — working…"

	case "$ACTION" in
	*"Word → PDF"* | *"Excel → PDF"* | *"PowerPoint → PDF"*)
		out="$(unique_path "$OUT_DIR/${NAME}.pdf")"
		lo_convert "$FIRST" pdf "$out" && { ok=0; produced="$out"; }
		;;

	*"Images → PDF"*)
		# One PDF from all the selected images, in list order.
		out="$(unique_path "$OUT_DIR/${NAME}.pdf")"
		"$IM" "${files[@]}" -auto-orient "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		extra="${#files[@]} images"
		;;

	*"PDF → Word"*)
		# `--convert-to docx` on a PDF fails outright: LibreOffice has no
		# route from PDF to Writer without being told to use the PDF import
		# filter AND the explicit target filter name. Measured: the old
		# command exited 1 and produced nothing, while the notification
		# still said the conversion had completed.
		out="$(unique_path "$OUT_DIR/${NAME}.docx")"
		lo_convert "$FIRST" "docx:MS Word 2007 XML" "$out" writer_pdf_import \
			&& { ok=0; produced="$out"; }
		;;

	*"PDF → JPG"* | *"PDF → PNG"*)
		local ext=jpg; [[ "$ACTION" == *"PNG"* ]] && ext=png
		local dpi
		dpi="$(printf '150 — screen\n300 — print\n600 — archive\n72 — small\n' \
			| menu "Quality" "dots per inch")" || return 0
		dpi="${dpi%% *}"
		[[ "$dpi" =~ ^[0-9]+$ ]] || dpi=150
		local stem; stem="$(unique_stem "$OUT_DIR" "$NAME" "-*.${ext}")"
		# pdftoppm, not ImageMagick: IM shells out to Ghostscript for PDF
		# input and rasterises the whole file in memory at once, which on a
		# large document is the difference between a second and a minute.
		local pf=(-r "$dpi"); [[ "$ext" == jpg ]] && pf+=(-jpeg) || pf+=(-png)
		if pdftoppm "${pf[@]}" "$FIRST" "$stem" >/dev/null 2>&1; then
			produced="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")-*.${ext}" | sort | head -1)"
			[[ -n "$produced" ]] && ok=0
			extra="$(pdf_pages "$FIRST") pages at ${dpi} dpi"
		fi
		;;

	*"PDF → Text"*)
		out="$(unique_path "$OUT_DIR/${NAME}.txt")"
		# -layout keeps columns and tables readable instead of interleaving
		# them into one stream.
		pdftotext -layout "$FIRST" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		if [[ -n "$produced" && ! -s "$produced" ]]; then
			notify_safe "iLovePDF" "$FILENAME has no text layer — it is scanned images. Try OCR."
			rm -f "$produced"; return 1
		fi
		;;

	*"Extract images"*)
		# The images as they were embedded, not a re-render of the page.
		local stem; stem="$(unique_stem "$OUT_DIR" "$NAME" "-*")"
		if pdfimages -all "$FIRST" "$stem" >/dev/null 2>&1; then
			produced="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")-*" | sort | head -1)"
			if [[ -z "$produced" ]]; then
				notify_safe "iLovePDF" "No embedded images in $FILENAME"
				return 1
			fi
			ok=0
			extra="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")-*" | wc -l) images"
		fi
		;;

	*"Merge PDFs"*)
		out="$(unique_path "$OUT_DIR/${NAME}_merged.pdf")"
		# qpdf, not gs: Ghostscript re-writes every page through its
		# interpreter, which silently drops form fields, annotations and
		# bookmarks. qpdf copies the page objects across intact.
		qpdf --empty --pages "${files[@]}" -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		extra="${#files[@]} files → $(pdf_pages "$out" 2>/dev/null) pages"
		;;

	*"Split into pages"*)
		local pages; pages="$(pdf_pages "$FIRST")"
		[[ "$pages" =~ ^[0-9]+$ ]] || { notify_safe "iLovePDF" "Could not read a page count"; return 1; }
		(( pages < 2 )) && { notify_safe "iLovePDF" "$FILENAME is one page — nothing to split."; return 0; }
		local stem; stem="$(unique_stem "$OUT_DIR" "$NAME" "_page_*.pdf")"
		if qpdf --split-pages "$FIRST" "${stem}_page_%d.pdf" >/dev/null 2>&1; then
			produced="$(find "$OUT_DIR" -maxdepth 1 -name "$(basename "$stem")_page_*.pdf" | sort | head -1)"
			[[ -n "$produced" ]] && ok=0
			extra="$pages pages"
		fi
		;;

	*"Extract page range"*)
		local pages range; pages="$(pdf_pages "$FIRST")"
		range="$(ask_pages "$pages" "Keep which pages?")" || return 0
		out="$(unique_path "$OUT_DIR/${NAME}_p${range//[^0-9]/-}.pdf")"
		qpdf "$FIRST" --pages . "$range" -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		[[ -n "$produced" ]] && extra="$(pdf_pages "$out") of $pages pages"
		;;

	*"Delete pages"*)
		local pages range; pages="$(pdf_pages "$FIRST")"
		range="$(ask_pages "$pages" "Delete which pages?")" || return 0
		out="$(unique_path "$OUT_DIR/${NAME}_trimmed.pdf")"
		# qpdf has no "remove these pages" -- only "keep these". A
		# ":"-suffixed range like "1-z:2,4" looks like an exclusion but is
		# not: qpdf 12 answers `expected :even or :odd`. So the pages to
		# keep are computed here and handed over as a normal range.
		local keep
		keep="$(complement_range "$range" "$pages")" || keep=""
		if [[ -z "$keep" ]]; then
			notify_safe "iLovePDF" "That would delete every page."
			return 1
		fi
		qpdf "$FIRST" --pages . "$keep" -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		[[ -n "$produced" ]] && extra="$(pdf_pages "$out") of $pages pages left"
		;;

	*"Rotate"*)
		local deg
		deg="$(printf '90 — quarter turn right\n180 — upside down\n270 — quarter turn left\n' \
			| menu "Rotate by" "applies to every page")" || return 0
		deg="${deg%% *}"
		[[ "$deg" =~ ^(90|180|270)$ ]] || return 0
		out="$(unique_path "$OUT_DIR/${NAME}_rot${deg}.pdf")"
		qpdf "$FIRST" --rotate="+${deg}" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		;;

	*"Reverse page order"*)
		out="$(unique_path "$OUT_DIR/${NAME}_reversed.pdf")"
		qpdf "$FIRST" --pages . z-1 -- "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		;;

	*"Compress"*)
		local q
		q="$(printf 'ebook — good quality, much smaller\nscreen — smallest, on-screen only\nprinter — print quality\nprepress — highest quality\n' \
			| menu "Compression" "$(human_size "$(file_size "$FIRST")") now")" || return 0
		q="${q%% *}"
		[[ "$q" =~ ^(screen|ebook|printer|prepress)$ ]] || q=ebook
		out="$(unique_path "$OUT_DIR/${NAME}_compressed.pdf")"
		if gs -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -dPDFSETTINGS="/$q" \
			-dNOPAUSE -dBATCH -dQUIET -sOutputFile="$out" "$FIRST" >/dev/null 2>&1; then
			ok=0; produced="$out"
			local before after
			before="$(file_size "$FIRST")"; after="$(file_size "$out")"
			# Compression that makes the file BIGGER is a real outcome on an
			# already-optimised PDF. Say so rather than calling it a saving.
			if (( after >= before )); then
				extra="no saving — already optimised ($(human_size "$before"))"
			else
				extra="$(human_size "$before") → $(human_size "$after")  (−$(( 100 - after*100/before ))%)"
			fi
		fi
		;;

	*"Protect with password"*)
		local pw pw2
		pw="$(ask_password "New password" "needed to open the file")" || return 0
		pw2="$(ask_password "Confirm password" "type it again")" || return 0
		[[ "$pw" == "$pw2" ]] || { notify_safe "iLovePDF" "Passwords did not match."; return 1; }
		out="$(unique_path "$OUT_DIR/${NAME}_protected.pdf")"
		# 256-bit AES. qpdf reads both passwords from argv, which is visible
		# in /proc for the moment the process lives -- unavoidable with
		# qpdf's CLI, and the file is the thing being protected, not the
		# machine it was made on.
		qpdf --encrypt "$pw" "$pw" 256 -- "$FIRST" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		extra="AES-256"
		;;

	*"Remove password"*)
		local pw
		pw="$(ask_password "Password" "the one that opens $FILENAME")" || return 0
		out="$(unique_path "$OUT_DIR/${NAME}_unlocked.pdf")"
		if qpdf --password="$pw" --decrypt "$FIRST" "$out" >/dev/null 2>&1; then
			ok=0; produced="$out"
		else
			notify_safe "iLovePDF" "Wrong password, or $FILENAME is not encrypted."
			return 1
		fi
		;;

	*"Watermark"*)
		local text
		text="$(ask_text "Watermark text" "drawn diagonally across every page")" || return 0
		[[ -n "$text" ]] || return 0
		out="$(unique_path "$OUT_DIR/${NAME}_watermarked.pdf")"
		make_watermark "$FIRST" "$text" && \
			qpdf "$FIRST" --overlay "$WM_TMP" --repeat=1 -- "$out" >/dev/null 2>&1 \
			&& { ok=0; produced="$out"; }
		rm -f "$WM_TMP" 2>/dev/null || true
		;;

	*"Add page numbers"*)
		out="$(unique_path "$OUT_DIR/${NAME}_numbered.pdf")"
		make_numbers "$FIRST" && \
			qpdf "$FIRST" --overlay "$NUM_TMP" -- "$out" >/dev/null 2>&1 \
			&& { ok=0; produced="$out"; }
		rm -f "$NUM_TMP" 2>/dev/null || true
		;;

	*"Repair"*)
		out="$(unique_path "$OUT_DIR/${NAME}_repaired.pdf")"
		# Two passes: qpdf rebuilds the cross-reference table, and if the
		# damage is deeper than that, Ghostscript re-interprets the content
		# streams. The second is lossier, so it is the fallback.
		if qpdf --linearize "$FIRST" "$out" >/dev/null 2>&1 && [[ -s "$out" ]]; then
			ok=0; produced="$out"; extra="rebuilt index"
		elif gs -o "$out" -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress "$FIRST" >/dev/null 2>&1 \
			&& [[ -s "$out" ]]; then
			ok=0; produced="$out"; extra="rebuilt by re-interpreting"
		fi
		;;

	*"OCR"*)
		out="$(unique_path "$OUT_DIR/${NAME}_ocr.pdf")"
		ocr_pdf "$FIRST" "$out" && { ok=0; produced="$out"; extra="text layer added"; }
		;;

	*"Resize image"*)
		local size
		size="$(ask_size)" || return 0
		out="$(unique_path "$OUT_DIR/${NAME}_resized.${FIRST##*.}")"
		"$IM" "$FIRST" -resize "$size" "$out" >/dev/null 2>&1 && { ok=0; produced="$out"; }
		;;
	esac

	# The old script notified "completed" unconditionally, at the end of a
	# case statement that never checked a single exit status. A failed
	# LibreOffice run and a successful one produced the same message.
	if (( ok != 0 )) || [[ -z "$produced" || ! -e "$produced" ]]; then
		notify_safe "iLovePDF — failed" "$LABEL could not process $FILENAME"
		return 1
	fi

	notify_safe "iLovePDF ✓ $LABEL" "${extra:-$(human_size "$(file_size "$produced")")} · ${OUT_DIR/#$HOME/\~}"
	offer_open "$OUT_DIR" "$produced"
	return 0
}

# Which pages survive deleting <spec> from a <total>-page document.
# "2,4" of 5 -> "1,3,5". Pure bash: adding a python3 dependency for set
# arithmetic on a few dozen integers is not a trade worth making, and this
# script is already the only thing standing between the user and a website.
# Returns 1 if nothing would be left.
complement_range() {
	local spec="$1" total="$2"
	local -a drop=()
	local part a b p
	# ${spec//,/ } splits on commas without a subshell.
	for part in ${spec//,/ }; do
		part="${part//z/$total}"
		[[ -n "$part" ]] || continue
		if [[ "$part" == *-* ]]; then
			a="${part%%-*}"; b="${part##*-}"
			[[ "$a" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] || return 1
			(( a > b )) && { p="$a"; a="$b"; b="$p"; }
			for (( p = a; p <= b; p++ )); do drop[p]=1; done
		else
			[[ "$part" =~ ^[0-9]+$ ]] || return 1
			drop[part]=1
		fi
	done
	local -a keep=()
	for (( p = 1; p <= total; p++ )); do
		[[ -n "${drop[p]:-}" ]] || keep+=("$p")
	done
	(( ${#keep[@]} )) || return 1
	local IFS=,
	printf '%s' "${keep[*]}"
}

# A transparent single page the size of the document's first page, with the
# text across it. Scaled to the page rather than a fixed point size: a
# constant size is a banner on A6 and a rounding error on A0.
WM_TMP=""
make_watermark() {
	local src="$1" text="$2"
	local w h; w="$(pdf_width "$src")"; h="$(pdf_height "$src")"
	[[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || return 1
	(( w > 0 && h > 0 )) || return 1
	local pt=$(( w / 7 ))
	(( pt < 12 )) && pt=12
	WM_TMP="$(mktemp --suffix=.pdf)"
	local png; png="$(mktemp --suffix=.png)"
	"$IM" -size "${w}x${h}" xc:none -pointsize "$pt" \
		-fill 'rgba(220,40,40,0.28)' -gravity center -annotate -30 "$text" \
		"$png" >/dev/null 2>&1 || { rm -f "$png"; return 1; }
	"$IM" "$png" -page "${w}x${h}" "$WM_TMP" >/dev/null 2>&1 || { rm -f "$png"; return 1; }
	rm -f "$png"
	[[ -s "$WM_TMP" ]]
}

# One stamp page per document page, each carrying its own number, so the
# overlay lands page-for-page rather than repeating a single stamp.
NUM_TMP=""
make_numbers() {
	local src="$1"
	local n w h; n="$(pdf_pages "$src")"; w="$(pdf_width "$src")"; h="$(pdf_height "$src")"
	[[ "$n" =~ ^[0-9]+$ && "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || return 1
	(( n > 0 )) || return 1
	local pt=$(( h / 45 )); (( pt < 9 )) && pt=9
	local tmpdir; tmpdir="$(mktemp -d)"
	local i
	for (( i = 1; i <= n; i++ )); do
		"$IM" -size "${w}x${h}" xc:none -pointsize "$pt" -fill 'rgba(0,0,0,0.75)' \
			-gravity south -annotate "+0+$(( h / 40 ))" "$i" \
			"$(printf '%s/p%05d.png' "$tmpdir" "$i")" >/dev/null 2>&1 || { rm -rf "$tmpdir"; return 1; }
	done
	NUM_TMP="$(mktemp --suffix=.pdf)"
	# Collected into an array by the shell's own glob, in sorted order --
	# the %05d in the filenames above is what makes that order numeric
	# rather than 1, 10, 11, 2.
	local -a stamps=("$tmpdir"/p*.png)
	"$IM" "${stamps[@]}" -page "${w}x${h}" "$NUM_TMP" >/dev/null 2>&1 \
		|| { rm -rf "$tmpdir"; return 1; }
	rm -rf "$tmpdir"
	[[ -s "$NUM_TMP" ]]
}

# Render each page, OCR it, and reassemble -- tesseract's own pdf output
# carries an invisible text layer over the image it was given.
ocr_pdf() {
	local src="$1" dst="$2"
	local tmpdir; tmpdir="$(mktemp -d)"
	pdftoppm -r 300 -png "$src" "$tmpdir/p" >/dev/null 2>&1 || { rm -rf "$tmpdir"; return 1; }
	local page parts=()
	for page in "$tmpdir"/p-*.png "$tmpdir"/p-*.PNG; do
		[[ -e "$page" ]] || continue
		tesseract "$page" "${page%.png}" pdf >/dev/null 2>&1 || continue
		[[ -s "${page%.png}.pdf" ]] && parts+=("${page%.png}.pdf")
	done
	if (( ${#parts[@]} == 0 )); then rm -rf "$tmpdir"; return 1; fi
	qpdf --empty --pages "${parts[@]}" -- "$dst" >/dev/null 2>&1 || { rm -rf "$tmpdir"; return 1; }
	rm -rf "$tmpdir"
	[[ -s "$dst" ]]
}

# Offer the result rather than just naming a path. Declining is the common
# case, so Esc and "No" both simply return.
offer_open() {
	local dir="$1" file="$2"
	command -v xdg-open >/dev/null 2>&1 || return 0
	local ans rc=0
	ans="$(printf 'No\nOpen file\nOpen folder\n' | menu "Done" "$(basename "$file")" -selected-row 0)" || rc=$?
	(( rc != 0 )) && return 0
	case "$ans" in
		"Open folder") setsid xdg-open "$dir"  >/dev/null 2>&1 & ;;
		"Open file")   setsid xdg-open "$file" >/dev/null 2>&1 & ;;
	esac
	return 0
}

# --- Browser ----------------------------------------------------------
#
# Returns 0 when files were chosen, 1 to go back to the roots menu, 2 to
# quit. SELECTED_FILES is the output.
navigate() {
	local current_dir="$1"
	local action="$2"
	local multi_select="$3"
	shift 3
	local ext_array=("$@")
	local label="${action#*  }"

	local -a navigation_stack=()
	local -a rofi_extra=()
	[[ "$multi_select" == "true" ]] && rofi_extra=(-multi-select)

	# Exact string membership. This was `grep -q "^${current_dir}$"`, which
	# treats the path as a regular expression -- a directory with a '+' or
	# '[' in its name either matched nothing or matched the wrong root, and
	# the "../" entry appeared or vanished accordingly.
	is_root() {
		local d="$1" r
		for r in "${MAIN_DIR_MAP[@]}"; do [[ "$r" == "$d" ]] && return 0; done
		return 1
	}

	while true; do
		local -a DIRS=() FILES=() ENTRIES=()

		while IFS= read -r -d '' d; do
			local dn; dn="$(basename "$d")"
			[[ "$dn" == .* ]] && continue
			DIRS+=("$dn/")
		done < <(find "$current_dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)

		while IFS= read -r -d '' f; do
			local fn; fn="$(basename "$f")"
			[[ "$fn" == .* ]] && continue
			# A file with no dot at all has no extension; "${fn##*.}" would
			# return the whole name and could match by accident.
			[[ "$fn" == *.* ]] || continue
			local fe="${fn##*.}" e
			for e in "${ext_array[@]}"; do
				if [[ "${fe,,}" == "$e" ]]; then FILES+=("$fn"); break; fi
			done
		done < <(find "$current_dir" -mindepth 1 -maxdepth 1 -type f -print0 2>/dev/null | sort -z)

		ENTRIES=("🏠 Main Menu")
		is_root "$current_dir" || ENTRIES=("../" "${ENTRIES[@]}")
		(( ${#DIRS[@]}  )) && ENTRIES+=("${DIRS[@]}")
		(( ${#FILES[@]} )) && ENTRIES+=("${FILES[@]}")

		local rel="${current_dir/#"$HOME"/\~}"
		local mesg
		if (( ${#FILES[@]} == 0 )); then
			mesg="nothing here it can use · wants: ${ext_array[*]}"
		elif [[ "$multi_select" == "true" ]]; then
			mesg="$(rofi_hint "Shift/Ctrl to pick several" "combined in list order" "Esc back")"
		else
			mesg="$(rofi_hint "↵ choose" "Esc back")"
		fi

		local choice rc=0
		choice="$(printf '%s\n' "${ENTRIES[@]}" | menu "$label $SEPARATOR $rel" "$mesg" "${rofi_extra[@]}")" || rc=$?

		(( rc > 1 )) && return 2

		if (( rc != 0 )) || [[ -z "$choice" ]]; then
			# Esc: up one level if we descended, otherwise back to the roots
			# menu. This is the behaviour that `set -e` made unreachable.
			if (( ${#navigation_stack[@]} == 0 )); then return 1; fi
			current_dir="${navigation_stack[-1]}"
			unset 'navigation_stack[-1]'
			continue
		fi

		case "$choice" in
		"🏠 Main Menu") return 1 ;;
		"../")
			if (( ${#navigation_stack[@]} )); then
				current_dir="${navigation_stack[-1]}"
				unset 'navigation_stack[-1]'
			else
				current_dir="$(dirname "$current_dir")"
			fi
			;;
		*/)
			navigation_stack+=("$current_dir")
			current_dir="$current_dir/${choice%/}"
			;;
		*)
			# `echo -e` here mangled any filename containing a backslash --
			# it interprets \t, \n and friends inside the name itself.
			local -a picked=()
			mapfile -t picked <<<"$choice"
			local item
			for item in "${picked[@]}"; do
				[[ -n "$item" ]] || continue
				[[ -f "$current_dir/$item" ]] || continue
				SELECTED_FILES+=("$current_dir/$item")
			done
			(( ${#SELECTED_FILES[@]} )) && return 0
			;;
		esac
	done
}

# --- Entry point ------------------------------------------------------
#
# An `if` rather than `[[ ... ]] && run`, because the && form leaves the
# file's exit status at 1 when the guard is false -- and this file turns on
# `set -e`, so sourcing it for a test killed the shell doing the sourcing.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	run "$@"
fi
