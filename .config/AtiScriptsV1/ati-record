#!/usr/bin/env bash

# Script name: dm-record
# Description: Menu script to record video, audio, webcam, gif.
# Dependencies: ffmpeg, pulseaudio, alsa, slop (for area selection), libnotify (for notify-send), rofi/dmenu(optional)

set -euo pipefail

# rofi_select — "win+p then r [record] opens rofi, i want it open the
# rofi like qml one". rofi_select already IS that switch (Wayland +
# ati-menu-select installed -> the same Menu.qml dmenu view the
# screenshot picker uses; anywhere else -> real rofi, unchanged). This
# script just never called it, reaching for its own literal `rofi -dmenu`
# below instead.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/ati-rofi-common.sh"

# Configuration
record_dir="${record_dir:-$HOME/Videos/Recordings}"
mkdir -p "$record_dir"

# Per-user state. The recording PID and the pending-GIF handoff were fixed
# paths in /tmp, which is shared: the first account to record owns them
# mode 644 and every other account's write fails with EACCES. For the PID
# file that is not cosmetic -- `stop` reads it to find the ffmpeg to
# signal, so a second account could start a recording it had no way to
# stop, and ffmpeg would keep writing until something filled up.
runtime_dir="${XDG_RUNTIME_DIR:-/tmp/rofi-$(id -u)}"
mkdir -p "$runtime_dir" 2>/dev/null || true
recording_pid_file="$runtime_dir/recordingpid"
recording_gif_file="$runtime_dir/recordinggif"

# Notification wrapper
notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "dm-record" "$1"
  fi
  echo "$1"
}

# Detect menu program
get_menu_command() {
  if command -v rofi >/dev/null 2>&1; then
    echo "rofi -dmenu -i -p"
  elif command -v dmenu >/dev/null 2>&1; then
    echo "dmenu -i -l 10 -p"
  else
    echo "text"
  fi
}
MENU="$(get_menu_command)"

# Stop recording
#
# ffmpeg writes the container trailer (the GIF terminator, the mp4 moov
# atom) only after it is asked to stop, and on a long recording that
# takes well over a second. The old code slept exactly one second and
# then SIGKILLed unconditionally, which truncated three of the eight
# files in ~/Videos/Recordings -- each one ending at a block-aligned size
# with no GIF trailer byte, i.e. killed mid-write.
#
# So: ask it to stop, then actually wait for it to go, and only reach for
# SIGKILL if it has clearly wedged -- saying so, rather than pretending
# the recording is fine.
STOP_GRACE_SECONDS=60

stop_recording() {
  if [[ ! -f "$recording_pid_file" ]]; then
    notify "No active recording found"
    return
  fi

  local recpid waited
  recpid="$(cat "$recording_pid_file")"
  kill -15 "$recpid" 2>/dev/null || true

  waited=0
  while kill -0 "$recpid" 2>/dev/null; do
    sleep 0.2
    waited=$((waited + 1))
    ((waited >= STOP_GRACE_SECONDS * 5)) && break
  done

  if kill -0 "$recpid" 2>/dev/null; then
    kill -9 "$recpid" 2>/dev/null || true
    notify "Recording force-stopped after ${STOP_GRACE_SECONDS}s — file may be incomplete"
  else
    notify "Recording stopped"
  fi
  rm -f "$recording_pid_file"

  # GIF captures land as h264 and are converted once the capture is
  # closed; see record_area_gif.
  convert_pending_gif
}

# Full-screen capture geometry.
#
# Was an inline `xdpyinfo | awk` substitution. xdpyinfo lives in
# xorg-xdpyinfo, which is not pulled in by anything else here, and when it
# is absent the substitution yields an empty string -- so ffmpeg was
# handed a bare `-s` followed by the next flag and died with a parse error
# that says nothing about a missing package. xrandr covers the machines
# that have it instead.
screen_geometry() {
  local geo=""
  if command -v xdpyinfo >/dev/null 2>&1; then
    geo="$(xdpyinfo 2>/dev/null | awk '/dimensions/ {print $2; exit}')"
  fi
  if [[ -z "$geo" ]] && command -v xrandr >/dev/null 2>&1; then
    geo="$(xrandr --current 2>/dev/null | awk '/ connected primary/{split($4,a,"+"); print a[1]; exit}')"
  fi
  [[ -n "$geo" ]] || return 1
  printf '%s\n' "$geo"
}

# Record full screen + audio
record_screen_audio() {
  local geo
  if ! geo="$(screen_geometry)"; then
    notify "Error: cannot read the screen size (install xorg-xdpyinfo or xorg-xrandr)"
    exit 1
  fi
  output="$record_dir/screen-audio-$(date '+%y%m%d-%H%M-%S').mp4"
  ffmpeg -nostdin -y -f x11grab -framerate 30 \
    -s "$geo" \
    -i "${DISPLAY:-:0}" \
    -f pulse -i default \
    -c:v libx264 -crf 23 -preset fast \
    -c:a aac "$output" </dev/null &
  echo $! >"$recording_pid_file"
  notify "Screen + Audio recording started → $output"
}

# Record full screen (video only)
record_screen() {
  local geo
  if ! geo="$(screen_geometry)"; then
    notify "Error: cannot read the screen size (install xorg-xdpyinfo or xorg-xrandr)"
    exit 1
  fi
  output="$record_dir/screen-only-$(date '+%y%m%d-%H%M-%S').mp4"
  ffmpeg -nostdin -y -f x11grab -framerate 30 \
    -s "$geo" \
    -i "${DISPLAY:-:0}" \
    -c:v libx264 -crf 23 -preset fast "$output" </dev/null &
  echo $! >"$recording_pid_file"
  notify "Screen recording started → $output"
}

# Record selected area (video only)
record_area() {
  if ! command -v slop >/dev/null 2>&1; then
    notify "Error: 'slop' required but not installed."
    exit 1
  fi

  notify "Click and drag to select area"
  if ! selection=$(slop -f "%x %y %w %h" --nokeyboard); then
    notify "Selection cancelled"
    exit 0
  fi
  read -r X Y W H <<<"$selection"

  if [[ -z "$X" || -z "$Y" || -z "$W" || -z "$H" || $W -lt 50 || $H -lt 50 ]]; then
    notify "Invalid selection"
    exit 1
  fi

  output="$record_dir/screen-area-$(date '+%y%m%d-%H%M-%S').mp4"
  ffmpeg -nostdin -y -f x11grab -framerate 30 \
    -video_size "${W}x${H}" -i "${DISPLAY:-:0}+${X},${Y}" \
    -c:v libx264 -crf 23 -preset fast "$output" </dev/null &
  echo $! >"$recording_pid_file"
  notify "Screen area recording started → $output"
}

# Record selected area as GIF
#
# Captured to h264 first and converted on stop, rather than written
# straight out as a GIF. Encoding GIF live means every frame carries the
# default palette with no cross-frame optimisation: the eight recordings
# already in ~/Videos/Recordings run to 1.1 GB, one of them 269 MB for 46
# seconds. Measured on a 6-second full-screen capture, direct GIF came to
# 29.6 MB; capture-then-convert with a real palette came to 1.3 MB, for
# two seconds of conversion. Same footage, 23x smaller.
#
# palettegen has to see the whole stream before it can emit a palette, so
# it cannot be part of the live pipeline -- doing it in one pass buffers
# the entire recording and stalls. Hence the two stages.
GIF_FPS=12
GIF_MAX_WIDTH=900

record_area_gif() {
  command -v slop >/dev/null || {
    notify "slop not installed"
    exit 1
  }

  notify "Select area for GIF"

  if ! selection=$(slop -f "%x %y %w %h" --nokeyboard); then
    notify "Selection cancelled"
    exit 0
  fi

  read -r X Y W H <<<"$selection"

  if ! [[ "$X" =~ ^[0-9]+$ && "$Y" =~ ^[0-9]+$ &&
    "$W" =~ ^[0-9]+$ && "$H" =~ ^[0-9]+$ ]] ||
    ((W <= 0 || H <= 0)); then
    notify "Invalid selection"
    exit 1
  fi

  output="$record_dir/screen-area-$(date '+%y%m%d-%H%M-%S').gif"
  # $$ kept it from colliding by name, but a screen capture has no business
  # sitting world-readable in /tmp for the length of the recording.
  local source="$runtime_dir/dm-record-gif-$$.mp4"

  ffmpeg -nostdin -y -f x11grab -framerate "$GIF_FPS" \
    -video_size "${W}x${H}" -i "${DISPLAY:-:0}+${X},${Y}" \
    -c:v libx264 -crf 18 -preset ultrafast "$source" </dev/null &

  echo $! >"$recording_pid_file"
  # Read back by stop_recording, which does the conversion.
  printf '%s\n%s\n' "$source" "$output" >"$recording_gif_file"
  notify "GIF recording started → press the key again to stop"
}

# Turn the captured h264 into a GIF with a palette built from the footage.
convert_pending_gif() {
  [[ -f "$recording_gif_file" ]] || return 0

  local source output
  { read -r source; read -r output; } <"$recording_gif_file"
  rm -f "$recording_gif_file"

  if [[ ! -s "$source" ]]; then
    notify "GIF capture produced nothing"
    rm -f "$source"
    return 0
  fi

  notify "Converting to GIF…"
  if ffmpeg -nostdin -y -hide_banner -loglevel error -i "$source" \
    -vf "fps=${GIF_FPS},scale=min(iw\,${GIF_MAX_WIDTH}):-2:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=3:diff_mode=rectangle" \
    "$output" </dev/null; then
    notify "GIF saved → $output ($(du -h "$output" | cut -f1))"
    rm -f "$source"
  else
    # Keep the h264 rather than lose the recording to a failed convert.
    notify "GIF conversion failed — capture kept at $source"
  fi
}

# Record audio only
record_audio() {
  output="$record_dir/audio-$(date '+%y%m%d-%H%M-%S').mp3"
  # Pulse, not ALSA: the rest of the script records through pulse, and
  # ALSA's `default` is the raw device -- it fails outright if anything
  # else already holds it.
  ffmpeg -nostdin -y -f pulse -i default \
    -c:a libmp3lame -qscale:a 2 "$output" </dev/null &
  echo $! >"$recording_pid_file"
  notify "Audio recording started → $output"
}

# The first /dev/video* node that can actually CAPTURE.
#
# /dev/video0 was hardcoded, and on a lot of machines it is not the camera:
# a single UVC webcam registers several nodes, and drivers that expose a
# metadata or statistics node claim video0 while the image stream sits on
# video1 or video2. ffmpeg then fails with "Not a video capture device" and
# the recording silently never starts. v4l2-ctl reports the capability
# when it is installed; without it, fall back to the first node that
# exists, which is the old behaviour and no worse.
webcam_device() {
  local dev
  for dev in /dev/video*; do
    [[ -c "$dev" ]] || continue
    if command -v v4l2-ctl >/dev/null 2>&1; then
      v4l2-ctl -d "$dev" --all 2>/dev/null | grep -q 'Video Capture' || continue
    fi
    printf '%s\n' "$dev"
    return 0
  done
  return 1
}

# Record webcam (low resolution)
record_webcam_low() {
  local cam
  if ! cam="$(webcam_device)"; then
    notify "Error: no capture-capable webcam found under /dev/video*"
    exit 1
  fi
  output="$record_dir/webcam-low-$(date '+%y%m%d-%H%M-%S').mp4"
  # -video_size is an INPUT option for the v4l2 demuxer, so it has to come
  # before -i. After -i, ffmpeg parses it as an output option and the
  # request is quietly dropped -- both webcam modes recorded at whatever
  # the camera's default happened to be, and the menu labels lied.
  ffmpeg -nostdin -y -f v4l2 -video_size 640x480 -i "$cam" \
    -c:v libx264 "$output" </dev/null &
  echo $! >"$recording_pid_file"
  notify "Webcam (low-res) recording started → $output"
}

# Record webcam (HD)
record_webcam_hd() {
  local cam
  if ! cam="$(webcam_device)"; then
    notify "Error: no capture-capable webcam found under /dev/video*"
    exit 1
  fi
  output="$record_dir/webcam-hd-$(date '+%y%m%d-%H%M-%S').mp4"
  ffmpeg -nostdin -y -f v4l2 -video_size 1920x1080 -i "$cam" \
    -c:v libx264 "$output" </dev/null &
  echo $! >"$recording_pid_file"
  notify "Webcam (HD) recording started → $output"
}

# Menu
askrecording() {
  if [ "$MENU" = "text" ]; then
    echo "Select recording mode:"
    echo "1) Screen + Audio (full display)"
    echo "2) Screen Only (full display)"
    echo "3) Screen Area (selection)"
    echo "4) Audio Only"
    echo "5) Webcam (low-res 640x480)"
    echo "6) Webcam (HD 1920x1080)"
    echo "7) GIF (screen area)"
    read -rp "Choice [1-7]: " choice
    case $choice in
    1) record_screen_audio ;;
    2) record_screen ;;
    3) record_area ;;
    4) record_audio ;;
    5) record_webcam_low ;;
    6) record_webcam_hd ;;
    7) record_area_gif ;;
    *)
      notify "Invalid choice"
      exit 1
      ;;
    esac
  else
    # rofi_select picks Menu.qml's dmenu view over real rofi on Wayland
    # (see the header note); ${MENU} itself is left as-is for the
    # dmenu/text branches just above, and as rofi_select's own X11/no-qml
    # fallback, which is real rofi either way -- unchanged behaviour there.
    # || true: rofi_select exits non-zero on Escape (the ordinary way to
    # back out), and under this script's own set -e that would otherwise
    # kill it right here instead of reaching the `*) notify "No selection
    # made"` case below that already exists to handle exactly that —
    # same trap rofi_translator had, see its own note on the same fix.
    choice=$(printf "Screen + Audio (full display)\\nScreen Only (full display)\\nScreen Area (selection)\\nAudio Only\\nWebcam (low-res 640x480)\\nWebcam (HD 1920x1080)\\nGIF (screen area)" | rofi_select "Select recording mode:") || true
    case "$choice" in
    "Screen + Audio (full display)") record_screen_audio ;;
    "Screen Only (full display)") record_screen ;;
    "Screen Area (selection)") record_area ;;
    "Audio Only") record_audio ;;
    "Webcam (low-res 640x480)") record_webcam_low ;;
    "Webcam (HD 1920x1080)") record_webcam_hd ;;
    "GIF (screen area)") record_area_gif ;;
    *)
      notify "No selection made"
      exit 0
      ;;
    esac
  fi
}

main() {
  if ! command -v ffmpeg >/dev/null 2>&1; then
    notify "Error: ffmpeg required but not installed."
    exit 1
  fi

  # If recording already active → stop immediately
  if [[ -f "$recording_pid_file" ]] && ps -p "$(cat "$recording_pid_file")" >/dev/null 2>&1; then
    stop_recording
  else
    askrecording
  fi
}

main "$@"
