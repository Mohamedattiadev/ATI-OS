#!/bin/bash

# ========= CONFIG =========
MIN_INTERVAL=300   # 5 minutes (seconds)
MAX_INTERVAL=600   # 10 minutes
NOTIFY_TIME=15000   # notification duration (ms)
TITLE="🌙 ذكر"
HISTORY_FILE="$HOME/.cache/last_dhikr"
# ==========================

# Make sure cache dir exists
mkdir -p "$HOME/.cache"

# Adhkar list
ADHKAR=(
# ===== Tasbeeh & Short Dhikr =====
"سبحان الله"
"الحمد لله"
"الله أكبر"
"لا إله إلا الله"
"لا حول ولا قوة إلا بالله"
"سبحان الله وبحمده"
"سبحان الله العظيم"
"سبحان الله والحمد لله ولا إله إلا الله والله أكبر"
"الحمد لله رب العالمين"
"لا إله إلا الله وحده لا شريك له، له الملك وله الحمد وهو على كل شيء قدير"

# ===== Istighfar =====
"أستغفر الله"
"أستغفر الله العظيم"
"أستغفر الله العظيم وأتوب إليه"
"رب اغفر لي"
"رب اغفر لي وتب علي إنك أنت التواب الرحيم"

# ===== Salawat =====
"اللهم صل وسلم على نبينا محمد ﷺ"
"اللهم صل على محمد وعلى آل محمد كما صليت على إبراهيم"
"اللهم صل وسلم وبارك على عبدك ورسولك محمد ﷺ"

# ===== Authentic Duas =====
"اللهم إنك عفو تحب العفو فاعف عني"
"اللهم إني أسألك العفو والعافية في الدنيا والآخرة"
"اللهم إني أعوذ بك من الهم والحزن"
"اللهم إني أعوذ بك من العجز والكسل"
"اللهم يا مقلب القلوب ثبت قلبي على دينك"
"اللهم أعني على ذكرك وشكرك وحسن عبادتك"
"اللهم لا سهل إلا ما جعلته سهلا وأنت تجعل الحزن إذا شئت سهلا"
"اللهم ارزقني حسن الخاتمة"
"حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم"
"لا إله إلا أنت سبحانك إني كنت من الظالمين"
"رضيت بالله ربًا وبالإسلام دينًا وبمحمد ﷺ نبيًا"

# ===== Protection Adhkar =====
"بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم"
"أعوذ بكلمات الله التامات من شر ما خلق"
"أعوذ بالله السميع العليم من الشيطان الرجيم"

# ===== FULL QURAN AYAT (NOT SPLIT) =====
"﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾"
"﴿ فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ ﴾"
"﴿ وَمَا تَوْفِيقِي إِلَّا بِاللَّهِ ۚ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ ﴾"
"﴿ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ ﴾"
"﴿ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ ﴾"
"﴿ رَبِّ زِدْنِي عِلْمًا ﴾"
"﴿ إِنَّ مَعَ الْعُسْرِ يُسْرًا ﴾"
"﴿ فَإِنَّ مَعَ الْعُسْرِ يُسْرًا ﴾"
"﴿ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَىٰ بِاللَّهِ وَكِيلًا ﴾"
"﴿ وَاللَّهُ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ ﴾"
"﴿ وَاللَّهُ أَعْلَمُ بِمَا فِي الصُّدُورِ ﴾"
"﴿ إِنَّ اللَّهَ لَطِيفٌ خَبِيرٌ ﴾"
"﴿ سَيَجْعَلُ اللَّهُ بَعْدَ عُسْرٍ يُسْرًا ﴾"
)


while true; do
  # Pick random dhikr (avoid repeating last one)
  while :; do
    DHIKR="${ADHKAR[RANDOM % ${#ADHKAR[@]}]}"
    LAST="$(cat "$HISTORY_FILE" 2>/dev/null)"
    [[ "$DHIKR" != "$LAST" ]] && break
  done

  echo "$DHIKR" > "$HISTORY_FILE"

  # Send notification
  notify-send \
    -u normal \
    -t "$NOTIFY_TIME" \
    "$TITLE" \
    "$DHIKR"

  # Random sleep between MIN and MAX
  SLEEP_TIME=$((RANDOM % (MAX_INTERVAL - MIN_INTERVAL + 1) + MIN_INTERVAL))
  sleep "$SLEEP_TIME"
done
