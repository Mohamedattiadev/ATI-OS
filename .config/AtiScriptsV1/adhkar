#!/bin/bash

# ========= CONFIG =========
MIN_INTERVAL=300   # 5 minutes (seconds)
MAX_INTERVAL=600   # 10 minutes
NOTIFY_TIME=15000   # notification duration (ms)
TITLE="🌙 ذكر"
HISTORY_FILE="$HOME/.cache/last_dhikr"
# ==========================

# Make sure cache dir exists
mkdir -p "$HOME/.cache"

# Adhkar list
ADHKAR=(
# ===== Tasbeeh & Short Dhikr =====
"سبحان الله"
"الحمد لله"
"الله أكبر"
"لا إله إلا الله"
"لا حول ولا قوة إلا بالله"
"سبحان الله وبحمده"
"سبحان الله العظيم"
"سبحان الله والحمد لله ولا إله إلا الله والله أكبر"
"الحمد لله رب العالمين"
"لا إله إلا الله وحده لا شريك له، له الملك وله الحمد وهو على كل شيء قدير"

# ===== Istighfar =====
"أستغفر الله"
"أستغفر الله العظيم"
"أستغفر الله العظيم وأتوب إليه"
"رب اغفر لي"
"رب اغفر لي وتب علي إنك أنت التواب الرحيم"

# ===== Salawat =====
"اللهم صل وسلم على نبينا محمد ﷺ"
"اللهم صل على محمد وعلى آل محمد كما صليت على إبراهيم"
"اللهم صل وسلم وبارك على عبدك ورسولك محمد ﷺ"

# ===== Authentic Duas =====
"اللهم إنك عفو تحب العفو فاعف عني"
"اللهم إني أسألك العفو والعافية في الدنيا والآخرة"
"اللهم إني أعوذ بك من الهم والحزن"
"اللهم إني أعوذ بك من العجز والكسل"
"اللهم يا مقلب القلوب ثبت قلبي على دينك"
"اللهم أعني على ذكرك وشكرك وحسن عبادتك"
"اللهم لا سهل إلا ما جعلته سهلا وأنت تجعل الحزن إذا شئت سهلا"
"اللهم ارزقني حسن الخاتمة"
"حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم"
"لا إله إلا أنت سبحانك إني كنت من الظالمين"
"رضيت بالله ربًا وبالإسلام دينًا وبمحمد ﷺ نبيًا"

# ===== Protection Adhkar =====
"بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم"
"أعوذ بكلمات الله التامات من شر ما خلق"
"أعوذ بالله السميع العليم من الشيطان الرجيم"

# ===== FULL QURAN AYAT (NOT SPLIT) =====
"﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾"
"﴿ فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ ﴾"
"﴿ وَمَا تَوْفِيقِي إِلَّا بِاللَّهِ ۚ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ ﴾"
"﴿ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ ﴾"
"﴿ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ ﴾"
"﴿ رَبِّ زِدْنِي عِلْمًا ﴾"
"﴿ إِنَّ مَعَ الْعُسْرِ يُسْرًا ﴾"
"﴿ فَإِنَّ مَعَ الْعُسْرِ يُسْرًا ﴾"
"﴿ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَىٰ بِاللَّهِ وَكِيلًا ﴾"
"﴿ وَاللَّهُ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ ﴾"
"﴿ وَاللَّهُ أَعْلَمُ بِمَا فِي الصُّدُورِ ﴾"
"﴿ إِنَّ اللَّهَ لَطِيفٌ خَبِيرٌ ﴾"
"﴿ سَيَجْعَلُ اللَّهُ بَعْدَ عُسْرٍ يُسْرًا ﴾"
)


# ---- SLEEP FIRST, NOTIFY SECOND ----
#
# Reported as part of "when i start the hyperland a lot of notifications
# appear, like 2-3 ones". This is one of them, on every single session.
#
# The loop below used to notify and THEN sleep, so the first dhikr went out
# the instant the process started. autostart.conf launches this at login
# (behind a 40 s delay), which put a remembrance card on screen while the bar
# was still coming up and the desktop was still filling in — the one moment
# it is certain not to be read.
#
# Moving the wait to the top costs nothing the loop was providing: the
# interval between cards is unchanged, and the only difference is that the
# FIRST one now arrives 5-10 minutes in, like every one after it, instead of
# arriving during the login burst. A reminder that fires while you are still
# logging in is the definition of a notification that trains you to dismiss
# without reading.
#
# Deliberately the same RANDOM draw and not a fixed delay: a constant first
# interval would make the first card land at a predictable moment after every
# login, which is the thing this script's randomised spacing exists to avoid.
sleep $((RANDOM % (MAX_INTERVAL - MIN_INTERVAL + 1) + MIN_INTERVAL))

while true; do
  # Pick random dhikr (avoid repeating last one)
  while :; do
    DHIKR="${ADHKAR[RANDOM % ${#ADHKAR[@]}]}"
    LAST="$(cat "$HISTORY_FILE" 2>/dev/null)"
    [[ "$DHIKR" != "$LAST" ]] && break
  done

  echo "$DHIKR" > "$HISTORY_FILE"

  # Send notification.
  #
  # ONE ARGUMENT, NOT TWO. Requested: "the notification of adhkar, no need
  # to show ذكر". $TITLE was passed as the summary and the dhikr as the
  # body, so every card read "🌙 ذكر" above the actual remembrance — a
  # label repeating what the Arabic already says, on a surface where the
  # dhikr is the whole content.
  #
  # notify-send takes the summary as its only required argument, so
  # dropping the body and promoting the dhikr into the summary slot is
  # what removes the heading rather than blanking it. Passing an empty
  # summary instead would leave the island drawing an empty first line and
  # the history card an empty bold row.
  #
  # $TITLE is kept defined above and unused on purpose: it is what the
  # desktop-entry name and any future --app-name would be built from, and
  # deleting it would lose the one place the script says what it is.
  notify-send \
    -u normal \
    -t "$NOTIFY_TIME" \
    "$DHIKR"

  # Random sleep between MIN and MAX
  SLEEP_TIME=$((RANDOM % (MAX_INTERVAL - MIN_INTERVAL + 1) + MIN_INTERVAL))
  sleep "$SLEEP_TIME"
done
