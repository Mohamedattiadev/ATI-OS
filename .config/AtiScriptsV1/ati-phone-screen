#!/usr/bin/env bash
# Put the Android phone's screen on this desktop, with no cable and no
# typed addresses. One keybinding, one window.
#
# The manual route is four steps of copying numbers off the phone: read
# the pairing host:port, `adb pair`, read a DIFFERENT host:port off the
# main Wireless debugging screen, `adb connect`. Both ports are random
# and the connect port changes on every phone reboot, so it is not
# something you do once -- it is something you do every time.
#
# None of that is necessary, because the phone ANNOUNCES both services
# over mDNS the moment Wireless debugging is on:
#   _adb-tls-pairing._tcp   while the pairing dialog is open
#   _adb-tls-connect._tcp   whenever wireless debugging is listening
# Upstream adb resolves these itself. Arch's android-tools does NOT --
# it is built without the Bonjour/mDNS backend, so `adb mdns services`
# answers "unknown host service 'mdns:services'" and every guide that
# says "adb will just find it" is wrong on this machine. avahi-browse
# reads the same announcements, so this script does the lookup adb
# cannot and hands adb a plain host:port.
#
# That makes the steady state: turn Wireless debugging on once (it
# survives reboots), then press the key. Pairing is asked for only when
# the phone has never been paired with this laptop.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=rofi_common.sh
source "$SCRIPT_DIR/rofi_common.sh"

require_cmd scrcpy adb avahi-browse || exit 1

TAG="-h string:x-dunst-stack-tag:phone-screen"
ICON="phone-symbolic"
_note() { # title, body
    # shellcheck disable=SC2086  # $TAG is deliberately word-split
    notify_safe -a "Phone" $TAG -i "$ICON" "$1" "${2:-}"
}

# scrcpy's shortcut modifier defaults to "left Alt OR left Super".
# Super is qtile's mod (config.py: mod = "mod4"), and qtile's grabs are
# global -- they fire before the focused window ever sees the key, so
# with the default, MOD+f tiles the scrcpy window instead of
# fullscreening the phone. Pinned to Alt, which .Xmodmap puts on Caps.
SCRCPY_ARGS=(--shortcut-mod=lalt --window-title=Phone)

# ─── the wifi profile, and why wifi is the slow one ──────────────────
# Measured on this link: ping to the phone averaged 53ms, peaked at 78ms,
# with 16ms of jitter. That is the lag. No encoder setting can undo a
# 53ms round trip -- it is already worse than two frames at 30fps before
# anything is encoded, sent or decoded. USB is not a marginal upgrade
# here, it is the fix, which is why _mirror prefers it and raises the
# quality ceiling when it gets it.
#
# Given that link, these settings spend the little headroom there is on
# latency rather than on detail:
#
#   -m 720        The phone is 1080x2400 and the window it lands in is
#                 ~300px wide on a 1366x768 panel. Full resolution is
#                 encoded, pushed over that link and decoded only to be
#                 thrown away by the scaler. Fewer pixels also means
#                 fewer packets, which is what jitter actually punishes.
#   --max-fps=30  scrcpy decodes in SOFTWARE (no hwaccel option exists in
#                 scrcpy 4.1), and this is a Skylake i7-6600U.
#   -b 3M         The 8Mbps default is far more than this link carries
#                 cleanly; overshooting it buys retransmits, not detail.
#
# Sound comes out of the LAPTOP, not the phone. --audio-source=output
# forwards the whole device output and mutes playback on the handset, so
# a video watched in the mirror plays through these speakers -- which is
# the point of watching it here. It is a second, separately buffered
# stream and does cost some latency; --audio-buffer=50 (default 50) is
# the knob if the sound crackles, and --no-audio is the way back to the
# lowest-latency picture.
SCRCPY_ARGS+=(-m 720 --max-fps=30 -b 3M --audio-source=output)

# If the picture stutters rather than lagging, --video-buffer=50 trades
# 50ms of delay for absorbing that 16ms of jitter. Deliberately not the
# default: it makes the pointer feel worse, which is the usual complaint.

# Seconds to wait for the pairing dialog after telling you to open it.
# Long enough to unlock the phone and find the menu; short enough that a
# forgotten prompt does not leave a script browsing mDNS forever.
PAIR_WAIT="${PAIR_WAIT:-60}"

# Named in the notifications, so the "try again" advice points at the key
# that actually runs this rather than at a command nobody typed.
KEYHINT="Super+Shift+F6"

# ─── mDNS discovery ──────────────────────────────────────────────────
# avahi-browse -rpt: -r resolve, -p parseable, -t exit once the cache is
# drained. Resolved records are the lines starting with '=', semicolon
# separated:
#   =;iface;proto;name;type;domain;host;ADDRESS;PORT;txt
# IPv4 only: adb parses host:port by splitting on the last colon, so a
# bare IPv6 literal is read as a host with a garbage port. Filtering
# here is cheaper than bracket-quoting for an address family the phone
# always publishes alongside v4 anyway.
#
# An optional second argument restricts the match to one service
# instance name, which the QR flow needs: the name in the QR is the only
# thing tying an announcement to the password we generated for it.
_discover() {
    local service="$1" want="${2:-}"
    timeout 5 avahi-browse -rpt "$service" 2>/dev/null \
        | awk -F';' -v want="$want" \
            '$1 == "=" && $3 == "IPv4" && (want == "" || $4 == want) { print $8 ":" $9; exit }'
}

# ─── which phone, over which transport ───────────────────────────────
# Only the "device" state counts. "unauthorized" means the RSA prompt is
# unanswered and every scrcpy call would fail; "offline" is a stale entry
# for a port the phone no longer listens on. Both used to sail through a
# naive `adb devices | grep -q` and leave scrcpy to fail with a stack
# trace instead of a sentence.
_devices() {
    adb devices 2>/dev/null | awk 'NR > 1 && NF == 2 { print $1, $2 }'
}

# A wireless serial is literally "ip:port"; a USB serial never is. That
# distinction is the whole transport test -- adb offers nothing better.
_is_tcp() { [[ "$1" == *:* ]]; }

# Pick ONE device, preferring USB.
#
# Two reasons this must choose rather than let scrcpy sort it out. First,
# scrcpy aborts outright when adb lists more than one device, which is
# exactly what happens the moment you plug in a phone that is already
# paired over wifi -- the cable made it stop working. Second, USB is the
# lower-latency path by a wide margin, so when both exist it is simply
# the better one.
_pick_device() {
    local serial state usb="" tcp=""
    while read -r serial state; do
        [[ "$state" == "device" ]] || continue
        if _is_tcp "$serial"; then tcp="${tcp:-$serial}"; else usb="${usb:-$serial}"; fi
    done < <(_devices)
    printf '%s' "${usb:-$tcp}"
}

# States other than "device" that are worth reporting rather than
# silently treating as "no phone".
_has_state() {
    local want="$1" serial state
    while read -r serial state; do
        [[ "$state" == "$want" ]] && return 0
    done < <(_devices)
    return 1
}

# Drop dead wireless entries. A phone that rebooted, or moved network,
# leaves an "offline" serial behind forever -- and an offline entry still
# counts toward scrcpy's "more than one device" abort, so a stale record
# from last week can block a perfectly good cable today.
_prune_offline() {
    local serial state
    while read -r serial state; do
        [[ "$state" == "device" ]] && continue
        _is_tcp "$serial" && adb disconnect "$serial" >/dev/null 2>&1
    done < <(_devices)
}

# Wait for a usable device, because "connected" is not "ready": adb
# reports a successful TCP connect while the device is still offline for
# a beat, and a freshly plugged cable takes a moment to enumerate. The
# original code tested once, immediately, and on a false answer fell all
# the way through to the pairing dialog -- asking you to pair a phone
# that was already paired and about to come up.
_wait_device() {
    local deadline=$(( SECONDS + ${1:-8} )) serial
    while (( SECONDS < deadline )); do
        serial="$(_pick_device)"
        [[ -n "$serial" ]] && { printf '%s' "$serial"; return 0; }
        sleep 1
    done
    return 1
}

# ─── park it down the right-hand edge ────────────────────────────────
# A phone is ~9:20. Left to itself the window opens centred, over
# whatever you were reading, in a shape that fits nothing -- so it gets
# pinned to the right edge as a side panel, full usable height, which is
# the only place a portrait window costs no horizontal room worth having.
#
# Sized from the LIVE phone and screen, not from constants: the aspect
# differs per handset, and these dotfiles run on panels from 1366x768 up
# (see ui-scale). qtile's own screen/bar objects are the authority on
# what "usable" means here -- reading the bar's real height is what keeps
# the window clear of it whether the bar is on top or bottom today.

# Prints "width height top_offset bottom_bar" for the current screen.
# Shared by the initial placement and the bounds watcher so the two can
# never disagree about where the usable area ends.
_screen_box() {
    local sw sh bar_top bar_bottom info
    info="$(qtile cmd-obj -o screen -f info 2>/dev/null)"
    sw="$(sed -n 's/.*"width": \([0-9]*\).*/\1/p' <<< "$info" | head -1)"
    sh="$(sed -n 's/.*"height": \([0-9]*\).*/\1/p' <<< "$info" | head -1)"
    [[ "$sw" =~ ^[0-9]+$ && "$sh" =~ ^[0-9]+$ ]] || return 1

    # fullsize, NOT size. Mod+Shift+Z swaps which bar is showing, but BOTH
    # objects keep existing afterwards and both keep reporting their
    # configured "size" -- so reading that subtracted 40px for a bottom bar
    # that was not on screen, and pushed the window up past the real edge.
    # fullsize is 0 for a hidden bar, which is exactly the answer wanted.
    bar_top="$(qtile cmd-obj -o bar top -f info 2>/dev/null | sed -n 's/.*"fullsize": \([0-9]*\).*/\1/p' | head -1)"
    bar_bottom="$(qtile cmd-obj -o bar bottom -f info 2>/dev/null | sed -n 's/.*"fullsize": \([0-9]*\).*/\1/p' | head -1)"
    [[ "$bar_top" =~ ^[0-9]+$ ]] || bar_top=0
    [[ "$bar_bottom" =~ ^[0-9]+$ ]] || bar_bottom=0

    # The trailing newline is load bearing. Without it `read` still fills
    # the variables but returns non-zero at EOF, so every caller written
    # as `read ... || return` bailed out on a perfectly good answer --
    # which silently switched off both the placement and the watcher.
    printf '%d %d %d %d\n' "$sw" "$(( sh - bar_bottom ))" "$(( bar_top + 8 ))" "$bar_bottom"
}

_place_args() {
    local serial="$1" sw sh bar_top bar_bottom pw ph win_w win_h margin=8 _top

    read -r sw sh _top bar_bottom < <(_screen_box) || return 0
    [[ "$sw" =~ ^[0-9]+$ ]] || return 0
    bar_top=$(( _top - 8 ))
    sh=$(( sh + bar_bottom ))

    # `wm size` reports "Physical size: 1080x2400", and an override line
    # too if one is set -- take the last, which is what is actually shown.
    # CURRENT dimensions, which means rotation-aware. `wm size` reports
    # the physical panel and never changes, so sizing from it put a
    # portrait box on screen while scrcpy -- which follows the live
    # rotation -- opened a landscape window from the same left edge and
    # hung ~370px off the right of the screen, controls included.
    #
    # dumpsys' cur=WxH does track rotation. It is the less stable of the
    # two interfaces though, so `wm size` stays as the fallback: a
    # portrait guess still beats emitting no geometry at all.
    read -r pw ph < <(adb -s "$serial" shell dumpsys window displays 2>/dev/null \
        | sed -n 's/.*cur=\([0-9]*\)x\([0-9]*\).*/\1 \2/p' | head -1)
    if [[ ! "$pw" =~ ^[0-9]+$ ]]; then
        read -r pw ph < <(adb -s "$serial" shell wm size 2>/dev/null \
            | sed -n 's/.*: \([0-9]*\)x\([0-9]*\).*/\1 \2/p' | tail -1)
    fi
    [[ "$pw" =~ ^[0-9]+$ && "$ph" =~ ^[0-9]+$ ]] || return 0

    # Fit inside the usable area on BOTH axes. Height alone is the right
    # constraint for a portrait phone, but a landscape one derived from
    # height is wider than the screen -- which is exactly how the window
    # ended up hanging off the right edge. Cap the width too, and take
    # the height back down to match so the aspect ratio survives.
    #
    # PHONE_SIZE is the share of the usable HEIGHT a portrait phone gets,
    # as a percentage. Portrait is the case with no slack: a ~9:20 handset
    # at full height is only ~325px wide on a 1366x768 panel, and it
    # cannot be made wider without being taller than the screen. So this
    # is genuinely the ceiling, not a preference -- 100 is as big as
    # portrait goes here, and a bigger picture needs a bigger monitor.
    #
    # Landscape is the opposite: sized from height it works out ~1350px
    # wide, the whole panel, burying everything behind it the moment a
    # video goes fullscreen. Hence the separate width cap, which portrait
    # never reaches.
    local avail_w avail_h pct="${PHONE_SIZE:-92}"
    (( pct < 40 )) && pct=40
    (( pct > 100 )) && pct=100

    avail_h=$(( (sh - bar_top - bar_bottom - 2 * margin) * pct / 100 ))
    avail_w=$(( sw * 60 / 100 ))

    win_h=$avail_h
    win_w=$(( win_h * pw / ph ))
    if (( win_w > avail_w )); then
        win_w=$avail_w
        win_h=$(( win_w * ph / pw ))
    fi
    (( win_w < 200 )) && win_w=200
    (( win_h < 200 )) && win_h=200

    printf -- '--window-x=%d --window-y=%d --window-width=%d --window-height=%d' \
        $(( sw - win_w - margin )) $(( bar_top + margin )) "$win_w" "$win_h"
}

# ─── keep it on screen when the phone rotates mid-session ────────────
# scrcpy resizes its OWN window whenever the device resolution changes --
# opening a video fullscreen flips a ~9:20 portrait window to ~20:9 --
# and it keeps the top-left corner fixed while doing it. Anchored to the
# right edge, growing wider from that same left edge walks the window
# straight off the screen, controls included.
#
# This has to be a poll, and that is not laziness. qtile's float_change
# hook was the obvious home for it and was tried first; probing it
# directly showed it fires zero times for a floating window resized from
# outside qtile, because it tracks floating STATE rather than geometry.
# X offers no "window resized itself" signal a shell can wait on, so
# sampling the geometry is what is left. One xdotool call a second
# against one window id, for as long as the mirror is open.
_watch_bounds() {
    local wid="" sw sh top margin=8 tries=0
    command -v xdotool >/dev/null || return 0

    # The window does not exist yet -- scrcpy is exec'd after this starts.
    while (( tries < 40 )); do
        wid="$(xdotool search --class '^scrcpy$' 2>/dev/null | tail -1)"
        [[ -n "$wid" ]] && break
        sleep 0.5
        tries=$(( tries + 1 ))
    done
    [[ -n "$wid" ]] || return 0

    local _bb
    read -r sw sh top _bb < <(_screen_box) || return 0
    [[ "$sw" =~ ^[0-9]+$ ]] || return 0

    local X Y WIDTH HEIGHT nx ny
    while :; do
        # Life is tied to the PROCESS, not the window id. X recycles ids,
        # and a geometry lookup on a closed window happily answers for
        # whatever inherited the number -- measured: the id kept returning
        # a valid rectangle after its owner was killed, so a watcher keyed
        # on that ran forever, nudging some other application's window.
        # pgrep -x matches the process name exactly, so unlike pgrep -f it
        # cannot be fooled by a shell that merely mentions "scrcpy".
        pgrep -x scrcpy >/dev/null 2>&1 || break

        # --shell prints X=/Y=/WIDTH=/HEIGHT= assignments; all numeric.
        local geom
        geom="$(xdotool getwindowgeometry --shell "$wid" 2>/dev/null)" || break
        [[ -n "$geom" ]] || break
        eval "$geom"

        nx=$X; ny=$Y
        (( X + WIDTH > sw - margin )) && nx=$(( sw - WIDTH - margin ))
        (( nx < margin )) && nx=$margin
        (( Y + HEIGHT > sh - margin )) && ny=$(( sh - HEIGHT - margin ))
        (( ny < top )) && ny=$top

        if (( nx != X || ny != Y )); then
            xdotool windowmove "$wid" "$nx" "$ny" 2>/dev/null
        fi
        sleep 1
    done
}

_mirror() {
    local serial="$1" place extra=()
    # -s pins the transport. Without it scrcpy aborts the moment a second
    # entry exists in `adb devices`, which is the normal state whenever a
    # cable is plugged into a phone that is also paired over wifi.
    if _is_tcp "$serial"; then
        _note "📱 Connecting…" "wireless — plug in USB for a smoother picture"
    else
        _note "📱 Connecting…" "USB"
        # Over a cable the bandwidth ceiling is gone, so the wifi-shaped
        # limits are pure quality loss. Raise them back up.
        extra=(-m 1280 --max-fps=60 -b 12M)
    fi
    # Word-split on purpose: _place_args emits four flags, or nothing at
    # all when the geometry cannot be read (no qtile, no phone size), in
    # which case scrcpy falls back to its own placement.
    read -r -a place <<< "$(_place_args "$serial")"

    # Started BEFORE the exec, deliberately. exec replaces this shell with
    # scrcpy, so anything launched afterwards would never run; forked now,
    # the watcher is simply reparented and outlives the swap. It ends by
    # itself when xdotool can no longer find the window.
    _watch_bounds &
    disown 2>/dev/null || true

    # -S: the phone's own panel stays dark. -w: but it does not sleep,
    # which it otherwise would mid-session, freezing the mirror.
    exec scrcpy -s "$serial" "${SCRCPY_ARGS[@]}" "${extra[@]}" "${place[@]}" -S -w
}

# ─── 0. already mirroring? then just show it ─────────────────────────
# Nothing used to check, so a second press started a SECOND scrcpy
# against the same phone: two windows, two decoders, two audio streams,
# both fighting over the same wifi budget -- which is the other half of
# why the picture was poor. The key is now a toggle-to-front rather than
# a spawn, matching how Mod+n / Mod+b treat their sessions.
#
# Tested against the WINDOW, not the process list. `pgrep -f` reads whole
# command lines, so any shell that merely mentions the pattern matches it
# -- while writing this, it matched the very terminal running the test.
# A window titled "Phone" whose class is scrcpy is the thing that
# actually exists on screen, and it cannot false-positive.
#
# Class as well as title, so a window someone happened to name "Phone"
# does not silently swallow the keypress.
if command -v xdotool >/dev/null; then
    existing=""
    while read -r wid; do
        [[ -n "$wid" ]] || continue
        [[ "$(xdotool getwindowname "$wid" 2>/dev/null)" == "Phone" ]] || continue
        existing="$wid"
    done < <(xdotool search --class '^scrcpy$' 2>/dev/null)

    if [[ -n "$existing" ]]; then
        xdotool windowactivate "$existing" 2>/dev/null
        exit 0
    fi
fi

# ─── 0b. tidy up before looking ──────────────────────────────────────
# Starting the server explicitly keeps its "* daemon started *" chatter
# out of the first `adb devices`, whose output this script parses.
adb start-server >/dev/null 2>&1
_prune_offline

# ─── 1. already usable (USB, or a live wireless session) ─────────────
serial="$(_pick_device)"
[[ -n "$serial" ]] && _mirror "$serial"

# An unanswered RSA prompt looks identical to "no phone" from here, and
# no amount of reconnecting or re-pairing will clear it -- only a tap on
# the phone will. Say so instead of opening a pairing dialog that cannot
# help.
if _has_state unauthorized; then
    _note "🔒 Waiting for you to allow this computer" \
          "Tap Allow on the phone (tick 'always allow')"
    serial="$(_wait_device 30)" && _mirror "$serial"
    _note "🔒 Still not allowed" "the USB debugging prompt was not accepted"
    exit 1
fi

# ─── 2. wireless debugging is listening: just connect ────────────────
target="$(_discover _adb-tls-connect._tcp)"
if [[ -n "$target" ]]; then
    if adb connect "$target" 2>&1 | grep -qi "connected to"; then
        # "connected" is not "ready" -- see _wait_device.
        serial="$(_wait_device 10)" && _mirror "$serial"
    fi
    # Reachable and announcing, but the handshake was refused: this
    # laptop's key is not in the phone's paired list (phone reset, or
    # "Forget this device"). Fall through to pairing rather than
    # reporting a network problem that isn't one.
    _prune_offline
fi

# ─── 3. pair ─────────────────────────────────────────────────────────
# Reaching here means the phone is on the network but not paired with
# this laptop -- which is NOT the same as "no phone found", and saying so
# once sent me to re-enable a setting that was already on.
#
# One dialog serves BOTH pairing methods, unconditionally. An earlier
# version showed the QR only when no pairing dialog happened to be open
# on the phone, and fell back to a bare rofi prompt otherwise -- so which
# UI you got depended on the phone's current screen, and the QR route
# silently disappeared exactly when the phone was already sitting on the
# pairing screen.
#
# Pair by QR instead of by typed code. Same handshake, but nothing has to
# be read off one screen and typed into the other.
#
# The QR does NOT contain an address. It carries a service name and a
# password, in the WIFI: form Android's scanner already understands:
#     WIFI:T:ADB;S:<service name>;P:<password>;;
# Scanning it makes the PHONE start announcing _adb-tls-pairing._tcp
# under that exact service name, and adb -- still the client, exactly as
# in the typed-code flow -- then finds it over mDNS and pairs using the
# password in place of the six digits. So the roles never actually
# reverse, which is why this needs no listener on our side.
pair_target="$(_discover _adb-tls-pairing._tcp)"

if [[ -n "$target" || -n "$pair_target" ]]; then
    require_cmd qrencode rofi || exit 1

    # The name is what ties the announcement we are about to watch for to
    # the QR we are about to draw; the password is a one-shot token that
    # dies with the pairing. Both come from /dev/urandom via tr, so
    # neither depends on $RANDOM's 15 bits.
    qr_name="atidots-$(tr -dc 'a-z0-9' </dev/urandom | head -c6)"
    qr_pass="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c12)"

    qr_png="$(mktemp --suffix=.png)"
    qr_viewer=""
    # The password sits in this file's pixels, so it must not outlive the
    # pairing -- including on the paths that exit early or get Ctrl-C'd.
    # shellcheck disable=SC2064  # expand $qr_png now, not at trap time
    trap "rm -f '$qr_png'; [[ -n \"\$qr_viewer\" ]] && kill \$qr_viewer 2>/dev/null" EXIT

    # -m 2: without a quiet zone a phone camera cannot find the symbol at
    # all. -s 8: ~260px of actual symbol, which is plenty for a phone
    # camera held at arm's length and does not need scaling up.
    qrencode -s 8 -m 2 -o "$qr_png" "WIFI:T:ADB;S:${qr_name};P:${qr_pass};;"

    # ONE window for both routes.
    #
    # The two pairing methods are not alternatives you should have to
    # choose between up front: cameras fail on glossy panels, at odd
    # angles, and in bad light, and finding that out should not mean
    # closing a QR and starting over in a different mode. So the dialog
    # shows the QR *and* an entry for the six digits, and whichever
    # completes first wins.
    #
    # rofi, so it matches every other prompt on this desktop rather than
    # arriving as a stock GTK dialog in colours nothing else uses.
    #
    # The QR is the MESSAGE BOX'S BACKGROUND, not a list icon. As an icon
    # it looked right but broke the moment you touched the keyboard: the
    # icon belongs to a listview row, typing filters the list, the row
    # stops matching, and the code you were about to fall back on vanishes
    # -- precisely when you need it. The message box is not filtered, so
    # it survives every keystroke. It also drops the 1px stroke, which was
    # element.selected.normal's border in base.rasi and not a QR feature
    # at all.
    #
    # Vertical padding is what gives the box its height (rofi ignores a
    # `height` on a widget with no content), and url(...,height) then
    # scales the symbol to fill it. stdin is deliberately EMPTY: there is
    # no row to select, and none is wanted.
    #
    # The window width is tied to that height on purpose. A background
    # image TILES: scaled to the box height, the symbol comes out roughly
    # 280px wide, so at 330px the repeat falls outside the rounded corner
    # and is never seen. Widening the window to 360 exposed a sliver of
    # the second copy down the right-hand edge. Change the padding and
    # this width has to move with it.
    #
    # -format f is what makes the entry usable: it returns the TYPED text
    # rather than a selected row, so the digits come back even with no
    # rows at all. (Verified: plain Enter returns the text -- no
    # -kb-accept-custom rebinding needed.)
    #
    # The hint lives in the placeholder because this rofi build ignores
    # both `str:` and `content:` on a custom textbox widget -- a hint
    # widget renders as an empty bar.
    qr_out="$(mktemp)"
    # shellcheck disable=SC2064  # expand the paths now, not at trap time
    trap "rm -f '$qr_png' '$qr_out'; [[ -n \"\$qr_viewer\" ]] && kill \$qr_viewer 2>/dev/null" EXIT

    printf '' \
        | rofi -dmenu -i -format f \
            -p "Pair" \
            -mesg " " \
            -theme "$HOME/.config/rofi/themes/base.rasi" \
            -theme-str "window { width: 330px; }
                        inputbar { children: [ prompt, entry ]; }
                        entry { placeholder: \"6-digit code\"; }
                        mainbox { children: [ inputbar, message ]; }
                        message { padding: 140px 0px; border: 0;
                                  background-image: url(\"$qr_png\", height); }
                        textbox { background-color: transparent; }" \
            >"$qr_out" 2>/dev/null &
    qr_viewer=$!

    _note "📷 Scan the QR" \
          "or type the 6-digit code in the same window"

    # Race the two routes. Neither can block: a blocking `wait` on rofi
    # would ignore a successful scan until the dialog was dismissed, and
    # a blocking mDNS loop would ignore a typed code. So poll both.
    #
    # Matching OUR service name on the QR route is what makes this safe
    # with more than one phone on the network -- a bare "any pairing
    # service" match could hand our password to whichever device
    # happened to be pairing at that moment.
    code=""
    # A wall-clock deadline, not an iteration count: each pass spends a
    # couple of seconds inside avahi-browse, so `seq $PAIR_WAIT` made the
    # advertised 60-second wait last nearer three minutes.
    deadline=$(( SECONDS + PAIR_WAIT ))
    while (( SECONDS < deadline )); do
        pair_target="$(_discover _adb-tls-pairing._tcp "$qr_name")"
        if [[ -n "$pair_target" ]]; then
            code="$qr_pass"          # scanned: the QR's password IS the code
            break
        fi

        if ! kill -0 "$qr_viewer" 2>/dev/null; then
            # Dialog closed. Cancel and the empty-field case both leave
            # nothing usable, and both mean "stop", not "keep waiting".
            wait "$qr_viewer" 2>/dev/null
            code="$(tr -cd '0-9' <"$qr_out")"
            [[ -z "$code" ]] && exit 0

            # Six digits, always. That is not a guess about this handset:
            # AOSP generates the wireless-debugging code as a 6-digit
            # value, so it is the same on every Android 11+ device and
            # every vendor skin -- Xiaomi, Samsung, Pixel alike. Only the
            # QR route uses a longer secret, and that one never comes
            # through this field.
            #
            # Checked here rather than restricted at the keyboard: rofi's
            # entry has no input mask, and validating after the fact also
            # absorbs a pasted "123 456" or a stray letter, which the
            # tr above has already stripped.
            if (( ${#code} != 6 )); then
                _note "❌ That is not a 6-digit code" \
                      "Android pairing codes are always 6 digits — got ${#code}"
                exit 1
            fi
            # Typed code: the phone announces under ITS own name, not
            # ours, so this lookup must not filter by qr_name.
            pair_target="$(_discover _adb-tls-pairing._tcp)"
            [[ -z "$pair_target" ]] && {
                _note "❌ No pairing dialog open" \
                      "the code screen must still be showing on the phone"
                exit 1
            }
            break
        fi
        sleep 1
    done

    # Drop the dialog and the image now, not in the EXIT trap: the success
    # path ends in `exec scrcpy`, and exec replaces this process without
    # ever running the trap -- which would leave the password sitting in a
    # world-readable PNG for as long as the machine stays up.
    kill "$qr_viewer" 2>/dev/null; qr_viewer=""
    rm -f "$qr_png" "$qr_out"

    if [[ -z "$pair_target" ]]; then
        _note "⌛ Timed out" "press ${KEYHINT} again for a fresh code"
        exit 1
    fi
fi

if [[ -n "$pair_target" ]]; then
    # $code was set by whichever route won the race above: the QR's
    # password, or the digits typed into the same dialog.
    #
    # The code goes on argv either way -- `adb pair host:port code` and
    # the interactive prompt end up in the same place -- but it is a
    # one-shot token that dies with the dialog, so this is not a secret
    # worth contorting the call for.
    if adb pair "$pair_target" "$code" 2>&1 | grep -qi "successfully paired"; then
        # The pairing port dies with the dialog; the connect port is a
        # different one, announced separately. Re-browse rather than
        # reusing pair_target -- reusing it is the single most common
        # way the manual version fails.
        _note "✅ Paired" "finding the phone…"
        connect_deadline=$(( SECONDS + 25 ))
        while (( SECONDS < connect_deadline )); do
            target="$(_discover _adb-tls-connect._tcp)"
            [[ -n "$target" ]] && adb connect "$target" >/dev/null 2>&1
            serial="$(_pick_device)"
            [[ -n "$serial" ]] && _mirror "$serial"
            sleep 1
        done
        _note "⚠️ Paired, but not connected" "close the pairing dialog and press ${KEYHINT} again"
        exit 1
    fi
    _note "❌ Pairing failed" "wrong code, or the dialog timed out"
    exit 1
fi

# ─── 4. nothing announced ────────────────────────────────────────────
# Distinguish "the phone is not offering it" from "this laptop cannot
# hear mDNS at all", because the fix is completely different and the
# symptom is identical.
if ! systemctl is-active --quiet avahi-daemon; then
    _note "❌ avahi-daemon is not running" "sudo systemctl enable --now avahi-daemon"
    exit 1
fi

_note "📴 No phone found" \
      "Phone: Settings → Developer options → Wireless debugging → ON
Same Wi-Fi as this laptop, then press the key again."
exit 1
