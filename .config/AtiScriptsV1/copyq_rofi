#!/usr/bin/env bash
# Rofi-based CopyQ picker with vim (ctrl+j/k) nav + image thumbnails.

set -euo pipefail

MAX=${1:-15}
TAB='&clipboard'
THUMBS=/tmp/copyq-thumbs
mkdir -p "$THUMBS"
rm -f "$THUMBS"/*.png 2>/dev/null || true

mapfile -t rows < <(
  MAX="$MAX" TAB="$TAB" THUMBS="$THUMBS" copyq eval - <<'JSEOF'
var TAB = env("TAB");
var MAX = parseInt(env("MAX"));
var THUMBS = env("THUMBS");
tab(TAB);
var n = Math.min(count(), MAX);
for (var i = 0; i < n; i++) {
  var d = getitem(i);
  var keys = Object.keys(d);
  var isImg = false;
  for (var j = 0; j < keys.length; j++) {
    if (keys[j].indexOf("image/") == 0) { isImg = true; break; }
  }
  var label = "";
  var icon = "";
  if (isImg) {
    var buf = read("image/png", i);
    if (buf && buf.length > 0) {
      icon = THUMBS + "/" + i + ".png";
      var f = new File(icon);
      f.open();
      f.write(buf);
      f.close();
    }
    // PNG IHDR: bytes 16-23. buf is QByteArray; use .mid+.toString+charCodeAt.
    var w = 0, h = 0;
    if (buf && buf.size && buf.size() > 24) {
      var hdr = buf.mid(16, 8).toString();
      w = (hdr.charCodeAt(0)<<24) | (hdr.charCodeAt(1)<<16) | (hdr.charCodeAt(2)<<8) | hdr.charCodeAt(3);
      h = (hdr.charCodeAt(4)<<24) | (hdr.charCodeAt(5)<<16) | (hdr.charCodeAt(6)<<8) | hdr.charCodeAt(7);
    }
    label = w && h ? ("image " + w + "×" + h) : "image";
  } else {
    var t = str(d["text/plain"] || "").replace(/[\r\n\t]/g, " ").substring(0, 220);
    label = t.length ? t : "<empty>";
  }
  print(i + "\t" + label + "\t" + icon + "\n");
}
JSEOF
)

# Ephemeral theme: inherit user base (matches other rofi scripts), just enable thumbs.
THEME_FILE=/tmp/copyq-rofi-theme.rasi
cat > "$THEME_FILE" <<'RASI'
@import "~/.config/rofi/themes/base.rasi"

listview     { lines: 8; fixed-height: 1; scrollbar: true; spacing: 3px; }
scrollbar    { width: 4px; }
element      { padding: 4px 8px; spacing: 10px; }
element-icon { size: 48px; expand: false; }
RASI

esc_pango() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

build_input() {
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r idx label icon <<< "$row"
    [ -z "${idx:-}" ] && continue
    safe=$(esc_pango "$label")
    entry=$(printf '<span alpha="50%%">%02d</span>  %s' "$idx" "$safe")
    if [ -n "${icon:-}" ] && [ -f "$icon" ]; then
      printf '%s\0icon\x1f%s\n' "$entry" "$icon"
    else
      printf '%s\n' "$entry"
    fi
  done
}

sel=$(build_input | rofi -dmenu -i \
  -p "clip" \
  -show-icons \
  -markup-rows \
  -no-custom \
  -theme "$THEME_FILE" \
  -format 'i') || exit 0

[ -z "$sel" ] && exit 0
# sel is now the row index in `rows` (0-based, from `-format i`). Map to CopyQ index.
row_pos=$sel
if [ "$row_pos" -ge "${#rows[@]}" ]; then exit 0; fi
IFS=$'\t' read -r idx _ _ <<< "${rows[$row_pos]}"
[ -z "$idx" ] && exit 0

copyq eval - <<JSEOF2
tab("$TAB");
select($idx);
JSEOF2
sleep 0.05
xdotool key --clearmodifiers ctrl+v
