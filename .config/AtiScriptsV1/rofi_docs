#!/usr/bin/env bash
# rofi_docs — the system documentation menu, behind the bar's logo chip.
#
# Left-clicking the logo used to open a terminal, which four other bindings
# already do. A desktop with 79 keybindings, 22 themes, 126 troubleshooting
# entries and 38 custom commands has a discovery problem instead.
#
# Everything is GENERATED from the live system, never hand-listed, so no
# section can drift out of date:
#
#   Keybindings   parsed from config.py by qtile-keys (AST, not regex)
#   Commands      each script's own header comment -- READ, never executed
#   Troubleshoot  the headings of TROUBLESHOOTING.md, with their first line
#                 of context, jumping to the right line
#   Docs          rendered read-only; only the qtile config opens writable
#
# Navigation: Esc goes UP one level, not out. Every submenu returns to its
# parent, and only Esc at the top level closes the menu -- a menu you have
# to reopen from the bar after every glance is a menu you stop using.
#
# NOTE: never use a shell var named DISPLAY in this script — it shadows the
# X11 $DISPLAY env var and every downstream tool then fails silently.

set -uo pipefail

DOTFILES="${DOTFILES_DIR:-$HOME/.dotfiles}"
QTILE_CFG="$HOME/.config/qtile/config.py"
VIEW_CLASS="docs-view"
ESPANSO_DIR="$HOME/.config/espanso"

# theme-apply writes this from the active 9-slot palette. Without it glow
# renders in its own built-in colors, which is why a themed desktop still
# showed dracula pink and blue inside every document it opened. "auto" is
# the honest fallback on a machine where theme-apply has not run yet.
GLOW_STYLE="$HOME/.cache/qtile/glow.json"
[[ -f "$GLOW_STYLE" ]] || GLOW_STYLE="auto"

# rofi -dmenu exits 1 on Escape and 0 on a selection. That difference is
# the whole navigation model, so it gets its own wrapper: RC is the caller's
# signal to go back up rather than act.
RC=0
pick() {
  local out
  out="$(rofi -dmenu -i -p "$1" ${2:+-mesg "$2"})"
  RC=$?
  printf '%s' "$out"
}

# Set by every function that actually opens something. The menu is a
# LAUNCHER, so once it has launched, it is done: sections used to return
# into main_menu's loop, which re-drew the top-level rofi on top of the
# window you had just asked for. You then had to Esc it away every single
# time. Checked once in main_menu, after the dispatch.
LAUNCHED=0

# ── viewers ──────────────────────────────────────────────────────────
# `kitty -e sh -c '<pager> ...'`: if <pager> is not installed, kitty maps a
# window, sh prints "command not found" and exits, and the window vanishes
# after ~0.2s -- no error anywhere you can read it. That is not theoretical:
# `less` is not in the `base` group and nothing else on this system pulls it
# in, and BOTH `glow -p` and `bat --paging=always` exec less rather than
# paging themselves, so every text view in this menu died that way.
#
# So: never launch a terminal for a binary that is not there. Check first,
# say so in rofi, and fall back to nvim -- which is the one viewer this
# repo can actually guarantee, since editing the config is the whole point.
have() { command -v "$1" >/dev/null 2>&1; }

# A pager that exists. less if installed (best defaults for this), else
# nvim in read-only mode, which pages fine and is never absent here.
term_view() {  # term_view <shell-command>
  setsid kitty --class "$VIEW_CLASS" --title "docs" -e sh -c "$1" >/dev/null 2>&1 &
  LAUNCHED=1
}

# Markdown is RENDERED and read-only. Opening README.md in a writable nvim
# was wrong twice over: it showed raw markup instead of the document, and
# it invited edits to a file that is the repo's own documentation. It also
# tripped fidget.nvim, which writes into the buffer and raised
# "Buffer is not 'modifiable'" on every notification.
view_md() {
  local f="$1"
  [[ -f "$f" ]] || { rofi -e "not found: $f"; return; }
  if have glow && have less; then
    term_view "glow -s '$GLOW_STYLE' -p -w 100 '$f'"
  else
    # `glow -p` IS less -- without it glow dumps the whole document and
    # exits, which is a flash, not a viewer. nvim shows raw markup instead
    # of rendered prose, but it scrolls, searches and stays open.
    view_at_line "$f" 1
  fi
}

# Read-only nvim at a line, for jumping into a specific troubleshooting
# entry. `-R` (readonly MODE), not `+set nomodifiable`: nomodifiable blocks
# plugins that legitimately write to their own buffers, which is what
# produced the fidget.nvim traceback. -R only stops YOU writing the file.
view_at_line() {
  local f="$1" line="${2:-1}"
  [[ -f "$f" ]] || { rofi -e "not found: $f"; return; }
  setsid kitty --class "$VIEW_CLASS" --title "docs" \
    -e nvim -R "+${line}" "+normal zz" "$f" >/dev/null 2>&1 &
  LAUNCHED=1
}

# The one writable target. Editing your own config is the point.
view_edit() {
  local f="$1"
  [[ -f "$f" ]] || { rofi -e "not found: $f"; return; }
  setsid kitty --class "$VIEW_CLASS" --title "docs" -e nvim "$f" >/dev/null 2>&1 &
  LAUNCHED=1
}

view_text() {
  local title="$1" body="$2" tmp
  tmp="$(mktemp --suffix=.txt)"
  printf '%s\n' "$body" > "$tmp"
  if have less; then
    term_view "less -R '$tmp'; rm -f '$tmp'"
  else
    # -R would make the buffer read-only anyway; +set nomodified stops the
    # "no write since last change" prompt on :q for a throwaway file.
    term_view "nvim -R '+set nomodified' '$tmp'; rm -f '$tmp'"
  fi
}

# A generated PAGE, not a dump. About/services/gpu/audit used to arrive as
# raw command output in a bare pager -- correct information, presented as a
# wall of monospace with no title, no grouping and no relationship to the
# themed documents sitting one menu entry away. They are markdown now and
# go through the same themed glow renderer, so a generated panel and a
# committed README look like the same product.
#
# The body is markdown. Command output belongs in a fenced block inside it,
# which is what panel_block below is for.
view_panel() {
  local title="$1" body="$2" tmp
  tmp="$(mktemp --suffix=.md)"
  { printf '# %s\n\n' "$title"; printf '%s\n' "$body"; } > "$tmp"
  if have glow && have less; then
    term_view "glow -s '$GLOW_STYLE' -p -w 100 '$tmp'; rm -f '$tmp'"
  else
    view_text "$title" "$body"
    rm -f "$tmp"
  fi
}

# Wrap command output as a fenced block. Alignment matters in `systemctl`
# and `xrandr` output, so it must not be reflowed as prose.
panel_block() {  # panel_block <language> <text>
  printf '```%s\n%s\n```\n' "$1" "$2"
}

# "key   value" lines -> a markdown table. Two columns, because that is
# what every one of these panels actually is.
panel_table() {  # panel_table <col1> <col2> <"key<TAB>value" lines>
  printf '| %s | %s |\n| --- | --- |\n' "$1" "$2"
  printf '%s\n' "$3" | while IFS=$'\t' read -r k v; do
    [[ -z "$k" ]] && continue
    printf '| %s | %s |\n' "$k" "$v"
  done
}

# Launch a detached GUI/rofi tool. Same LAUNCHED bookkeeping, plus the
# missing-binary check the terminal viewers get -- `setsid theme-toggle &`
# on a host without it failed completely silently.
run_tool() {
  have "$1" || { rofi -e "not installed: $1\nrun: ./wizard.sh --yes --only=ati-scripts"; return; }
  setsid "$@" >/dev/null 2>&1 &
  LAUNCHED=1
}

# ── qtile IPC ────────────────────────────────────────────────────────
# The cheatsheets live inside qtile and used to be reached by replaying
# their key chord with xdotool. That could not work: entering the chord
# auto-shows the qtile sheet, so the replayed `k` toggled it straight back
# off (it appeared for one frame), and `v`/`f` showed the qtile sheet first
# and then replaced it. config.py now exposes open_cheatsheet() for this.
qtile_eval() {
  qtile cmd-obj -o cmd -f eval -a "$1" 2>&1
}
open_cheatsheet() {
  local out
  out="$(qtile_eval "__import__('sys').modules['config'].open_cheatsheet('$1')")"
  [[ "$out" == '"ok"' ]] || rofi -e "could not open the $1 cheatsheet:\n$out"
}

# ── keybindings ──────────────────────────────────────────────────────
sec_keys() {
  if ! command -v qtile-keys >/dev/null 2>&1; then
    rofi -e "qtile-keys not installed — run: ./wizard.sh --yes --only=ati-scripts"
    return
  fi
  local n; n="$(qtile-keys | wc -l)"
  qtile-keys | pick "Keys" "$n bindings, parsed live from config.py · Esc goes back" >/dev/null
}

# ── cheatsheets ──────────────────────────────────────────────────────
sec_cheats() {
  while :; do
    local c
    c="$(printf '%s\n' \
      "󰘳  Qtile cheatsheet      every mode and binding" \
      "󰕷  Vim cheatsheet        motions, text objects, registers" \
      "󰈺  Fish / kitty          shell and terminal shortcuts" \
      | pick "Cheatsheets" "Esc goes back · in the sheet, Esc or q closes it")"
    (( RC != 0 )) && return
    case "$c" in
      *Qtile*) open_cheatsheet qtile; return ;;
      *Vim*)   open_cheatsheet vim;   return ;;
      *Fish*)  open_cheatsheet fish;  return ;;
      *) return ;;
    esac
  done
}

# ── documentation ────────────────────────────────────────────────────
sec_docs() {
  while :; do
    local c
    c="$(printf '%s\n' \
      "󰈙  README                 what this desktop is and how to install it" \
      "󰋗  Troubleshooting        126 fixes, searchable by symptom" \
      "󰏗  Packages               how packages are declared and installed" \
      "󰃤  Boot entries           the rescue kernel, and why it exists" \
      "󰅱  qtile config           the source — the only writable entry" \
      | pick "Documentation" "rendered read-only · Esc goes back")"
    (( RC != 0 )) && return
    case "$c" in
      *README*)          view_md "$DOTFILES/README.md"; return ;;
      *Troubleshooting*) sec_trouble ;;
      *Packages*)        view_md "$DOTFILES/.config/arch-config/README.md"; return ;;
      *"Boot entries"*)  view_md "$DOTFILES/.config/arch-config/boot/README.md"; return ;;
      *"qtile config"*)  view_edit "$QTILE_CFG"; return ;;
      *) return ;;
    esac
  done
}

# TROUBLESHOOTING.md is 144 KB. Dumping it in a pager is not documentation,
# and the headings alone are too terse to search by symptom -- "Rofi" tells
# you nothing. Each entry therefore carries the first line of its own body
# as context, which is where the actual symptom is written.
sec_trouble() {
  local f="$DOTFILES/TROUBLESHOOTING.md"
  [[ -f "$f" ]] || { rofi -e "not found: $f"; return; }
  local sel
  # Every entry in this file follows the same shape:
  #     ### Some terse heading
  #     - **Symptom:** what you actually observed
  # The heading alone is useless to search by -- "Rofi" and "Theming" tell
  # you nothing -- but the Symptom line is written in exactly the words
  # you would use when the thing goes wrong. So that is what is shown, and
  # what rofi filters on.
  sel="$(awk '
    /^#{2,3} / {
      if (heading != "") emit()
      line = FNR
      depth = (substr($0,1,3) == "###") ? 3 : 2
      sub(/^#+ +/, "")
      heading = $0
      sym = ""; firstprose = ""
      next
    }
    heading != "" && sym == "" && /\*\*Symptom:?\*\*/ {
      sym = $0
      sub(/^.*\*\*Symptom:?\*\*[[:space:]]*/, "", sym)
      gsub(/[`*_]/, "", sym)
      next
    }
    heading != "" && firstprose == "" && NF > 0 && $0 !~ /^[#`|<>]/ {
      firstprose = $0
      sub(/^-[[:space:]]*/, "", firstprose)
      gsub(/[`*_]/, "", firstprose)
    }
    END { if (heading != "") emit() }
    function emit(   pad, ctx) {
      ctx = (sym != "") ? sym : firstprose
      if (ctx == "") ctx = "(section)"
      if (length(ctx) > 88) ctx = substr(ctx, 1, 85) "..."
      pad = (depth == 3) ? "   " : ""
      printf "%s%-46s  %-90s :%s\n", pad, substr(heading, 1, 46), ctx, line
      heading = ""
    }
  ' "$f" | pick "Troubleshooting" "$(grep -cE '^#{2,3} ' "$f") fixes · type the symptom you are seeing · Esc goes back")"
  (( RC != 0 )) && return
  [[ -z "$sel" ]] && return
  local line="${sel##*:}"
  [[ "$line" =~ ^[0-9]+$ ]] && view_at_line "$f" "$line"
}

# ── commands ─────────────────────────────────────────────────────────
# Shows each script's header comment. It never RUNS the script.
#
# The first version called `<script> --help`, which was a genuine bug: most
# of these tools have no --help, so the flag fell through to their normal
# code path and the menu launched rofi pickers, toggled themes and started
# dictation instead of documenting anything.
script_desc() {
  # Two statements, not one: in `local a=$2 b=${a%.py}` the expansion of $a
  # happens BEFORE local has assigned it, so stem was silently always empty
  # and the precise "<name> — <description>" header match below could never
  # fire. Every entry came from the loose fallback heuristic instead.
  local f="$1" base="$2" d
  local stem="${base%.py}"
  d="$(head -12 "$f" \
       | grep -m1 -E "^(#+ *|\"\"\")${stem}(\.py)?[[:space:]]+[—–-][[:space:]]*." \
       | sed -E "s/^(#+ *|\"\"\")${stem}(\.py)?[[:space:]]+[—–-][[:space:]]*//")"
  if [[ -z "$d" ]]; then
    d="$(head -14 "$f" | sed -E '1d' | grep -E '^#' | sed -E 's/^#+ *//' \
      | grep -vE '^(shellcheck|pylint|noqa|-\*-|!)' \
      | grep -vE '^[[:punct:][:space:]]*$' \
      | grep -vE '^(Script name|Author|Maintainer|Usage|CONFIG)\b' \
      | grep -E '[A-Za-z].*[[:space:]][A-Za-z]+[[:space:]][A-Za-z]+' | head -1)"
  fi
  d="$(sed -E 's/^(Description|DESCRIPTION)[[:space:]]*:[[:space:]]*//; s/^-[[:space:]]+//' <<<"$d")"
  d="${d#"${d%%[![:space:]]*}"}"
  [[ -z "$d" ]] && d="(no description)"
  printf '%s' "$d"
}

sec_commands() {
  local dir="$DOTFILES/.config/AtiScriptsV1"
  while :; do
    local list="" f base
    for f in "$dir"/*; do
      [[ -f "$f" && -x "$f" ]] || continue
      base="$(basename "$f")"
      case "$base" in *.sh|rofi_common*|rofi_shared*|__pycache__*) continue ;; esac
      list+="$(printf '%-24s %s' "$base" "$(script_desc "$f" "$base" | cut -c1-74)")"$'\n'
    done
    local sel
    sel="$(printf '%s' "$list" | pick "Commands" "Enter shows the script's documentation — nothing is run · Esc goes back")"
    (( RC != 0 )) && return
    [[ -z "$sel" ]] && return
    local cmd; cmd="$(awk '{print $1}' <<<"$sel")"
    [[ -f "$dir/$cmd" ]] || return
    # The leading comment block: everything from line 2 until the first
    # line that is not a comment. That is where these scripts document
    # themselves, and reading it cannot have side effects.
    #
    # Fenced, not prose: these headers are hand-wrapped and full of literal
    # command lines and ASCII diagrams, all of which markdown would happily
    # reflow into nonsense.
    view_panel "$cmd" "$(
      printf '`%s`\n\n' "$dir/$cmd"
      panel_block "" "$(awk 'NR==1 {next} /^#/ {sub(/^#+ ?/,""); print; next} /^$/ {print; next} {exit}' "$dir/$cmd")"
    )"
    return
  done
}

# ── appearance ───────────────────────────────────────────────────────
sec_appearance() {
  while :; do
    local c
    c="$(printf '%s\n' \
      "󰸌  Theme                  22 palettes, retints every app at once" \
      "󰍹  UI scale               size the desktop to this screen" \
      "󰸉  Wallpaper              picker" \
      "󰇥  Boot splash            your name on the boot screen" \
      | pick "Appearance" "Esc goes back")"
    (( RC != 0 )) && return
    case "$c" in
      *Theme*)      run_tool theme-toggle;    return ;;
      *"UI scale"*) run_tool ui-scale-toggle; return ;;
      *Wallpaper*)  run_tool dm-setbg;        return ;;
      *"Boot splash"*)
        view_panel "Boot splash" "$(
          printf 'What plymouth is configured to show while this machine boots.\n\n'
          panel_block "" "$(boot-splash status 2>&1)"
          printf '\nChange the name on it with `boot-splash set-name "<name>"`.\n'
        )"
        return ;;
      *) return ;;
    esac
  done
}

# ── espanso ─────────────────────────────────────────────────────────
# espanso's snippets in match/base.yml do not contain personal data --
# they shell out to `source /etc/environment; echo "$MY_NAME"` and friends.
# That is the right design (nothing private is committed) but it has a
# sharp edge: on a machine where those variables are not set, every one of
# those snippets silently expands to an EMPTY STRING. No error, no warning
# -- you type `:email` and nothing appears.
#
# So this section is built around the variables, not the files.
sec_espanso() {
  local match_dir="$ESPANSO_DIR/match"
  local envfile="/etc/environment"

  # Reading /etc/environment needs no privilege -- it is 0644, because
  # pam_env has to read it as every user at login. The `sudo grep` this
  # used to run was pure downside: rofi_docs is spawned from the bar with
  # no controlling terminal, so on a host where the sudo timestamp has
  # expired that grep cannot prompt and simply fails, and EVERY variable
  # was then reported missing. sudo is kept for the WRITE below, which
  # genuinely needs it.
  env_has() { grep -qE "^[[:space:]]*${1}=" "$envfile" 2>/dev/null; }

  while :; do
    # Which variables the snippets reference, and which are actually set.
    local wanted set_count missing_count
    wanted="$(grep -ohE '\$[A-Z][A-Z0-9_]+' "$match_dir"/*.yml 2>/dev/null \
              | tr -d '$' | sort -u)"
    set_count=0; missing_count=0
    local v missing=""
    for v in $wanted; do
      if env_has "$v"; then
        set_count=$((set_count+1))
      else
        missing_count=$((missing_count+1)); missing+="$v"$'\n'
      fi
    done

    local c
    c="$(printf '%s\n' \
      "󰉺  Personal variables      ${set_count} set · ${missing_count} missing" \
      "󰏫  Edit /etc/environment   where the values live" \
      "󰝒  Snippet files           $(ls -1 "$match_dir"/*.yml 2>/dev/null | wc -l) file(s) in match/" \
      "󰑓  Restart espanso         apply changes" \
      | pick "Espanso" "snippets read personal data from /etc/environment · Esc goes back")"
    (( RC != 0 )) && return
    case "$c" in
      *"Personal variables"*)
        local body v
        # Every `body+="$(...)"` here loses the command substitution's
        # trailing newlines, so each chunk ends with an explicit $'\n'.
        body="$(printf 'espanso snippets reference **%s** variables, read from `%s`.' \
                  "$(wc -w <<<"$wanted")" "$envfile")"$'\n\n'
        body+="$(printf '## Set (%s)' "$set_count")"$'\n\n'
        for v in $wanted; do
          env_has "$v" && body+="- \`$v\`"$'\n'
        done
        (( set_count == 0 )) && body+=$'_none_\n'
        body+=$'\n'"$(printf '## Missing (%s)' "$missing_count")"$'\n'
        body+=$'\nSnippets using these expand to an empty string — no error, no warning.\n\n'
        body+="$(sed '/^$/d; s/^/- `/; s/$/`/' <<<"$missing")"
        body+=$'\n\n---\n\n'"Add them to \`$envfile\` as \`KEY=value\`, one per line, then run:"$'\n\n'
        body+=$'```\nespanso restart\n```\n'
        view_panel "Espanso variables" "$body"
        return ;;
      *"Edit /etc/environment"*)
        # Scaffold the missing keys first, commented out, so the file
        # documents what espanso is looking for instead of being an empty
        # page you have to guess at.
        #
        # Guarded by the marker line, because the scaffold writes the keys
        # COMMENTED OUT -- so they still read as "missing" on the next open,
        # and the unguarded version appended the whole block again every
        # single time this entry was selected.
        #
        # Both the scaffold and sudoedit run INSIDE the terminal, not out
        # here: this script has no controlling terminal (the bar spawned
        # it), so a sudo password prompt had nowhere to appear and the
        # append silently did nothing.
        local scaffold="" sf
        if [[ -n "${missing// /}" ]] && ! grep -q 'added by rofi_docs' "$envfile" 2>/dev/null; then
          sf="$(mktemp --suffix=.env)"
          {
            echo ""
            echo "# --- espanso snippet variables (added by rofi_docs) ---"
            echo "# Fill in the value after '=' and remove the leading '#'."
            echo "# Snippets that use an unset variable expand to nothing."
            sed 's/^/#/; s/$/=/' <<<"$missing"
          } > "$sf"
          scaffold="sudo tee -a '$envfile' < '$sf' >/dev/null; rm -f '$sf';"
        fi
        # sudoedit, not `sudo nvim`: it edits a copy as you and installs it
        # afterwards, so a crashed editor cannot leave a root-owned mess in
        # /etc, and your own nvim config is used rather than root's.
        term_view "$scaffold SUDO_EDITOR=nvim sudoedit '$envfile'"
        return ;;
      *"Snippet files"*)
        local f list=""
        for f in "$match_dir"/*.yml; do
          [[ -f "$f" ]] || continue
          list+="$(printf '%-24s %s triggers' "$(basename "$f")" \
                   "$(grep -c '^[[:space:]]*-[[:space:]]*trigger' "$f" 2>/dev/null || echo 0)")"$'\n'
        done
        list+="＋  new snippet file…"
        local sel
        sel="$(printf '%s\n' "$list" | pick "Snippets" "Esc goes back")"
        (( RC != 0 )) && continue
        [[ -z "$sel" ]] && continue
        if [[ "$sel" == "＋"* ]]; then
          local name; name="$(printf '' | rofi -dmenu -p "new file name (no .yml)")"
          [[ -z "$name" ]] && continue
          local new_f="$match_dir/${name%.yml}.yml"
          [[ -f "$new_f" ]] || cat > "$new_f" <<'YML'
# espanso snippets. Apply with:  espanso restart
matches:
  - trigger: ":example"
    replace: "replaced text"
YML
          view_edit "$new_f"
        else
          view_edit "$match_dir/$(awk '{print $1}' <<<"$sel")"
        fi
        return ;;
      *"Restart espanso"*)
        if espanso restart >/dev/null 2>&1; then
          notify-send -a espanso "espanso restarted" "snippets reloaded" 2>/dev/null
          LAUNCHED=1
        else
          rofi -e "espanso restart failed — is espanso running?"
        fi
        return ;;
      *) return ;;
    esac
  done
}

# ── system ───────────────────────────────────────────────────────────
sec_system() {
  while :; do
    local c
    c="$(printf '%s\n' \
      "󰋼  About                  user · theme · scale · gpu · kernel" \
      "󰏗  Package audit          declared vs actually installed" \
      "󰓅  Services               what failed, what is running" \
      "󰍛  Display + GPU          resolution, DPI, driver" \
      | pick "System" "Esc goes back")"
    (( RC != 0 )) && return
    case "$c" in
      *About*)
        view_panel "About this machine" "$(panel_table "" "value" "$(about_rows)")"
        return ;;
      *"Package audit"*)
        view_panel "Package audit" "$(
          printf 'Declared in `.config/arch-config/modules/*.yaml` versus what pacman\nactually has installed.\n\n'
          panel_block "" "$("$DOTFILES/installScripts/wizard.sh" --audit 2>&1 | sed 's/\x1b\[[0-9;]*m//g')"
        )"
        return ;;
      *Services*)
        view_panel "Services" "$(
          printf '## Failed\n\n'
          panel_block "" "$(systemctl --failed --no-pager 2>&1)"
          printf '\n## Running\n\n'
          panel_block "" "$(systemctl list-units --type=service --state=running --no-pager 2>&1 | head -40)"
        )"
        return ;;
      *"Display + GPU"*)
        view_panel "Display + GPU" "$(
          printf '## Outputs and modes\n\n'
          panel_block "" "$(xrandr --current 2>&1 | grep -E ' connected|\*')"
          printf '\n## UI scale\n\n'
          panel_block "" "$(ui-scale --show 2>&1)"
          printf '\n## Graphics driver\n\n'
          panel_block "" "$(lspci -k 2>/dev/null | grep -A3 -E 'VGA|3D')"
        )"
        return ;;
      *) return ;;
    esac
  done
}

# Tab-separated key/value rows. panel_table turns these into markdown; the
# `about` CLI subcommand still prints them as plain aligned text, since a
# markdown table piped into another program helps nobody.
about_rows() {
  local gpu res
  gpu="$(lspci -mn 2>/dev/null | awk -F'"' '$2 ~ /^03/ {print $4}' | head -1)"
  case "$gpu" in
    8086) gpu="Intel" ;; 1002|1022) gpu="AMD" ;; 10de) gpu="NVIDIA" ;;
    *) gpu="${gpu:-unknown}" ;;
  esac
  res="$(xrandr --current 2>/dev/null | awk '/ connected primary/{print $4}' | cut -d+ -f1)"
  printf 'user\t%s\n'     "$USER"
  printf 'host\t%s\n'     "$(hostnamectl hostname 2>/dev/null || hostname)"
  printf 'theme\t%s\n'    "$(cat "$HOME/.cache/qtile/theme_mode" 2>/dev/null || echo unknown)"
  printf 'ui scale\t%s\n' "$(cat "$HOME/.cache/qtile/ui_scale" 2>/dev/null || echo 1.00)"
  printf 'display\t%s\n'  "${res:-unknown}"
  printf 'gpu\t%s\n'      "$gpu"
  printf 'kernel\t%s\n'   "$(uname -r)"
  printf 'qtile\t%s\n'    "$(qtile --version 2>/dev/null | head -1)"
  printf 'picom\t%s\n'    "$(pacman -Qq picom-ftlabs-pinned picom-ftlabs-git 2>/dev/null | sort -u | paste -sd' ' -)"
  printf 'uptime\t%s\n'   "$(uptime -p 2>/dev/null | sed 's/^up //')"
  printf 'dotfiles\t%s\n' "$(git -C "$DOTFILES" rev-parse --short HEAD 2>/dev/null || echo '-')"
}

about_text() { about_rows | column -t -s $'\t'; }

# ── main ─────────────────────────────────────────────────────────────
# Loops: a submenu returning (its Esc) lands back here rather than exiting,
# so Esc reads as "up one level" everywhere. Only Esc at THIS level closes.
main_menu() {
  while :; do
    local c
    c="$(printf '%s\n' \
      "󰌌  Keybindings          ▸ every shortcut, searchable" \
      "󰘳  Cheatsheets          ▸ qtile · vim · fish" \
      "󰈙  Documentation        ▸ README · troubleshooting · packages" \
      "󰞌  Commands             ▸ every tool this desktop installs" \
      "󰛄  Espanso              ▸ text expansion snippets" \
      "󰏘  Appearance           ▸ theme · scale · wallpaper · splash" \
      "󰒓  System               ▸ about · audit · services · gpu" \
      | pick "Docs" "Esc closes · inside a section, Esc comes back here")"
    (( RC != 0 )) && return
    case "$c" in
      *Keybindings*)   sec_keys ;;
      *Cheatsheets*)   sec_cheats; return ;;
      *Documentation*) sec_docs ;;
      *Commands*)      sec_commands ;;
      *Espanso*)       sec_espanso ;;
      *Appearance*)    sec_appearance ;;
      *System*)        sec_system ;;
      *) return ;;
    esac
    # A section that OPENED something is the end of the interaction: falling
    # back into this loop redrew the top-level menu directly on top of the
    # window you had just asked for, so every single lookup ended with an
    # extra Esc. A section that came back empty-handed (its own Esc) still
    # lands here, which is what makes Esc read as "up one level".
    (( LAUNCHED )) && return
  done
}

case "${1:-}" in
  "")          main_menu ;;
  keys)        sec_keys ;;
  cheats)      sec_cheats ;;
  docs)        sec_docs ;;
  trouble)     sec_trouble ;;
  commands)    sec_commands ;;
  espanso)     sec_espanso ;;
  appearance)  sec_appearance ;;
  system)      sec_system ;;
  about)       about_text ;;
  --help|-h)   sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "rofi_docs: unknown section '$1'" >&2; exit 2 ;;
esac
