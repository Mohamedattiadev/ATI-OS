#!/usr/bin/env bash
# ati-theme-animate <mode> — apply a theme THROUGH the circular reveal, if there
# is a shell up that can draw one.
#
# WHY THIS EXISTS
# ---------------
# Reported: "when I change the theme and wallpaper I want the same animation of
# the island". The animation is a Quickshell overlay — it takes a screenshot,
# freezes the screen, runs theme-apply BEHIND it, and sweeps the new palette in
# over the frozen frame. Two consequences follow from that order and both of
# them shape this script:
#
#   * the trigger cannot be "notice that the theme changed". By then the
#     desktop has already repainted in stages, which is the thing the sweep
#     exists to hide. Freezing has to come first, so the overlay has to be
#     handed the theme NAME and left to run theme-apply itself;
#   * every caller that ran `theme-apply` directly therefore bypassed the
#     animation entirely, however many shells were running.
#
# The picker is one of those callers — theme-toggle ended with
# `exec theme-apply "$MODE"` — and so is wallpaper-set.sh, which re-runs
# theme-apply in wal mode because there the wallpaper IS the palette. That is
# the other half of the report: a wallpaper change is a theme change here.
#
# WHICH SHELL, AND WHY IT IS ASKED IN THIS ORDER
# ----------------------------------------------
# Both of the resident shells expose the SAME function under the same target,
# deliberately, so this file has one spelling to keep in step:
#
#     tide applyThemeAnimated <mode>
#
#   1. the island       — it owns the overlay in both backends, so it answers
#                         under Hyprland and under qtile alike;
#   2. the popups shell — the topbar's resident companion, which hosts the
#                         same overlay for the session where the island is
#                         stopped. See tide-island-fork/popups.qml.
#   3. theme-apply      — no shell to draw it. qtile wearing its OWN bar is
#                         the real case: nothing Quickshell is running there
#                         at all.
#
# ISLAND FIRST AND NOT bar-mode: the state file says which bar was CHOSEN, and
# this needs to know which shell is actually up. They disagree for a few
# hundred milliseconds on every switch, and during a theme change that window
# is the difference between an animation and a frozen screen with nothing
# behind it.
#
# `qs ipc call` EXITS NON-ZERO WITH NO INSTANCE — 255, measured — which is what
# makes the fallthrough work at all. It exits 0 for a missing FUNCTION, which
# is the trap in hypr/NEXT-SESSION.md's RULES, so the two shells must both
# actually implement the function; a typo here would look like success and do
# nothing.

set -euo pipefail

[[ $# -ge 1 ]] || { echo "usage: ati-theme-animate <mode>" >&2; exit 2; }

mode="$1"

FORK_DIR="${TIDE_ISLAND_FORK_DIR:-$HOME/.config/quickshell/tide-island-fork}"
POPUPS_ENTRY="$FORK_DIR/popups.qml"

# qsipc if installed (same argv shape as qs, its own header explains why),
# qs otherwise. Either way this function's contract holds: nonzero exit
# with no instance is what makes the FORK_DIR -> POPUPS_ENTRY fallthrough
# below work, and both binaries exit nonzero for that case (qs: 255,
# qsipc: 1 -- the exact value was never what this checked).
ipc_bin=qs
command -v qsipc >/dev/null 2>&1 && ipc_bin=qsipc

try_ipc() {
  "$ipc_bin" -p "$1" ipc call tide applyThemeAnimated "$mode" >/dev/null 2>&1
}

if try_ipc "$FORK_DIR"; then
  exit 0
fi

if try_ipc "$POPUPS_ENTRY"; then
  exit 0
fi

# Nothing to animate with. Not an error and not worth a notification: the
# theme still changes, which is what was asked for.
exec theme-apply "$mode"
