#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/../lib/ati-rofi-common.sh"

require_cmd rofi gawk sed grep flock || exit 1
load_palette

USER_NAME="$(whoami | tr '[:lower:]' '[:upper:]')"
TODOS_DIR="$HOME/${USER_NAME}TODOS"
# Single source of truth. This used to be todos.md, which left two
# unrelated lists side by side in the same directory: todos.md here, and
# TODOS.md maintained by the Mod+Shift+S Simplenote sync. Tasks added in
# one were invisible to the other. TODOS.md wins because it is the one
# that syncs to the phone.
TODO_FILE="$TODOS_DIR/TODOS.md"
LEGACY_TODO_FILE="$TODOS_DIR/todos.md"
SUBTASK_FILE="$TODOS_DIR/subtasks.md"
WORKING_FILE="$TODOS_DIR/working_on.txt"
LOCK_FILE="$TODOS_DIR/.rofi_todo.lock"

mkdir -p "$TODOS_DIR"
touch "$TODO_FILE" "$SUBTASK_FILE" "$WORKING_FILE" "$LOCK_FILE"

# One-time migration: fold any real tasks out of the old store, then
# retire it so it cannot drift again. Only checkbox lines move; blank
# lines and stray text are dropped rather than pushed to Simplenote.
if [[ -s "$LEGACY_TODO_FILE" ]]; then
    if grep -qE '^[[:space:]]*- \[[ x]\]' "$LEGACY_TODO_FILE"; then
        printf '\n' >>"$TODO_FILE"
        grep -E '^[[:space:]]*- \[[ x]\]' "$LEGACY_TODO_FILE" >>"$TODO_FILE"
        notify_safe "rofi_todo" "migrated tasks from todos.md into TODOS.md"
    fi
    mv "$LEGACY_TODO_FILE" "${LEGACY_TODO_FILE}.migrated"
fi

# Prevent concurrent invocations from corrupting files.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    notify_safe "rofi_todo already running" "waiting for lock..."
    flock 9
fi

# Ensure each task file ends with a newline (prevents merging lines on append).
ensure_trailing_newline() {
    local f="$1"
    [[ -s "$f" ]] || return 0
    local last
    last=$(tail -c1 "$f")
    [[ "$last" == $'\n' ]] || printf '\n' >>"$f"
}
for f in "$TODO_FILE" "$SUBTASK_FILE" "$WORKING_FILE"; do
    ensure_trailing_newline "$f"
done

# sed -i portable helper (BSD sed needs '' arg).
sed_i() {
    if [[ "$(uname)" == "Darwin" ]]; then
        sed -i '' "$@"
    else
        sed -i "$@"
    fi
}
# Legacy shim (script uses ${SED_COMMAND} in many places).
SED_COMMAND="sed_i"

AWK_COMMAND="gawk"

# Palette-driven header, priority and state tints. These used to be a
# mix of palette variables and literals ("red", "green", "orange",
# "#ffd700", "#f0c674"), so theme-apply recoloured half the list and left
# the other half doom-one regardless of the palette in force.
HEADER_COLOR="$PAL_SEL"
PRIO_HIGH_COLOR="$PAL_URGENT"
PRIO_NORMAL_COLOR="$PAL_SEL1"
PRIO_LOW_COLOR="$PAL_ACTIVE"
WORKING_COLOR="$PAL_URGENT"   # the "working on this" marker
DONE_COLOR="$PAL_ACTIVE"      # completed tasks
DUE_COLOR="$PAL_SEL"          # due today
OPEN_COLOR="$PAL_SEL1"        # still to do
# Tags get a deterministic colour per name; drawing it from the palette
# instead of hashing raw RGB keeps them inside the theme rather than
# producing whatever #3B7F12 the hash happened to land on.
TAG_COLORS="${PAL_SEL},${PAL_ACTIVE},${PAL_SEL1},${PAL_URGENT},${PAL_FG}"

# ICONS (Nerd Font)
# -----------------------------------------------------------------------------
ICON_TODO="󰄱" # checkbox_blank_outline
ICON_DONE="󰄲" # checkbox_marked
ICON_ADD=""  # plus_circle
# shellcheck disable=SC2034  # kept so the ICON_* set stays complete
ICON_DEL="󰆴"
ICON_EDIT="" # pencil
ICON_WORKING="󰡠"
ICON_DUE="󰥔"
SMALL_DUE_ICON="󰄉"
ICON_YANK="󰅍"
ICON_SUBTASK="  └─"
ICON_DONE_TODAY="󰄲" # check_circle_outline
# SESSIONS
# -----------------------------------------------------------------------------
SESSIONS=("Today's Todos" "Future Tasks" "General Tasks" "Done Tasks")
SESSION_TODAY=0
SESSION_FUTURE=1
SESSION_GENERAL=2
SESSION_DONE=3
current_session_index=$SESSION_TODAY

# FORMAT FUNCTION (EXCLUDES SUBTASKS FROM DONE SECTIONS)
# -----------------------------------------------------------------------------

# -------------------- RANDOM COLOR FUNCTION -----------------------

get_session_content() {
  local session_index="$1"

  local working_list
  working_list=" $(paste -sd' ' "$WORKING_FILE") "

  local all_formatted_lines
  all_formatted_lines=$(
    $AWK_COMMAND -v session="$session_index" \
      -v today="$(date "+%Y-%m-%d")" \
      -v working_list="$working_list" \
      -v ICON_TODO="$ICON_TODO" \
      -v ICON_DONE="$ICON_DONE" \
      -v ICON_WORKING="$ICON_WORKING" \
      -v ICON_DONE_TODAY="$ICON_DONE_TODAY" \
      -v SMALL_DUE_ICON="$SMALL_DUE_ICON" \
      -v ICON_SUBTASK="$ICON_SUBTASK" \
      -v PRIO_HIGH="$PRIO_HIGH_COLOR" \
      -v PRIO_NORMAL="$PRIO_NORMAL_COLOR" \
      -v PRIO_LOW="$PRIO_LOW_COLOR" \
      -v WORKING_COLOR="$WORKING_COLOR" \
      -v DONE_COLOR="$DONE_COLOR" \
      -v DUE_COLOR="$DUE_COLOR" \
      -v OPEN_COLOR="$OPEN_COLOR" \
      -v TAG_COLORS="$TAG_COLORS" '
	BEGIN { FS = "|"; tag_n = split(TAG_COLORS, TAG_PAL, ",") }

# Deterministic colour per tag name, but chosen from the palette rather
# than hashed straight into RGB — the old version multiplied the first
# character out into arbitrary #RRGGBB, which ignored the theme entirely
# and could land on a colour invisible against the background.
function tag_color(tag,   sum, i) {
    sum = 0
    for (i = 1; i <= length(tag); i++) sum += index("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", substr(tag, i, 1))
    return TAG_PAL[(sum % tag_n) + 1]
}


	{
		line_num = $1
		# FS is "|", so $2 stopped at the first pipe and any task text
		# containing one was silently truncated on screen. Take
		# everything after the first separator instead.
		line_text = substr($0, index($0, "|") + 1)
		is_subtask = match(line_text, /^[[:space:]]+- \[[ x]\]/)

		# TODO_FILE is now the same TODOS.md that syncs to Simplenote,
		# and that note is kept as a plain numbered list ("7- fix the
		# rofi scripts"). Render those as open todos rather than
		# skipping every line that is not already a markdown checkbox —
		# otherwise the whole Simplenote list would be invisible here.
		# Nothing is rewritten on disk until the user acts on the line.
		if (!match(line_text, /^[-] \[[ x]\]/)) {
			if (match(line_text, /^[0-9]+[[:space:]]*-[[:space:]]*[^[:space:]]/)) {
				sub(/^[0-9]+[[:space:]]*-[[:space:]]*/, "", line_text)
				line_text = "- [ ] " line_text
			} else next
		}
		sub(/^[[:space:]]+/, "", line_text)

		prio_num = 0; prio_mark = ""
		if (match(line_text, /@Prio\((high|normal|low)\)/, m)) {
			prio_tag = m[1]
			if (prio_tag == "high")   { prio_num = 3; prio_mark = "<span color=\"" PRIO_HIGH "\" size=\"80%\" weight=\"bold\">(high)</span> " }
			if (prio_tag == "normal") { prio_num = 2; prio_mark = "<span color=\"" PRIO_NORMAL "\" size=\"80%\">(normal)</span> " }
			if (prio_tag == "low")    { prio_num = 1; prio_mark = "<span color=\"" PRIO_LOW "\" size=\"80%\">(low)</span> " }
		}

		color_start = ""; color_end = ""
		if (match(line_text, /@Color\(([^)]+)\)/, c)) {
			color_val = c[1]
			color_start = "<span color=\"" color_val "\">"
			color_end = "</span>"
		}

		task_text = line_text
		sub(/^- \[[x ]\] ?/, "", task_text)
		sub(/ ?@Prio\((high|normal|low)\) ?/, "", task_text)
		sub(/ ?@Color\([^)]+\) ?/, "", task_text)

		# --- deterministic @Tag(...) processing ---
		tag_html = ""
		while (match(task_text, /@Tag\(([^)]+)\)/, tag_match)) {
			tag_name = tag_match[1]
			tag_html = tag_html "<span color=\"" tag_color(tag_name) "\">#" tag_name "</span> "
			task_text = substr(task_text, 1, RSTART-1) substr(task_text, RSTART+RLENGTH)
		}

		sub(/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$/, "", task_text)
		gsub(/&/, "&amp;", task_text)
		gsub(/</, "&lt;", task_text)
		gsub(/>/, "&gt;", task_text)

		is_done = (index(line_text, "[x]") > 0)
		match(line_text, /@[0-9]{4}-[0-9]{2}-[0-9]{2}/)
		task_date = substr(line_text, RSTART+1, RLENGTH-1)

		is_due_today = (task_date == today)
		is_done_today = (is_done && task_date == today)
		is_future = (!is_done && task_date > today)

		working_mark = ""
		if (index(working_list, " " line_num " ") > 0) {
			working_mark = "<span color=\"" WORKING_COLOR "\">" ICON_WORKING "</span> "
		}

		prefix = (is_subtask ? ICON_SUBTASK " " : "")

		if (is_done) {
			if (is_subtask) next
			if (is_done_today) {
				printf "done_today|%d|%d|%s<span color=\"%s\">%s</span> <span alpha=\"80%%\"><s>%s%s%s%s%s</s></span>\n", prio_num, line_num, prefix, DONE_COLOR, ICON_DONE_TODAY, prio_mark, tag_html, color_start, task_text, color_end
			} else {
				printf "done_all|%d|%d|%s%s<span color=\"%s\">%s</span> <span alpha=\"80%%\"><s>%s%s%s%s%s</s></span>\n", prio_num, line_num, prefix, working_mark, DONE_COLOR, ICON_DONE, prio_mark, tag_html, color_start, task_text, color_end
			}
		} else {
			if (is_due_today) {
				printf "today|%d|%d|%s%s<span color=\"%s\">%s</span> %s%s%s%s%s\n", prio_num, line_num, prefix, working_mark, DUE_COLOR, SMALL_DUE_ICON, prio_mark, tag_html, color_start, task_text, color_end
			} else if (is_future) {
				printf "future|%d|%d|%s%s<span color=\"%s\">%s</span> %s%s%s%s%s\n", prio_num, line_num, prefix, working_mark, OPEN_COLOR, ICON_TODO, prio_mark, tag_html, color_start, task_text, color_end
			} else {
				printf "general|%d|%d|%s%s<span color=\"%s\">%s</span> %s%s%s%s%s\n", prio_num, line_num, prefix, working_mark, OPEN_COLOR, ICON_TODO, prio_mark, tag_html, color_start, task_text, color_end
			}
		}
	}' < <(awk '{ print NR "|" $0 }' "$TODO_FILE")
  )

  # Every emitted row is "line_number|markup", header rows using 0. The
  # caller splits that apart: rofi is shown only the markup, and the line
  # numbers are kept in a bash array indexed the same way. They used to
  # be sent to rofi as part of the row, so every task in the list was
  # displayed with a bare "12|" glued to the front of it.
  header() {
    printf '0|<b><span color="%s">%s</span>  %s</b>\0meta\x1fnonselectable\x1ftrue\n' \
      "$HEADER_COLOR" "$1" "$2"
  }

  if [[ "$session_index" == "$SESSION_TODAY" ]]; then
    header "$ICON_DUE" "TODAY'S TODOS"
    echo "$all_formatted_lines" | grep '^today|' | sort -t'|' -k2,2nr | cut -d'|' -f3-
  elif [[ "$session_index" == "$SESSION_FUTURE" ]]; then
    header "$ICON_DUE" "FUTURE TASKS"
    echo "$all_formatted_lines" | grep '^future|' | sort -t'|' -k2,2nr | cut -d'|' -f3-
  elif [[ "$session_index" == "$SESSION_GENERAL" ]]; then
    header "$ICON_TODO" "GENERAL TASKS"
    echo "$all_formatted_lines" | grep '^general|' | sort -t'|' -k2,2nr | cut -d'|' -f3-
  elif [[ "$session_index" == "$SESSION_DONE" ]]; then
    header "$ICON_DONE_TODAY" "DONE TODAY"
    echo "$all_formatted_lines" | grep '^done_today|' | sort -t'|' -k2,2nr | cut -d'|' -f3-
    header "$ICON_DONE" "ALL DONE"
    echo "$all_formatted_lines" | grep '^done_all|' | sort -t'|' -k2,2nr | cut -d'|' -f3-
  fi
}

update_parent_task_status() {
  local parent_line="$1"

  # Check all subtasks of this parent
  local total_subtasks
  local done_subtasks

  total_subtasks=$(grep -Fc "@Parent(${parent_line})" "$SUBTASK_FILE")
  done_subtasks=$(grep -F "@Parent(${parent_line})" "$SUBTASK_FILE" | grep -cE "^[[:space:]]*- \[x\]")

  if [[ $total_subtasks -gt 0 && $total_subtasks -eq $done_subtasks ]]; then
    # All subtasks done: mark parent task done
    local parent_task_line
    parent_task_line=$(sed "${parent_line}q;d" "$TODO_FILE")

    if [[ "$parent_task_line" == *"- [ ]"* ]]; then
      TASK_TEXT_WITH_PRIO=$(echo "$parent_task_line" | sed -E 's/^- \[[x ]\] ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//')
      new_timestamp=$(date "+@%Y-%m-%d %H:%M")
      NEW_LINE="- [x] ${TASK_TEXT_WITH_PRIO} ${new_timestamp}"
      ${SED_COMMAND} "${parent_line}c${NEW_LINE}" "$TODO_FILE"
      ${SED_COMMAND} "/^${parent_line}$/d" "$WORKING_FILE"
    fi
  else
    # Not all subtasks done: mark parent task not done if currently done
    local parent_task_line
    parent_task_line=$(sed "${parent_line}q;d" "$TODO_FILE")

    if [[ "$parent_task_line" == *"- [x]"* ]]; then
      ${SED_COMMAND} "${parent_line}s/\[x\]/[ ]/" "$TODO_FILE"
    fi
  fi
}

# MAIN LOOP
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
while true; do
  SESSION_TITLE="${SESSIONS[$current_session_index]}"
  SESSION_ICON=""
  case "$current_session_index" in
  "$SESSION_TODAY") SESSION_ICON="${ICON_DUE}" ;;
  "$SESSION_FUTURE") SESSION_ICON="${ICON_DUE}" ;;
  "$SESSION_GENERAL") SESSION_ICON="${ICON_TODO}" ;;
  "$SESSION_DONE") SESSION_ICON="${ICON_DONE}" ;;
  esac

  # Rows come back as "line_number|markup". Split them so rofi only ever
  # sees the markup, and recover the line number by index afterwards.
  #
  # Via a file rather than a bash array: the header rows carry rofi's
  # "\0meta\x1fnonselectable" suffix, and a NUL cannot survive inside a
  # bash string — read into a variable, the headers would lose their
  # metadata and become selectable rows displaying the raw markup.
  ROWS_FILE=$(mktemp)
  get_session_content "$current_session_index" >"$ROWS_FILE"
  mapfile -t ROW_LINES < <(cut -d'|' -f1 "$ROWS_FILE")

  # Alt is dead in hardware on this laptop and survives only as an
  # xmodmap remap of Caps Lock (see `mod2` in qtile's config.py), so
  # every Alt binding here is one xmodmap hiccup from doing nothing.
  # Ctrl+Shift+<same letter> is the reliable half; Alt stays as an alias.
  # Spelt "Control+A", not "Control+Shift+a": rofi matches on the keysym
  # X actually delivers, and with shift held that is the capital. The
  # Shift+ spelling parses without complaint and then never fires --
  # rofi's own defaults write Control+V for paste for this reason.
  SELECTED_INDEX=$(cut -d'|' -f2- "$ROWS_FILE" | rofi -theme ~/.config/rofi/themes/todo-large.rasi -dmenu \
    -p "<span color='${HEADER_COLOR}'>${SESSION_ICON}</span> ${SESSION_TITLE}" \
    -mesg "<b>^A</b> add · <b>^D</b> del · <b>^E</b> edit · <b>^W</b> working · <b>^T</b> date · <b>^P</b> prio · <b>^S/^U</b> subtasks · <b>Ctrl+y</b> ${ICON_YANK} yank · <b>^H/^L</b> session" \
    -markup-rows \
    -i \
    -kb-custom-1 "Alt+a,Control+A" \
    -kb-custom-2 "Alt+d,Control+D" \
    -kb-custom-3 "Alt+w,Control+W" \
    -kb-custom-4 "Alt+e,Control+E" \
    -kb-custom-5 "Alt+t,Control+T" \
    -kb-custom-6 "Alt+p,Control+P" \
    -kb-custom-7 "Alt+h,Control+H" \
    -kb-custom-8 "Alt+l,Control+L" \
    -kb-custom-9 "Alt+s,Control+S" \
    -kb-custom-10 "Alt+u,Control+U" \
    -kb-custom-11 "Control+y" \
    -format 'i')
  EXIT_CODE=$?
  rm -f "$ROWS_FILE"

  LINE_NUMBER=""
  if [[ "$SELECTED_INDEX" =~ ^[0-9]+$ ]] && [[ -n "${ROW_LINES[$SELECTED_INDEX]:-}" ]]; then
    LINE_NUMBER="${ROW_LINES[$SELECTED_INDEX]}"
    # 0 marks a section header, which carries no task.
    [[ "$LINE_NUMBER" == "0" ]] && LINE_NUMBER=""
  fi

  # Adding a task and switching session are the two actions that do not
  # need one, so they run before the "nothing selected" bail-out.
  case $EXIT_CODE in
  16)
    current_session_index=$(((current_session_index - 1 + ${#SESSIONS[@]}) % ${#SESSIONS[@]}))
    continue
    ;;
  17)
    current_session_index=$(((current_session_index + 1) % ${#SESSIONS[@]}))
    continue
    ;;
  esac

  if [[ -z "$LINE_NUMBER" && $EXIT_CODE -ne 10 ]]; then
    if [[ $EXIT_CODE -eq 1 ]]; then
      exit 0
    fi
    continue
  fi

  # Add-task (10) is reached with no selection, so there is no line to read.
  LINE_CONTENT=""
  [[ -n "$LINE_NUMBER" ]] && LINE_CONTENT=$(sed "${LINE_NUMBER}q;d" "$TODO_FILE")

  # Plain Simplenote lines ("7- fix the rofi scripts") are shown as open
  # todos but are not checkboxes on disk, so every mutation below would
  # miss them. Normalise this one line — and only when the user actually
  # acts on it, so merely opening the menu never rewrites the note.
  if [[ -n "$LINE_NUMBER" ]] &&
     [[ ! "$LINE_CONTENT" =~ ^[[:space:]]*-\ \[[x\ ]\] ]] &&
     [[ "$LINE_CONTENT" =~ ^[0-9]+[[:space:]]*-[[:space:]]*[^[:space:]] ]]; then
    NORMALISED="- [ ] $(sed -E 's/^[0-9]+[[:space:]]*-[[:space:]]*//' <<<"$LINE_CONTENT")"
    ${SED_COMMAND} "${LINE_NUMBER}c${NORMALISED}" "$TODO_FILE"
    LINE_CONTENT="$NORMALISED"
  fi

  case $EXIT_CODE in
  0) # Toggle done
    if [[ "$LINE_CONTENT" == *"- [ ]"* ]]; then
      TASK_TEXT_WITH_PRIO=$(echo "$LINE_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//')
      new_timestamp=$(date "+@%Y-%m-%d %H:%M")
      NEW_LINE="- [x] ${TASK_TEXT_WITH_PRIO} ${new_timestamp}"
      ${SED_COMMAND} "${LINE_NUMBER}c${NEW_LINE}" "$TODO_FILE"
      ${SED_COMMAND} "/^${LINE_NUMBER}$/d" "$WORKING_FILE"
    elif [[ "$LINE_CONTENT" == *"- [x]"* ]]; then
      ${SED_COMMAND} "${LINE_NUMBER}s/\[x\]/[ ]/" "$TODO_FILE"
    fi
    ;;

  10) # MODIFIED: Add Task
    # Add Task section
    NEW_TODO=$(echo "" | rofi -theme ~/.config/rofi/themes/todo-large.rasi \
      -dmenu -p "${ICON_ADD} Add (-h|-n|-l)(-c color)(# tag)" -filter "")

    if [ -n "$NEW_TODO" ]; then
      TASK_TEXT="$NEW_TODO"
      PRIORITY="normal"
      COLOR_TAG=""

      # Extract color tag first
      if [[ "$TASK_TEXT" =~ -c[[:space:]]([^[:space:]]+) ]]; then
        color_val="${BASH_REMATCH[1]}"
        COLOR_TAG="@Color(${color_val})"
        TASK_TEXT=$(echo "$TASK_TEXT" | sed -E "s/-c[[:space:]]${color_val}[[:space:]]?//")
      fi

      # Extract priority tag from the remaining text
      if [[ "$TASK_TEXT" =~ ^-[hH] ]]; then
        PRIORITY="high"
        TASK_TEXT="${TASK_TEXT:2}"
      elif [[ "$TASK_TEXT" =~ ^-[nN] ]]; then
        PRIORITY="normal"
        TASK_TEXT="${TASK_TEXT:2}"
      elif [[ "$TASK_TEXT" =~ ^-[lL] ]]; then
        PRIORITY="low"
        TASK_TEXT="${TASK_TEXT:2}"
      fi

      TASK_TEXT=$(echo "$TASK_TEXT" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

      # Convert #tags to @Tag(name)@Color(random) if COLOR_TAG not set
      TASK_TEXT=$(echo "$TASK_TEXT" | sed -E "s/#([a-zA-Z0-9_]+)/@Tag(\1)/g")

      timestamp=$(date "+@%Y-%m-%d %H:%M")

      # Assemble the final line
      FINAL_LINE="- [ ] @Prio(${PRIORITY}) ${COLOR_TAG} ${TASK_TEXT} ${timestamp}"
      FINAL_LINE=$(echo "$FINAL_LINE" | sed 's/  / /g') # Clean up double spaces

      # Append to file safely
      printf "%s\n" "$FINAL_LINE" >>"$TODO_FILE"
    fi
    ;;
  11) # Delete (with confirmation)
    TASK_PREVIEW=$(echo "$LINE_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ ?@Prio\((low|normal|high)\) ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//' | head -c 80)
    ROFI_THEME="$HOME/.config/rofi/themes/todo-large.rasi" rofi_confirm "Delete task?" "$TASK_PREVIEW" || continue
    ${SED_COMMAND} "${LINE_NUMBER}d" "$TODO_FILE"
    ${SED_COMMAND} "/^${LINE_NUMBER}$/d" "$WORKING_FILE"
    # Also drop orphaned subtasks pointing to this parent line.
    ${SED_COMMAND} "/@Parent(${LINE_NUMBER})/d" "$SUBTASK_FILE"
    notify_safe "🗑️  Task deleted"
    ;;
  12) # Toggle Working On
    if grep -Fxq "$LINE_NUMBER" "$WORKING_FILE"; then
      ${SED_COMMAND} "/^${LINE_NUMBER}$/d" "$WORKING_FILE"
    else
      echo "$LINE_NUMBER" >>"$WORKING_FILE"
    fi
    ;;

  13) # Edit
    TASK_TEXT_WITH_PRIO=$(echo "$LINE_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//')
    CURRENT_TEXT_ONLY=$(echo "$TASK_TEXT_WITH_PRIO" | sed -E 's/ ?@Prio\((low|normal|high)\) ?//')

    OLD_PRIORITY_TAG=$(echo "$TASK_TEXT_WITH_PRIO" | grep -oE "@Prio\((low|normal|high)\)")

    EDIT_PROMPT_TEXT="${CURRENT_TEXT_ONLY}"
    EDITED_INPUT=$(rofi -dmenu -theme ~/.config/rofi/themes/todo-large.rasi \
      -p "${ICON_EDIT} Edit" \
      -mesg "Edit task (optional: -h, -n, -l to change priority)" \
      -filter "$EDIT_PROMPT_TEXT")

    if [ -n "$EDITED_INPUT" ]; then
      NEW_PRIORITY_TAG="$OLD_PRIORITY_TAG"
      EDITED_TEXT="$EDITED_INPUT"
      if [[ "$EDITED_INPUT" =~ ^-[hH][[:space:]]? ]]; then
        NEW_PRIORITY_TAG="@Prio(high)"
        EDITED_TEXT="${EDITED_INPUT:2}"
      elif [[ "$EDITED_INPUT" =~ ^-[nN][[:space:]]? ]]; then
        NEW_PRIORITY_TAG="@Prio(normal)"
        EDITED_TEXT="${EDITED_INPUT:2}"
      elif [[ "$EDITED_INPUT" =~ ^-[lL][[:space:]]? ]]; then
        NEW_PRIORITY_TAG="@Prio(low)"
        EDITED_TEXT="${EDITED_INPUT:2}"
      fi
      EDITED_TEXT=$(echo "$EDITED_TEXT" | sed 's/^[[:space:]]*//')
      TASK_STATE=$(echo "$LINE_CONTENT" | grep -oE "\[[x ]\]")
      NEW_TIMESTAMP=$(date "+@%Y-%m-%d %H:%M")
      NEW_LINE="- ${TASK_STATE} ${NEW_PRIORITY_TAG} ${EDITED_TEXT} ${NEW_TIMESTAMP}"
      NEW_LINE=$(echo "$NEW_LINE" | sed -E 's/ +/ /g; s/ $//')
      ${SED_COMMAND} "${LINE_NUMBER}c${NEW_LINE}" "$TODO_FILE"
    fi
    ;;
  14) # Change Date (Alt+t)
    NEW_DATE_CHOICE=$(echo -e "Today\nTomorrow\nNext Week\nCustom Date\n(remove)" | rofi -theme ~/.config/rofi/themes/todo-large.rasi -dmenu -p "Select a New Date")

    if [ -n "$NEW_DATE_CHOICE" ]; then
      NEW_DATE=""
      case "$NEW_DATE_CHOICE" in
      "Today") NEW_DATE=$(date "+%Y-%m-%d") ;;
      "Tomorrow") NEW_DATE=$(date --date="tomorrow" "+%Y-%m-%d") ;; # Corrected for BSD/macOS date
      "Next Week") NEW_DATE=$(date --date="+7 days" "+%Y-%m-%d") ;; # Corrected for BSD/macOS date
      "Custom Date")
        NEW_DATE=$(rofi -theme ~/.config/rofi/themes/todo-large.rasi -dmenu -p "Enter a custom date (YYYY-MM-DD)")
        if ! [[ "$NEW_DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then NEW_DATE=""; fi
        ;;
      "(remove)") NEW_DATE="" ;;
      *) continue ;;
      esac

      TASK_TEXT_WITH_PRIO=$(echo "$LINE_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//')
      TASK_STATE=$(echo "$LINE_CONTENT" | grep -oE "\[[x ]\]")
      TASK_TIME=$(echo "$LINE_CONTENT" | grep -oE "[0-9]{2}:[0-9]{2}")

      if [ -n "$NEW_DATE" ]; then
        NEW_LINE="- ${TASK_STATE} ${TASK_TEXT_WITH_PRIO} @${NEW_DATE} ${TASK_TIME}"
      else
        NEW_LINE="- ${TASK_STATE} ${TASK_TEXT_WITH_PRIO}"
      fi

      NEW_LINE=$(echo "$NEW_LINE" | sed -E 's/ +/ /g; s/ $//')
      ${SED_COMMAND} "${LINE_NUMBER}c${NEW_LINE}" "$TODO_FILE"
    fi
    ;;
  15) # Change Priority (Alt+p)
    NEW_PRIORITY=$(echo -e "high\nnormal\nlow" | rofi -theme ~/.config/rofi/themes/todo-large.rasi -dmenu -p "Change Priority")
    if [ -n "$NEW_PRIORITY" ]; then
      NEW_PRIORITY_TAG="@Prio(${NEW_PRIORITY})"
      TASK_TEXT=$(echo "$LINE_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ ?@Prio\((low|normal|high)\) ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//')
      TASK_STATE=$(echo "$LINE_CONTENT" | grep -oE "\[[x ]\]")
      OLD_TIMESTAMP=$(echo "$LINE_CONTENT" | grep -oE " @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$")

      NEW_LINE="- ${TASK_STATE} ${NEW_PRIORITY_TAG} ${TASK_TEXT}${OLD_TIMESTAMP}"
      NEW_LINE=$(echo "$NEW_LINE" | sed -E 's/ +/ /g; s/ $//')
      ${SED_COMMAND} "${LINE_NUMBER}c${NEW_LINE}" "$TODO_FILE"
    fi
    ;;
  # 16 and 17 (session switching) are handled before the selection
  # check above, since they need no task.

  18) # Add Subtask (Ctrl+Shift+S / Alt+s)
    PARENT_LINE="$LINE_NUMBER"
    SUBTASK_INPUT=$(rofi -theme ~/.config/rofi/themes/todo-large.rasi -dmenu -p "${ICON_ADD} Add Subtask")

    if [ -n "$SUBTASK_INPUT" ]; then
      # This no longer adds the redundant parent task name
      TIMESTAMP=$(date "+@%Y-%m-%d %H:%M")
      NEW_LINE="- [ ] ${SUBTASK_INPUT} @Parent(${PARENT_LINE}) ${TIMESTAMP}"
      echo "$NEW_LINE" >>"$SUBTASK_FILE"
    fi
    ;;

  19) # View and toggle Subtasks (Ctrl+Shift+U / Alt+u)
    PARENT_LINE="$LINE_NUMBER"
    if [[ -z "$PARENT_LINE" ]]; then continue; fi

    # Get the clean parent task name for the Rofi title
    PARENT_TASK_TEXT=$(echo "$LINE_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ ?@Prio\((low|normal|high)\) ?//; s/ ?@Color\([^)]+\) ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//; s/^[ ]*//; s/[ ]*$//')

    while true; do
      # Read subtasks from file, prepending their line number
      mapfile -t SUBTASKS < <(nl -w1 -s'|' "$SUBTASK_FILE" | $AWK_COMMAND -v pline="$PARENT_LINE" -v icon_done="$ICON_DONE" -v icon_todo="$ICON_TODO" '
				BEGIN { FS = "|" }
				# Find subtasks for the selected parent
				$2 ~ "@Parent\\(" pline "\\)" {
					line_num_in_file = $1
					text = $2
					icon = (text ~ /^\s*- \[x\]/) ? icon_done : icon_todo
					
					# Clean the text for display, removing all tags and metadata
					sub(/^[-] \[[x ]\] ?/, "", text);
					sub(/ ?@Prio\([^)]+\) ?/, "", text);
					sub(/ ?@Color\([^)]+\) ?/, "", text);
					sub(/ ?@Parent\([^)]+\) ?/, "", text);
					sub(/ @.*/, "", text); # Aggressively clean up old, malformed tags like "@MainTaskName @date"
					gsub(/^[[:space:]]*|[[:space:]]*$/, "", text);
					
					# Escape special characters for Pango markup
					gsub(/&/, "&amp;", text); gsub(/</, "&lt;", text); gsub(/>/, "&gt;", text);
					
					# Final format: "line_number|icon Formatted Text"
					printf "%s|%s %s\n", line_num_in_file, icon, text
				}
			')

      if [ ${#SUBTASKS[@]} -eq 0 ]; then
        rofi -e "No subtasks found"
        break
      fi

      # Show the subtask menu. Note the new keybinding and message.
      SELECTED_INDEX=$(printf '%s\n' "${SUBTASKS[@]}" | cut -d'|' -f2- | rofi -theme ~/.config/rofi/themes/todo-large.rasi \
        -dmenu -markup-rows \
        -p "Subtasks for: ${PARENT_TASK_TEXT}" \
        -mesg "<b>Enter:</b> Toggle Done | <b>Ctrl+y:</b> Yank" \
        -format 'i' \
        -kb-custom-1 "Control+y")
      SUB_EXIT_CODE=$?

      # Exit subtask menu if Esc is pressed
      if [[ $SUB_EXIT_CODE -eq 1 ]]; then break; fi
      # Loop again if nothing was selected
      if [[ ! "$SELECTED_INDEX" =~ ^[0-9]+$ ]]; then continue; fi

      # Get the subtask's line number from our array
      SUBTASK_LINE_DATA="${SUBTASKS[$SELECTED_INDEX]}"
      SUBTASK_LINE_NUM=$(echo "$SUBTASK_LINE_DATA" | cut -d'|' -f1)
      if [[ -z "$SUBTASK_LINE_NUM" ]]; then continue; fi

      case $SUB_EXIT_CODE in
      0) # Toggle Done (Enter)
        CUR_LINE=$(sed "${SUBTASK_LINE_NUM}q;d" "$SUBTASK_FILE")
        if [[ "$CUR_LINE" == *"[x]"* ]]; then
          NEW_LINE=$(echo "$CUR_LINE" | sed 's/\[x\]/[ ]/')
        else
          NEW_LINE=$(echo "$CUR_LINE" | sed 's/\[ \]/[x]/')
        fi
        ${SED_COMMAND} "${SUBTASK_LINE_NUM}s/.*/${NEW_LINE}/" "$SUBTASK_FILE"
        update_parent_task_status "$PARENT_LINE"
        ;;
      10) # Yank Subtask (Ctrl+y)
        SUBTASK_CONTENT=$(sed "${SUBTASK_LINE_NUM}q;d" "$SUBTASK_FILE")
        # Extract clean text for clipboard
        SUBTASK_TEXT_ONLY=$(echo "$SUBTASK_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ ?@Prio\(([^)]+)\) ?//; s/ ?@Color\(([^)]+)\) ?//; s/ ?@Parent\(([^)]+)\) ?//; s/ @.*//; s/^[ ]*//; s/[ ]*$//')
        copy_to_clipboard "$SUBTASK_TEXT_ONLY"
        ;;
      esac
      # Loop to refresh the subtask list
    done
    ;;
  20) # NEW: Yank Task to Clipboard (Ctrl+y)
    TASK_TEXT_ONLY=$(echo "$LINE_CONTENT" | sed -E 's/^- \[[x ]\] ?//; s/ ?@Prio\((low|normal|high)\) ?//; s/ ?@Color\([^)]+\) ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//; s/^[ ]*//; s/[ ]*$//')
    copy_to_clipboard "$TASK_TEXT_ONLY"
    notify_safe "📋 Copied task"
    continue # Re-show the list
    ;;
  1 | *) # Escape or unexpected exit code
    exit 0
    ;;
  esac
done
