#!/usr/bin/env bash
# ati-todo-popup — JSON-in/JSON-out backend for the QML todo popup
# (quickshell/ati-menu/plugins/todo/Todo.qml), on $mod P T.
#
# WHY A NEW SCRIPT AND NOT rofi_todo ITSELF
# ------------------------------------------
# rofi_todo IS the file format's owner (~400 lines: four session tabs,
# priority/colour tags, subtasks, a working-on marker, inline edit,
# due-date changes, yank) and stays exactly as it is — this does not touch
# it and does not replace it. What this adds is a FIRST QML surface for
# the two actions asked for: "list + add + toggle done" (list shape, same
# as wallpaper/volume/bluetooth already have in QML — see popups.qml's own
# header for that convention). Priorities, colour tags, subtasks, session
# tabs, inline edit, due-date changes and yank stay on rofi_todo, still
# reachable on the same key it always had.
#
# SAME FILES, SAME LOCK, ON PURPOSE
# ----------------------------------
# TODO_FILE and LOCK_FILE below are byte-identical to rofi_todo's own —
# same directory, same filename, same flock. A task added or checked off
# here shows up in rofi_todo and vice versa; there is exactly one list, two
# ways to touch it, exactly like the anki card has three ways to fill in
# the same seven-key JSON contract.
#
# Subcommands:
#   ati-todo-popup list            -> JSON array of open tasks
#   ati-todo-popup list-done       -> JSON array of done tasks
#   ati-todo-popup toggle <line>   -> flip that line's checkbox
#   ati-todo-popup add "<text>"    -> append a new open task
#
# `list-done` is v2's Tab-to-done-tab addition: same recognisers, same
# JSON shape (plus `doneAt`), just the opposite `[x]` test — kept as a
# second subcommand rather than a `--done` flag on `list` so a caller
# needs no branching to build the right argv, matching `toggle`/`add`'s
# own one-verb-per-line shape.
set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
require_cmd() { local c; for c; do command -v "$c" >/dev/null 2>&1 || { echo "ati-todo-popup: missing $c" >&2; return 1; }; done; }
require_cmd jq gawk flock sed || exit 1

USER_NAME="$(whoami | tr '[:lower:]' '[:upper:]')"
TODOS_DIR="$HOME/${USER_NAME}TODOS"
TODO_FILE="$TODOS_DIR/TODOS.md"
LOCK_FILE="$TODOS_DIR/.rofi_todo.lock"
mkdir -p "$TODOS_DIR"
touch "$TODO_FILE" "$LOCK_FILE"

sed_i() { sed -i "$@"; }

CMD="${1:-list}"

case "$CMD" in
list)
  # Same recognisers rofi_todo's own awk block uses: a real checkbox line,
  # or a Simplenote plain-numbered line ("7- fix the rofi scripts") shown
  # as an open task without being rewritten on disk — display-only, same
  # as rofi_todo does until the line is actually touched.
  #
  # One JSON OBJECT per line, no brackets, no commas — `jq -s` (slurp)
  # below builds the array. The first cut here hand-built the array with
  # a `(line_num > 1 ? "," : "")` comma guard, which tracked the FILE's
  # line number instead of "is this the first EMITTED row" — the first
  # matching task is essentially never on line 1, so that guard was true
  # on the very first row too and every call emitted `[\n,{...}` — invalid
  # JSON, on every single list with at least one task. QML's JSON.parse
  # then threw, `tasks` reset to `[]`, and the popup looked like it had
  # added nothing — reported as "todo not adding", when the add itself
  # (confirmed against TODO_FILE directly) was working the whole time.
  # jq -s sidesteps the count-tracking entirely, including the zero-task
  # case (`[]`, not `[\n]`).
  gawk -v today="$(date "+%Y-%m-%d")" '
    {
      line_num = NR
      line_text = $0
      if (!match(line_text, /^- \[[x ]\]/)) {
        if (match(line_text, /^[0-9]+[[:space:]]*-[[:space:]]*[^[:space:]]/)) {
          sub(/^[0-9]+[[:space:]]*-[[:space:]]*/, "", line_text)
          line_text = "- [ ] " line_text
        } else next
      }
      if (index(line_text, "[x]") > 0) next   # done — not this list

      task_text = line_text
      sub(/^- \[ \] ?/, "", task_text)

      prio = "normal"
      if (match(task_text, /@Prio\((high|normal|low)\)/, m)) prio = m[1]
      sub(/ ?@Prio\((high|normal|low)\) ?/, "", task_text)
      sub(/ ?@Color\([^)]+\) ?/, "", task_text)
      gsub(/@Tag\(([^)]+)\)/, "#\\1", task_text)

      due = ""
      if (match(task_text, /@[0-9]{4}-[0-9]{2}-[0-9]{2}/)) due = substr(task_text, RSTART+1, RLENGTH-1)
      sub(/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$/, "", task_text)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", task_text)
      if (task_text == "") next

      due_today = (due == today) ? "true" : "false"
      printf "{\"line\":%d,\"text\":%s,\"prio\":%s,\"due\":%s,\"dueToday\":%s}\n", \
        line_num, json_escape(task_text), json_escape(prio), json_escape(due), due_today
    }
    function json_escape(s,   r) { r = s; gsub(/\\/, "\\\\", r); gsub(/"/, "\\\"", r); return "\"" r "\"" }
  ' "$TODO_FILE" | jq -s '.'
  ;;

list-done)
  # Same shape as `list`, mirrored: DONE lines only, plus `doneAt` (the
  # trailing @timestamp, which on a done line is when it was checked off
  # rather than a due date — rofi_todo's own DONE_COLOR rows read the same
  # field the same way). Subtask lines (leading whitespace) are skipped —
  # subtasks live in a separate file this script never reads, same as v1.
  gawk '
    {
      line_num = NR
      line_text = $0
      if (!match(line_text, /^- \[x\]/)) next
      if (match(line_text, /^[[:space:]]/)) next   # a subtask line, not this file anyway

      task_text = line_text
      sub(/^- \[x\] ?/, "", task_text)

      prio = "normal"
      if (match(task_text, /@Prio\((high|normal|low)\)/, m)) prio = m[1]
      sub(/ ?@Prio\((high|normal|low)\) ?/, "", task_text)
      sub(/ ?@Color\([^)]+\) ?/, "", task_text)
      gsub(/@Tag\(([^)]+)\)/, "#\\1", task_text)

      done_at = ""
      if (match(task_text, /@[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$/)) {
        done_at = substr(task_text, RSTART+1, RLENGTH-1)
      }
      sub(/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$/, "", task_text)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", task_text)
      if (task_text == "") next

      printf "{\"line\":%d,\"text\":%s,\"prio\":%s,\"due\":%s,\"dueToday\":false,\"doneAt\":%s}\n", \
        line_num, json_escape(task_text), json_escape(prio), json_escape(""), json_escape(done_at)
    }
    function json_escape(s,   r) { r = s; gsub(/\\/, "\\\\", r); gsub(/"/, "\\\"", r); return "\"" r "\"" }
  ' "$TODO_FILE" | jq -s 'sort_by(.doneAt) | reverse'
  ;;

toggle)
  LINE="${2:-}"
  [[ "$LINE" =~ ^[0-9]+$ ]] || { echo "ati-todo-popup: toggle needs a line number" >&2; exit 1; }
  exec 9>"$LOCK_FILE"
  flock 9
  CONTENT="$(sed "${LINE}q;d" "$TODO_FILE")"
  # Same lazy-normalise-on-touch rofi_todo does for a Simplenote line.
  if [[ ! "$CONTENT" =~ ^[[:space:]]*-\ \[[x\ ]\] ]] && [[ "$CONTENT" =~ ^[0-9]+[[:space:]]*-[[:space:]]*[^[:space:]] ]]; then
    CONTENT="- [ ] $(sed -E 's/^[0-9]+[[:space:]]*-[[:space:]]*//' <<<"$CONTENT")"
  fi
  if [[ "$CONTENT" == *"- [ ]"* ]]; then
    TEXT_PART="$(sed -E 's/^- \[[x ]\] ?//; s/ @[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?$//' <<<"$CONTENT")"
    TS="$(date "+@%Y-%m-%d %H:%M")"
    NEW_LINE="- [x] ${TEXT_PART} ${TS}"
    sed_i "${LINE}c${NEW_LINE}" "$TODO_FILE"
  elif [[ "$CONTENT" == *"- [x]"* ]]; then
    sed_i "${LINE}s/\[x\]/[ ]/" "$TODO_FILE"
  fi
  echo '{"ok":true}'
  ;;

add)
  TEXT="${2:-}"
  [[ -n "${TEXT// }" ]] || { echo "ati-todo-popup: add needs text" >&2; exit 1; }
  exec 9>"$LOCK_FILE"
  flock 9

  # "the new todos from the todo popup should appear in TODOS.md ... under
  # ### todos, fix this" — this was a plain `>> "$TODO_FILE"` append, which
  # lands at the END OF THE FILE regardless of what section is there. On a
  # file that also holds `### words` (the translate popup's saves) and a
  # `### <date>_research_notes` section per day (ati-note-capture), "the
  # end of the file" is whichever of those happened to be written last —
  # so a task added today landed inside TODAY's research notes, not any
  # kind of todos section. `list`/`list-done`/`toggle` never cared WHICH
  # section a checkbox line sits in (they scan the whole file), so this
  # went unnoticed until someone opened TODOS.md directly ($mod SHIFT S)
  # and found tasks mixed into an unrelated section.
  #
  # Ensure the section exists once, then always insert the new task
  # directly under its header — newest task first in the section, same
  # "add lands at the top" shape a session tab would give without needing
  # one. `head`/`tail` splicing rather than sed's multi-line `a\`, which is
  # exactly the kind of escaping this script already had one comma-guard
  # bug from getting subtly wrong once (see `list`'s own header).
  if ! grep -qxF "### todos" "$TODO_FILE"; then
    {
      if [[ "$(head -n1 "$TODO_FILE")" == "# TODOS" ]]; then
        head -n1 "$TODO_FILE"
        printf '\n### todos\n'
        tail -n +2 "$TODO_FILE"
      else
        printf '### todos\n\n'
        cat "$TODO_FILE"
      fi
    } > "${TODO_FILE}.tmp" && mv "${TODO_FILE}.tmp" "$TODO_FILE"
  fi

  TS="$(date "+@%Y-%m-%d %H:%M")"
  # Same default-priority shape rofi_todo's own Add-Task case writes with
  # no -h/-n/-l prefix, so a task added here reads identically there.
  NEW_LINE="- [ ] @Prio(normal) ${TEXT} ${TS}"
  HDR_LINE="$(grep -nxF "### todos" "$TODO_FILE" | head -1 | cut -d: -f1)"
  {
    head -n "$HDR_LINE" "$TODO_FILE"
    printf '%s\n' "$NEW_LINE"
    tail -n +"$((HDR_LINE + 1))" "$TODO_FILE"
  } > "${TODO_FILE}.tmp" && mv "${TODO_FILE}.tmp" "$TODO_FILE"
  echo '{"ok":true}'
  ;;

*)
  echo "usage: ati-todo-popup list|list-done|toggle <line>|add <text>" >&2
  exit 2
  ;;
esac
