#!/usr/bin/env bash
# ati-capture-qr — decode a QR code from a screen region straight to the
# clipboard. Same freeze+region+capture pipeline as ati-capture-text, but
# deliberately does NOT reuse its OCR path for the decode step: zbarimg is
# run with -Sdisable -Sqrcode.enable so it only ever looks for QR symbols,
# not the half-dozen other barcode symbologies zbar supports by default,
# which false-positive constantly on ordinary dense screen content (text,
# icons) when left enabled -- Omarchy's own bin/omarchy-capture-qr makes
# this same deliberate choice.
#
# SECURITY: the decoded value goes to the clipboard via `wl-copy
# --sensitive` and NOWHERE else -- no notify-send of the content, no log
# line. QR codes routinely carry `otpauth://` 2FA secrets; printing one to
# a notification (which lands in notification history) or the journal
# would leak it. This is a security property of the original, not an
# implementation detail to simplify away.
set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=ati-rofi-common.sh
source "$SCRIPT_DIR/ati-rofi-common.sh"

require_cmd hyprpicker slurp grim zbarimg wl-copy || exit 1

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
  notify_safe "ati-capture-qr" "QR capture needs Hyprland/Wayland"
  exit 1
fi

hyprpicker -r -z >/dev/null 2>&1 &
freeze_pid=$!
sleep 0.15

region="$(slurp)"
kill "$freeze_pid" 2>/dev/null
wait "$freeze_pid" 2>/dev/null

[[ -z "$region" ]] && exit 0

value="$(grim -g "$region" - | zbarimg -Sdisable -Sqrcode.enable --raw -q - 2>/dev/null)"

if [[ -z "$value" ]]; then
  notify_safe "ati-capture-qr" "No QR code found"
  exit 1
fi

printf '%s' "$value" | wl-copy --sensitive
# Deliberately no notify-send of $value -- see header. A content-free
# confirmation is fine; the decoded value itself never appears here.
notify_safe "ati-capture-qr" "QR code copied to clipboard"
