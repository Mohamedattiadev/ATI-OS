#!/usr/bin/env bash
# ati-launch-webapp <url> [extra browser flags...] — launch a URL as an
# app-mode browser window (no tabs/address bar), the Exec= target every
# .desktop ati-webapp-install writes points at.
#
# Ported from Omarchy's bin/omarchy-launch-webapp (MIT, see NOTICE.md):
# find the session's default browser via xdg-settings, resolve its real
# Exec binary out of its own .desktop file (rather than guessing a binary
# name), and hand it --app=<url>. Adapted: no uwsm-app (Universal Wayland
# Session Manager isn't installed/used in this session, same reasoning
# NOTICE.md already gives for AppLibrary.qml's launch()), and qtile/X11 is
# handled the same way since app-mode Chromium-family browsers work
# identically under X11 -- this isn't a Wayland-only feature.
set -uo pipefail

[[ $# -ge 1 ]] || { echo "usage: ati-launch-webapp <url> [browser-flags...]" >&2; exit 2; }

url="$1"; shift
[[ "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || url="https://$url"

browser="$(xdg-settings get default-web-browser 2>/dev/null)"

case "$browser" in
  google-chrome*|brave*|microsoft-edge*|chromium*|vivaldi*) ;;
  *) browser="brave-browser.desktop" ;;
esac

exec_bin=""
for dir in "$HOME/.local/share/applications" /usr/share/applications; do
  f="$dir/$browser"
  [[ -f "$f" ]] || continue
  exec_bin="$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$f" | head -1)"
  [[ -n "$exec_bin" ]] && break
done

[[ -n "$exec_bin" ]] || { echo "ati-launch-webapp: could not resolve a browser Exec for $browser" >&2; exit 1; }

exec setsid "$exec_bin" --app="$url" "$@"
