#!/usr/bin/env bash
# Rofi-based CopyQ picker with vim (ctrl+j/k) nav + image thumbnails.
# alt+d deletes the highlighted entry, alt+p pin/unpin (via copyq), enter pastes.

set -euo pipefail

MAX=${1:-15}
TAB='&clipboard'
# Per-user scratch. Both of these were fixed paths in /tmp, which is shared:
# the first account to open the picker owns them mode 644, and every other
# account's write fails with EACCES -- no thumbnails, and an unstyled menu.
# XDG_RUNTIME_DIR is already per-user and mode 700; the fallback is
# namespaced by UID for sessions that do not set it.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/rofi-$(id -u)}"
mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
THUMBS="$RUNTIME_DIR/copyq-thumbs"
mkdir -p "$THUMBS"
rm -f "$THUMBS"/*.png 2>/dev/null || true

fetch_rows() {
  MAX="$MAX" TAB="$TAB" THUMBS="$THUMBS" copyq eval - <<'JSEOF'
var TAB = env("TAB");
var MAX = parseInt(env("MAX"));
var THUMBS = env("THUMBS");
tab(TAB);
var n = Math.min(count(), MAX);
var seen = {};
for (var i = 0; i < n; i++) {
  var d = getitem(i);
  var keys = Object.keys(d);
  var isImg = false;
  var pinned = false;
  for (var j = 0; j < keys.length; j++) {
    if (keys[j].indexOf("image/") == 0) isImg = true;
    if (keys[j] == "application/x-copyq-item-pinned") pinned = true;
  }
  var label = "";
  var icon = "";
  var dedupeKey = "";
  if (isImg) {
    var buf = read("image/png", i);
    if (buf && buf.size && buf.size() > 24) {
      icon = THUMBS + "/" + i + ".png";
      var f = new File(icon); f.open(); f.write(buf); f.close();
      var hdr = buf.mid(16, 8).toString();
      var w = (hdr.charCodeAt(0)<<24) | (hdr.charCodeAt(1)<<16) | (hdr.charCodeAt(2)<<8) | hdr.charCodeAt(3);
      var h = (hdr.charCodeAt(4)<<24) | (hdr.charCodeAt(5)<<16) | (hdr.charCodeAt(6)<<8) | hdr.charCodeAt(7);
      label = "image " + w + "×" + h;
      dedupeKey = "img:" + buf.size();
    } else {
      label = "image";
      dedupeKey = "img:" + i;
    }
  } else {
    var raw = str(d["text/plain"] || "");
    var t = raw.replace(/[\r\n\t]/g, " ").substring(0, 220);
    if (!t.length) { label = "<empty>"; dedupeKey = "empty:" + i; }
    else {
      var glyph = "";
      if (/^https?:\/\//.test(raw)) glyph = " ";
      else if (/^(\/|~\/|\.\/)/.test(raw)) glyph = " ";
      else if (/^\s*(git|sudo|cd|ls|npm|pnpm|yarn|cargo|python|node|pip|systemctl|docker|make|curl|wget|ssh|rsync)\s/.test(raw)) glyph = " ";
      else if (raw.indexOf("\n") >= 0) glyph = " ";
      label = glyph + t;
      dedupeKey = "txt:" + raw;
    }
  }
  if (seen[dedupeKey]) continue;
  seen[dedupeKey] = true;
  var pinMark = pinned ? "P" : " ";
  print(i + "\t" + pinMark + "\t" + label + "\t" + icon + "\n");
}
JSEOF
}

load_rows() { mapfile -t rows < <(fetch_rows); }
load_rows

# Ephemeral theme. Inherits dtos-center.rasi -- the same theme rofi_light
# and the plain launcher use -- so every picker in this setup is the same
# 45%-wide, 8-row box. It used to import base.rasi directly, which skips
# dtos-center's width and lines and left this menu wider than the rest.
THEME_FILE="$RUNTIME_DIR/copyq-rofi-theme.rasi"
cat > "$THEME_FILE" <<'RASI'
@import "~/.config/rofi/themes/dtos-center.rasi"

mainbox      { children: [inputbar, message, listview]; }
message      { padding: 4px 6px; border: 0; }
textbox      { text-color: inherit; }
listview     { fixed-height: 1; scrollbar: true; }
scrollbar    { width: 4px; }
element-icon { size: 48px; expand: false; }
RASI

esc_pango() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

build_input() {
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r idx pin label icon <<< "$row"
    [ -z "${idx:-}" ] && continue
    safe=$(esc_pango "$label")
    if [ "$pin" = "P" ]; then
      prefix=$(printf '<span alpha="50%%">%02d</span> <span foreground="#f2c94c"></span> ' "$idx")
    else
      prefix=$(printf '<span alpha="50%%">%02d</span>   ' "$idx")
    fi
    entry="${prefix}${safe}"
    if [ -n "${icon:-}" ] && [ -f "$icon" ]; then
      printf '%s\0icon\x1f%s\n' "$entry" "$icon"
    else
      printf '%s\n' "$entry"
    fi
  done
}

while true; do
  N=${#rows[@]}
  MESG=$(printf '<span alpha="60%%">%d entries · enter paste · alt+d del · alt+w view · esc quit</span>' "$N")
  set +e
  sel=$(build_input | rofi -dmenu -i \
    -p "clip" \
    -mesg "$MESG" \
    -show-icons \
    -markup-rows \
    -no-custom \
    -theme "$THEME_FILE" \
    -kb-custom-1 'Alt+d' \
    -kb-custom-2 'Alt+w' \
    -format 'i')
  rc=$?
  set -e

  # Exit codes: 0=Enter, 1=cancel, 10=custom-1 (delete), 11=custom-2 (edit), 12=custom-3 (view), 13=custom-4 (next tab)
  case $rc in
    0)
      [ -z "$sel" ] && exit 0
      [ "$sel" -ge "$N" ] && exit 0
      IFS=$'\t' read -r idx _ _ _ <<< "${rows[$sel]}"
      [ -z "$idx" ] && exit 0
      copyq eval - <<JSEOF2
tab("$TAB");
select($idx);
JSEOF2
      sleep 0.05
      xdotool key --clearmodifiers ctrl+v
      exit 0
      ;;
    10)
      [ -z "$sel" ] && exit 0
      [ "$sel" -ge "$N" ] && exit 0
      IFS=$'\t' read -r idx _ _ _ <<< "${rows[$sel]}"
      [ -z "$idx" ] && exit 0
      copyq eval - <<JSEOF3
tab("$TAB");
remove($idx);
JSEOF3
      load_rows
      [ "${#rows[@]}" -eq 0 ] && exit 0
      continue
      ;;
    11)
      [ -z "$sel" ] && exit 0
      [ "$sel" -ge "$N" ] && exit 0
      IFS=$'\t' read -r idx _ _ icon <<< "${rows[$sel]}"
      [ -z "$idx" ] && exit 0
      if [ -n "${icon:-}" ] && [ -f "$icon" ]; then
        # Image entry: reuse the thumb (raw PNG). imv is floated by qtile
        # via Match(wm_class="imv"). -s shrink prevents upscaling small clips.
        setsid imv -W 820 -H 500 -s shrink "$icon" >/dev/null 2>&1 < /dev/null &
        disown
      else
        tmp=$(mktemp --suffix=.txt /tmp/copyq-view.XXXXXX)
        copyq eval - > "$tmp" <<JSEOF5
tab("$TAB");
print(str(read($idx)));
JSEOF5
        setsid alacritty --class clip-view --title "clip-view" \
          -o "window.dimensions.columns=80" \
          -o "window.dimensions.lines=20" \
          -o "window.padding.x=8" \
          -o "window.padding.y=8" \
          -o "font.size=10" \
          -e nvim -R -c "set nonumber norelativenumber signcolumn=no laststatus=0" "$tmp" \
          >/dev/null 2>&1 < /dev/null &
        disown
      fi
      exit 0
      ;;
    *)
      exit 0
      ;;
  esac
done
