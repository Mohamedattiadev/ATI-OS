// dotfiles.script — animated plymouth boot splash: name, Arch mark, dots.
//
// Replaces the wall of scrolling kernel and mirror-list text Arch shows by
// default. The motion is not decoration: a boot with no movement is
// indistinguishable from a boot that has hung, which is the real problem.
//
// Everything drawn here is generated per-machine by `boot-splash` from the
// current username and the active theme palette, so a user called `beko`
// gets "Beko" in their own colours without editing this file.
//
// The composition, top to bottom:
//
//   the name, in ANSI Shadow block art, up in the upper third
//   the Arch mark, small and quiet
//   three dots
//
// The dots do two jobs at once, which is why there is no ring here any
// more. A ring large enough to read its arc became a second focal point
// competing with the name; a ring small enough not to read as a stray dot.
// Three dots are legible at a size that stays subordinate.
//
//   liveness  a wave travels through them continuously -- this keeps
//             moving even when plymouth reports no progress at all, which
//             is most of a fast boot
//   progress  they turn accent-coloured left to right as real progress
//             arrives, smoothly rather than one whole dot at a time
//
// The name is rendered SOLID: the ANSI Shadow face ships a drop shadow
// drawn in box-drawing characters, and filling those in the same colour as
// the letters produces a hollow double outline that reads as a cheap bevel
// rather than as depth.
//
// Plymouth's script language is not JavaScript despite appearances: no
// `let`, no closures, `fun` declares a function, and integer division
// truncates.

// ── palette (substituted by boot-splash) ────────────────────────────
// Flat: top and bottom are the same colour. Plymouth's only built-in
// background is this vertical gradient, and a lifted top was tried as a
// cheap vignette -- it pulled the result away from the flat dark field
// with one bright word on it that this is modelled on.
//
// This colour must match the static BMP boot-splash hands to systemd-boot.
// systemd-boot paints that bitmap before the kernel starts and plymouth's
// splash replaces it in place; if the two backgrounds differ, the handover
// is a visible flash.
Window.SetBackgroundTopColor(BGTOP_R, BGTOP_G, BGTOP_B);
Window.SetBackgroundBottomColor(BG_R, BG_G, BG_B);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

// ── assets ──────────────────────────────────────────────────────────
// Sizes are read from the images rather than substituted in: the
// generator scales them to the screen it was run on, and reading the real
// width here means the two cannot drift apart.
title_image = Image("title.png");
title_w = title_image.GetWidth();
title_h = title_image.GetHeight();

mark_image = Image("mark.png");
mark_w = mark_image.GetWidth();
mark_h = mark_image.GetHeight();

dot_image = Image("dot.png");
dot_ac_image = Image("dot_accent.png");
dot_w = dot_image.GetWidth();

// ── layout ──────────────────────────────────────────────────────────
// The indicator is anchored to the BOTTOM of the screen rather than hung
// underneath the name. Gluing it to the name is what produced the old
// top-heavy stack; giving it its own home near the bottom edge is what
// every boot screen that reads well actually does.
//
// These fractions are mirrored exactly in boot-splash's splash_layout, so
// the static BMP and this first frame are the same picture.
dot_gap = screen_height / 35;
dots_y  = screen_height * 81 / 100;
dots_w  = dot_w * 3 + dot_gap * 2;
dots_x  = screen_width / 2 - dots_w / 2;

mark_x = screen_width / 2 - mark_w / 2;
mark_y = dots_y - mark_h - screen_height / 22;

title_x = screen_width / 2 - title_w / 2;
title_y = screen_height * 38 / 100 - title_h / 2;

// Every sprite starts at its FINAL opacity. There is no fade-in, and that
// is deliberate: systemd-boot has already painted a static BMP of this
// exact composition before the kernel started, and plymouth takes over the
// framebuffer the instant it starts. Fading up from zero would make the
// picture already on screen vanish and then reappear -- strictly worse
// than no transition at all. The handover is invisible only if the first
// plymouth frame is identical to the bitmap it replaces.
title_sprite = Sprite(title_image);
title_sprite.SetX(title_x);
title_sprite.SetY(title_y);
title_sprite.SetZ(3);
title_sprite.SetOpacity(1);

mark_sprite = Sprite(mark_image);
mark_sprite.SetX(mark_x);
mark_sprite.SetY(mark_y);
mark_sprite.SetZ(3);
mark_sprite.SetOpacity(0.80);

// Two sprites per dot, stacked: the foreground one carries the liveness
// wave, the accent one on top fades in with progress. Cross-fading two
// fixed images is the only way to get a colour transition here -- plymouth
// script cannot tint an image, and pre-rendering a colour ramp would mean
// shipping frames for something two sprites do for free.
for (i = 0; i < 3; i++) {
  dot_sprite[i] = Sprite(dot_image);
  dot_sprite[i].SetX(dots_x + i * (dot_w + dot_gap));
  dot_sprite[i].SetY(dots_y);
  dot_sprite[i].SetZ(2);

  dot_ac_sprite[i] = Sprite(dot_ac_image);
  dot_ac_sprite[i].SetX(dots_x + i * (dot_w + dot_gap));
  dot_ac_sprite[i].SetY(dots_y);
  dot_ac_sprite[i].SetZ(3);
  dot_ac_sprite[i].SetOpacity(0);
}

// ── state ───────────────────────────────────────────────────────────
tick = 0;
progress = 0;
target_progress = 0;

// Plymouth calls this ~50x/second. Everything is phrased in ticks rather
// than seconds so the motion stays stable on hardware that refreshes
// slower than that.
//
// Budget: on this machine the splash is on screen for about five seconds.
// Every duration below is chosen against that, not against a hypothetical
// slow boot -- an effect with a period longer than the splash itself is an
// effect nobody ever sees.
fun refresh_callback() {
  tick++;

  // --- progress ------------------------------------------------------
  // Chase the target rather than jumping to it: plymouth reports progress
  // in coarse steps, and an indicator that teleports reads as broken.
  if (progress < target_progress)
    progress = progress + (target_progress - progress) / 14;

  // Creep forward even with no reported progress, capped below full so it
  // can never claim to have finished something it has not. Paced to the
  // real splash duration.
  drift = tick / 700;
  if (drift > 0.75) drift = 0.75;
  shown = progress;
  if (drift > shown) shown = drift;
  if (shown > 1) shown = 1;

  // --- dots ----------------------------------------------------------
  for (i = 0; i < 3; i++) {
    // Liveness wave. The phase offset per dot is what makes it travel
    // rather than all three pulsing together, which reads as a blink.
    // Sin() at tick 0 with i = 0 gives exactly the value boot-splash
    // renders into the static BMP, so the handover does not step.
    wave = 0.5 + 0.5 * Math.Sin(tick / 9 - i * 1.1);
    dot_sprite[i].SetOpacity(0.22 + 0.55 * wave);

    // Progress, spread across the three dots. Each dot takes a third, and
    // fades in over its share rather than snapping on -- three hard steps
    // over five seconds would read as three glitches.
    fill = shown * 3 - i;
    if (fill < 0) fill = 0;
    if (fill > 1) fill = 1;
    dot_ac_sprite[i].SetOpacity(fill);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, prog) {
  p = prog;
  if (p > 1.0) p = 1.0;
  if (p < 0.0) p = 0.0;
  target_progress = p;
}
Plymouth.SetBootProgressFunction(progress_callback);

// ── password prompt ─────────────────────────────────────────────────
// Only reached on an encrypted root. This config does not use one, but a
// themed splash that cannot ask for a passphrase would brick a machine
// that later adds LUKS: it would sit at the logo with no prompt and no
// way in.
prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
  hint = Image.Text(prompt, FG_R, FG_G, FG_B);
  prompt_sprite.SetImage(hint);
  prompt_sprite.SetX(screen_width / 2 - hint.GetWidth() / 2);
  prompt_sprite.SetY(title_y + title_h + screen_height / 12);
  prompt_sprite.SetZ(6);

  dots = "";
  for (i = 0; i < bullets; i++) dots += "*";
  dot_text = Image.Text(dots, FG_R, FG_G, FG_B);
  bullets_sprite.SetImage(dot_text);
  bullets_sprite.SetX(screen_width / 2 - dot_text.GetWidth() / 2);
  bullets_sprite.SetY(title_y + title_h + screen_height / 8);
  bullets_sprite.SetZ(6);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  prompt_sprite.SetImage(Image.Text("", 0, 0, 0));
  bullets_sprite.SetImage(Image.Text("", 0, 0, 0));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ── messages ────────────────────────────────────────────────────────
// fsck progress and emergency text arrive here. Showing them matters: a
// splash that swallows "unexpected inconsistency, run fsck manually"
// leaves the user staring at a logo forever.
message_sprite = Sprite();
message_sprite.SetZ(7);

fun message_callback(text) {
  msg = Image.Text(text, FG_R, FG_G, FG_B);
  message_sprite.SetImage(msg);
  message_sprite.SetX(screen_width / 2 - msg.GetWidth() / 2);
  message_sprite.SetY(screen_height - screen_height / 12);
}
Plymouth.SetMessageFunction(message_callback);
