[Desktop Entry]
Type=Application
Name=PCManFM-Qt File Manager
GenericName=File Manager
Comment=Browse the file system and manage the files
Icon=system-file-manager
Categories=Utility;Core;System;FileTools;FileManager;Qt;
Exec=env QT_FONT_DPI=84 pcmanfm-qt %U
Terminal=false
MimeType=inode/directory;
Keywords=file;manager;explorer;browser;
StartupNotify=true
X-Ati-Note=Local override. See .config/pcmanfm-qt/default/settings.conf for why QT_FONT_DPI is here.
